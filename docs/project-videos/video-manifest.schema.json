{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanifcarroll.com/schemas/project-video-manifest.json",
  "title": "Portfolio project video manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "editorialProfile",
    "slug",
    "title",
    "family",
    "timing",
    "viewer",
    "takeaway",
    "theme",
    "scenes",
    "posterAt",
    "privacy",
    "sources",
    "generation"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "editorialProfile": { "const": "silent-proof-v1" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "family": { "enum": ["system-proof", "product-journey", "visual-showcase"] },
    "timing": { "enum": ["standard", "short", "loop"] },
    "viewer": { "type": "string", "minLength": 1 },
    "takeaway": { "type": "string", "minLength": 1 },
    "theme": { "$ref": "#/$defs/theme" },
    "scenes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/scene" }
    },
    "posterAt": { "type": "number", "minimum": 0 },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hide", "safe"],
      "properties": {
        "hide": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "safe": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "templateVersion", "hyperframesVersion"],
      "properties": {
        "model": { "const": "gpt-5.6-sol" },
        "templateVersion": { "const": "2.0.0" },
        "hyperframesVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "sourceCommit": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "textRole": { "enum": ["primary", "supporting", "orientation", "status"] },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas",
        "surface",
        "ink",
        "muted",
        "border",
        "accent",
        "accentSoft",
        "accent2",
        "deep",
        "fontDisplay",
        "fontBody",
        "fontMono",
        "motif"
      ],
      "properties": {
        "canvas": { "$ref": "#/$defs/hex" },
        "surface": { "$ref": "#/$defs/hex" },
        "ink": { "$ref": "#/$defs/hex" },
        "muted": { "$ref": "#/$defs/hex" },
        "border": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" },
        "accentSoft": { "$ref": "#/$defs/hex" },
        "accent2": { "$ref": "#/$defs/hex" },
        "deep": { "$ref": "#/$defs/hex" },
        "fontDisplay": { "type": "string", "minLength": 1 },
        "fontBody": { "type": "string", "minLength": 1 },
        "fontMono": { "type": "string", "minLength": 1 },
        "motif": { "enum": ["rails", "path", "gallery"] }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "title", "body"],
      "properties": {
        "role": { "$ref": "#/$defs/textRole" },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "value", "label"],
      "properties": {
        "role": { "$ref": "#/$defs/textRole" },
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "textRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline"],
      "properties": {
        "eyebrow": { "$ref": "#/$defs/textRole" },
        "headline": { "const": "primary" },
        "body": { "$ref": "#/$defs/textRole" }
      }
    },
    "assetTextElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "text"],
      "properties": {
        "role": { "$ref": "#/$defs/textRole" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": { "asset": ["assetAlt"], "assetText": ["asset"] },
      "required": [
        "id",
        "kind",
        "intent",
        "textRoles",
        "headline",
        "duration",
        "layout",
        "transition",
        "motion"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": {
          "enum": [
            "problem",
            "context",
            "action",
            "workflow",
            "evidence",
            "report",
            "showcase",
            "result",
            "end"
          ]
        },
        "intent": { "type": "string", "minLength": 1 },
        "textRoles": { "$ref": "#/$defs/textRoles" },
        "eyebrow": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "duration": { "type": "number", "minimum": 2.5 },
        "layout": { "enum": ["copy-left", "copy-right", "full", "stack", "rail", "report"] },
        "asset": { "type": "string", "minLength": 1 },
        "assetAlt": { "type": "string" },
        "assetFit": { "enum": ["cover", "contain"] },
        "assetPosition": { "type": "string" },
        "assetText": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assetTextElement" }
        },
        "labels": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/label" }
        },
        "stat": { "$ref": "#/$defs/stat" },
        "transition": { "enum": ["push-left", "push-up", "dissolve"] },
        "motion": { "enum": ["assemble", "settle", "scroll", "drift"] }
      }
    }
  }
}
