{
  "name": "hanif-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "node node_modules/astro/bin/astro.mjs dev --host 127.0.0.1 --port ${PORT:-4321}",
    "dev:direct": "node node_modules/astro/bin/astro.mjs dev",
    "start": "node node_modules/astro/bin/astro.mjs dev",
    "check:projects": "node scripts/check-project-metadata.mjs",
    "check:copy": "node scripts/check-user-facing-copy.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "notes:sync": "node scripts/sync-notes-content.mjs",
    "notes:check": "node scripts/sync-notes-content.mjs --check",
    "videos:list": "node scripts/project-videos.mjs list",
    "videos:test": "node --test scripts/project-video-lib.test.mjs",
    "videos:validate": "node scripts/project-videos.mjs validate",
    "videos:generate": "node scripts/project-videos.mjs generate",
    "videos:qa": "node scripts/project-videos.mjs qa",
    "videos:render": "node scripts/project-videos.mjs render",
    "videos:all": "node scripts/project-videos.mjs all",
    "build": "node node_modules/astro/bin/astro.mjs check && node node_modules/astro/bin/astro.mjs build && node scripts/check-user-facing-copy.mjs",
    "preview": "node node_modules/astro/bin/astro.mjs preview",
    "astro": "node node_modules/astro/bin/astro.mjs",
    "prepare": "husky",
    "tuesday:test": "bun test src/lib/tuesday-sim/"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.4",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^6.0.2",
    "@netlify/functions": "^5.3.0",
    "astro": "^7.1.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.10",
    "typescript": "6.0.3",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "5.2.8",
    "@fontsource/eb-garamond": "5.2.7",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/league-gothic": "5.2.8",
    "@fontsource/montserrat": "5.2.8",
    "@fontsource/oswald": "5.2.8",
    "@fontsource/space-mono": "5.2.9",
    "@hyperframes/producer": "0.7.46",
    "@react-email/ui": "6.9.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "baseline-browser-mapping": "^2.10.38",
    "gsap": "3.14.2",
    "husky": "^9.1.7",
    "hyperframes": "0.7.46",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "parse5": "^8.0.1",
    "playwright-core": "^1.61.0"
  },
  "packageManager": "bun@1.3.8",
  "portless": {
    "name": "portfolio",
    "script": "dev:app",
    "appPort": 4321
  }
}
