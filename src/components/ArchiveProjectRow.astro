---
import { Image } from 'astro:assets';
import type { ProjectCard } from '@src/lib/project-cards';
interface Props {
	project: ProjectCard;
}

const { project } = Astro.props;
const visibleTags = project.tags.slice(0, 3);
---

<li class='hc-archive-row'>
	<a class='hc-archive-row__link' href={`/projects/${project.slug}/`}>
		<figure class='hc-archive-row__media'>
			<Image
				src={project.image}
				alt=''
				loading='lazy'
				widths={[400, 800, 1200]}
				sizes='(min-width: 1024px) 160px, (min-width: 640px) 25vw, calc(100vw - 3rem)'
				aria-hidden='true'
				class:list={{ 'hc-archive-row__image--contain': project.slug === 'palabruno' }}
			/>
		</figure>
		<div class='hc-archive-row__content'>
			<h3 class='hc-archive-row__title'>{project.name}</h3>
			<p class='hc-archive-row__description'>{project.description}</p>
			<ul class='hc-archive-row__tags' aria-label='Technologies used'>
				{visibleTags.map((tag) => <li>{tag}</li>)}
			</ul>
		</div>
	</a>
</li>
