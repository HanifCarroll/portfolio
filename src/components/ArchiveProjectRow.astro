---
import { Image } from 'astro:assets';
import type { ProjectCard } from '@src/lib/project-cards';
import { itemTitleClass, metaClass, titleHoverClass } from '@src/lib/ui';
interface Props {
	project: ProjectCard;
}

const { project } = Astro.props;
const visibleTags = project.tags.slice(0, 3);
---

<li>
	<a class:list={['group grid gap-2 text-inherit no-underline']} href={`/projects/${project.slug}/`}>
		<Image
			class='mb-2 block h-auto w-full'
			src={project.image}
			alt=''
			loading='lazy'
			widths={[400, 720, 1120]}
			sizes='(min-width: 1200px) 536px, (min-width: 768px) calc(50vw - 4rem), calc(100vw - 3rem)'
			aria-hidden='true'
		/>
		<h3 class:list={[itemTitleClass, titleHoverClass, 'md:text-[2.25rem]']}>{project.name}</h3>
		<p class='m-0 max-w-[36rem] text-[clamp(1.125rem,2vw,1.25rem)] leading-[1.55] text-ink-muted'>{project.description}</p>
		<p class:list={[metaClass, 'mt-1']}><span class='sr-only'>Technologies used: </span>{visibleTags.join(' · ')}</p>
	</a>
</li>
