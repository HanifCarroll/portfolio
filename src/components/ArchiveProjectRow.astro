---
import { Image } from 'astro:assets';
import type { ProjectCard } from '@src/lib/project-cards';
interface Props {
	project: ProjectCard;
}

const { project } = Astro.props;
const visibleTags = project.tags.slice(0, 3);
---

<li>
	<a
		class='group grid gap-3 text-inherit no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:grid-cols-8 sm:gap-4'
		href={`/projects/${project.slug}/`}
	>
		<figure class='m-0 sm:col-span-2'>
			<Image
				class='aspect-video w-full object-contain'
				src={project.image}
				alt=''
				loading='lazy'
				widths={[400, 800, 1200]}
				sizes='(min-width: 1024px) 160px, (min-width: 640px) 25vw, calc(100vw - 3rem)'
				aria-hidden='true'
			/>
		</figure>
		<div class='sm:col-span-6'>
			<h3 class='m-0 text-base font-medium leading-snug text-ink transition-colors group-hover:text-accent-ink group-focus-visible:text-accent-ink'>{project.name}</h3>
			<p class='mt-2 mb-0 text-sm leading-relaxed text-ink-muted'>{project.description}</p>
			<ul class='mt-3 mb-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0 text-xs text-ink-muted' aria-label='Technologies used'>
				{visibleTags.map((tag) => <li class='after:ml-3 after:text-line after:content-["·"] last:after:content-none'>{tag}</li>)}
			</ul>
		</div>
	</a>
</li>
