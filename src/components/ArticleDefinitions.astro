<div
  id="article-definition"
  role="tooltip"
  class="article-definition invisible fixed z-[1000] w-[min(360px,calc(100vw-24px))] translate-y-[5px] rounded-xl border border-[#b9c9db] bg-[#f4f7fa] px-5 py-[18px] font-sans text-[15px] leading-[1.6] text-ink opacity-0 shadow-[0_12px_36px_#0002] transition-[opacity,transform,visibility] duration-[180ms] motion-reduce:translate-y-0 motion-reduce:transition-none [&.is-visible]:visible [&.is-visible]:translate-y-0 [&.is-visible]:opacity-100"
></div>
<script>
  const tooltip = document.querySelector<HTMLElement>('#article-definition')!;
  let active: HTMLButtonElement | null = null;
  let timer: ReturnType<typeof setTimeout>;
  function hide() {
    clearTimeout(timer);
    active?.removeAttribute('aria-describedby');
    active = null;
    tooltip.classList.remove('is-visible');
  }
  function show(button: HTMLButtonElement) {
    clearTimeout(timer);
    active?.removeAttribute('aria-describedby');
    active = button;
    tooltip.textContent = button.dataset.definition ?? '';
    button.setAttribute('aria-describedby', tooltip.id);
    const rect = button.getBoundingClientRect();
    const width = tooltip.offsetWidth;
    tooltip.style.left = `${Math.max(12, Math.min(rect.left, innerWidth - width - 12))}px`;
    const height = tooltip.offsetHeight;
    tooltip.style.top = `${Math.max(12, rect.bottom + height + 20 > innerHeight ? rect.top - height - 10 : rect.bottom + 10)}px`;
    tooltip.classList.add('is-visible');
  }
  const delayHide = () => { timer = setTimeout(hide, 160); };
  document.querySelectorAll<HTMLButtonElement>('.definition-term').forEach(button => {
    button.addEventListener('pointerenter', event => { if (event.pointerType !== 'touch') show(button); });
    button.addEventListener('pointerleave', delayHide);
    button.addEventListener('focus', () => show(button));
    button.addEventListener('blur', hide);
    button.addEventListener('click', () => show(button));
  });
  tooltip.addEventListener('pointerenter', () => clearTimeout(timer));
  tooltip.addEventListener('pointerleave', delayHide);
  document.addEventListener('keydown', event => { if (event.key === 'Escape') hide(); });
  document.addEventListener('pointerdown', event => {
    if (!(event.target instanceof Element) || !event.target.closest('.definition-term, .article-definition')) hide();
  });
  window.addEventListener('scroll', hide, { passive: true });
  window.addEventListener('resize', hide);
  const diagrams = document.querySelectorAll<HTMLElement>('.bpm-diagram');
  if (diagrams.length) {
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: 'base', themeVariables: { primaryColor: '#E8EDF5', primaryTextColor: '#152235', primaryBorderColor: '#8CA4BE', lineColor: '#527394', secondaryColor: '#F8EDCE', tertiaryColor: '#F4F7FA' }, flowchart: { useMaxWidth: true } });
    await mermaid.run({ nodes: Array.from(diagrams) });
  }
</script>
<style is:global>
  /* Mermaid generates this SVG markup, so it can't carry utility classes. */
  .bpm-diagram .labelBkg {
    min-width: 48px;
    padding: 0;
    border-radius: 3px;
    box-shadow: 0 0 0 6px #f8edce;
  }
  .bpm-diagram .labelBkg .edgeLabel,
  .bpm-diagram .labelBkg p {
    background: transparent;
  }
  .bpm-diagram .edgeLabel foreignObject {
    overflow: visible;
  }
</style>
