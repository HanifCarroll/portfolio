---
import { Image } from 'astro:assets';
import Ava from '@src/assets/img/hanif-author-portrait.jpg';
---

<div class='not-prose flex items-center gap-4 font-sans text-base leading-[1.35]'>
	<a href='https://github.com/hanifcarroll' target='_blank' rel='noopener noreferrer' class='h-12 w-12 shrink-0 overflow-hidden rounded-full'>
		<Image src={Ava} alt='Hanif Carroll' />
	</a>
	<div>
		<a href='https://github.com/hanifcarroll' class='block text-ink no-underline decoration-accent decoration-2 underline-offset-[0.18em] hover:underline focus-visible:underline' target='_blank' rel='noopener noreferrer'>
			Hanif Carroll
		</a>
		<span class='block text-ink-muted'>Freelance Software Engineer</span>
	</div>
</div>
