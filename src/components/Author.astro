---
import { Image } from 'astro:assets';
import Ava from '@src/assets/img/hanif-author-portrait.jpg';

---

<div class='flex gap-4 items-center leading-tight not-prose'>
	<a
		href='https://github.com/hanifcarroll'
		target='_blank'
		rel='noopener noreferrer'
		class='h-12 w-12 shrink-0 overflow-hidden rounded-full'
	>
		<Image src={Ava} alt='Hanif Carroll' />
	</a>
	<div>
		<div>
			<a
				href='https://github.com/hanifcarroll'
				class='block font-bold text-inherit hover:text-[var(--link-color)]'
				target='_blank'
				rel='noopener noreferrer'
			>
				Hanif Carroll
			</a>
		</div>
		<small class='avatar__subtitle'>Contract Product Engineer</small>
	</div>
</div>
