---
import { Image } from 'astro:assets';
import Ava from '@src/assets/img/hanif-author-portrait.jpg';

interface Props {
	nameClass?: string;
	subtitleClass?: string;
}

const { nameClass = 'font-bold', subtitleClass = '' } = Astro.props;
---

<div class='not-prose flex items-center gap-4 leading-tight'>
	<a
		href='https://github.com/hanifcarroll'
		target='_blank'
		rel='noopener noreferrer'
		class='h-12 w-12 shrink-0 overflow-hidden rounded-full'
	>
		<Image src={Ava} alt='Hanif Carroll' />
	</a>
	<div>
		<div>
			<a
				href='https://github.com/hanifcarroll'
				class:list={['block text-inherit', nameClass]}
				target='_blank'
				rel='noopener noreferrer'
			>
				Hanif Carroll
			</a>
		</div>
		<small class={subtitleClass}>Forward Deployed Engineer</small>
	</div>
</div>
