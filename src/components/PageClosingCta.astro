---
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';
import { buttonClass, textLinkClass } from '../lib/ui';

const {
	title = "Need an engineer who can work directly with your clients?",
	body = "I work with clients on discovery, scope, implementation, and handoff. Available for fully remote roles and contracts.",
	primaryLabel = 'Discuss a role or engagement',
	location = 'footer_cta'
} = Astro.props;
const mobileAction = 'max-sm:w-full max-sm:justify-between';
---

<section class='relative bg-canvas py-24 text-ink max-sm:py-12' data-motion-group>
	<div class='mx-auto w-[min(calc(100%-7rem),75rem)] max-lg:w-[min(calc(100%-3rem),75rem)]'>
		<div
			class='grid items-center gap-12 rounded-xl border border-line bg-canvas p-[clamp(2rem,6vw,6rem)] shadow-card lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] max-lg:gap-6 max-sm:rounded-none max-sm:border-0 max-sm:bg-transparent max-sm:p-0 max-sm:shadow-none'
			data-motion-item
		>
			<h2 class='m-0 text-[clamp(2rem,4vw,2.5rem)] font-bold leading-[1.2] tracking-[-0.05em] text-ink text-balance max-sm:text-[clamp(2rem,9vw,2.25rem)] max-sm:leading-[1.06]'>{title}</h2>
			<div class='grid gap-6 max-sm:gap-8'>
				<p class='m-0 max-w-reading text-xl leading-[1.65] text-ink-muted max-sm:text-lg max-sm:leading-[1.5] max-sm:text-ink'>{body}</p>
				<div class='flex flex-wrap items-center gap-4 max-sm:w-full max-sm:flex-col max-sm:items-stretch'>
					<a class:list={[buttonClass(), mobileAction]} href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location={location}>{primaryLabel}</a>
					<a class:list={[textLinkClass, mobileAction, 'max-sm:min-h-11 max-sm:px-6']} href={EMAIL_URL} data-track-event='email_clicked' data-track-location={location}>Email Hanif</a>
				</div>
			</div>
		</div>
	</div>
</section>
