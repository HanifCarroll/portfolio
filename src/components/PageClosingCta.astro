---
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';
import { buttonClass, textLinkClass } from '../lib/ui';

const {
	title = 'Have something in your business you’d like help with?',
	body = 'Email me about one task, or book a call. I’ll look at how it works today and tell you what I’d do.',
	primaryLabel = 'Email me about one task',
	location = 'footer_cta',
	inverse = false
} = Astro.props;
const mobileAction = 'max-sm:w-full max-sm:justify-between';
// Bright yellow reads on ink; light backgrounds use the dark gold instead.
const inverseLink = 'underline decoration-accent decoration-2 underline-offset-[0.18em] hover:decoration-current focus-visible:decoration-current';
---

{inverse ? (
	<section class='bg-ink pt-24 pb-24 text-center text-white lg:pt-40 lg:pb-40' data-section='closing-cta' aria-labelledby='closing-cta-title' data-motion-group>
		<div class='mx-auto w-full max-w-page px-6 md:px-12' data-motion-item>
			<h2 id='closing-cta-title' class='m-0 font-editorial text-[clamp(2.5rem,6vw,5.25rem)] font-normal leading-none tracking-[-0.042em] text-white text-balance'>{title}</h2>
			<p class='mx-auto mt-6 mb-0 max-w-[36rem] text-[clamp(1.125rem,2vw,1.25rem)] leading-[1.55] text-balance'>{body}</p>
			<div class='mt-8 flex items-center justify-center gap-x-6 gap-y-3 max-sm:flex-col max-sm:items-stretch'>
				<a class='inline-flex min-h-[3.25rem] items-center justify-center rounded-lg bg-white px-[1.625rem] py-3 text-base font-medium text-ink no-underline transition-colors hover:bg-white/85 focus-visible:bg-white/85' href={EMAIL_URL} data-track-event='email_clicked' data-track-location={location}>{primaryLabel}</a>
				<a class:list={['inline-flex min-h-11 items-center self-center text-base text-white', inverseLink]} href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location={location}>Book a call</a>
			</div>
			<p class='mx-auto mt-8 mb-0 text-base leading-relaxed text-white/80'>Work at an agency? <a class:list={['text-white', inverseLink]} href='/agencies/'>I also build under your name.</a></p>
		</div>
	</section>
) : (
	<section class='relative bg-canvas py-24 text-ink max-sm:py-12' data-motion-group>
		<div class='mx-auto w-[min(calc(100%-7rem),75rem)] max-lg:w-[min(calc(100%-3rem),75rem)]'>
			<div
				class='grid items-center gap-12 rounded-xl border border-line bg-canvas p-[clamp(2rem,6vw,6rem)] shadow-card lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] max-lg:gap-6 max-sm:rounded-none max-sm:border-0 max-sm:bg-transparent max-sm:p-0 max-sm:shadow-none'
				data-motion-item
			>
				<h2 class='m-0 text-[clamp(2rem,4vw,2.5rem)] font-bold leading-[1.2] tracking-[-0.05em] text-ink text-balance max-sm:text-[clamp(2rem,9vw,2.25rem)] max-sm:leading-[1.06]'>{title}</h2>
				<div class='grid gap-6 max-sm:gap-8'>
					<p class='m-0 max-w-reading text-xl leading-[1.65] text-ink-muted max-sm:text-lg max-sm:leading-[1.5] max-sm:text-ink'>{body}</p>
					<div class='flex flex-wrap items-center gap-4 max-sm:w-full max-sm:flex-col max-sm:items-stretch'>
						<a class:list={[buttonClass(), mobileAction]} href={EMAIL_URL} data-track-event='email_clicked' data-track-location={location}>{primaryLabel}</a>
						<a class:list={[textLinkClass, mobileAction, 'max-sm:min-h-11 max-sm:px-6']} href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location={location}>Book a call</a>
					</div>
					<p class='m-0 text-sm leading-relaxed text-ink-muted'>Work at an agency? <a class='font-medium text-ink underline decoration-accent-ink underline-offset-4 hover:text-accent-ink hover:decoration-accent focus-visible:text-accent-ink focus-visible:decoration-accent' href='/agencies/'>I also build under your name.</a></p>
				</div>
			</div>
		</div>
	</section>
)}
