---
import { BOOK_CALL_URL } from '../consts';
import { getDictionary, getLocale, localizedPath } from '../i18n';
import { closingActionsClass, closingBodyClass, closingButtonClass, closingClass, closingLinkClass, closingTitleClass, closingUnderlineClass, shellClass } from '../lib/ui';

const locale = getLocale(Astro.currentLocale);
const { closing, action } = getDictionary(locale);
const {
	title = closing.title,
	body = closing.body,
	primaryLabel = action.emailProblem,
	location = 'footer_cta'
} = Astro.props;
---

<section class={closingClass} data-section='closing-cta' aria-labelledby='closing-cta-title' data-motion-group>
	<div class={shellClass} data-motion-item>
		<h2 id='closing-cta-title' class={closingTitleClass}>{title}</h2>
		<p class={closingBodyClass}>{body}</p>
		<div class={closingActionsClass}>
			<a class={closingButtonClass} href={localizedPath('/contact/', locale)} data-track-event='email_clicked' data-track-location={location}>{primaryLabel}</a>
			<a class={closingLinkClass} href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location={location}>{action.bookCall}</a>
		</div>
		<p class='mx-auto mt-8 mb-0 text-base leading-relaxed text-white/80'>{closing.agencyPrompt}{' '}<a class:list={['text-white', closingUnderlineClass]} href={localizedPath('/agencies/', locale)}>{closing.agencyLink}</a></p>
	</div>
</section>
