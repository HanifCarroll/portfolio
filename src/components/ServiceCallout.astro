---
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';
import { buttonClass, textLinkClass } from '../lib/ui';

type Variant = 'general' | 'systemsBuild';
type Context = 'blog' | 'case-study';

interface Props {
	variant?: Variant;
	context?: Context;
	location: string;
	class?: string;
}

const { variant = 'general', context = 'blog', location, class: className = '' } = Astro.props as Props;

const offers = {
	general: {
		title: "Need an engineer who works directly with clients?",
		body: "I learn how an organization works, figure out where software could help, and build it with the people who’ll use it. Available for fully remote roles and contracts.",
		secondaryHref: '/projects/',
		secondaryLabel: 'See projects',
		primaryLabel: 'Discuss a role or engagement'
	},
	systemsBuild: {
		title: 'Have a client engagement that needs an engineer?',
		body: 'I work with clients from discovery and prototypes through integrations, launch, and handoff. Available for fully remote roles and contracts.',
		secondaryHref: '/projects/',
		secondaryLabel: 'See projects',
		primaryLabel: 'Discuss a role or engagement'
	}
} as const;

const offer = context === 'case-study'
	? {
			...offers[variant],
			title: 'Need an engineer who can work directly with your clients?',
			body: 'I work with clients on discovery, scope, implementation, and handoff. Available for fully remote roles and contracts.',
			primaryLabel: 'Discuss a role or engagement'
		}
	: offers[variant];
const secondaryHref = context === 'case-study' ? EMAIL_URL : offer.secondaryHref;
const secondaryLabel = context === 'case-study' ? 'Email Hanif' : offer.secondaryLabel;
const secondaryEvent = context === 'case-study' ? 'email_clicked' : 'service_page_clicked';
const isCaseStudy = context === 'case-study';
const mobileAction = 'max-sm:w-full max-sm:justify-between';
---

<section
	class:list={[
		'grid text-ink',
		isCaseStudy
			? 'mt-24 -mx-6 w-[calc(100%+3rem)] items-start gap-12 bg-canvas px-6 py-[clamp(2rem,5vw,4rem)] md:-mx-14 md:w-[calc(100%+7rem)] md:px-14 lg:grid-cols-2 max-lg:gap-6 max-sm:mt-0 max-sm:py-20'
			: 'mt-16 items-center gap-12 rounded-xl border border-line bg-canvas p-[clamp(2rem,6vw,6rem)] shadow-card lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] max-lg:gap-6 max-sm:rounded-none max-sm:border-0 max-sm:py-12 max-sm:shadow-none',
		'max-sm:mx-[calc(50%-50vw)] max-sm:w-screen max-sm:px-6',
		className,
	]}
>
	<h2 class='m-0 font-editorial text-[clamp(2rem,4vw,2.5rem)] font-bold leading-[1.1] tracking-[-0.045em] text-ink text-balance max-sm:text-[clamp(2rem,9vw,2.25rem)] max-sm:leading-[1.06]'>
		{offer.title}
	</h2>
	<div class='grid gap-6 max-sm:gap-8'>
		<p class='m-0 max-w-reading text-lg leading-[1.65] text-ink-muted max-sm:leading-[1.5] max-sm:text-ink'>{offer.body}</p>
		<div class:list={['flex flex-wrap items-center gap-4 max-sm:w-full max-sm:flex-col max-sm:items-stretch', isCaseStudy && 'max-md:items-stretch']}>
			<a
				class:list={[buttonClass(isCaseStudy ? 'border-ink-muted' : 'border-line'), mobileAction]}
				href={BOOK_CALL_URL}
				target='_blank'
				rel='noopener noreferrer'
				data-track-event='book_call_clicked'
				data-track-location={`${location}_primary`}
			>
				{offer.primaryLabel}
			</a>
			<a
				class:list={isCaseStudy ? [buttonClass(), mobileAction] : [textLinkClass, mobileAction, 'max-sm:min-h-11 max-sm:px-6']}
				href={secondaryHref}
				data-track-event={secondaryEvent}
				data-track-location={`${location}_secondary`}
			>
				{secondaryLabel}
			</a>
		</div>
	</div>
</section>
