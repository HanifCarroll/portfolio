---
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';

type Variant = 'general' | 'systemsBuild' | 'ongoing';
type Context = 'blog' | 'case-study';

interface Props {
	variant?: Variant;
	context?: Context;
	location: string;
	class?: string;
}

const { variant = 'general', context = 'blog', location, class: className = '' } = Astro.props as Props;

const offers = {
	general: {
		title: "Tell me what your team needs to ship.",
		body: "Start with the feature, integration, or system that's stuck. We'll work out whether a project or a monthly contract fits.",
		secondaryHref: '/projects/',
		secondaryLabel: 'See projects',
		primaryLabel: 'Book a 30-minute fit call'
	},
	systemsBuild: {
		title: 'Have a product priority that needs an owner?',
		body: 'I join B2B SaaS teams on contract to ship the features, internal tools, and integrations already on your roadmap.',
		secondaryHref: '/projects/',
		secondaryLabel: 'See projects',
		primaryLabel: 'Book a 30-minute fit call'
	},
	ongoing: {
		title: 'Need ongoing senior engineering?',
		body: 'A monthly contract covers continuing priorities across your product and the systems around it.',
		secondaryHref: '/projects/',
		secondaryLabel: 'See projects',
		primaryLabel: 'Book a 30-minute fit call'
	}
} as const;

const offer = offers[variant];
const secondaryHref = context === 'case-study' ? EMAIL_URL : offer.secondaryHref;
const secondaryLabel = context === 'case-study' ? 'Email Hanif' : offer.secondaryLabel;
const secondaryEvent = context === 'case-study' ? 'email_clicked' : 'service_page_clicked';
---

<section
	class:list={['hc-cta-panel', 'hc-cta-panel--mobile-band', 'hc-cta-base', `hc-cta-panel--${context}`, className]}
>
	<h2>{offer.title}</h2>
	<div class='hc-cta-panel__body'>
		<p>{offer.body}</p>
		<div class='hc-actions hc-actions--paired'>
			<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location={`${location}_primary`}>
				{offer.primaryLabel}
			</a>
			<a class:list={context === 'case-study' ? ['hc-button', 'hc-button--secondary'] : ['hc-text-link']} href={secondaryHref} data-track-event={secondaryEvent} data-track-location={`${location}_secondary`}>
				{secondaryLabel}
			</a>
		</div>
	</div>
</section>
