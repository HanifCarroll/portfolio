---
import { BOOK_CALL_URL } from '../consts';

type Variant = 'general' | 'systemsBuild' | 'ongoing';
type Context = 'blog' | 'case-study';

interface Props {
	variant?: Variant;
	context?: Context;
	location: string;
	class?: string;
}

const { variant = 'general', context = 'blog', location, class: className = '' } = Astro.props as Props;

const offers = {
	general: {
		title: "Tell me what your team needs to ship.",
		body: "Start with the feature, integration, or system that's stuck. We'll work out whether a project or a monthly contract fits.",
		secondaryHref: '/services/',
		secondaryLabel: 'Explore contract engineering',
		primaryLabel: 'Book a fit call'
	},
	systemsBuild: {
		title: "Have something that needs building?",
		body: 'I build customer-facing features, internal tools, and integrations for B2B SaaS teams on contract.',
		secondaryHref: '/services/',
		secondaryLabel: 'Explore contract engineering',
		primaryLabel: 'Book a fit call'
	},
	ongoing: {
		title: 'Need ongoing senior engineering?',
		body: 'A monthly contract covers continuing priorities across your product and the systems around it.',
		secondaryHref: '/services/',
		secondaryLabel: 'Explore contract engineering',
		primaryLabel: 'Book a fit call'
	}
} as const;

const offer = offers[variant];
---

<section
	class:list={['hc-cta-panel', 'hc-cta-panel--mobile-band', `hc-cta-panel--${context}`, className]}
	data-header-surface={context === 'blog' ? 'dark' : 'light'}
	data-header-surface-mobile='dark'
>
	<h2>{offer.title}</h2>
	<div class='hc-cta-panel__body'>
		<p>{offer.body}</p>
		<div class='hc-actions hc-actions--paired'>
			<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location={`${location}_primary`}>
				{offer.primaryLabel}
			</a>
			<a class='hc-text-link' href={offer.secondaryHref} data-track-event='service_page_clicked' data-track-location={`${location}_secondary`}>
				{offer.secondaryLabel}
			</a>
		</div>
	</div>
</section>
