---
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';

type Variant = 'general' | 'audit' | 'systemsBuild' | 'ongoing';
type Context = 'blog' | 'case-study';

interface Props {
	variant?: Variant;
	context?: Context;
	location: string;
	class?: string;
}

const { variant = 'general', context = 'blog', location, class: className = '' } = Astro.props as Props;

const offers = {
	general: {
		title: "Which workflow is giving your team trouble?",
		body: "Start with the repeated manual work, unreliable handoff, reporting problem, approval bottleneck, or system that no longer fits.",
		secondaryHref: '/services/',
		secondaryLabel: 'Compare all services',
		primaryLabel: 'Book a Business Systems Audit'
	},
	audit: {
		title: "Find what's slowing your operations down.",
		body: 'A Business Systems Audit maps the workflow, identifies where the process gets stuck, and gives you a first build plan.',
		secondaryHref: '/services/business-systems-audit/',
		secondaryLabel: 'See the Business Systems Audit',
		primaryLabel: 'Book a Business Systems Audit'
	},
	systemsBuild: {
		title: 'Have a workflow ready to become software?',
		body: 'I design and build internal tools, automations, dashboards, integrations, and AI-assisted workflows around the people who need to use them.',
		secondaryHref: '/services/business-systems-build/',
		secondaryLabel: 'See the Business Systems Build',
		primaryLabel: 'Start a scoping conversation'
	},
	ongoing: {
		title: 'Need ongoing technical help from someone who knows your systems?',
		body: 'An Ongoing Technical Partnership can cover connected priorities across a defined area of your business.',
		secondaryHref: '/services/ongoing-technical-partnership/',
		secondaryLabel: 'See the Ongoing Technical Partnership',
		primaryLabel: 'Book a fit call'
	}
} as const;

const offer = offers[variant];
---

<section class:list={['hc-cta-panel', `hc-cta-panel--${context}`, className]}>
	<h2>{offer.title}</h2>
	<div class='hc-cta-panel__body'>
		<p>{offer.body}</p>
		<div class='hc-actions'>
			<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location={`${location}_primary`}>
				{offer.primaryLabel}
			</a>
			<a class='hc-text-link' href={offer.secondaryHref} data-track-event='service_page_clicked' data-track-location={`${location}_secondary`}>
				{offer.secondaryLabel}
			</a>
			{context === 'case-study' && <a class='hc-text-link' href={EMAIL_URL} data-track-event='email_clicked' data-track-location={`${location}_email`}>Email Hanif</a>}
		</div>
	</div>
</section>
