---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOK_CALL_URL } from '../consts';
import type { ServiceOffer } from '../lib/service-offers';
import ServiceAuditMap from '../assets/img/illustrations/service-audit-map-dark.png';
import ServiceFocusedBuild from '../assets/img/illustrations/service-focused-build-dark.png';
import ServiceOngoingPartnership from '../assets/img/illustrations/service-ongoing-partnership-dark.png';
import ServiceCommercialSection from './service-detail/ServiceCommercialSection.astro';
import ServiceDeliverablesSection from './service-detail/ServiceDeliverablesSection.astro';
import ServiceFaqSection from './service-detail/ServiceFaqSection.astro';
import ServiceFitSection from './service-detail/ServiceFitSection.astro';
import ServiceProofSection from './service-detail/ServiceProofSection.astro';
import ServiceSummary from './service-detail/ServiceSummary.astro';
import ServiceWorkingSection from './service-detail/ServiceWorkingSection.astro';
import '../styles/service-detail.css';

interface Props {
	offer: ServiceOffer;
}

const { offer } = Astro.props as Props;
const heroIllustrations = {
	audit: ServiceAuditMap,
	systemsBuild: ServiceFocusedBuild,
	ongoing: ServiceOngoingPartnership
};
const heroIllustration = heroIllustrations[offer.key];
const serviceJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: offer.label,
	description: offer.description,
	url: `https://www.hanifcarroll.com${offer.path}`,
	provider: {
		'@type': 'Organization',
		name: 'HC Studio',
		url: 'https://www.hanifcarroll.com/'
	}
};
---

<BaseLayout
	title={offer.metaTitle}
	description={offer.description}
	jsonLd={serviceJsonLd}
	bodyClass='page-service-detail'
	footerCtaTitle={offer.finalHeading}
	footerCtaBody={offer.finalBody}
	footerCtaPrimaryLabel={offer.primaryCta}
	footerCtaLocation={`${offer.key}_final`}
>
	<article class='hc-service-detail-page' data-service-key={offer.key}>
		<header class='hc-detail-hero' data-motion-intro data-header-surface='dark'>
			<div class='hc-container-wide hc-detail-hero__grid'>
				<div class='hc-detail-hero__copy'>
					<nav class='hc-breadcrumbs' aria-label='Breadcrumb'>
						<a href='/'>Home</a><span aria-hidden='true'>/</span><a href='/services/'>Services</a><span aria-hidden='true'>/</span><span>{offer.label}</span>
					</nav>
					<h1 data-motion='headline'>{offer.heroTitle}</h1>
					<p class='hc-lead' data-motion-deck>{offer.heroBody}</p>
					<div class='hc-detail-hero__cta'>
						<div class='hc-actions hc-actions--paired'>
							<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location={`${offer.key}_hero`}>{offer.primaryCta}</a>
							<a class='hc-text-link' href={offer.secondaryHref}>{offer.secondaryCta}</a>
						</div>
						{offer.key === 'audit' && <p class='hc-detail-hero__cta-note'>The first call is to see whether an audit is the right place to begin.</p>}
					</div>
				</div>
				<figure class='hc-detail-hero__figure' data-motion-intro-item><Image src={heroIllustration} alt='' aria-hidden='true' loading='eager' /></figure>
			</div>
		</header>
		<ServiceSummary offer={offer} />
		{offer.sectionOrder.map((section) => (
			<>
				{section === 'fit' && <ServiceFitSection offer={offer} />}
				{section === 'deliverables' && <ServiceDeliverablesSection offer={offer} />}
				{section === 'proof' && <ServiceProofSection offer={offer} />}
				{section === 'working' && <ServiceWorkingSection offer={offer} />}
				{section === 'commercial' && <ServiceCommercialSection offer={offer} />}
				{section === 'faq' && <ServiceFaqSection offer={offer} />}
			</>
		))}
	</article>
</BaseLayout>
