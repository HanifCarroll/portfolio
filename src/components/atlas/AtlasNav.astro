---
// Entry list with search. Used in the desktop sidebar and the mobile header Contents panel.
import { englishPath, getDictionary, getLocale } from '../../i18n';
import { getAtlasCatalog } from '../../lib/atlas';

const { id = 'atlas-search' } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const { atlas: copy } = getDictionary(locale);
const current = englishPath(Astro.url.pathname).match(/^\/atlas\/([^/]+)/)?.[1];
const { problems, sections } = await getAtlasCatalog(locale);
---

<div data-atlas-nav-root>
	<label class='sr-only' for={id}>{copy.searchLabel}</label>
	<input
		id={id}
		type='search'
		placeholder={copy.searchPlaceholder}
		autocomplete='off'
		class='mb-6 w-full rounded-lg -outline-offset-2 border border-ink-muted bg-canvas px-3 py-2 font-sans text-base text-ink placeholder:text-ink-muted focus:border-ink'
		data-atlas-search
	/>
	<p class='m-0 mb-4 hidden font-sans text-base text-ink-muted' data-atlas-empty>{copy.noMatches}</p>
	<nav aria-label={copy.entriesLabel}>
		{sections.map((section) => (
			<div class='mb-6' data-atlas-group>
				<p class='m-0 mb-1.5 font-sans text-base leading-snug text-ink'>{section.title}</p>
				<ul class='m-0 list-none p-0'>
					{section.entries.map((entry) => (
						<li data-atlas-item data-search={[entry.title, entry.summary, ...entry.tools, ...problems.filter((problem) => problem.entries.includes(entry)).map((problem) => problem.title)].join(' ').toLowerCase()}>
							<a
								class:list={[
									'block py-1.5 pl-4 font-sans text-base leading-snug no-underline -outline-offset-2 transition-colors',
									entry.id === current ? 'text-ink underline decoration-accent-ink decoration-2 underline-offset-[0.18em]' : 'text-ink-muted hover:text-ink focus-visible:text-ink',
								]}
								href={entry.href}
								hreflang={entry.hreflang}
								aria-current={entry.id === current ? 'page' : undefined}
							>
								{entry.linkTitle}
							</a>
						</li>
					))}
				</ul>
			</div>
		))}
	</nav>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-atlas-nav-root]').forEach((root) => {
		const input = root.querySelector<HTMLInputElement>('[data-atlas-search]')!;
		const empty = root.querySelector<HTMLElement>('[data-atlas-empty]')!;
		input.addEventListener('input', () => {
			const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
			let shown = 0;
			root.querySelectorAll<HTMLElement>('[data-atlas-group]').forEach((group) => {
				let groupShown = 0;
				group.querySelectorAll<HTMLElement>('[data-atlas-item]').forEach((item) => {
					const match = terms.every((term) => item.dataset.search!.includes(term));
					item.hidden = !match;
					if (match) groupShown++;
				});
				group.hidden = groupShown === 0;
				shown += groupShown;
			});
			empty.classList.toggle('hidden', shown > 0);
		});
	});
</script>
