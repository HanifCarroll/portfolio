---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class='grid max-w-[65ch] gap-2 py-3 [&+&]:mt-8 [&_p]:m-0 [&_p]:font-editorial [&_p]:text-[1.15rem] [&_p]:leading-[1.5] [&_p]:text-ink-muted'>
	<h3 class='m-0 font-editorial text-[1.45rem] font-semibold leading-[1.12] tracking-normal text-ink text-balance'>{title}</h3>
	<slot />
</div>
