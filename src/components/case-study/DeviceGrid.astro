---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface DeviceGridScreen {
	image: ImageMetadata;
	mobileImage?: ImageMetadata;
	alt: string;
	label: string;
	title: string;
	caption: string;
	frame?: 'desktop' | 'mobile';
	mobileScrollable?: boolean;
	width?: 'contained' | 'compact';
}

interface Props {
	screens: DeviceGridScreen[];
	stacked?: boolean;
}

const { screens, stacked = false } = Astro.props;
const cardWidth = { contained: 'mx-auto w-[min(100%,52rem)]', compact: 'mx-auto w-[min(100%,38rem)]' };
---

<div class:list={['mt-3 grid gap-8 md:items-start', stacked ? 'md:grid-cols-1' : 'md:grid-cols-2']}>
	{
		screens.map((screen) => (
			<figure class:list={['grid min-w-0 content-start gap-4', screen.width && cardWidth[screen.width]]}>
				<div class:list={['relative w-full', screen.frame === 'mobile' ? 'mx-auto max-w-[16rem]' : 'max-w-[66rem]']}>
					<div
						class:list={[
							'overflow-hidden rounded-xl border border-line bg-canvas',
							screen.mobileScrollable && 'max-md:overflow-x-auto max-md:overscroll-x-contain max-md:[scrollbar-width:thin]',
						]}
					>
						<picture class:list={['block', screen.mobileScrollable && 'max-md:w-[44rem] max-md:max-w-none']}>
							{screen.mobileImage && <source media='(max-width: 47.999rem)' srcset={screen.mobileImage.src} />}
							<Image src={screen.image} alt={screen.alt} loading='eager' class='block h-auto w-full' />
						</picture>
					</div>
				</div>
				{screen.mobileScrollable && <span class='hidden text-[0.75rem] text-ink-muted max-md:-mt-2 max-md:block'>Swipe to read the full capture</span>}
				<figcaption class='grid max-w-[38rem] gap-[0.35rem] font-sans'>
					<span class='text-[0.7rem] font-bold uppercase leading-[1.4] tracking-[0.08em] text-accent-ink'>{screen.label}</span>
					<strong class='text-[1.05rem] font-[650] leading-[1.3] text-ink'>{screen.title}</strong>
					<p class='m-0 text-[0.875rem] leading-[1.6] text-ink-muted'>{screen.caption}</p>
				</figcaption>
			</figure>
		))
	}
</div>
