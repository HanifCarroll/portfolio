---
interface Props {
	imageSelector?: string;
	zoomable?: boolean;
}
const { imageSelector = '.cs-project-hero img, .cs-content img', zoomable = false } = Astro.props;

const controlClass = 'inline-flex min-h-11 cursor-pointer items-center justify-center rounded-[0.4rem] border border-white/40 bg-transparent px-3 py-2 font-[inherit] text-white no-underline hover:bg-white/12 focus-visible:outline-2 focus-visible:outline-offset-[0.2rem] focus-visible:outline-white';
const imageBase = 'block rounded-[0.4rem] shadow-[0_1.5rem_5rem_rgb(0_0_0/45%)]';
---

<dialog
	class:list={[
		'group m-0 box-border h-dvh max-h-none w-screen max-w-none border-0 bg-transparent p-[clamp(1rem,3vw,2.5rem)] text-white backdrop:bg-[rgb(16_13_15/92%)] backdrop:backdrop-blur-md',
		'motion-safe:[&[open]:not([data-closing])]:backdrop:animate-backdrop-in motion-safe:[&[data-closing]]:backdrop:animate-backdrop-out',
	]}
	aria-label="Expanded image"
	data-image-lightbox
	data-image-selector={imageSelector}
	data-zoomable={zoomable || undefined}
>
	<div
		class:list={[
			'relative grid size-full place-items-center',
			'motion-safe:group-[[open]:not([data-closing])]:animate-lightbox-in motion-safe:group-data-[closing]:animate-lightbox-out',
			zoomable && 'grid-rows-[auto_minmax(0,1fr)] gap-4',
		]}
	>
		<button class="absolute top-0 right-0 z-1 grid size-11 cursor-pointer place-items-center rounded-full border border-white/28 bg-[rgb(16_13_15/72%)] p-0 text-white hover:bg-white hover:text-[#100d0f] focus-visible:bg-white focus-visible:text-[#100d0f] focus-visible:outline-2 focus-visible:outline-offset-[0.2rem] focus-visible:outline-white" type="button" aria-label="Close image" data-lightbox-close>
			<svg class="size-5 fill-none stroke-current [stroke-linecap:round] [stroke-width:1.75]" viewBox="0 0 24 24" aria-hidden="true">
				<path d="m6 6 12 12M18 6 6 18" />
			</svg>
		</button>
		{zoomable ? (
			<>
				<div class="flex w-full flex-wrap items-center gap-2 pr-14 font-sans text-[0.875rem]" role="group" aria-label="Image view">
					<button class={controlClass} type="button" data-lightbox-fit>Fit</button>
					<button class={controlClass} type="button" data-lightbox-full>Full size</button>
					<button class={controlClass} type="button" aria-label="Zoom out" data-lightbox-out>−</button>
					<button class={controlClass} type="button" aria-label="Zoom in" data-lightbox-in>+</button>
					<output class="min-w-[3ch] px-1 tabular-nums" aria-live="polite" aria-label="Image zoom" data-lightbox-scale></output>
					<a class={controlClass} target="_blank" rel="noopener" data-lightbox-original>Open original image</a>
				</div>
				<div class="size-full overflow-auto overscroll-contain focus-visible:outline-2 focus-visible:outline-offset-[0.2rem] focus-visible:outline-white" tabindex="0" role="region" aria-label="Image; scroll to explore when zoomed" data-lightbox-viewport>
					<div class="grid min-h-full w-max min-w-full place-items-center p-4">
						<img class={`${imageBase} max-w-none max-h-none flex-none bg-white`} alt="" data-lightbox-image />
					</div>
				</div>
			</>
		) : <img class={`${imageBase} max-w-full max-h-[calc(100dvh-clamp(2rem,6vw,5rem))] object-contain`} alt="" data-lightbox-image />}
	</div>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-image-lightbox]');
	const expandedImage = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
	const viewport = dialog?.querySelector<HTMLElement>('[data-lightbox-viewport]');
	const original = dialog?.querySelector<HTMLAnchorElement>('[data-lightbox-original]');
	const scaleOutput = dialog?.querySelector<HTMLOutputElement>('[data-lightbox-scale]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	let trigger: HTMLElement | null = null;
	let closeTimer: number | undefined;
	let fitted = true;
	let scale = 1;
	const fitScale = () => Math.min(1, (viewport!.clientWidth - 32) / expandedImage!.naturalWidth, (viewport!.clientHeight - 32) / expandedImage!.naturalHeight);
	const renderZoom = () => {
		if (!viewport || !expandedImage?.naturalWidth || !dialog?.open) return;
		if (fitted) scale = fitScale();
		expandedImage.style.width = `${Math.round(expandedImage.naturalWidth * scale)}px`;
		expandedImage.style.height = `${Math.round(expandedImage.naturalHeight * scale)}px`;
		if (scaleOutput) scaleOutput.value = `${Math.round(scale * 100)}%`;
	};
	const setZoom = (next: number, fit = false) => {
		fitted = fit;
		scale = Math.min(4, Math.max(fitScale(), next));
		renderZoom();
		viewport?.scrollTo(0, 0);
	};

	const close = () => {
		if (!dialog?.open || dialog.hasAttribute('data-closing')) return;
		if (reducedMotion.matches) return dialog.close();

		dialog.setAttribute('data-closing', '');
		closeTimer = window.setTimeout(() => dialog.close(), 160);
	};

	document.querySelectorAll<HTMLImageElement>(dialog?.dataset.imageSelector || '.cs-project-hero img, .cs-content img').forEach((image) => {
		const link = image.closest<HTMLAnchorElement>('a');
		if (!dialog || !expandedImage || !image.alt || (link && !link.hasAttribute('data-image-link'))) return;
		const control: HTMLElement = link || image;

		if (!link) {
			image.tabIndex = 0;
			image.role = 'button';
		}
		control.setAttribute('aria-label', `View larger: ${image.alt}`);
		control.setAttribute('aria-haspopup', 'dialog');
		image.dataset.lightboxTrigger = '';
		image.classList.add('cursor-zoom-in');
		control.classList.add('focus-visible:outline-2', 'focus-visible:outline-offset-[0.35rem]', 'focus-visible:outline-accent-ink');

		const open = () => {
			trigger = control;
			expandedImage.src = link?.href || image.currentSrc || image.src;
			expandedImage.alt = image.alt;
			if (original) original.href = expandedImage.src;
			dialog.setAttribute('aria-label', `Expanded image: ${image.alt}`);
			fitted = true;
			dialog.removeAttribute('data-closing');
			dialog.showModal();
			renderZoom();
			viewport?.scrollTo(0, 0);
		};

		control.addEventListener('click', (event) => {
			if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
			event.preventDefault();
			open();
		});
		control.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			open();
		});
	});
	expandedImage?.addEventListener('load', renderZoom);
	window.addEventListener('resize', renderZoom);
	dialog?.querySelector('[data-lightbox-fit]')?.addEventListener('click', () => setZoom(1, true));
	dialog?.querySelector('[data-lightbox-full]')?.addEventListener('click', () => setZoom(1));
	dialog?.querySelector('[data-lightbox-in]')?.addEventListener('click', () => setZoom(scale * 1.5));
	dialog?.querySelector('[data-lightbox-out]')?.addEventListener('click', () => setZoom(scale / 1.5));

	dialog?.querySelector<HTMLButtonElement>('[data-lightbox-close]')?.addEventListener('click', close);
	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) close();
	});
	dialog?.addEventListener('close', () => {
		window.clearTimeout(closeTimer);
		dialog.removeAttribute('data-closing');
		trigger?.focus();
	});
	dialog?.addEventListener('cancel', (event) => {
		event.preventDefault();
		close();
	});
</script>
