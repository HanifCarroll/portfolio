---
interface ProofRow {
	label: string;
	title: string;
	body: string;
}

interface Props {
	rows: ProofRow[];
}

const { rows } = Astro.props;
---

<div class='grid max-w-[65ch] gap-4 [&>p]:mt-0 [&>p]:mb-2 [&>p]:text-lg [&>p]:leading-[1.6] [&>p]:text-ink-muted'>
	<slot />
	{
		rows.map((row, index) => (
			<article class='grid grid-cols-[2rem_minmax(0,1fr)] gap-3 py-4 md:grid-cols-[2.5rem_minmax(0,1fr)] md:gap-4' aria-label={row.label}>
				<span class='pt-[0.35rem] text-base leading-[1.3] tracking-[0.12em] text-ink-muted tabular-nums'>{String(index + 1).padStart(2, '0')}</span>
				<div class='grid gap-[0.4rem]'>
					<h3 class='m-0 font-editorial text-[1.625rem] font-normal leading-[1.18] text-ink text-balance'>{row.title}</h3>
					<p class='m-0 text-lg leading-[1.6] text-ink-muted'>{row.body}</p>
				</div>
			</article>
		))
	}
</div>
