---
interface ProofRow {
	label: string;
	title: string;
	body: string;
}

interface Props {
	rows: ProofRow[];
}

const { rows } = Astro.props;
---

<div class='grid max-w-[65ch] gap-4 [&>p]:mt-0 [&>p]:mb-2 [&>p]:text-[1.0625rem] [&>p]:leading-[1.7] [&>p]:text-ink-muted'>
	<slot />
	{
		rows.map((row, index) => (
			<article class='grid grid-cols-[1.75rem_minmax(0,1fr)] gap-3 py-[1.15rem] md:grid-cols-[2rem_minmax(0,1fr)] md:gap-4' aria-label={row.label}>
				<span class='pt-1 text-[0.72rem] font-bold tracking-[0.08em] text-ink-muted tabular-nums'>{String(index + 1).padStart(2, '0')}</span>
				<div class='grid gap-[0.4rem]'>
					<h3 class='m-0 text-[1.05rem] font-[650] leading-[1.3] tracking-[-0.01em] text-ink text-balance'>{row.title}</h3>
					<p class='m-0 text-[0.95rem] leading-[1.6] text-ink-muted'>{row.body}</p>
				</div>
			</article>
		))
	}
</div>
