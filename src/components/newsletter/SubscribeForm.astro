---
import { NEWSLETTER_URL } from '../../consts';

interface Props {
	location: 'hero' | 'closing';
}

const { location } = Astro.props;
const beehiivFormId = '35125e12-8fca-4f74-b609-4861f4b66cbb';
---

<div class='awt-signup' data-track-location={`newsletter_${location}`}>
	<div class='awt-signup__embed' aria-label='Subscribe to A Working Theory'>
		<script async src='https://subscribe-forms.beehiiv.com/v3/loader.js' data-beehiiv-form={beehiivFormId} is:inline></script>
	</div>
	<noscript>
		<a class='awt-signup__fallback' href={NEWSLETTER_URL}>Subscribe on beehiiv</a>
	</noscript>
</div>

<script>
	const subscribeEmbeds = document.querySelectorAll('.awt-signup__embed');

	for (const embed of subscribeEmbeds) {
		const accessibleName = embed.getAttribute('aria-label') ?? 'Subscribe to A Working Theory';
		const titleFrame = () => {
			const frame = embed.querySelector('iframe');
			if (!frame) return false;
			frame.title = accessibleName;
			return true;
		};

		if (!titleFrame()) {
			const observer = new MutationObserver(() => {
				if (titleFrame()) observer.disconnect();
			});
			observer.observe(embed, { childList: true, subtree: true });
		}
	}
</script>
