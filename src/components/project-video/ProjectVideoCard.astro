---
import { Image } from 'astro:assets';
import type { ProjectCard } from '@src/lib/project-cards';
import { getVideoPosterSources } from '@src/lib/video-posters';

interface Props {
	project: ProjectCard;
	featured?: boolean;
	variant?: 'lead' | 'card' | 'compact';
	index?: number;
}

const { project, featured = false, variant, index } = Astro.props;
const video = project.videos?.preview ?? project.videos?.overview;
const resolvedVariant = variant ?? (featured ? 'lead' : 'card');
const className = `project-video-card project-video-card--${resolvedVariant}`;
const loading = resolvedVariant === 'lead' ? 'eager' : 'lazy';
const fetchPriority = resolvedVariant === 'lead' ? 'high' : undefined;
const posterSources = video ? getVideoPosterSources(video.poster) : null;
const proofLabel = project.cardLabel ?? (project.proofType === 'client' ? 'Client work' : 'Independent work');
const mediaSizes =
	resolvedVariant === 'lead'
		? '(min-width: 980px) min(52vw, 40rem), calc(100vw - 2rem)'
		: resolvedVariant === 'compact'
			? '(min-width: 760px) 24rem, calc(100vw - 2rem)'
			: '(min-width: 760px) min(50vw, 34rem), calc(100vw - 2rem)';
---

{
	<a href={`/case-studies/${project.slug}/`} class={className} data-project-video-card={video ? true : undefined} data-project-proof={project.proofType}>
		<div class='project-video-card__media-wrap'>
			{
				video && posterSources ? (
					<>
				<video
					class='project-video-card__media'
					muted
					loop
					playsinline
					preload='none'
					aria-hidden='true'
					tabindex='-1'
				>
					<source src={video.src} type='video/mp4' />
				</video>
				<img
					class='project-video-card__poster'
					src={posterSources.src}
					srcset={posterSources.srcset}
					sizes={mediaSizes}
					width='960'
					height='540'
					alt=''
					loading={loading}
					decoding='async'
					fetchpriority={fetchPriority}
					aria-hidden='true'
				/>
				<span class='project-video-card__play-indicator' aria-hidden='true'></span>
					</>
				) : (
					<Image
						class='project-video-card__poster'
						src={project.image}
						alt=''
						sizes={mediaSizes}
						loading={loading}
						decoding='async'
						fetchpriority={fetchPriority}
						aria-hidden='true'
					/>
				)
			}
		</div>
		<div class='project-video-card__copy'>
			{index && <span class='project-video-card__index' aria-hidden='true'>{String(index).padStart(2, '0')}</span>}
			<p class='project-video-card__proof-label'>{proofLabel}</p>
			<h3 class='heading-display heading-display--subsection'>{project.name}</h3>
			<p>{project.description}</p>
		</div>
	</a>
}

<script>
	const installProjectVideoCards = () => {
		const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const saveData = 'connection' in navigator && Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
		if (reduceMotion || saveData) return;

		document.querySelectorAll<HTMLAnchorElement>('[data-project-video-card]').forEach((card) => {
			const video = card.querySelector('video');
			if (!video) return;

			const setPlaying = (isPlaying: boolean) => {
				card.classList.toggle('is-playing', isPlaying);
			};
			const play = () => {
				video.play().then(() => setPlaying(true)).catch(() => setPlaying(false));
			};
			const pause = () => {
				video.pause();
				video.currentTime = 0;
				setPlaying(false);
			};

			video.addEventListener('playing', () => setPlaying(true));
			video.addEventListener('pause', () => setPlaying(false));
			video.addEventListener('ended', () => setPlaying(false));
			video.addEventListener('error', () => setPlaying(false));

			if (canHover) {
				card.addEventListener('mouseenter', play);
				card.addEventListener('focusin', play);
				card.addEventListener('mouseleave', pause);
				card.addEventListener('focusout', pause);
				return;
			}

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							play();
							return;
						}

						pause();
					});
				},
				{ threshold: 0.6 }
			);

			observer.observe(card);
		});
	};

	installProjectVideoCards();
</script>
