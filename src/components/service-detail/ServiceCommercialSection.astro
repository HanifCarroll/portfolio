---
import { BOOK_CALL_URL } from '../../consts';
import type { ServiceOffer } from '../../lib/service-offers';

interface Props {
	offer: ServiceOffer;
}

const { offer } = Astro.props as Props;
const showPartnershipContract = offer.key === 'ongoing';
---

<section class='hc-detail-section hc-detail-commercial hc-section' aria-labelledby={`${offer.key}-price`}>
	<div class='hc-container hc-commercial-layout'>
		<div class='hc-commercial-panel'>
			<h2 id={`${offer.key}-price`}>{offer.pricingHeading}</h2>
			<p>{offer.pricingBody}</p>
			<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location={`${offer.key}_commercial`}>{offer.primaryCta}</a>
		</div>
		{showPartnershipContract && (
			<div class='hc-commercial-context'>
				<h2>What I need from your team.</h2>
				<ul class='hc-compact-list'>{offer.responsibilities.map((item) => <li>{item}</li>)}</ul>
				<p>{offer.ownershipBody}</p>
			</div>
		)}
	</div>
</section>
