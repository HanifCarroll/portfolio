---
import type { ServiceOffer } from '../../lib/service-offers';

interface Props {
	offer: ServiceOffer;
}

const { offer } = Astro.props as Props;
const showSystemTypes = offer.key === 'systemsBuild';
const showBoundary = offer.key === 'ongoing';
const showOwnership = offer.key !== 'ongoing';
---

<section class='hc-detail-section hc-detail-deliverables hc-section' aria-labelledby={`${offer.key}-deliverables`}>
	<div class='hc-container'>
		<header class='hc-detail-section-header'>
			<h2 id={`${offer.key}-deliverables`}>{offer.deliverablesHeading}</h2>
		</header>
		<div class='hc-deliverables'>
			{offer.deliverables.map((item) => <div class='hc-deliverable'><h3>{item.title}</h3><p>{item.body}</p></div>)}
		</div>
		{showSystemTypes && (
			<div class='hc-detail-supporting-grid'>
				<h3>{offer.includedHeading}</h3>
				<ul class='hc-plain-list'>{offer.included.map((item) => <li>{item}</li>)}</ul>
			</div>
		)}
		{showBoundary && (
			<div class='hc-detail-inline-note'>
				<h3>When a priority becomes a Business Systems Build</h3>
				<p>{offer.boundary}</p>
			</div>
		)}
		{showOwnership && (
			<div class='hc-detail-inline-note'>
				<h3>{offer.ownershipHeading}</h3>
				<p>{offer.ownershipBody}</p>
			</div>
		)}
	</div>
</section>
