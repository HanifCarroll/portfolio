---
import type { ServiceOffer } from '../../lib/service-offers';

interface Props {
	offer: ServiceOffer;
}

const { offer } = Astro.props as Props;
---

<section class='hc-detail-section hc-detail-fit hc-section' aria-labelledby={`${offer.key}-fit`}>
	<div class='hc-container hc-detail-grid'>
		<div class='hc-detail-heading'>
			<h2 id={`${offer.key}-fit`}>{offer.fitHeading}</h2>
			<p>{offer.fitBody}</p>
			{offer.key === 'audit' && (
				<a
					class='hc-text-link'
					href='/resources/process-mapping-worksheet/'
					data-track-event='resource_clicked'
					data-track-location='business_systems_audit_fit'
				>
					Map one workflow with the free worksheet
				</a>
			)}
			{offer.key === 'systemsBuild' && (
				<a class='hc-text-link' href={offer.secondaryHref}>Still deciding what should be built? Start with the Audit</a>
			)}
		</div>
		<ul class='hc-signal-list'>{offer.fitSignals.map((signal) => <li>{signal}</li>)}</ul>
	</div>
</section>
