---
import type { ServiceOffer } from '../../lib/service-offers';

interface Props {
	offer: ServiceOffer;
}

const { offer } = Astro.props as Props;
---

<aside class='hc-offer-summary' aria-label={`${offer.label} at a glance`}>
	<div class='hc-container'>
		<dl>
			{offer.summary.map((item) => (
				<div>
					<dt>{item.label}</dt>
					<dd>{item.body}</dd>
				</div>
			))}
		</dl>
	</div>
</aside>
