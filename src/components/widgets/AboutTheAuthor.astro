---
import Author from '../Author.astro';
import { metaClass } from '../../lib/ui';
import { getDictionary } from '../../i18n';
const { blog } = getDictionary(Astro.currentLocale);
---

<div class='grid w-full gap-5'>
	<p class={metaClass}>{blog.author}</p>
	<Author />
	<p class='m-0 max-w-[36rem] text-lg leading-[1.55] text-ink-muted'>
		{blog.authorBio}
	</p>
</div>
