---
import Author from '../Author.astro';
import { metaClass } from '../../lib/ui';
import { getLocale } from '../../i18n';
const spanish = getLocale(Astro.currentLocale) === 'es';
---

<div class='grid w-full gap-5'>
	<p class={metaClass}>{spanish ? 'Sobre el autor' : 'About the author'}</p>
	<Author />
	<p class='m-0 max-w-[36rem] text-lg leading-[1.55] text-ink-muted'>
		{spanish ? 'Hanif es ingeniero de software independiente y tiene más de 9 años de experiencia. Arma sitios web, herramientas y automatizaciones para negocios chicos.' : 'Hanif is a freelance software engineer with 9+ years of experience. He builds websites, tools, and automations for small businesses.'}
	</p>
</div>
