---
const { headings } = Astro.props;
const toc = (headings || []).filter((heading: any) => heading.depth === 2);
---

<nav class='toc' aria-label='Contents'>
	<ul class='max-h-[calc(100vh-8rem)] overflow-auto text-[0.9rem] [&::-webkit-scrollbar]:w-[5px] [&::-webkit-scrollbar-thumb]:rounded-[5px] [&::-webkit-scrollbar-thumb]:bg-[#eee] [&::-webkit-scrollbar-track]:bg-transparent'>
		{
			toc.map((heading: any) => (
				<li>
					<a
						class='block py-2 text-inherit leading-tight text-zinc-700 transition-colors hover:text-primary'
						href={'#' + heading.slug}>
						{heading.text}
					</a>
					{heading.subheadings?.length > 0 && (
						<ul class='pl-4'>
							{heading.subheadings.map((subheading: any) => (
								<li>
									<a
										class='block py-1.5 text-inherit leading-tight text-zinc-600 transition-colors hover:text-primary'
										href={'#' + subheading.slug}>
										{subheading.text}
									</a>
								</li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ul>
</nav>
