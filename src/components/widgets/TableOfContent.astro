---
const { headings, label } = Astro.props;
const toc = (headings || []).filter((heading: any) => heading.depth === 2);
---

<nav class='toc' aria-label={label}>
	<ul class='m-0 list-none p-0 font-sans text-base'>
		{
			toc.map((heading: any) => (
				<li>
					<a
						class='block py-2 leading-tight text-ink-muted no-underline -outline-offset-2 transition-colors hover:text-ink focus-visible:text-ink'
						href={'#' + heading.slug}>
						{heading.text}
					</a>
					{heading.subheadings?.length > 0 && (
						<ul class='pl-4'>
							{heading.subheadings.map((subheading: any) => (
								<li>
									<a
										class='block py-1.5 leading-tight text-ink-muted no-underline -outline-offset-2 transition-colors hover:text-ink focus-visible:text-ink'
										href={'#' + subheading.slug}>
										{subheading.text}
									</a>
								</li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ul>
</nav>
