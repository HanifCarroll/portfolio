---
// Docs-style shell for Build Atlas. Below lg, the entry list lives in the header's Contents menu instead.
import BaseLayout from './BaseLayout.astro';
import AtlasNav from '../components/atlas/AtlasNav.astro';
import '../styles/notes.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const isIndex = Astro.url.pathname.replace(/\/$/, '') === '/atlas';
---

<BaseLayout title={title} description={description} showFooterCta={false} footerLinksOnly bodyClass='hc-atlas'>
	<div class='mx-auto grid w-full max-w-page gap-10 px-6 pb-24 md:px-12 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16'>
		<aside class='hidden pt-12 lg:block'>
			<div class='sticky top-24 max-h-[calc(100svh-8rem)] overflow-y-auto overscroll-contain pb-8 [scrollbar-width:none]'>
				<a class='mb-4 block font-sans text-sm font-bold text-ink no-underline hover:text-accent-ink' href='/atlas/' aria-current={isIndex ? 'page' : undefined}>Build Atlas</a>
				<AtlasNav />
			</div>
		</aside>

		<div class='min-w-0 pt-10 lg:pt-12'>
			<slot />
		</div>
	</div>
</BaseLayout>
