---
import BaseHead from './components/BaseHead.astro';
import Header from './components/Header.astro';
import PageClosingCta from '../components/PageClosingCta.astro';
import { EMAIL_URL } from '../consts';

const {
	title,
	description,
	socialTitle,
	socialDescription,
	image,
	jsonLd,
	ogType,
	robots,
	showHeader = true,
	showFooterCta = true,
	footerCtaTitle,
	footerCtaBody,
	footerCtaPrimaryLabel,
	footerCtaLocation = 'footer_cta',
	// White-on-ink closing and footer that read as one block. Only the homepage sets it.
	inverseClosing = false,
	bodyClass = ''
} = Astro.props;

const currentYear = new Date().getFullYear();
const footerLinks = [
	{ href: '/agencies/', label: 'Agencies', external: false },
	{ href: EMAIL_URL, label: 'Email', external: false },
	{ href: 'https://linkedin.com/in/hanifcarroll', label: 'LinkedIn', external: true },
	{ href: 'https://github.com/hanifcarroll', label: 'GitHub', external: true },
	{ href: 'https://x.com/hanifcarroll', label: 'X', external: true },
	{ href: 'https://www.threads.com/@hanifcarroll', label: 'Threads', external: true },
];
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead title={title} description={description} socialTitle={socialTitle} socialDescription={socialDescription} image={image} jsonLd={jsonLd} ogType={ogType} robots={robots} />
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };

			window.hcTrackEvent = (eventName, properties = {}) => {
				if (!eventName) return;
				const gaProperties = {
					...properties,
					page_title: document.title,
					page_path: window.location.pathname
				};
				window.gtag('event', eventName, { ...gaProperties, transport_type: 'beacon' });
			};

			if (!window.hcAnalyticsClickTrackingReady) {
				window.hcAnalyticsClickTrackingReady = true;
				document.addEventListener('click', (event) => {
					if (!(event.target instanceof Element) || !(event instanceof MouseEvent)) return;
					const link = event.target.closest('a[data-track-event]');
					if (!(link instanceof HTMLAnchorElement)) return;
					const eventName = link.dataset.trackEvent;
					if (!eventName) return;

					window.hcTrackEvent(eventName, {
						event_location: link.dataset.trackLocation || 'unknown',
						link_text: (link.textContent || '').replace(/\s+/g, ' ').trim(),
						link_url: link.href
					});
				});
			}
		</script>
	</head>
	<body class={bodyClass}>
		<a class='skip-link' href='#main'>Skip to content</a>
		{showHeader && <Header isNotes={bodyClass.split(/\s+/).includes('hc-notes')} isAtlas={bodyClass.split(/\s+/).includes('hc-atlas')} />}
		<main id='main' class='hc-main' data-motion-page>
			<slot />
		</main>

		{showFooterCta && <PageClosingCta title={footerCtaTitle} body={footerCtaBody} primaryLabel={footerCtaPrimaryLabel} location={footerCtaLocation} inverse={inverseClosing} />}

		<footer class:list={['hc-footer pb-[env(safe-area-inset-bottom)]', inverseClosing ? 'bg-ink text-base text-white/80' : 'border-t border-rule bg-canvas text-sm text-ink-muted']} aria-label='Footer'>
			{inverseClosing && <div class='mx-auto w-full max-w-page px-6 md:px-12'><div class='border-t border-white/15'></div></div>}
			<div class:list={['mx-auto flex w-full max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-6 md:px-12', { 'max-sm:flex-col-reverse max-sm:gap-y-4 max-sm:py-8': inverseClosing }]}>
				<span>&copy; {currentYear} Hanif Carroll</span>
				<nav class:list={['flex flex-wrap items-center gap-x-5 gap-y-2', { 'max-sm:justify-center': inverseClosing }]} aria-label='Footer navigation'>
					{footerLinks.map((link) => (
						<a
							class:list={['text-inherit no-underline transition-colors', inverseClosing ? 'hover:text-white focus-visible:text-white' : 'hover:text-ink focus-visible:text-ink']}
							href={link.href}
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noopener noreferrer' : undefined}
						>
							{link.label}
						</a>
					))}
				</nav>
			</div>
		</footer>

		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
