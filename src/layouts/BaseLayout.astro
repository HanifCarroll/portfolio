---
import BaseHead from './components/BaseHead.astro';
import Header from './components/Header.astro';
import PageClosingCta from '../components/PageClosingCta.astro';
import { ClientRouter, fade } from 'astro:transitions';
import { EMAIL_URL } from '../consts';

const {
	title,
	description,
	socialTitle,
	socialDescription,
	image,
	jsonLd,
	ogType,
	robots,
	showHeader = true,
	showFooterCta = true,
	showFooter = true,
	footerCtaTitle,
	footerCtaBody,
	footerCtaPrimaryLabel,
	footerCtaLocation = 'footer_cta',
	bodyClass = ''
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead title={title} description={description} socialTitle={socialTitle} socialDescription={socialDescription} image={image} jsonLd={jsonLd} ogType={ogType} robots={robots} />
		<ClientRouter />
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };

			window.hcTrackEvent = (eventName, properties = {}) => {
				if (!eventName) return;
				const gaProperties = {
					...properties,
					page_title: document.title,
					page_path: window.location.pathname
				};
				window.gtag('event', eventName, { ...gaProperties, transport_type: 'beacon' });
			};

			if (!window.hcAnalyticsClickTrackingReady) {
				window.hcAnalyticsClickTrackingReady = true;
				document.addEventListener('click', (event) => {
					if (!(event.target instanceof Element) || !(event instanceof MouseEvent)) return;
					const link = event.target.closest('a[data-track-event]');
					if (!(link instanceof HTMLAnchorElement)) return;
					const eventName = link.dataset.trackEvent;
					if (!eventName) return;

					window.hcTrackEvent(eventName, {
						event_location: link.dataset.trackLocation || 'unknown',
						link_text: (link.textContent || '').replace(/\s+/g, ' ').trim(),
						link_url: link.href
					});
				});
			}
		</script>
	</head>
	<body class={bodyClass}>
		<a class='skip-link' href='#main'>Skip to content</a>
		{showHeader && <Header isNotes={bodyClass.split(/\s+/).includes('hc-notes')} isHome={bodyClass.split(/\s+/).includes('hc-home')} />}
		<main id='main' class='hc-main' data-motion-page transition:name='page-content' transition:animate={fade({ duration: '0.4s' })}>
			<slot />
		</main>

		{showFooterCta && <PageClosingCta title={footerCtaTitle} body={footerCtaBody} primaryLabel={footerCtaPrimaryLabel} location={footerCtaLocation} />}

		<footer class:list={['hc-footer', !showFooter && 'hc-footer--mobile-only']} aria-label='Footer' transition:name='site-footer'>
			<div class='hc-container-page'>
				<div class='hc-footer-inner'>
					<div class='hc-footer-brand'>
						<span class='hc-footer-eyebrow'>Independent product engineering</span>
						<a class='hc-footer-name' href='/'>Hanif Carroll</a>
					</div>
					<p class='hc-footer-positioning'>Contract product engineer for B2B SaaS teams.</p>
				</div>
				<nav class='hc-footer-nav' aria-label='Footer navigation'>
					<a href={EMAIL_URL}><span class='hc-footer-link-index'>01</span><span>Email</span><span class='hc-footer-link-arrow' aria-hidden='true'>&rarr;</span></a>
					<a href='https://linkedin.com/in/hanifcarroll' target='_blank' rel='noopener noreferrer'><span class='hc-footer-link-index'>02</span><span>LinkedIn</span><span class='hc-footer-link-arrow' aria-hidden='true'>&nearr;</span></a>
					<a href='https://github.com/hanifcarroll' target='_blank' rel='noopener noreferrer'><span class='hc-footer-link-index'>03</span><span>GitHub</span><span class='hc-footer-link-arrow' aria-hidden='true'>&nearr;</span></a>
				</nav>
				<div class='hc-footer-bottom'><span>&copy; {currentYear} Hanif Carroll</span><span>Product · systems · integrations</span></div>
			</div>
		</footer>

		<script>
			import '../scripts/motion';
		</script>
		<script is:inline>
			history.scrollRestoration = 'manual';
			const scrollToLocationHash = () => {
				history.scrollRestoration = 'manual';
				const hash = window.location.hash;
				if (!hash) {
					window.setTimeout(() => window.scrollTo({ top: 0, left: 0, behavior: 'instant' }), 150);
					return;
				}

				const targetId = decodeURIComponent(hash.slice(1));
				const scrollToTarget = () => document.getElementById(targetId)?.scrollIntoView({ block: 'start', behavior: 'auto' });
				window.requestAnimationFrame(() => window.requestAnimationFrame(scrollToTarget));
				window.setTimeout(scrollToTarget, 150);
			};
			document.addEventListener('astro:page-load', scrollToLocationHash);
			window.addEventListener('hashchange', scrollToLocationHash);
		</script>
	</body>
</html>
