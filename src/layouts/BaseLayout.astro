---
import BaseHead from './components/BaseHead.astro';
import Header from './components/Header.astro';
import { ClientRouter } from 'astro:transitions';
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';

const {
	title,
	description,
	socialDescription,
	image,
	jsonLd,
	ogType,
	robots,
	showFooterCta = true,
	bodyClass = ''
} = Astro.props;

const currentYear = new Date().getFullYear();
const gtmId = import.meta.env.PUBLIC_GTM_CONTAINER_ID;
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead title={title} description={description} socialDescription={socialDescription} image={image} jsonLd={jsonLd} ogType={ogType} robots={robots} />
		<ClientRouter />
	</head>
	<body class={bodyClass}>
		{
			gtmId && (
				<noscript>
					<iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height='0' width='0' style='display:none;visibility:hidden' />
				</noscript>
			)
		}
		<a class='skip-link' href='#main'>Skip to content</a>
		<Header />
		<main id='main' class='hc-main' data-motion-page>
			<slot />
		</main>

		{
			showFooterCta && (
				<section class='hc-footer-cta'>
					<div class='hc-container'>
						<div class='hc-cta-panel'>
							<h2>Tell me what's getting harder to run.</h2>
							<div class='hc-cta-panel__body'>
								<p>Start with the workflow that's causing delays, repeated effort, missed handoffs, or unreliable reporting.</p>
								<div class='hc-actions'>
									<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location='footer_cta'>
										Book a Business Systems Audit
									</a>
									<a class='hc-text-link' href={EMAIL_URL} data-track-event='email_clicked' data-track-location='footer_cta'>Email Hanif</a>
								</div>
							</div>
						</div>
					</div>
				</section>
			)
		}

		<footer class='hc-footer' data-header-surface='dark'>
			<div class='hc-container-page'>
				<div class='hc-footer-inner'>
					<div class='hc-footer-brand'>
						<img src='/brand/hc-studio-wordmark-reverse.svg' alt='HC Studio' width='4463' height='795' />
						<p>Technical consulting for founder-led businesses whose workflows have become harder to run as they grow.</p>
					</div>
					<nav class='hc-footer-nav' aria-label='Footer navigation'>
						<a href='/services/'>Services</a>
						<a href='/projects/'>Case Studies</a>
						<a href='/blog/'>Blog</a>
						<a href='/about/'>About</a>
						<a href={EMAIL_URL}>Email Hanif</a>
					</nav>
				</div>
				<div class='hc-footer-bottom'>
					<span>&copy; {currentYear} HC Studio LLC</span>
					<span>
						<a href={EMAIL_URL}>Email</a> · <a href='https://linkedin.com/in/hanifcarroll' target='_blank' rel='noopener noreferrer'>LinkedIn</a> · <a href='https://github.com/hanifcarroll' target='_blank' rel='noopener noreferrer'>GitHub</a>
					</span>
				</div>
			</div>
		</footer>

		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };

			document.addEventListener('click', (event) => {
				if (!(event.target instanceof Element) || !(event instanceof MouseEvent)) return;
				const link = event.target.closest('a[data-track-event]');
				if (!(link instanceof HTMLAnchorElement)) return;
				const eventName = link.dataset.trackEvent;
				if (!eventName) return;

				const payload = {
					event: eventName,
					event_location: link.dataset.trackLocation || 'unknown',
					link_text: (link.textContent || '').replace(/\s+/g, ' ').trim(),
					link_url: link.href,
					page_title: document.title,
					page_path: window.location.pathname
				};
				window.dataLayer.push(payload);
				window.gtag('event', eventName, { ...payload, event: undefined, transport_type: 'beacon' });
			});
		</script>
		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
