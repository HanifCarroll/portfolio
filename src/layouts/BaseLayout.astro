---
import BaseHead from './components/BaseHead.astro';
import Header from './components/Header.astro';
import PageClosingCta from '../components/PageClosingCta.astro';
import { EMAIL_URL } from '../consts';
import { getDictionary, getLocale, localizedPath } from '../i18n';

const {
	title,
	description,
	socialTitle,
	socialDescription,
	image,
	jsonLd,
	ogType,
	robots,
	showHeader = true,
	showFooterCta = true,
	footerCtaTitle,
	footerCtaBody,
	footerCtaPrimaryLabel,
	footerCtaLocation = 'footer_cta',
	bodyClass = ''
} = Astro.props;

const locale = getLocale(Astro.currentLocale);
const { nav, locale: localeCopy } = getDictionary(locale);
const currentYear = new Date().getFullYear().toLocaleString(localeCopy.format, { useGrouping: false });
const atlasHref = localizedPath('/atlas/', locale);
const atlasFallback = locale === 'es' && atlasHref === '/atlas/';
const footerLinks = [
	{ href: localizedPath('/agencies/', locale), label: nav.agencies, external: false },
	{ href: atlasHref, label: nav.atlas + (atlasFallback ? nav.englishFallback : ''), external: false, hreflang: atlasFallback ? 'en' : undefined },
	{ href: EMAIL_URL, label: nav.email, external: false },
	{ href: 'https://linkedin.com/in/hanifcarroll', label: 'LinkedIn', external: true },
	{ href: 'https://github.com/hanifcarroll', label: 'GitHub', external: true },
	{ href: 'https://x.com/hanifcarroll', label: 'X', external: true },
	{ href: 'https://www.threads.com/@hanifcarroll', label: 'Threads', external: true },
];
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={title} description={description} socialTitle={socialTitle} socialDescription={socialDescription} image={image} jsonLd={jsonLd} ogType={ogType} robots={robots} />
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };

			window.hcTrackEvent = (eventName, properties = {}) => {
				if (!eventName) return;
				const gaProperties = {
					...properties,
					page_title: document.title,
					page_path: window.location.pathname,
					locale: document.documentElement.lang
				};
				window.gtag('event', eventName, { ...gaProperties, transport_type: 'beacon' });
			};

			if (!window.hcAnalyticsClickTrackingReady) {
				window.hcAnalyticsClickTrackingReady = true;
				document.addEventListener('click', (event) => {
					if (!(event.target instanceof Element) || !(event instanceof MouseEvent)) return;
					const link = event.target.closest('a[data-track-event]');
					if (!(link instanceof HTMLAnchorElement)) return;
					const eventName = link.dataset.trackEvent;
					if (!eventName) return;

					window.hcTrackEvent(eventName, {
						event_location: link.dataset.trackLocation || 'unknown',
						link_text: (link.textContent || '').replace(/\s+/g, ' ').trim(),
						link_url: link.href
					});
				});
			}
		</script>
	</head>
	<body class={bodyClass}>
		<a class='skip-link' href='#main'>{nav.skip}</a>
		{showHeader && <Header isNotes={bodyClass.split(/\s+/).includes('hc-notes')} isAtlas={bodyClass.split(/\s+/).includes('hc-atlas')} />}
		<main id='main' class='hc-main' data-motion-page>
			<slot />
		</main>

		{showFooterCta && <PageClosingCta title={footerCtaTitle} body={footerCtaBody} primaryLabel={footerCtaPrimaryLabel} location={footerCtaLocation} />}

		{/* The ink footer reads as one block with the closing. Alone, it gets more room so it doesn't look clipped. */}
		<footer class='hc-footer bg-ink pb-[env(safe-area-inset-bottom)] text-base text-white/80' aria-label={nav.footer}>
			<div class:list={['mx-auto flex w-full max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 md:px-12 max-sm:flex-col-reverse max-sm:gap-y-4', showFooterCta ? 'py-6 max-sm:py-8' : 'py-10 md:py-12 [main:has(>[data-section=closing-cta])+footer_&]:py-6 max-sm:[main:has(>[data-section=closing-cta])+footer_&]:py-8']}>
				<span>&copy; {currentYear} Hanif Carroll</span>
				{/* Phones: two even rows of three links instead of five and one. */}
				<nav class='flex flex-wrap items-center gap-x-5 gap-y-2 max-sm:grid max-sm:grid-cols-[repeat(3,auto)] max-sm:justify-center max-sm:justify-items-center' aria-label={nav.footerNav}>
					{footerLinks.map((link) => (
						<a
							class='text-inherit no-underline transition-colors hover:text-white focus-visible:text-white'
							href={link.href}
							hreflang={link.hreflang}
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noopener noreferrer' : undefined}
						>
							{link.label}
						</a>
					))}
				</nav>
			</div>
		</footer>

		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
