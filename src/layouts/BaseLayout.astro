---
import BaseHead from './components/BaseHead.astro';
import Header from './components/Header.astro';
import PageClosingCta from '../components/PageClosingCta.astro';
import { ClientRouter, fade } from 'astro:transitions';
import { EMAIL_URL } from '../consts';

const {
	title,
	description,
	socialDescription,
	image,
	jsonLd,
	ogType,
	robots,
	showFooterCta = true,
	footerCtaTitle,
	footerCtaBody,
	footerCtaPrimaryLabel,
	footerCtaLocation = 'footer_cta',
	footerCtaSurface = 'canvas',
	bodyClass = ''
} = Astro.props;

const currentYear = new Date().getFullYear();
const gtmId = import.meta.env.PUBLIC_GTM_CONTAINER_ID;
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead title={title} description={description} socialDescription={socialDescription} image={image} jsonLd={jsonLd} ogType={ogType} robots={robots} />
		<ClientRouter />
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };

			window.hcTrackEvent = (eventName, properties = {}) => {
				if (!eventName) return;
				const gaProperties = {
					...properties,
					page_title: document.title,
					page_path: window.location.pathname
				};
				const payload = { event: eventName, ...gaProperties };
				window.dataLayer.push(payload);
				window.gtag('event', eventName, { ...gaProperties, transport_type: 'beacon' });
			};

			if (!window.hcAnalyticsClickTrackingReady) {
				window.hcAnalyticsClickTrackingReady = true;
				document.addEventListener('click', (event) => {
					if (!(event.target instanceof Element) || !(event instanceof MouseEvent)) return;
					const link = event.target.closest('a[data-track-event]');
					if (!(link instanceof HTMLAnchorElement)) return;
					const eventName = link.dataset.trackEvent;
					if (!eventName) return;

					window.hcTrackEvent(eventName, {
						event_location: link.dataset.trackLocation || 'unknown',
						link_text: (link.textContent || '').replace(/\s+/g, ' ').trim(),
						link_url: link.href
					});
				});
			}
		</script>
	</head>
	<body class={bodyClass}>
		{
			gtmId && (
				<noscript>
					<iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height='0' width='0' style='display:none;visibility:hidden' />
				</noscript>
			)
		}
		<a class='skip-link' href='#main'>Skip to content</a>
		<Header />
		<main id='main' class='hc-main' data-motion-page transition:name='page-content' transition:animate={fade({ duration: '0.24s' })}>
			<slot />
		</main>

		{showFooterCta && <PageClosingCta title={footerCtaTitle} body={footerCtaBody} primaryLabel={footerCtaPrimaryLabel} location={footerCtaLocation} surface={footerCtaSurface} />}

		<footer class='hc-footer' data-header-surface='dark' transition:name='site-footer'>
			<div class='hc-container-page'>
				<div class='hc-footer-inner'>
					<div class='hc-footer-brand'>
						<span class='hc-footer-eyebrow'>Independent product engineering</span>
						<a class='hc-footer-name' href='/'>Hanif Carroll</a>
					</div>
					<p class='hc-footer-positioning'>Contract product engineer for B2B SaaS teams.</p>
				</div>
				<nav class='hc-footer-nav' aria-label='Footer navigation'>
					<a href='/now/'><span class='hc-footer-link-index'>01</span><span>Now</span><span class='hc-footer-link-arrow' aria-hidden='true'>&rarr;</span></a>
					<a href='/tools/'><span class='hc-footer-link-index'>02</span><span>Tools</span><span class='hc-footer-link-arrow' aria-hidden='true'>&rarr;</span></a>
					<a href={EMAIL_URL}><span class='hc-footer-link-index'>03</span><span>Email</span><span class='hc-footer-link-arrow' aria-hidden='true'>&rarr;</span></a>
					<a href='https://linkedin.com/in/hanifcarroll' target='_blank' rel='noopener noreferrer'><span class='hc-footer-link-index'>04</span><span>LinkedIn</span><span class='hc-footer-link-arrow' aria-hidden='true'>&nearr;</span></a>
					<a href='https://github.com/hanifcarroll' target='_blank' rel='noopener noreferrer'><span class='hc-footer-link-index'>05</span><span>GitHub</span><span class='hc-footer-link-arrow' aria-hidden='true'>&nearr;</span></a>
				</nav>
				<div class='hc-footer-bottom'>
					<span>&copy; {currentYear} Hanif Carroll</span>
					<span>Product · systems · integrations</span>
				</div>
			</div>
		</footer>

		<script>
			import '../scripts/motion';
		</script>
		<script is:inline>
			history.scrollRestoration = 'manual';
			const scrollToLocationHash = () => {
				history.scrollRestoration = 'manual';
				const hash = window.location.hash;
				if (!hash) {
					window.setTimeout(() => window.scrollTo({ top: 0, left: 0, behavior: 'instant' }), 150);
					return;
				}

				const targetId = decodeURIComponent(hash.slice(1));
				const scrollToTarget = () => document.getElementById(targetId)?.scrollIntoView({ block: 'start', behavior: 'auto' });
				window.requestAnimationFrame(() => window.requestAnimationFrame(scrollToTarget));
				window.setTimeout(scrollToTarget, 150);
			};
			document.addEventListener('astro:page-load', scrollToLocationHash);
			window.addEventListener('hashchange', scrollToLocationHash);
		</script>
	</body>
</html>
