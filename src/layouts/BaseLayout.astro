---
import BaseHead from './components/BaseHead.astro';
import Header from './components/Header.astro';
import PageClosingCta from '../components/PageClosingCta.astro';
import { EMAIL_URL } from '../consts';

const {
	title,
	description,
	socialTitle,
	socialDescription,
	image,
	jsonLd,
	ogType,
	robots,
	showHeader = true,
	showFooterCta = true,
	showFooter = true,
	footerCtaTitle,
	footerCtaBody,
	footerCtaPrimaryLabel,
	footerCtaLocation = 'footer_cta',
	bodyClass = ''
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead title={title} description={description} socialTitle={socialTitle} socialDescription={socialDescription} image={image} jsonLd={jsonLd} ogType={ogType} robots={robots} />
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };

			window.hcTrackEvent = (eventName, properties = {}) => {
				if (!eventName) return;
				const gaProperties = {
					...properties,
					page_title: document.title,
					page_path: window.location.pathname
				};
				window.gtag('event', eventName, { ...gaProperties, transport_type: 'beacon' });
			};

			if (!window.hcAnalyticsClickTrackingReady) {
				window.hcAnalyticsClickTrackingReady = true;
				document.addEventListener('click', (event) => {
					if (!(event.target instanceof Element) || !(event instanceof MouseEvent)) return;
					const link = event.target.closest('a[data-track-event]');
					if (!(link instanceof HTMLAnchorElement)) return;
					const eventName = link.dataset.trackEvent;
					if (!eventName) return;

					window.hcTrackEvent(eventName, {
						event_location: link.dataset.trackLocation || 'unknown',
						link_text: (link.textContent || '').replace(/\s+/g, ' ').trim(),
						link_url: link.href
					});
				});
			}
		</script>
	</head>
	<body class={bodyClass}>
		<a class='skip-link' href='#main'>Skip to content</a>
		{showHeader && <Header isNotes={bodyClass.split(/\s+/).includes('hc-notes')} isHome={bodyClass.split(/\s+/).includes('hc-home')} />}
		<main id='main' class='hc-main' data-motion-page>
			<slot />
		</main>

		{showFooterCta && <PageClosingCta title={footerCtaTitle} body={footerCtaBody} primaryLabel={footerCtaPrimaryLabel} location={footerCtaLocation} />}

		<footer class:list={['hc-footer', !showFooter && 'hc-footer--mobile-only']} aria-label='Footer'>
			<div class='hc-container-page hc-footer-inner'>
				<span>&copy; {currentYear} Hanif Carroll</span>
				<nav class='hc-footer-nav' aria-label='Footer navigation'>
					<a href={EMAIL_URL}>Email</a>
					<a href='https://linkedin.com/in/hanifcarroll' target='_blank' rel='noopener noreferrer'>LinkedIn</a>
					<a href='https://github.com/hanifcarroll' target='_blank' rel='noopener noreferrer'>GitHub</a>
				</nav>
			</div>
		</footer>

		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
