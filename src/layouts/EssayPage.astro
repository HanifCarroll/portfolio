---
// Long-form single-column page used by Now and How I work.
import BaseLayout from './BaseLayout.astro';
import { deckClass, metaClass, pageTitleClass, shellClass } from '../lib/ui';

interface Props {
	title: string;
	pageTitle: string;
	description: string;
	deck?: string;
	meta?: string;
	robots?: string;
	bodyClass?: string;
}

const { title, pageTitle, description, deck, meta, robots, bodyClass = '' } = Astro.props;
---

<BaseLayout title={pageTitle} description={description} robots={robots} bodyClass={bodyClass}>
	<article class:list={[shellClass, 'pb-[clamp(6rem,12vw,10rem)]']}>
		<header class='max-w-measure pt-12 pb-[clamp(3rem,6vw,5rem)] lg:pt-20' data-motion-intro>
			<h1 class={pageTitleClass} data-motion='headline'>
				{title}
			</h1>
			{deck && (
				<p class:list={[deckClass, 'mt-6 max-w-reading']} data-motion-deck>
					{deck}
				</p>
			)}
			{meta && <p class:list={[metaClass, 'mt-6']}>{meta}</p>}
		</header>

		<div
			class:list={[
				'prose max-w-reading text-ink',
				'prose-headings:text-ink prose-h2:mt-20 prose-h2:mb-5 prose-h2:font-editorial prose-h2:text-[clamp(2rem,3.6vw,3rem)] prose-h2:font-normal prose-h2:leading-[1.02] prose-h2:tracking-[-0.035em] prose-h2:first:mt-0',
				'prose-p:text-[clamp(1.125rem,2vw,1.25rem)] prose-p:leading-[1.6] prose-p:text-ink-muted',
				'prose-li:text-[clamp(1.125rem,2vw,1.25rem)] prose-li:leading-[1.6] prose-li:text-ink-muted prose-li:my-2.5',
				'prose-strong:font-semibold prose-strong:text-ink',
			]}
		>
			<slot />
		</div>
	</article>
</BaseLayout>
