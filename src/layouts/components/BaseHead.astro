---
import '../../styles/design-tokens.css';
import '../../styles/global.css';
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/eb-garamond/latin-400-italic.css';
import '@fontsource/eb-garamond/latin-600.css';
import '@fontsource/eb-garamond/latin-700.css';

interface Props {
	title: string;
	description: string;
	socialTitle?: string;
	socialDescription?: string;
	image?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	ogType?: string;
	robots?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, socialTitle = title, description, socialDescription = description, image, jsonLd, ogType = 'website', robots } = Astro.props;
const defaultSocialImage = '/img/social-card-pencil-2026.jpg';
const fallbackImage = image ?? defaultSocialImage;
const fallbackImageURL = new URL(fallbackImage, Astro.url);
const isDefaultSocialImage = fallbackImage === defaultSocialImage;
const structuredData = jsonLd ? JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : '';
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const clarityProjectId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
const analyticsAllowedHosts = JSON.stringify(['hanifcarroll.com', 'www.hanifcarroll.com']);
const gaLoaderScript = gaMeasurementId
	? `(() => {
        const allowedHosts = new Set(${analyticsAllowedHosts});
        if (!allowedHosts.has(window.location.hostname)) return;

        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}';
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        window.gtag = window.gtag || gtag;

        gtag('js', new Date());
        gtag('config', '${gaMeasurementId}', {
            anonymize_ip: true,
            page_title: document.title,
            page_location: window.location.href,
            page_path: window.location.pathname,
        });
    })();`
	: '';
const clarityLoaderScript = clarityProjectId
	? `(() => {
        const clarityAllowedHosts = new Set(${analyticsAllowedHosts});
        if (!clarityAllowedHosts.has(window.location.hostname)) return;

        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);
            t.async=1;
            t.src='https://www.clarity.ms/tag/'+i;
            y=l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t,y);
        })(window, document, 'clarity', 'script', '${clarityProjectId}');
    })();`
	: '';
---

<!-- Global Metadata -->
<meta charset='utf-8' />
<meta name='viewport' content='width=device-width,initial-scale=1' />
<link rel='icon' href='/favicon.jpg' type='image/jpeg' />
<link rel='apple-touch-icon' href='/favicon.jpg' />
<meta name='generator' content={Astro.generator} />
{gscVerification && <meta name='google-site-verification' content={gscVerification} />}

{gaLoaderScript && <script is:inline set:html={gaLoaderScript} />}
{clarityLoaderScript && <script is:inline set:html={clarityLoaderScript} />}
<!-- Canonical URL -->
<link rel='canonical' href={canonicalURL} />
<link rel='alternate' type='application/rss+xml' title='Hanif Carroll Blog' href={new URL('/rss.xml', Astro.site)} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name='title' content={title} />
<meta name='description' content={description} />
{robots && <meta name='robots' content={robots} />}

<!-- Open Graph / Facebook -->
<meta property='og:type' content={ogType} />
<meta property='og:site_name' content='Hanif Carroll' />
<meta property='og:url' content={Astro.url} />
<meta property='og:title' content={socialTitle} />
<meta property='og:description' content={socialDescription} />
<meta property='og:image' content={fallbackImageURL} />
<meta property='og:image:alt' content={isDefaultSocialImage ? 'Portrait of Hanif Carroll beside the words AI Product Engineer.' : `${title} preview image`} />
{isDefaultSocialImage && <meta property='og:image:type' content='image/jpeg' />}
{isDefaultSocialImage && <meta property='og:image:width' content='1200' />}
{isDefaultSocialImage && <meta property='og:image:height' content='630' />}

<!-- Twitter -->
<meta property='twitter:card' content='summary_large_image' />
<meta property='twitter:url' content={Astro.url} />
<meta property='twitter:title' content={socialTitle} />
<meta property='twitter:description' content={socialDescription} />
<meta property='twitter:image' content={fallbackImageURL} />
<meta property='twitter:image:alt' content={isDefaultSocialImage ? 'Portrait of Hanif Carroll beside the words AI Product Engineer.' : `${title} preview image`} />
{structuredData && <script is:inline type='application/ld+json' set:html={structuredData} />}
