---
import HeaderLink from './HeaderLink.astro';
import { BOOK_CALL_URL } from '../../consts';

const navLinks = [
	{ href: '/case-studies/', label: 'Case Studies' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/about/', label: 'About' }
];
const mobileNavLinks = [{ href: '/', label: 'Home' }, ...navLinks];

const { pathname } = Astro.url;
const normalizePath = (value: string) => (value.endsWith('/') ? value : `${value}/`);
const isActiveLink = (href: string) => href === '/' ? normalizePath(pathname) === '/' : normalizePath(pathname).startsWith(normalizePath(href));
const headerCtaLabel = 'Book a fit call';
---

<header class='site-header' id='siteHeader' data-over-surface='light' transition:name='site-header'>
	<div class='hc-header'>
		<a href='/' class='hc-brand hc-brand--personal' aria-label='Hanif Carroll home'>
			<span>Hanif Carroll</span>
		</a>

		<nav class='hc-nav' aria-label='Primary navigation'>
			{navLinks.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
			<a
				class='hc-button'
				href={BOOK_CALL_URL}
				target='_blank'
				rel='noopener noreferrer'
				data-track-event='book_call_clicked'
				data-track-location='header_primary'
			>
				{headerCtaLabel}
			</a>
		</nav>

		<div class='hc-mobile-nav'>
			<button class='hc-mobile-nav__toggle' type='button' aria-expanded='false' aria-controls='mobileNavigation' aria-label='Open navigation'>
				<span></span><span></span><span></span>
			</button>
			<div class='hc-mobile-nav__panel' id='mobileNavigation' aria-hidden='true'>
				<nav class='hc-mobile-nav__links' aria-label='Mobile navigation'>
				{
					mobileNavLinks.map((link) => (
						<a class='hc-mobile-nav__link' href={link.href} aria-current={isActiveLink(link.href) ? 'page' : undefined}>
							{link.label}
						</a>
					))
				}
				<a
					class='hc-button'
					href={BOOK_CALL_URL}
					target='_blank'
					rel='noopener noreferrer'
					data-track-event='book_call_clicked'
					data-track-location='header_mobile'
				>
					{headerCtaLabel}
				</a>
				</nav>
				<p class='hc-mobile-nav__note'>Contract product engineer for B2B SaaS teams.</p>
			</div>
		</div>
	</div>
</header>
<script>
	import '../../scripts/site-header';
</script>
