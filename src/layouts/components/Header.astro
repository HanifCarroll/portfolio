---
import HeaderLink from './HeaderLink.astro';
import { BOOK_CALL_URL } from '../../consts';
import sections from '../../data/notes.generated';

const navLinks = [
	{ href: '/projects/', label: 'Projects' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/notes/', label: 'Notes' },
];
const mobileNavLinks = [{ href: '/', label: 'Home' }, ...navLinks];

const { pathname } = Astro.url;
const { isNotes = false, isHome = false } = Astro.props;
const publicSections = sections.filter(({ title }) => !['Systems and Attention', 'Health and Training'].includes(title));
const entryId = (section: string, title: string) =>
	`${section}-${title.toLowerCase().replace(/[’']/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
const normalizePath = (value: string) => (value.endsWith('/') ? value : `${value}/`);
const isActiveLink = (href: string) => href === '/' ? normalizePath(pathname) === '/' : normalizePath(pathname).startsWith(normalizePath(href));
const headerCtaLabel = 'Book a call';
---

<header class='site-header' id='siteHeader' transition:name='site-header'>
	<div class='hc-header'>
		<a href='/' class='hc-brand hc-brand--personal' aria-label='Hanif Carroll home'>
			<span class='hc-brand__full'>Hanif Carroll</span>
			{isHome && <span class='hc-brand__compact' aria-hidden='true'>HC</span>}
		</a>

		<nav class='hc-nav' aria-label='Primary navigation'>
			{navLinks.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
			<a
				class='hc-header__call-link'
				href={BOOK_CALL_URL}
				target='_blank'
				rel='noopener noreferrer'
				data-track-event='book_call_clicked'
				data-track-location='header_primary'
			>
				{headerCtaLabel}
				<svg aria-hidden='true' viewBox='0 0 16 16' focusable='false'>
					<path d='M3 13 13 3M6 3h7v7' />
				</svg>
			</a>
		</nav>

		<div class='hc-mobile-nav'>
			{isNotes && <details class='hc-notes-mobile-menu' data-notes-mobile-menu>
				<summary aria-label='Open table of contents'>
					<span class='hc-notes-mobile-menu__open'>Contents</span><span class='hc-notes-mobile-menu__close'>Close</span>
					<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M6 9l6 6 6-6'></path></svg>
				</summary>
				<div class='hc-notes-mobile-menu__panel'>
					<p class='hc-notes-toc-label'>Chapters</p>
					<nav aria-label='Mobile table of contents'>
						<ol class='hc-notes-mobile-toc'>
							{publicSections.map((section, sectionIndex) => (
								<li>
									<details class='hc-notes-mobile-section' open={sectionIndex === 0}>
										<summary><strong>{section.title}</strong><svg viewBox='0 0 24 24' width='18' height='18' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M6 9l6 6 6-6'></path></svg></summary>
										<ol>{section.entries.map((entry) => <li><a href={`#${entryId(section.slug, entry.title)}`}>{entry.title}</a></li>)}</ol>
									</details>
								</li>
							))}
						</ol>
					</nav>
				</div>
			</details>}
			<button class='hc-mobile-nav__toggle' type='button' aria-expanded='false' aria-controls='mobileNavigation' aria-label='Open navigation'>
				<span></span><span></span><span></span>
			</button>
			<div class='hc-mobile-nav__panel' id='mobileNavigation' aria-hidden='true'>
				<nav class='hc-mobile-nav__links' aria-label='Mobile navigation'>
				{
					mobileNavLinks.map((link) => (
						<a class='hc-mobile-nav__link' href={link.href} aria-current={isActiveLink(link.href) ? 'page' : undefined}>
							{link.label}
						</a>
					))
				}
				<a
					class='hc-mobile-nav__link hc-mobile-nav__call-link'
					href={BOOK_CALL_URL}
					target='_blank'
					rel='noopener noreferrer'
					data-track-event='book_call_clicked'
					data-track-location='header_mobile'
				>
					{headerCtaLabel}
					<svg aria-hidden='true' viewBox='0 0 16 16' focusable='false'>
						<path d='M3 13 13 3M6 3h7v7' />
					</svg>
				</a>
				</nav>
				<p class='hc-mobile-nav__note'>AI Product Engineer.</p>
			</div>
		</div>
	</div>
</header>
<script>
	import '../../scripts/site-header';
</script>
