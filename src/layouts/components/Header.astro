---
import HeaderLink from './HeaderLink.astro';
import { BOOK_CALL_URL } from '../../consts';
import sections, { noteEntryId } from '../../data/notes';
import AtlasNav from '../../components/atlas/AtlasNav.astro';
import { englishPath, getDictionary, getLocale, localizedPath, pairedPaths } from '../../i18n';

const locale = getLocale(Astro.currentLocale);
const { nav, action } = getDictionary(locale);
const navLinks = [
	{ href: '/projects/', label: nav.projects },
	{ href: '/how-i-work/', label: nav.work },
	{ href: '/blog/', label: nav.blog },
	{ href: '/guide/', label: nav.guide },
	{ href: '/notes/', label: nav.notes },
];
const mobileNavLinks = [{ href: '/', label: nav.home }, ...navLinks];

const { pathname } = Astro.url;
const { isNotes = false, isAtlas = false } = Astro.props;
const publicSections = sections
	.filter(({ title }) => !['Systems and Attention', 'Health and Training'].includes(title))
	.map((section) => ({ ...section, entries: section.entries.filter((entry) => !('hidden' in entry && entry.hidden)) }));
const isActiveLink = (href: string) => href === '/' ? englishPath(pathname) === '/' : englishPath(pathname).startsWith(href);
const headerCtaLabel = action.bookCall;
const alternates = pairedPaths(pathname);
const otherLocale = locale === 'en' ? 'es' : 'en';
const languageLink = alternates && { href: alternates[otherLocale], hreflang: otherLocale, lang: otherLocale };
const languageLabel = getDictionary(otherLocale).locale.label;
---

<header
	class='site-header sticky top-0 z-60 bg-canvas/95 pt-[env(safe-area-inset-top)] backdrop-blur-md'
	id='siteHeader'
	transition:name='site-header'
>
	<div class='hc-header mx-auto flex h-16 w-full max-w-page items-center justify-between gap-6 px-6 md:px-12 lg:h-20'>
		<a
			href={localizedPath('/', locale)}
			class='whitespace-nowrap text-lg font-bold tracking-[-0.03em] text-ink no-underline transition-colors hover:text-accent-ink focus-visible:text-accent-ink'
			aria-label={nav.homeLabel}
		>
			Hanif Carroll
		</a>

		<nav class='hidden items-center gap-6 lg:flex' aria-label={nav.primary}>
			{navLinks.map((link) => <HeaderLink href={localizedPath(link.href, locale)}>{link.label}</HeaderLink>)}
			{languageLink && <HeaderLink {...languageLink}>{languageLabel}</HeaderLink>}
			<a
				class='ml-6 inline-flex min-h-11 items-center gap-2 whitespace-nowrap rounded-md border border-ink bg-ink px-4 py-2 text-base font-medium text-canvas no-underline transition-colors hover:bg-ink-muted focus-visible:bg-ink-muted'
				href={BOOK_CALL_URL}
				target='_blank'
				rel='noopener noreferrer'
				data-track-event='book_call_clicked'
				data-track-location='header_primary'
			>
				{headerCtaLabel}
				<svg class='size-3.5 fill-none stroke-current stroke-[1.25]' aria-hidden='true' viewBox='0 0 16 16' focusable='false'>
					<path d='M3 13 13 3M6 3h7v7' />
				</svg>
			</a>
		</nav>

		<div class='hc-mobile-nav flex items-center gap-1 lg:hidden'>
			{languageLink && !isNotes && !isAtlas && <HeaderLink {...languageLink}>{languageLabel}</HeaderLink>}
			{isNotes && <details class='hc-notes-mobile-menu' data-notes-mobile-menu>
				<summary aria-label={nav.contentsOpen}>
					<span class='hc-notes-mobile-menu__open'>{nav.contents}</span><span class='hc-notes-mobile-menu__close'>{nav.close}</span>
					<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M6 9l6 6 6-6'></path></svg>
				</summary>
				<div class='hc-notes-mobile-menu__panel'>
					<p class='hc-notes-toc-label'>{nav.chapters}</p>
					<nav aria-label={nav.contentsMobile}>
						<ol class='hc-notes-mobile-toc'>
							{publicSections.map((section, sectionIndex) => (
								<li>
									<details class='hc-notes-mobile-section' open={sectionIndex === 0}>
										<summary><strong>{section.title}</strong><svg viewBox='0 0 24 24' width='18' height='18' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M6 9l6 6 6-6'></path></svg></summary>
										<ol>{section.entries.map((entry) => <li><a href={`#${noteEntryId(section.slug, entry)}`}>{entry.title}</a></li>)}</ol>
									</details>
								</li>
							))}
						</ol>
					</nav>
				</div>
			</details>}
			{isAtlas && <details class='hc-notes-mobile-menu' data-notes-mobile-menu>
				<summary aria-label={nav.contentsOpen}>
					<span class='hc-notes-mobile-menu__open'>{nav.contents}</span><span class='hc-notes-mobile-menu__close'>{nav.close}</span>
					<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M6 9l6 6 6-6'></path></svg>
				</summary>
				<div class='hc-notes-mobile-menu__panel'>
					<p class='m-0 mb-4 text-base font-medium text-ink-muted'><a class='text-inherit no-underline' href={localizedPath('/atlas/', locale)}>{nav.atlas}</a></p>
					<AtlasNav id='atlas-search-mobile' />
				</div>
			</details>}
			<button class='hc-mobile-nav__toggle' type='button' aria-expanded='false' aria-controls='mobileNavigation' aria-label={nav.open}>
				<span></span><span></span><span></span>
			</button>
			<div class='hc-mobile-nav__panel' id='mobileNavigation' aria-hidden='true'>
				<nav class='hc-mobile-nav__links' aria-label={nav.mobile}>
				{
					mobileNavLinks.map((link) => (
						<a class:list={['hc-mobile-nav__link', link.href === '/blog/' && 'mt-4']} href={localizedPath(link.href, locale)} aria-current={isActiveLink(link.href) ? 'page' : undefined}>
							{link.label}
						</a>
					))
				}
				<a
					class='hc-mobile-nav__link hc-mobile-nav__call-link'
					href={BOOK_CALL_URL}
					target='_blank'
					rel='noopener noreferrer'
					data-track-event='book_call_clicked'
					data-track-location='header_mobile'
				>
					{headerCtaLabel}
					<svg aria-hidden='true' viewBox='0 0 16 16' focusable='false'>
						<path d='M3 13 13 3M6 3h7v7' />
					</svg>
				</a>
				{languageLink && (isNotes || isAtlas) && <HeaderLink {...languageLink}>{languageLabel}</HeaderLink>}
				</nav>
				<p class='hc-mobile-nav__note'>{nav.job}.</p>
			</div>
		</div>
	</div>
</header>
<script>
	import '../../scripts/site-header';
</script>
