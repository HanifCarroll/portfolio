---
import type { HTMLAttributes } from 'astro/types';
import { headerLinkClass } from '../../lib/ui';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const hrefPath = href instanceof URL ? href.pathname : typeof href === 'string' ? href : '/';
const normalizePath = (value: string) => (value.endsWith('/') ? value : `${value}/`);
const isActive = !props.hreflang && normalizePath(Astro.url.pathname).startsWith(normalizePath(hrefPath));
---

<a
	href={href}
	aria-current={isActive ? 'page' : undefined}
	class:list={[headerLinkClass, className]}
	{...props}
>
	<slot />
</a>
