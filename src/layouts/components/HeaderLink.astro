---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const hrefPath = href instanceof URL ? href.pathname : typeof href === 'string' ? href : '/';
const normalizePath = (value: string) => (value.endsWith('/') ? value : `${value}/`);
const isActive = normalizePath(Astro.url.pathname).startsWith(normalizePath(hrefPath));
---

<a href={href} aria-current={isActive ? 'page' : undefined} class:list={['hc-nav-link', className]} {...props}>
	<slot />
</a>
