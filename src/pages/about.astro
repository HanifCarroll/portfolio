---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import HeroBackdrop from '../assets/img/hero-editorial-backdrop-navy-yellow.png';
import HeroPortrait from '../assets/img/hanif-consulting-hero-cutout-facing-left.png';
import '../styles/about.css';

const title = 'About Hanif Carroll | Contract Product Engineer';
const description =
	'Contract product engineer for B2B SaaS teams — customer-facing products, internal tools, and HubSpot integrations.';

const background = [
	{
		title: 'Capgemini',
		body: 'I learned structured delivery, stakeholder management, and how larger organizations make decisions around systems that affect many people.'
	},
	{
		title: 'LeagueApps',
		body: 'I worked inside a product team where UX, engineering, and business goals had to stay connected through delivery.'
	},
	{
		title: 'Contract work',
		body: 'I contract with B2B SaaS teams on customer-facing products, internal tools, and integrations.'
	}
];
---

<BaseLayout
	title={title}
	description={description}
	bodyClass='page-about'
	footerCtaTitle="Tell me what your team needs to ship."
	footerCtaBody="Start with the feature, integration, or system that's stuck. We'll work out whether a project or a monthly contract fits."
	footerCtaLocation='about_footer_cta'
	footerCtaSurface='canvas'
>
	<article class='hc-about-page'>
		<header class='hc-hero hc-about-hero' data-motion-intro>
			<div class='hc-container-wide hc-about-hero__grid'>
				<div class='hc-hero-copy'>
					<h1 class='hc-display' data-motion='headline'>I'm a contract product engineer for B2B SaaS teams.</h1>
					<p class='hc-lead' data-motion-deck>I'm Hanif Carroll, a product engineer with more than eight years of experience building web, mobile, automation, and AI systems.</p>
					<p class='hc-trust-note' data-motion-intro-item>I'm based in Buenos Aires and work US hours.</p>
				</div>
				<figure class='hc-about-hero__portrait'>
					<Image src={HeroBackdrop} alt='' aria-hidden='true' class='hc-about-hero__backdrop' loading='eager' />
					<Image src={HeroPortrait} alt='Hanif Carroll, contract product engineer' class='hc-about-hero__image' loading='eager' />
				</figure>
			</div>
		</header>

		<section class='hc-section hc-about-statement' data-motion-group>
			<div class='hc-container hc-about-continuity'>
				<div class='hc-section-header hc-about-continuity__heading'>
					<h2 class='hc-section-title' data-motion='reveal'>One person from the first conversation through handoff.</h2>
				</div>
				<div class='hc-detail-content hc-about-continuity__copy' data-motion-item>
					<p>I work directly with founders, product leads, and engineering teams from the first conversation through product decisions, implementation, and handoff.</p>
					<p>That continuity matters when the work spans people, software, data, business rules, and decisions that can't be handed between separate teams without losing context.</p>
				</div>
			</div>
		</section>

		<section class='hc-section hc-about-experience' data-motion-group data-header-surface='dark'>
			<div class='hc-container hc-about-experience__layout'>
				<div class='hc-about-experience__intro'>
					<h2 class='hc-section-title' data-motion='reveal'>Experience across consulting and product teams.</h2>
					<p class='hc-section-intro'>My background covers large delivery environments, product-led teams, direct client engagements, and systems I have designed and built for my own operations.</p>
					<div class='hc-actions'><a class='hc-text-link' href='/case-studies/'>View case studies</a></div>
				</div>
				<ol class='hc-about-experience__list'>{background.map((item, index) => <li data-motion-item><span class='hc-index'>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>)}</ol>
			</div>
		</section>
	</article>
</BaseLayout>
