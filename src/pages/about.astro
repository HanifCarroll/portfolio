---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import HeroBackdrop from '../assets/img/hero-editorial-backdrop-navy-yellow.png';
import HeroPortrait from '../assets/img/hanif-consulting-hero-cutout-facing-left.png';
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';

const title = 'About Hanif Carroll | Technical Consultant';
const description =
	'I help growing businesses replace repeated manual work and scattered information with clear workflows and software their team can use.';

const principles = [
	{
		title: 'Understand the workflow first',
		body: 'I begin with the people, steps, tools, and handoffs involved. That gives us a clear view of where the workflow is breaking down.'
	},
	{
		title: 'Use the simplest fix that will work',
		body: 'The answer may be custom software, an automation, an integration, better use of an existing tool, or a change to the process.'
	},
	{
		title: 'Make important state visible',
		body: 'Your team should be able to see the status, decisions, approvals, and failures that matter, especially when automation is involved.'
	},
	{
		title: 'Plan the handoff from the start',
		body: 'You keep the maps, software, documentation, and reasoning needed to run or extend what we build.'
	}
];

const background = [
	{
		title: 'Capgemini',
		body: 'I learned structured delivery, stakeholder management, and how larger organizations make decisions around systems that affect many people.'
	},
	{
		title: 'LeagueApps',
		body: 'I worked inside a product team where UX, engineering, and business goals had to stay connected through delivery.'
	},
	{
		title: 'HC Studio',
		body: 'I now work directly with founders and operators on internal tools, automation, AI-assisted workflows, and business-critical product systems.'
	}
];
---

<BaseLayout title={title} description={description} showFooterCta={false}>
	<article>
		<header class='hc-hero hc-about-hero'>
			<div class='hc-container-wide hc-about-hero__grid'>
				<div class='hc-hero-copy'>
					<h1 class='hc-display'>I help growing businesses fix workflows that have become hard to run.</h1>
					<p class='hc-lead'>I'm Hanif Carroll, a technical consultant and product engineer with more than eight years of experience building web, mobile, automation, and AI systems.</p>
					<p class='hc-trust-note'>I'm based in Buenos Aires, work US hours, and contract with US clients through my LLC, HC Studio.</p>
				</div>
				<figure class='hc-about-hero__portrait'>
					<Image src={HeroBackdrop} alt='' aria-hidden='true' class='hc-about-hero__backdrop' loading='eager' />
					<Image src={HeroPortrait} alt='Hanif Carroll, technical consultant' class='hc-about-hero__image' loading='eager' />
				</figure>
			</div>
		</header>

		<section class='hc-section'>
			<div class='hc-container hc-recognition'>
				<div class='hc-section-header'>
					<h2 class='hc-section-title'>One person from the first conversation through handoff.</h2>
				</div>
				<div class='hc-detail-content'>
					<p>I work directly with founders and operators from the first conversations through product decisions, implementation, and handoff.</p>
					<p>That continuity matters when the workflow spans people, software, data, business rules, and decisions that can't be handed between separate teams without losing context.</p>
				</div>
			</div>
		</section>

		<section class='hc-section--compact'>
			<div class='hc-container'>
				<div class='hc-section-header'><h2 class='hc-section-title'>How I work</h2></div>
				<div class='hc-principles-grid'>{principles.map((item, index) => <div class='hc-principle'><span class='hc-index'>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></div>)}</div>
			</div>
		</section>

		<section class='hc-section'>
			<div class='hc-container'>
				<div class='hc-section-header'>
					<h2 class='hc-section-title'>Experience across product teams, client projects, and independent systems.</h2>
					<p class='hc-section-intro'>My background covers large delivery environments, product-led teams, direct client engagements, and systems I have designed and built for my own operations.</p>
				</div>
				<div class='hc-service-list'>{background.map((item, index) => <div class='hc-service-item'><span class='hc-index'>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.body}</p></div>)}</div>
				<div class='hc-actions'><a class='hc-text-link' href='/projects/'>View case studies</a><a class='hc-text-link' href='/services/'>See all services</a></div>
			</div>
		</section>

		<section class='hc-section--compact'>
			<div class='hc-container'>
				<div class='hc-cta-panel'>
					<h2>Which workflow is giving your team trouble?</h2>
					<div class='hc-cta-panel__body'>
						<p>Start with the repeated manual work, unreliable handoff, reporting problem, approval bottleneck, or system that no longer fits.</p>
						<div class='hc-actions'><a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer'>Book a Business Systems Audit</a><a class='hc-text-link' href={EMAIL_URL}>Email Hanif</a></div>
					</div>
				</div>
			</div>
		</section>
	</article>
</BaseLayout>
