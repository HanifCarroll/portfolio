---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import HeroBackdrop from '../assets/img/hero-editorial-backdrop-navy-yellow.png';
import HeroPortrait from '../assets/img/hanif-consulting-hero-cutout-facing-left.png';
import AboutListenContext from '../assets/img/illustrations/about-listen-context.svg';
import AboutTradeoffs from '../assets/img/illustrations/about-tradeoffs.svg';
import AboutReviewLoop from '../assets/img/illustrations/about-review-loop.svg';
import AboutClearHandoff from '../assets/img/illustrations/about-clear-handoff.svg';
import AboutContinuity from '../assets/img/illustrations/about-continuity.svg';
import AboutContinuityMobile from '../assets/img/illustrations/about-continuity-mobile.svg';
import '../styles/about.css';

const title = 'About Hanif Carroll | Technical Consultant';
const description =
	'I help growing businesses replace repeated manual work and scattered information with clear workflows and software their team can use.';

const principles = [
	{
		title: 'I listen for the context behind the request',
		body: 'The first conversation is about how the business runs, who depends on the system, and what would make a meaningful difference.',
		image: AboutListenContext,
		alt: 'Paper model of a direct conversation becoming organized notes about people, tools, and constraints.'
	},
	{
		title: 'I make the tradeoffs visible',
		body: 'I explain the options, costs, and risks in plain language so you can make a decision without guessing what the technical details mean.',
		image: AboutTradeoffs,
		alt: 'Paper model comparing effort, value, and two possible technical paths.'
	},
	{
		title: 'I keep decisions close to the build',
		body: 'The person who learns the business problem stays involved through product decisions, implementation, review, and revision.',
		image: AboutReviewLoop,
		alt: 'Paper model of a short loop connecting a decision, working version, feedback, and revision.'
	},
	{
		title: 'I leave a clear path forward',
		body: 'You leave with the system, documentation, decisions, and next steps needed to operate it or keep improving it.',
		image: AboutClearHandoff,
		alt: 'Paper model of a completed system packaged with documentation, decisions, and next steps.'
	}
];

const background = [
	{
		title: 'Capgemini',
		body: 'I learned structured delivery, stakeholder management, and how larger organizations make decisions around systems that affect many people.'
	},
	{
		title: 'LeagueApps',
		body: 'I worked inside a product team where UX, engineering, and business goals had to stay connected through delivery.'
	},
	{
		title: 'HC Studio',
		body: 'I now work directly with founders and operators on internal tools, automation, AI-assisted workflows, and business-critical product systems.'
	}
];
---

<BaseLayout
	title={title}
	description={description}
	bodyClass='page-about'
	footerCtaTitle='Which workflow is giving your team trouble?'
	footerCtaBody='Start with the repeated manual work, unreliable handoff, reporting problem, approval bottleneck, or system that no longer fits.'
	footerCtaLocation='about_footer_cta'
	footerCtaSurface='canvas'
>
	<article class='hc-about-page'>
		<header class='hc-hero hc-about-hero' data-motion-intro>
			<div class='hc-container-wide hc-about-hero__grid'>
				<div class='hc-hero-copy'>
					<h1 class='hc-display' data-motion-headline>I help growing businesses fix workflows that have become hard to run.</h1>
					<p class='hc-lead' data-motion-deck>I'm Hanif Carroll, a technical consultant and product engineer with more than eight years of experience building web, mobile, automation, and AI systems.</p>
					<p class='hc-trust-note' data-motion-intro-item>I'm based in Buenos Aires, work US hours, and contract with US clients through my LLC, HC Studio.</p>
				</div>
				<figure class='hc-about-hero__portrait'>
					<Image src={HeroBackdrop} alt='' aria-hidden='true' class='hc-about-hero__backdrop' loading='eager' />
					<Image src={HeroPortrait} alt='Hanif Carroll, technical consultant' class='hc-about-hero__image' loading='eager' />
				</figure>
			</div>
		</header>

		<section class='hc-section hc-about-statement' data-motion-section>
			<div class='hc-container hc-about-continuity'>
				<div class='hc-section-header hc-about-continuity__heading'>
					<h2 class='hc-section-title' data-motion-section-label>One person from the first conversation through handoff.</h2>
				</div>
				<div class='hc-detail-content hc-about-continuity__copy' data-motion-item>
					<p>I work directly with founders and operators from the first conversations through product decisions, implementation, and handoff.</p>
					<p>That continuity matters when the workflow spans people, software, data, business rules, and decisions that can't be handed between separate teams without losing context.</p>
				</div>
				<figure class='hc-about-continuity__figure' data-motion-item>
					<Image class='hc-about-continuity__desktop' src={AboutContinuity} alt='A founder conversation, decision record, focused build plan, and handoff document connected by one continuous path.' loading='lazy' />
					<Image class='hc-about-continuity__mobile' src={AboutContinuityMobile} alt='' loading='lazy' />
				</figure>
			</div>
		</section>

		<section class='hc-section--compact hc-about-principles' data-motion-section>
			<div class='hc-container'>
				<div class='hc-section-header'><h2 class='hc-section-title' data-motion-section-label>What you can expect from me.</h2></div>
				<div class='hc-principles-grid'>{principles.map((item, index) => <div class='hc-principle' data-motion-item><figure><Image src={item.image} alt={item.alt} loading='lazy' /></figure><div class='hc-principle__copy'><span class='hc-index'>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></div></div>)}</div>
			</div>
		</section>

		<section class='hc-section hc-about-experience' data-motion-section data-header-surface='dark'>
			<div class='hc-container hc-about-experience__layout'>
				<div class='hc-about-experience__intro'>
					<h2 class='hc-section-title' data-motion-section-label>Experience across consulting and product teams.</h2>
					<p class='hc-section-intro'>My background covers large delivery environments, product-led teams, direct client engagements, and systems I have designed and built for my own operations.</p>
					<div class='hc-actions'><a class='hc-text-link' href='/case-studies/'>View case studies</a><a class='hc-text-link' href='/services/'>See all services</a></div>
				</div>
				<ol class='hc-about-experience__list'>{background.map((item, index) => <li data-motion-item><span class='hc-index'>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></li>)}</ol>
			</div>
		</section>
	</article>
</BaseLayout>
