---
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';
import { testimonials } from '../data/testimonials';
import BaseLayout from '../layouts/BaseLayout.astro';
import { closingActionsClass, closingButtonClass, closingLinkClass, metaClass, pageTitleClass, sectionHeadingClass, shellClass } from '../lib/ui';

const testimonial = testimonials.find(({ name }) => name === 'Markis Zarate')!;
---

<BaseLayout
	title='Builds for agencies | Hanif Carroll'
	description='I build websites and web apps for agencies, delivered under the agency’s name.'
	showFooterCta={false}
>
	<div class:list={[shellClass, 'pt-12 pb-[clamp(6rem,12vw,10rem)] lg:pt-20']}>
		<article class='text-[clamp(1.125rem,2vw,1.25rem)] leading-[1.55] text-ink-muted [&>:is(p,ul)]:max-w-[38rem]'>
			<h1 class={pageTitleClass}>Builds for agencies</h1>
			<p class='mt-6 mb-0'>I build websites and web apps for agencies that sell them but don’t have developers of their own. I work under your name, so your client deals with your team, and I handle the build from your designs through launch.</p>

			<h2 class:list={[sectionHeadingClass, 'mt-[clamp(4rem,8vw,6rem)]']}>What I take on</h2>
			<ul class='mt-6 mb-0 list-disc space-y-2 pl-5'>
				<li>Building sites and apps from your designs</li>
				<li>Fixing or extending a site that’s already live</li>
				<li>Adding a feature or integration to a client’s project</li>
			</ul>
			<p class='mt-8 mb-0'>I’m based in Buenos Aires and work U.S. Eastern hours, so I’m online when you and your clients are.</p>

			<blockquote class='mx-0 mt-[clamp(4rem,8vw,6rem)] mb-0 max-w-[48rem]'>
				<p class='m-0 font-editorial text-[clamp(1.5rem,2.4vw,2rem)] leading-[1.25] text-ink'>“{testimonial.quote}”</p>
				<footer class='mt-4'>
					<cite class:list={[metaClass, 'block not-italic']}>{testimonial.name} · {testimonial.role}</cite>
				</footer>
			</blockquote>
		</article>
	</div>

	{/* The page's two actions, in the shared ink closing. It has no heading, so it takes less room. */}
	<section class='bg-ink py-20 text-center text-white lg:py-28' data-section='closing-cta' aria-label='Contact'>
		<div class={shellClass}>
			<div class:list={[closingActionsClass, 'mt-0!']}>
				<a class={closingButtonClass} href={EMAIL_URL} data-track-event='email_clicked' data-track-location='agencies'>Email me</a>
				<a class={closingLinkClass} href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location='agencies'>Book a call</a>
			</div>
		</div>
	</section>
</BaseLayout>
