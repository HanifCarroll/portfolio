---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import AtlasLayout from '../../layouts/AtlasLayout.astro';
import Prose from '../../components/Prose.astro';
import { atlasSections } from '../../data/atlas';
import { articleTitleClass, deckClass, metaClass, titleHoverClass } from '../../lib/ui';

export async function getStaticPaths() {
	const order = atlasSections.map(({ id }) => id);
	const entries = (await getCollection('atlas')).sort(
		(a, b) => order.indexOf(a.data.section) - order.indexOf(b.data.section) || a.data.title.localeCompare(b.data.title),
	);
	return entries.map((entry, index) => ({
		params: { slug: entry.id },
		props: { entry, prev: entries[index - 1], next: entries[index + 1] },
	}));
}

type Entry = CollectionEntry<'atlas'>;
type Props = { entry: Entry; prev?: Entry; next?: Entry };
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const section = atlasSections.find(({ id }) => id === entry.data.section)!;
---

<AtlasLayout title={`${entry.data.title} | Build Atlas`} description={entry.data.summary}>
	<article class='max-w-[44rem]'>
		<p class:list={[metaClass, 'mb-4']}>{section.title}</p>
		<header class='mb-12'>
			<h1 class={articleTitleClass}>{entry.data.title}</h1>
			<p class:list={[deckClass, 'mt-6']}>{entry.data.summary}</p>
		</header>
		<Prose
			class:list={[
				'atlas-prose max-w-none font-editorial text-[1.2rem] leading-[1.65] text-ink',
				'prose-p:text-ink prose-li:text-ink prose-li:my-1 prose-strong:font-bold',
				'prose-headings:font-editorial prose-h2:mt-14 prose-h2:mb-3 prose-h2:text-[clamp(1.75rem,2.6vw,2.25rem)] prose-h2:font-normal prose-h2:leading-[1.1] prose-h2:tracking-[-0.02em]',
				'prose-blockquote:relative prose-blockquote:my-6 prose-blockquote:rounded-lg prose-blockquote:border-0 prose-blockquote:bg-ink/4 prose-blockquote:p-5 prose-blockquote:pt-14 prose-blockquote:not-italic prose-blockquote:font-mono prose-blockquote:text-base prose-blockquote:leading-[1.65] [&_blockquote_p]:before:content-none [&_blockquote_p]:after:content-none [&_blockquote_p:last-child]:mb-0',
				'prose-code:font-mono prose-code:before:content-none prose-code:after:content-none [&_:not(pre)>code]:text-[0.88em]',
			]}
		>
			<Content />
		</Prose>
		<nav class='mt-[clamp(4rem,8vw,6rem)] grid gap-8 font-sans text-base sm:grid-cols-2' aria-label='Previous and next entries'>
			{prev ? <a class:list={['group no-underline']} href={`/atlas/${prev.id}/`}><span class='block text-ink-muted'>← Previous</span><span class:list={['font-editorial text-2xl leading-[1.18] text-ink', titleHoverClass]}>{prev.data.title}</span></a> : <span />}
			{next && <a class:list={['group no-underline sm:text-right']} href={`/atlas/${next.id}/`}><span class='block text-ink-muted'>Next →</span><span class:list={['font-editorial text-2xl leading-[1.18] text-ink', titleHoverClass]}>{next.data.title}</span></a>}
		</nav>
	</article>
</AtlasLayout>

<script>
	// The agent instruction is the entry's blockquote; give it a copy button.
	document.querySelectorAll<HTMLElement>('.atlas-prose blockquote').forEach((quote) => {
		const button = document.createElement('button');
		button.type = 'button';
		button.textContent = 'Copy';
		button.className = 'absolute top-3 right-3 min-h-9 cursor-pointer rounded-lg border-0 bg-ink px-3 py-1 font-sans text-base not-italic text-canvas hover:bg-ink-muted';
		button.addEventListener('click', async () => {
			await navigator.clipboard.writeText(quote.innerText.replace(/\s*Copy$/, '').trim());
			button.textContent = 'Copied';
			setTimeout(() => (button.textContent = 'Copy'), 1500);
		});
		quote.append(button);
	});
</script>
