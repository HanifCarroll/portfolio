---
import { getCollection } from 'astro:content';
import AtlasLayout from '../../layouts/AtlasLayout.astro';
import { atlasProblems, atlasSections, atlasTools } from '../../data/atlas';
import { deckClass, pageTitleClass, sectionHeadingClass, titleHoverClass, underlineClass } from '../../lib/ui';

const atlasHeadingClass = `${sectionHeadingClass} text-[clamp(2rem,3.6vw,3rem)]`;

const description =
	'A vocabulary of the components a software project needs, from product to code to the agents that build it. Each entry says what a component is, when you need it, popular choices, and what to tell your agent.';
const entries = (await getCollection('atlas')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const byId = new Map(entries.map((entry) => [entry.id, entry]));
const problems = atlasProblems.map((problem) => ({
	...problem,
	entries: problem.entries.map((id) => byId.get(id) ?? (() => { throw new Error(`Unknown Build Atlas entry in atlasProblems: ${id}`); })()),
}));
const sections = atlasSections.map((section) => ({ ...section, entries: entries.filter((entry) => entry.data.section === section.id) }));
---

<AtlasLayout title='Build Atlas | Hanif Carroll' description={description}>
	<header class='pb-[clamp(4rem,8vw,6rem)]'>
		<h1 class={pageTitleClass}>Build Atlas</h1>
		<p class:list={[deckClass, 'mt-6 max-w-[40rem]']}>
			System design has shared words like database, queue and cache. Building with AI needs the same kind of words for everything else, so you can name what you need and tell an agent to build it. Each entry says what a component is, when you need it, the popular choices, and what to tell your agent.
		</p>
	</header>

	<section class='mb-[clamp(5rem,10vw,8rem)]' aria-labelledby='problems-title'>
		<h2 id='problems-title' class:list={[atlasHeadingClass, 'mb-8']}>What are you trying to do?</h2>
		<dl class='m-0 grid gap-x-10 gap-y-8 md:grid-cols-2'>
			{problems.map((problem) => (
				<div>
					<dt class='font-editorial text-2xl leading-[1.18] text-ink'>{problem.title}</dt>
					<dd class='m-0 mt-2 text-base leading-[1.7] text-ink-muted'>
						{problem.entries.map((entry, index) => (
							<>{index > 0 && <span aria-hidden='true'> · </span>}<a class:list={['text-ink', underlineClass]} href={`/atlas/${entry.id}/`}>{entry.data.title}</a></>
						))}
					</dd>
				</div>
			))}
		</dl>
	</section>

	{sections.map((section) => (
		<section id={section.id} class='mb-[clamp(5rem,10vw,8rem)] scroll-mt-24 last:mb-0' aria-labelledby={`${section.id}-title`}>
			<div class='mb-8'>
				<h2 id={`${section.id}-title`} class={atlasHeadingClass}>{section.title}</h2>
				<p class='mt-3 mb-0 max-w-[38rem] text-lg leading-[1.55] text-ink-muted'>{section.description}</p>
			</div>
			<ul class='m-0 grid list-none gap-7 p-0'>
				{section.entries.map((entry) => (
					<li>
						<a class:list={['group grid items-baseline gap-1 no-underline md:grid-cols-[15rem_minmax(0,1fr)] md:gap-8']} href={`/atlas/${entry.id}/`}>
							<span class:list={['font-editorial text-2xl leading-[1.18] text-ink', titleHoverClass]}>{entry.data.title}</span>
							<span class='text-base leading-[1.6] text-ink-muted'>
								{entry.data.summary}
								<span class='mt-1 block'>{atlasTools(entry.body).join(' · ')}</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	))}
</AtlasLayout>
