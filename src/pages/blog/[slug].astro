---
import { type CollectionEntry, getCollection } from 'astro:content';
import ArticleDefinitions from '../../components/ArticleDefinitions.astro';
import Prose from '../../components/Prose.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCallout from '../../components/ServiceCallout.astro';
import { Image } from 'astro:assets';
import FormattedDate from '../../components/FormattedDate.astro';
import AboutTheAuthor from '../../components/widgets/AboutTheAuthor.astro';
import Author from '../../components/Author.astro';
import TableOfContent from '../../components/widgets/TableOfContent.astro';
import { render } from 'astro:content';
import '../../styles/blog.css';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.hidden);
	return posts.map((post: any) => ({
		params: { slug: post.id },
		props: post
	}));
}
type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const {
	data: { title, subtitle, seoTitle, description, coverImage, pubDate, updatedDate, ctaVariant }
} = post;
const { Content, headings } = await render(post);

const canonicalUrl = new URL(`/blog/${post.id}/`, Astro.site).toString();
const wordCount = post.body?.replace(/<[^>]*>/g, '').split(/\s+/).filter(Boolean).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 225));
const tocHeadings = headings.filter((heading) => heading.depth === 2).map((heading) => ({
  ...heading,
  text: post.id === 'bpm-lifecycle-saas-onboarding'
    ? heading.text.replace(/^(\d+\.) Process ([^:]+):.*$/, '$1 $2').replace(/^Quick-Reference:.*$/, 'Quick reference')
    : heading.text
}));
const showContents = wordCount >= 1000 && tocHeadings.length >= 3;
const blogJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	url: canonicalUrl,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: {
		'@type': 'Person',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/'
	}
};
---

<BaseLayout
	title={seoTitle || title}
	description={description}
	image={coverImage?.src || undefined}
	jsonLd={blogJsonLd}
	ogType='article'
	showFooterCta={false}
	footerLinksOnly
	bodyClass={`page-blog-detail${post.id === 'bpm-lifecycle-saas-onboarding' ? ' page-bpm' : ''}`}
>
	<div class='container max-w-6xl space-y-10 py-8 md:space-y-12'>
		<header class='blog-post-hero' data-motion-intro>
			<div class='blog-post-hero__copy'>
				<h1 class='blog-post-hero__title' data-motion='headline'>{title}</h1>
				{subtitle && <p class='blog-post-hero__subtitle' data-motion-deck>{subtitle}</p>}
				{!subtitle && (
					<p class='blog-post-hero__dek text-lg leading-8 text-zinc-600' data-motion-deck>{description}</p>
				)}
				<div class='blog-post-hero__byline' data-motion-intro-item>
					<Author />
					<div class='blog-post-hero__publication-meta'>
						{
							updatedDate ? (
								<>
									Updated <FormattedDate date={updatedDate} />
								</>
							) : (
								<>
									Published <FormattedDate date={pubDate} />
								</>
							)
						}
						<span aria-hidden='true'>·</span>
						{readingMinutes} min read
					</div>
				</div>
			</div>
			{
				coverImage && (
					<figure class='blog-post-hero__media'>
						<Image class='blog-post-hero__image' src={coverImage} alt={title} loading='eager' />
					</figure>
				)
			}
		</header>

		<div class='blog-post-layout'>
			<div class='blog-post-main'>
				{
					showContents && (
						<details class='blog-post-toc'>
							<summary>Contents</summary>
							<TableOfContent headings={tocHeadings} />
						</details>
					)
				}
				<article class='blog-post-article'>
					<Prose class='blog-post-prose'>
						<Content />
					</Prose>
				</article>

				<section class='blog-post-author-inline' aria-label='About the author'>
					<AboutTheAuthor />
				</section>
			</div>


			<ServiceCallout variant={ctaVariant} context='blog' location={`blog_${post.id}`} />
		</div>
	</div>
{post.id === 'bpm-lifecycle-saas-onboarding' && <ArticleDefinitions />}
</BaseLayout>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.blog-post-toc').forEach(details => {
    const summary = details.querySelector('summary')!;
    let animation: Animation | undefined;
    let expanded = details.open;
    summary.addEventListener('click', event => {
      event.preventDefault();
      const startHeight = details.getBoundingClientRect().height;
      animation?.cancel();
      expanded = !expanded;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        details.open = expanded;
        return;
      }
      details.open = expanded;
      const endHeight = details.getBoundingClientRect().height;
      details.open = true;
      animation = details.animate(
        { height: [`${startHeight}px`, `${endHeight}px`] },
        { duration: 240, easing: 'cubic-bezier(0.2, 0, 0, 1)' }
      );
      animation.onfinish = () => {
        details.open = expanded;
        animation = undefined;
      };
    });
  });
</script>
