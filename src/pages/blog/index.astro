---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { focusClass, headingText, itemTitleClass, pageTitleClass, shellClass, titleHoverClass } from '../../lib/ui';

type BlogPost = CollectionEntry<'blog'>;
const title = 'Blog on products, workflows, and AI';
const description =
	'Practical notes for small-business owners on software, workflow automation, AI, and the technical decisions behind reliable systems.';

const posts = (await getCollection('blog', ({ data }) => !data.hidden)).sort(
	(a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const archiveJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: title,
	description,
	url: new URL('/blog/', Astro.site).toString(),
};
---

<BaseLayout
	title={title}
	description={description}
	jsonLd={archiveJsonLd}
	showFooterCta={false}
>
	<article class:list={[shellClass, 'pt-12 pb-[clamp(6rem,12vw,10rem)] lg:pt-20']}>
		<header class='pb-[clamp(3rem,6vw,5rem)]'>
			<h1 class={pageTitleClass}>Blog</h1>
		</header>

		<section aria-label='Blog posts'>
			<ol class='m-0 grid list-none gap-12 p-0'>
				{posts.map((post) => (
					<li>
						<a class:list={['group grid items-baseline gap-x-8 gap-y-2 text-inherit no-underline md:grid-cols-[minmax(0,1fr)_auto]', focusClass]} href={`/blog/${post.id}/`}>
							<h3 class:list={[itemTitleClass, titleHoverClass]}>{headingText(post.data.title)}</h3>
							<span class='text-base text-ink-muted tabular-nums'><FormattedDate date={post.data.pubDate} /></span>
							<p class='m-0 max-w-[40rem] text-lg leading-[1.55] text-ink-muted'>{post.data.description}</p>
						</a>
					</li>
				))}
			</ol>
		</section>
	</article>
</BaseLayout>
