---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getLocale, localizedPath } from '../../i18n';
import { getBlogCatalog } from '../../lib/blog';
import { headingText, itemTitleClass, pageTitleClass, shellClass, titleHoverClass } from '../../lib/ui';

const locale = getLocale(Astro.currentLocale);
const title = locale === 'es' ? 'Blog sobre productos, flujos de trabajo e IA' : 'Blog on products, workflows, and AI';
const description = locale === 'es'
	? 'Notas prácticas para dueños de negocios chicos sobre software, automatización de flujos de trabajo, IA y las decisiones técnicas para construir sistemas confiables.'
	: 'Practical notes for small-business owners on software, workflow automation, AI, and the technical decisions behind reliable systems.';
const posts = await getBlogCatalog(locale);

const archiveJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: title,
	description,
	url: new URL(localizedPath('/blog/', locale), Astro.site).toString(),
	...(locale === 'es' ? { inLanguage: 'es' } : {}),
};
---

<BaseLayout
	title={title}
	description={description}
	jsonLd={archiveJsonLd}
	showFooterCta={false}
>
	<article class:list={[shellClass, 'pt-12 pb-[clamp(6rem,12vw,10rem)] lg:pt-20']}>
		<header class='pb-[clamp(3rem,6vw,5rem)]'>
			<h1 class={pageTitleClass}>Blog</h1>
		</header>

		<section aria-label={locale === 'es' ? 'Artículos del blog' : 'Blog posts'}>
			<ol class='m-0 grid list-none gap-12 p-0'>
				{posts.map((post) => (
					<li>
						<a class:list={['group grid items-baseline gap-x-8 gap-y-2 text-inherit no-underline md:grid-cols-[minmax(0,1fr)_auto]']} href={post.href} hreflang={post.fallback ? 'en' : undefined}>
							<h3 class:list={[itemTitleClass, titleHoverClass]}>{headingText(post.title)}{post.fallback && <span class='font-sans text-base text-ink-muted'> (en inglés)</span>}</h3>
							<span class='text-base text-ink-muted tabular-nums'><FormattedDate date={post.entry.data.pubDate} /></span>
							<p class='m-0 max-w-[40rem] text-lg leading-[1.55] text-ink-muted'>{post.description}</p>
						</a>
					</li>
				))}
			</ol>
		</section>
	</article>
</BaseLayout>
