---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import '../../styles/blog-index.css';

type BlogPost = CollectionEntry<'blog'>;
const title = 'Blog on products, workflows, and AI';
const description =
	'Practical notes for founders and operators on software, workflow automation, AI, and the technical decisions behind reliable systems.';

const posts = (await getCollection('blog', ({ data }) => !data.hidden)).sort(
	(a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const archiveJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: title,
	description,
	url: new URL('/blog/', Astro.site).toString(),
};
---

<BaseLayout
	title={title}
	description={description}
	jsonLd={archiveJsonLd}
	showHeader={false}
	showFooterCta={false}
	showFooter={false}
	bodyClass='hc-blog-index'
>
	<article class='hc-blog-shell'>
		<div class='hc-blog-content'>
			<nav class='hc-blog-back' aria-label='Back to home'>
				<a href='/'>
					<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M19 12H5'></path><path d='M12 19l-7-7 7-7'></path></svg>
					Hanif Carroll
				</a>
			</nav>

			<header class='hc-blog-header'>
				<h1 class='hc-blog-title'>Blog</h1>
				<p class='hc-blog-intro'>
					Notes on dependable software, business workflows, and deciding where AI is useful.
				</p>
			</header>

			<section class='hc-blog-posts' aria-label='Blog posts'>
				<div class='hc-blog-section-label'>
					<h2 class='hc-blog-section-title'>All posts</h2>
				</div>
				<ol class='hc-blog-rows'>
					{posts.map((post) => (
						<li class='hc-blog-row'>
							<a class='hc-blog-row__link' href={`/blog/${post.id}/`}>
								<div class='hc-blog-row__meta'>
									<FormattedDate date={post.data.pubDate} />
								</div>
								<div class='hc-blog-row__content'>
									<h3 class='hc-blog-row__title'>{post.data.title}</h3>
									<p class='hc-blog-row__description'>{post.data.description}</p>
								</div>
							</a>
						</li>
					))}
				</ol>
			</section>
		</div>
	</article>
</BaseLayout>
