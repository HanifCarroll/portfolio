---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVideoCard from '../../components/project-video/ProjectVideoCard.astro';
import { projects } from '../../lib/project-cards';
import {
	DELISTED_CASE_STUDY_SLUGS,
	PROJECT_CLIENT_ORDER,
	PROJECT_METHOD_ORDER,
	PROJECT_R_AND_D_ORDER,
} from '../../lib/project-curation';
import '../../styles/projects.css';

const title = 'Case Studies';
const description = 'Selected client and independent projects showing workflow diagnosis, product decisions, software systems, and supported results.';

const projectBySlug = new Map(projects.map((project) => [project.slug, project]));

const selectProjects = (preferredOrder: readonly string[]) => {
	return preferredOrder.map((slug) => {
		const project = projectBySlug.get(slug);
		if (!project) throw new Error(`Missing project metadata for curated case study "${slug}".`);
		return project;
	});
};

const categorizedSlugs = [
	...PROJECT_CLIENT_ORDER,
	...PROJECT_METHOD_ORDER,
	...PROJECT_R_AND_D_ORDER,
	...DELISTED_CASE_STUDY_SLUGS,
];
const duplicateSlugs = categorizedSlugs.filter((slug, index) => categorizedSlugs.indexOf(slug) !== index);
if (duplicateSlugs.length > 0) {
	throw new Error(`Case-study curation contains duplicate slugs: ${[...new Set(duplicateSlugs)].join(', ')}`);
}

const categorizedSlugSet = new Set<string>(categorizedSlugs);
const uncategorizedProjects = projects.filter((project) => !categorizedSlugSet.has(project.slug));
if (uncategorizedProjects.length > 0) {
	throw new Error(`Case studies need a visibility tier: ${uncategorizedProjects.map((project) => project.slug).join(', ')}`);
}

const clientProjects = selectProjects(PROJECT_CLIENT_ORDER);
const methodProjects = selectProjects(PROJECT_METHOD_ORDER);
const researchProjects = selectProjects(PROJECT_R_AND_D_ORDER);
const spotlightProject = clientProjects[0];
const panoramaProject = clientProjects[1];
const trioProjects = clientProjects.slice(2);
const methodProject = methodProjects[0];
---

<BaseLayout title={`${title} | Hanif Carroll`} description={description} bodyClass='page-projects-index'>
	<article class='projects-index projects-index--spotlight'>
		<header class='projects-index__intro-band hc-container-wide' data-motion-intro>
			<h1 data-motion='headline'>Case Studies</h1>
			<div class='projects-index__intro-copy'>
				<p data-motion-deck>Client engagements showing how I understand an operation, choose the smallest useful intervention, and leave behind a system the client can use and own.</p>
				<div class='projects-index__filters' aria-label='Filter case studies'>
					<button class='is-active' type='button' data-project-filter='all' aria-pressed='true'>All projects</button>
					<button type='button' data-project-filter='client' aria-pressed='false'>Client</button>
					<button type='button' data-project-filter='independent' aria-pressed='false'>Independent</button>
				</div>
			</div>
		</header>

		<div class='projects-index__collection-heading hc-container-wide' data-project-group>
			<p>Client engagements</p>
			<h2>See how I mapped real workflows and built systems people could use.</h2>
		</div>

		<section class='projects-index__filtered hc-container-wide' data-project-filtered-results aria-live='polite' hidden>
			<div class='projects-index__filtered-grid' data-project-filtered-grid></div>
		</section>

		<section class='projects-index__spotlight hc-container-wide' data-project-group data-motion-group>
			<ProjectVideoCard project={spotlightProject} variant='lead' index={1} />
		</section>

		<section class='projects-index__panorama' data-project-group data-motion-group>
			<div class='hc-container-wide'>
				<ProjectVideoCard project={panoramaProject} variant='lead' index={2} />
			</div>
		</section>

		<section class='projects-index__trio hc-container-wide' data-project-group data-motion-group>
			{trioProjects.map((project, index) => (
				<ProjectVideoCard project={project} variant='compact' index={index + 3} />
			))}
		</section>

		<section class='projects-index__closing-feature' data-project-group data-motion-group>
			<div class='hc-container-wide'>
				<div class='projects-index__collection-heading projects-index__collection-heading--inverse'>
					<p>Method and diagnostic</p>
					<h2>A modeled workflow for recognizing where work breaks down.</h2>
				</div>
				<ProjectVideoCard project={methodProject} variant='lead' index={6} />
			</div>
		</section>

		<section class='projects-index__archive hc-container-wide' data-project-group data-motion-group>
			<div class='projects-index__archive-heading'>
				<h2>Independent systems and R&amp;D</h2>
				<p>Self-directed work exploring controlled automation, AI workflows, and durable operating systems.</p>
			</div>
			<div class='projects-index__archive-grid'>
				{researchProjects.map((project, index) => (
					<ProjectVideoCard project={project} variant='compact' index={index + clientProjects.length + methodProjects.length + 1} />
				))}
			</div>
		</section>
	</article>
</BaseLayout>

<script>
	const installProjectFilters = () => {
		const root = document.querySelector<HTMLElement>('.projects-index');
		if (!root || root.dataset.filtersReady === 'true') return;

		const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
		const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-project-proof]'));
		const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-project-group]'));
		const filteredResults = root.querySelector<HTMLElement>('[data-project-filtered-results]');
		const filteredGrid = root.querySelector<HTMLElement>('[data-project-filtered-grid]');
		if (!filteredResults || !filteredGrid) return;

		root.dataset.filtersReady = 'true';
		const cardRecords = cards.map((card) => {
			const origin = document.createComment('project-card-origin');
			const index = card.querySelector<HTMLElement>('.project-video-card__index');
			card.before(origin);
			return { card, origin, originalIndex: index?.textContent ?? '' };
		});

		const restoreOriginalLayout = () => {
			cardRecords.forEach(({ card, origin, originalIndex }) => {
				origin.parentNode?.insertBefore(card, origin.nextSibling);
				card.hidden = false;
				const index = card.querySelector<HTMLElement>('.project-video-card__index');
				if (index) index.textContent = originalIndex;
			});
		};

		const applyFilter = (filter: string, activeButton: HTMLButtonElement) => {
			restoreOriginalLayout();
			buttons.forEach((item) => {
				const active = item === activeButton;
				item.classList.toggle('is-active', active);
				item.setAttribute('aria-pressed', String(active));
			});

			if (filter === 'all') {
				filteredResults.hidden = true;
				groups.forEach((group) => { group.hidden = false; });
				return;
			}

			groups.forEach((group) => { group.hidden = true; });
			filteredGrid.replaceChildren();
			const matches = cardRecords.filter(({ card }) => {
				const isClient = card.dataset.projectProof === 'client';
				return filter === 'client' ? isClient : !isClient;
			});

			matches.forEach(({ card }, index) => {
				const cardIndex = card.querySelector<HTMLElement>('.project-video-card__index');
				if (cardIndex) cardIndex.textContent = String(index + 1).padStart(2, '0');
				filteredGrid.append(card);
			});
			filteredResults.hidden = false;
		};

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const filter = button.dataset.projectFilter ?? 'all';
				applyFilter(filter, button);
			});
		});
	};

	installProjectFilters();
	document.addEventListener('astro:page-load', installProjectFilters);
</script>
