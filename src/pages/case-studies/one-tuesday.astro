---
import OneTuesdayHero from '../../assets/img/projects/one-tuesday-hero.png';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BOOK_CALL_URL, EMAIL_URL } from '../../consts';
import { getProject } from '../../lib/projects';
import { ASSUMPTIONS } from '../../lib/tuesday-sim/engine';
import {
  TUESDAY_CHAPTERS,
  TUESDAY_COMPANY,
  TUESDAY_MIRROR_READOUTS,
  TUESDAY_MIRROR_STATEMENTS,
  TUESDAY_RESULTS,
} from '../../lib/tuesday-sim/story';
import '../../styles/tuesday.css';

const project = getProject('one-tuesday');
if (!project) throw new Error('Missing project metadata for one-tuesday.');
const title = project.seoTitle ?? project.title;
const description = project.seoDescription ?? project.description;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  url: project.liveUrl,
  creator: { '@type': 'Person', name: 'Hanif Carroll', url: 'https://www.hanifcarroll.com/' },
};
const { before, after, stressedBefore, stressedAfter } = TUESDAY_RESULTS;
const formatDuration = (minutes: number) => {
  const rounded = Math.round(minutes);
  if (rounded < 60) return `${rounded} minutes`;
  const hours = Math.floor(rounded / 60);
  const remainder = rounded % 60;
  return remainder === 0 ? `${hours} hours` : `${hours}h ${remainder}m`;
};
const formatHours = (minutes: number) => `${(minutes / 60).toFixed(1)} hours`;
const toReaderStatement = (statement: string) =>
  statement === 'Requests reach us through more than two channels.'
    ? 'Requests reach you through more than two channels.'
    : statement;
---

<BaseLayout
  title={title}
  description={description}
  image={OneTuesdayHero.src}
  jsonLd={jsonLd}
  showFooterCta={false}
  bodyClass='page-one-tuesday'
>
  <div id='tuesday-experience-root'></div>

  <article id='tuesday-reader' tabindex='-1'>
    <p class='t-reader-kicker'>Interactive workflow diagnostic</p>
    <h1>One Tuesday, twice.</h1>
    <p class='t-reader-deck'>
      {TUESDAY_COMPANY.name} is {TUESDAY_COMPANY.description}. {TUESDAY_COMPANY.dayContext}
    </p>
    <p class='t-reader-deck'>
      This is one modeled Tuesday, shown before and after six workflow changes. The numbers come from the assumptions below. Use them to compare the workflows, not to predict what another business would achieve.
    </p>

    <div class='t-reader-launch'>
      <p>Run the three-part experience to feel the queue, add each change, and compare both workflows under the same demand.</p>
      <button type='button' class='hc-button' data-tuesday-launch disabled>Run the interactive diagnostic</button>
    </div>

    <h2 id='tuesday-reader-old' tabindex='-1'>The old Tuesday</h2>
    <p>
      Requests arrive through email threads, phone calls, texts, walk-ins, and sticky notes. Nobody owns intake, so everyone does it a little.
    </p>
    <p>
      A request gets answered twice or not at all. Finding the status of a job means finding the person who last touched it.
    </p>
    <p>
      Under the assumptions below, the model generates {before.arrivals} requests across a nine-and-a-half-hour day while the operator works continuously:
    </p>
    <table>
      <thead><tr><th>Measure</th><th>Old Tuesday</th></tr></thead>
      <tbody>
        <tr><td>Requests arrived</td><td>{before.arrivals}</td></tr>
        <tr><td>Handled</td><td>{before.completed}</td></tr>
        <tr><td>Forgotten entirely</td><td>{before.dropped}</td></tr>
        <tr><td>Carried into tomorrow</td><td>{before.carried}</td></tr>
        <tr><td>Duplicate requests</td><td>{before.duplicates}</td></tr>
        <tr><td>Angry customer calls</td><td>{before.complaints}</td></tr>
        <tr><td>Average wait for an answer</td><td>{formatDuration(before.avgWaitMinutes)}</td></tr>
        <tr><td>Operator time on coordination</td><td>{formatHours(before.manualMinutes)}</td></tr>
      </tbody>
    </table>
    <p>
      Even with the operator working continuously, the old workflow spends most of the day finding, re-keying, forwarding, and confirming requests.
    </p>

    <h2 id='tuesday-reader-build' tabindex='-1'>Six workflow changes in the modeled scenario</h2>
    <p>
      The scenario changes one part of the workflow at a time. A real operation may need a different order, more capacity, or no new software at all.
    </p>
    {TUESDAY_CHAPTERS.map((chapter) => (
      <section class='t-reader-chapter'>
        <h3>{chapter.week} — {chapter.title}</h3>
        {chapter.body.map((paragraph) => <p>{paragraph}</p>)}
        <p class='t-reader-note'>{chapter.stageNote}</p>
      </section>
    ))}

    <h2 id='tuesday-reader-new' tabindex='-1'>The same modeled demand, twice</h2>
    <p>Both runs receive the same {before.arrivals} requests, and both operators work continuously. Only the workflow changes:</p>
    <table>
      <thead><tr><th>Measure</th><th>Old Tuesday</th><th>New Tuesday</th></tr></thead>
      <tbody>
        <tr><td>Handled</td><td>{before.completed}</td><td>{after.completed}</td></tr>
        <tr><td>Forgotten entirely</td><td>{before.dropped}</td><td>{after.dropped}</td></tr>
        <tr><td>Carried into tomorrow</td><td>{before.carried}</td><td>{after.carried}</td></tr>
        <tr><td>Duplicate requests</td><td>{before.duplicates}</td><td>{after.duplicates}</td></tr>
        <tr><td>Angry customer calls</td><td>{before.complaints}</td><td>{after.complaints}</td></tr>
        <tr><td>Average wait for an answer</td><td>{formatDuration(before.avgWaitMinutes)}</td><td>{formatDuration(after.avgWaitMinutes)}</td></tr>
        <tr><td>Operator time on coordination</td><td>{formatHours(before.manualMinutes)}</td><td>{formatHours(after.manualMinutes)}</td></tr>
      </tbody>
    </table>
    <p>
      In the model, the redesigned workflow spends less time coordinating requests and handles more of them. A real result depends on the company's workflow, demand, and capacity.
    </p>

    <div class='t-reader-model'>
      <h2>The stress test</h2>
      <p>Double the modeled volume, take the dispatcher out, and disable the scheduling API:</p>
      <table>
        <thead><tr><th>Under stress</th><th>Old Tuesday</th><th>New Tuesday</th></tr></thead>
        <tbody>
          <tr><td>Requests arrived</td><td>{stressedBefore.arrivals}</td><td>{stressedAfter.arrivals}</td></tr>
          <tr><td>Forgotten entirely</td><td>{stressedBefore.dropped}</td><td>{stressedAfter.dropped}</td></tr>
          <tr><td>Carried into tomorrow</td><td>{stressedBefore.carried}</td><td>{stressedAfter.carried}</td></tr>
          <tr><td>Angry customer calls</td><td>{stressedBefore.complaints}</td><td>{stressedAfter.complaints}</td></tr>
        </tbody>
      </table>

      <h2>The model</h2>
      <p>These inputs make the comparison inspectable. They describe the fictional company and should be replaced with a real operation's data before drawing conclusions.</p>
      <dl class='t-reader-assumptions'>
        {ASSUMPTIONS.map((assumption) => (
          <div>
            <dt>{assumption.parameter}: {assumption.value}</dt>
            <dd>{assumption.basis}</dd>
          </div>
        ))}
      </dl>
    </div>

    <h2 id='tuesday-reader-mirror' tabindex='-1'>How much of that Tuesday is yours?</h2>
    <p>Count the statements that describe your current operation:</p>
    <ul class='t-reader-mirror'>
      {TUESDAY_MIRROR_STATEMENTS.map((statement) => <li>{toReaderStatement(statement)}</li>)}
    </ul>
    <div class='t-reader-readouts'>
      {TUESDAY_MIRROR_READOUTS.map((readout) => (
        <p><span class='t-reader-score'>{readout.min}–{readout.max}</span><span><strong>{readout.headline}</strong> {readout.body}</span></p>
      ))}
    </div>
    <div class='t4-cta'>
      <p class='t4-cta__line'>If this resembles your week, start with the workflow that is getting harder to run.</p>
      <div class='t4-cta__actions'>
        <a
          class='hc-button'
          href={BOOK_CALL_URL}
          target='_blank'
          rel='noopener noreferrer'
          data-track-event='book_call_clicked'
          data-track-location='one_tuesday_reader'
        >Book a 30-minute audit fit call</a>
        <a
          class='t4-cta__secondary'
          href={EMAIL_URL}
          data-track-event='email_clicked'
          data-track-location='one_tuesday_reader'
        >Or email me your Tuesday</a>
      </div>
    </div>
    <p><a href='/case-studies/'>See real client work</a></p>
  </article>
</BaseLayout>

<script>
  import type { Root } from 'react-dom/client';

  let experienceRoot: Root | undefined;
  let experienceContainer: HTMLElement | null = null;
  let experienceLoad: Promise<void> | undefined;

  const loadExperience = async () => {
    const container = document.getElementById('tuesday-experience-root');
    if (!container) return;

    if (experienceRoot && experienceContainer === container) {
      window.dispatchEvent(new CustomEvent('tuesday:launch'));
      return;
    }

    experienceLoad ??= Promise.all([
      import('../../components/tuesday/TuesdayExperience'),
      import('react'),
      import('react-dom/client'),
    ]).then(([{ default: TuesdayExperience }, { createElement }, { createRoot }]) => {
      experienceContainer = container;
      experienceRoot = createRoot(container);
      experienceRoot.render(createElement(TuesdayExperience));
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => window.scrollTo({ top: 0, behavior: 'auto' }));
      });
    }).finally(() => {
      experienceLoad = undefined;
    });

    await experienceLoad;
  };

  const enableLaunchButtons = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-tuesday-launch]').forEach((button) => {
      button.disabled = false;
    });
  };

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const launch = event.target.closest('[data-tuesday-launch]');
    if (!launch) return;
    void loadExperience();
  });
  document.addEventListener('astro:page-load', enableLaunchButtons);
  enableLaunchButtons();
</script>
