---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import { guideGroups } from '../../data/guide';
import { guideProblems } from '../../data/guide-problems';
import { articleTitleClass, deckClass, metaClass, shellClass, titleHoverClass, underlineClass } from '../../lib/ui';

export async function getStaticPaths() {
	const order = guideGroups.map(({ id }) => id);
	const entries = (await getCollection('guide')).sort(
		(a, b) => order.indexOf(a.data.group) - order.indexOf(b.data.group) || a.data.title.localeCompare(b.data.title),
	);
	return entries.map((entry, index) => ({
		params: { slug: entry.id },
		props: { entry, prev: entries[index - 1], next: entries[index + 1] },
	}));
}

type Entry = CollectionEntry<'guide'>;
type Props = { entry: Entry; prev?: Entry; next?: Entry };
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const group = guideGroups.find(({ id }) => id === entry.data.group)!;
const problems = guideProblems.filter((problem) => (problem.entries as readonly string[]).includes(entry.id));
---

<BaseLayout title={`${entry.data.seoTitle} | Hanif Carroll`} description={entry.data.description}>
	<div class:list={[shellClass, 'pt-12 pb-[clamp(6rem,12vw,10rem)] lg:pt-20']}>
		<article class='max-w-[44rem]'>
			<p class:list={[metaClass, 'mb-4']}><a class='text-inherit no-underline hover:text-ink' href='/guide/'>Business tools guide</a> · {group.title}</p>
			<header class='mb-12'>
				<h1 class={articleTitleClass}>{entry.data.title}</h1>
				<p class:list={[deckClass, 'mt-6']}>{entry.data.summary}</p>
			</header>
			<section class='mb-12' aria-labelledby='problems-title'>
				<h2 id='problems-title' class='m-0 mb-3 font-editorial text-[clamp(1.75rem,2.6vw,2.25rem)] font-normal leading-[1.1] tracking-[-0.02em] text-ink'>Problems this solves</h2>
				<ul class='m-0 list-disc pl-6 font-editorial text-[1.2rem] leading-[1.65] text-ink marker:text-ink-muted'>
					{problems.map((problem) => <li class='my-1'>{problem.text}</li>)}
				</ul>
			</section>
			<Prose
				class:list={[
					'max-w-none font-editorial text-[1.2rem] leading-[1.65] text-ink',
					'prose-p:text-ink prose-li:text-ink prose-li:my-1 prose-strong:font-bold',
					'prose-headings:font-editorial prose-h2:mt-14 prose-h2:mb-3 prose-h2:text-[clamp(1.75rem,2.6vw,2.25rem)] prose-h2:font-normal prose-h2:leading-[1.1] prose-h2:tracking-[-0.02em]',
				]}
			>
				<Content />
			</Prose>
			<p class='mt-12 mb-0 font-sans text-base'><a class:list={['text-ink', underlineClass]} href='/guide/'>All topics in the guide</a></p>
			<nav class='mt-[clamp(4rem,8vw,6rem)] grid gap-8 font-sans text-base sm:grid-cols-2' aria-label='Previous and next entries'>
				{prev ? <a class='group no-underline' href={`/guide/${prev.id}/`}><span class='block text-ink-muted'>← Previous</span><span class:list={['font-editorial text-2xl leading-[1.18] text-ink', titleHoverClass]}>{prev.data.title}</span></a> : <span />}
				{next && <a class='group no-underline sm:text-right' href={`/guide/${next.id}/`}><span class='block text-ink-muted'>Next →</span><span class:list={['font-editorial text-2xl leading-[1.18] text-ink', titleHoverClass]}>{next.data.title}</span></a>}
			</nav>
		</article>
	</div>
</BaseLayout>
