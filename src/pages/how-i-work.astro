---
import EssayPage from '../layouts/EssayPage.astro';
const entry = Object.values(import.meta.glob('../content/how-i-work.md', { eager: true }))[0] as {
	frontmatter?: { title?: string; description?: string };
	default: any;
};
const frontmatter = entry.frontmatter ?? {};
const Content = entry.default;
const title = frontmatter.title ?? 'How I Work';
const description = frontmatter.description ?? '';
---

<EssayPage title={title} pageTitle='How I Work · Hanif Carroll' description={description} deck={description} bodyClass='hc-how'>
	<Content />
</EssayPage>
