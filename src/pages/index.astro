---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Portrait from '../assets/img/hanif-author-portrait.jpg';
import FormattedDate from '../components/FormattedDate.astro';
import GenruptThumb from '../assets/img/projects/genrupt-mobile-feature.png';
import PalabrunoThumb from '../assets/img/projects/palabruno-founder-idea-launch.png';
import DesarmaderoThumb from '../assets/img/projects/desarmadero-parts-stockroom-photo.png';
import { testimonials as allTestimonials } from '../data/testimonials';
import MuchoHangoutsThumb from '../assets/img/projects/mucho-hangouts-feature.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';
import '../styles/archive-shared.css';
import '../styles/home.css';

const title = 'Hanif Carroll | Forward Deployed Engineer';
const description =
	'Forward Deployed Engineer working directly with clients on discovery, workflow software, integrations, and production AI. Available for fully remote agency roles and contracts.';
const socialTitle = 'Hanif Carroll, Forward Deployed Engineer';
const socialDescription = 'Client discovery, workflow software, and production AI. Explore client engagements from scoping and prototypes to launch, support, and handoff.';

const homepageJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		jobTitle: 'Forward Deployed Engineer',
		description,
		sameAs: [
			'https://github.com/hanifcarroll',
			'https://linkedin.com/in/hanifcarroll',
			'https://x.com/hanifcarroll',
			'https://www.threads.com/@hanifcarroll'
		],
		knowsAbout: [
			'Frontend engineering',
			'React',
			'TypeScript',
			'Next.js',
			'React Native',
			'Frontend performance',
			'Reusable components',
			'Product engineering',
			'Internal tools',
			'HubSpot integrations',
			'AI product features',
			'Applied AI',
			'Business workflows',
			'Reliable AI integrations',
			'Contract engineering'
		]
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		description
	}
];

const navLinks = [
	{ href: '#projects', label: 'Explore client work' },
	{ href: '#experience', label: 'Experience' },
	{ href: '#about', label: 'About' },
	{ href: '#blog', label: 'Blog' }
];

const blogPosts = (await getCollection('blog', ({ data }) => !data.hidden))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const projects = [
  {
    slug: 'desarmadero-la-torre',
    title: 'Desarmadero La Torre — From parts catalog to operations prototype',
    description: 'Built a searchable parts catalog, then translated a returning client’s sales, payment, and dismantling workflows into a specification and role-based prototype.',
    status: 'Catalog delivered · Operations prototype',
    image: DesarmaderoThumb,
    alt: 'Automotive salvage inventory and the operating environment behind the client engagement.',
    tags: ['TypeScript', 'SvelteKit', 'Cloudflare D1']
  },
  {
    slug: 'genrupt',
    title: 'Genrupt — Building dependable AI seller workflows',
    description: 'Worked directly with the founder on AI seller workflows and the account permissions, billing, credits, and recoverable processing behind them.',
    status: 'Production client software',
    image: GenruptThumb,
    alt: 'Genrupt creative operations workspace for Amazon seller teams.',
    tags: ['TypeScript', 'Next.js', 'PostgreSQL']
  },
  {
    slug: 'palabruno',
    title: 'Palabruno — From product scope to launch and handoff',
    description: 'Collaborated on scope and learner/teacher workflows, then delivered web and mobile applications, subscriptions, payments, and release documentation.',
    status: 'Historical launch and handoff',
    image: PalabrunoThumb,
    alt: 'Palabruno reading product for Spanish learners and teachers.',
    tags: ['TypeScript', 'React', 'React Native']
  },
  {
    slug: 'mucho-hangouts',
    title: 'Mucho Hangouts — Stabilizing a live product while delivery continued',
    description: 'Addressed messaging, authentication, and application-state failures in an existing product while providing technical direction and mentoring its developers.',
    status: 'Monthly engineering engagement · 2025',
    image: MuchoHangoutsThumb,
    alt: 'Mucho Hangouts social events product interface.',
    tags: ['TypeScript', 'React', 'Node.js']
  }
];

const scopingProjects = [
  {slug: 'casa-elaria', title: 'Casa Elaria — Purchase-intent test', description: 'A focused storefront built around the decision to invest in inventory.'},
  {slug: 'online-store-conversion-review', title: 'Skincare store — Conversion review', description: 'A shopping-journey assessment translated into a prioritized improvement plan.'}
];

const testimonials = [...allTestimonials].sort((a, b) => {
  const order = ['Michael Shackelford', 'Valentin Zach'];
  const rank = (name: string) => order.includes(name) ? order.indexOf(name) : order.length;
  return rank(a.name) - rank(b.name);
});

const experience = [
	{
		period: 'Mar 2024 — Present',
		role: 'Founder & Software Engineer — Client Consulting',
		company: 'HC Studio',
		companyHref: null,
		body: 'Deliver software directly for clients and founders, with engagements spanning discovery, scoping, implementation, production support, and handoff.',
		independentBody: 'I also build and operate BA Eventos, a conversational event-search product for Buenos Aires.',
		independentHighlights: [
			'Switchboard — Agentic system demo: Built a Python/FastAPI and LangGraph agent that investigates customer-change requests and proposes policy-checked changes for human approval; deployed on AWS using Step Functions, SQS, and DynamoDB.',
			'Casamo — Independent product: Built an AI product that helps digital nomads find and compare furnished accommodation on Airbnb and Booking.com, evaluating listings against their requirements using photos, amenities, and guest reviews, and highlighting trade-offs and questions to confirm before booking.'
		],
		additionalConsulting: [
			'Casa Elaria: Built a storefront that captured email interest at checkout without taking payment, enabling a purchase-intent test before inventory investment.',
			'JIEC Labs: Reviewed the shopping journey and delivered seven prioritized recommendations covering product discovery, product-page clarity, and mobile performance.'
		],
		clients: [
  {
    "name": "Desarmadero La Torre",
    "href": "/projects/desarmadero-la-torre/",
    "engagement": "Client software and operations prototype · 2025 — 2026",
    "highlights": [
      "Translated client discovery into a functional specification and an interactive SvelteKit operations prototype covering sales, payment release, dismantling assignments, and vehicle lookup.",
      "Built a parts catalog searchable by make, model, and year, with photos so customers could check stock before calling and staff could update listings, reducing phone inquiry volume."
    ],
    "tags": [
      "TypeScript",
      "SvelteKit",
      "Cloudflare D1"
    ]
  },
  {
    "name": "Genrupt",
    "href": "/projects/genrupt/",
    "engagement": "Contract AI Product Engineer · 2025 — 2026",
    "highlights": [
      "Built AI generation, listing preparation, and image editing workflows for Amazon sellers, including OCR and inpainting; worked alongside the founder to help support Genrupt’s first 200 paying customers.",
      "Built organization billing, shared credits, and recoverable generation jobs; used atomic PostgreSQL reservations to prevent credit overspending and provider-job reuse with idempotent settlement to prevent duplicate charges on retries.",
      "Connected external AI agents to market-analysis and Amazon-listing workflows through OAuth-authenticated MCP tools, with organization permissions and asynchronous results."
    ],
    "tags": [
      "TypeScript",
      "Next.js",
      "PostgreSQL"
    ]
  },
  {
    "name": "Palabruno",
    "href": "/projects/palabruno/",
    "engagement": "Contract AI Product Engineer · Mar — Apr 2026",
    "highlights": [
      "Worked with the founder to take a Spanish-reading prototype through launch on iOS, Android, and web, including learner and teacher workflows, Stripe and RevenueCat subscriptions, release documentation, and handoff.",
      "Built a reading pipeline combining linguistic rules with constrained LLM generation, with checks that learning cards matched the selected word or phrase, targeted regeneration of invalid cards, and regression tests."
    ],
    "tags": [
      "TypeScript",
      "React",
      "React Native / Expo"
    ]
  },
  {
    "name": "Mucho Hangouts",
    "href": "/projects/mucho-hangouts/",
    "engagement": "Fractional CTO · 2025",
    "highlights": [
      "Stabilized messaging, notifications, and sign-in in a live product by centralizing authentication and server state and fixing socket connection lifecycles, while feature delivery continued.",
      "Provided technical direction for a five-person team and mentored two junior developers through reviews, pairing, and reusable patterns."
    ],
    "tags": [
      "TypeScript",
      "React",
      "Node.js"
    ]
  }
]
	},
	{
		period: 'Nov 2021 — Feb 2024',
		role: 'Senior Frontend Engineer',
		company: 'LeagueApps, later via Nearsure',
		companyHref: 'https://www.leagueapps.com/',
		highlights: [
			'Modernized tournament scheduling with React on the company’s first migration team, helping establish shared frontend patterns and components.',
			'Built drag-and-drop scheduling with conflict checks to prevent double bookings, plus self-service reporting for tournament operators.'
		],
		tags: ['TypeScript', 'React', 'AG Grid']
	},
	{
		period: 'Jan 2019 — Oct 2021',
		role: 'Software Engineer',
		company: 'Capgemini',
		companyHref: 'https://www.capgemini.com/',
		highlights: [
			'Owned the reporting module and developed additional features for Disney Cruise Line’s crew management system, which handled scheduling, cabin assignments, and crew contracts.',
			'Built KPI dashboards for Cisco; maintained Java Spring Boot microservices for GE Aviation.'
		],
		tags: ['Java', 'Spring Boot', 'TypeScript', 'Angular', 'React']
	},
	{
		period: 'Nov 2017 — Nov 2018',
		role: 'Frontend Engineer',
		company: '8base',
		companyHref: 'https://www.8base.com/',
		highlights: [
			'Built Jira / GitLab CI/CD automation and refactored 20+ shared UI components into a reusable library.'
		],
		tags: ['JavaScript', 'GitLab', 'CI/CD']
	}
];


---

<BaseLayout
	title={title}
	description={description}
	socialTitle={socialTitle}
	socialDescription={socialDescription}
	jsonLd={homepageJsonLd}
	bodyClass='hc-home'
	showFooterCta={true}
	showFooter={false}
	footerCtaLocation='home_blog_footer'
>
	<div class='hc-home-shell'>
		<header class='hc-home-header'>
			<div class='hc-home-header__top'>
				<figure class='hc-home-header__portrait' transition:name='portrait'>
					<Image
						src={Portrait}
						alt='Hanif Carroll'
						loading='eager'
						widths={[176, 352]}
						sizes='88px'
					/>
				</figure>
				<h1 class='hc-home-header__name'><a href='/' transition:name='brand'>Hanif Carroll</a></h1>
				<p class='hc-home-header__role'>Forward Deployed Engineer</p>
				<p class='hc-home-header__intro'>
					I work directly with clients to understand their workflows, define a practical scope, and build the software that supports their work.
          <br /><br />My experience spans operations tools, integrations, production AI applications, and improving existing products.
          <br /><br />Available for fully remote roles and contracts with AI implementation agencies.
				</p>

				<nav class='hc-home-nav' aria-label='In-page jump links'>
					<ul>
						{navLinks.map((link) => (
							<li>
								<a href={link.href}>
									<span class='hc-home-nav__indicator' aria-hidden='true'></span>
									<span class='hc-home-nav__text'>{link.label}</span>
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>

			<div class='hc-home-header__footer' transition:name='rail-footer'>
				<div class='hc-home-header__actions'>
					<a class='hc-home-resume' href='/Hanif-Carroll-Resume.pdf' download='Hanif-Carroll-Resume.pdf' data-track-event='resume_downloaded' data-track-location='home_rail'>
						Resume
					</a>

					<a
						class='hc-home-inquiry'
						href={BOOK_CALL_URL}
						target='_blank'
						rel='noopener noreferrer'
						data-track-event='book_call_clicked'
						data-track-location='home_rail'
					>
						Discuss a role or engagement <svg viewBox='0 0 24 24' width='14' height='14' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M7 17L17 7'></path><path d='M7 7h10v10'></path></svg>
					</a>
				</div>

				<ul class='hc-home-social' aria-label='Social media'>
					<li>
						<a
							href='https://github.com/hanifcarroll'
							target='_blank'
							rel='noopener noreferrer'
							aria-label='GitHub (opens in a new tab)'
							title='GitHub'
						>
							<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22'></path></svg>
						</a>
					</li>
					<li>
						<a
							href='https://linkedin.com/in/hanifcarroll'
							target='_blank'
							rel='noopener noreferrer'
							aria-label='LinkedIn (opens in a new tab)'
							title='LinkedIn'
						>
							<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z'></path><rect x='2' y='9' width='4' height='12'></rect><circle cx='4' cy='4' r='2'></circle></svg>
						</a>
					</li>
					<li>
						<a
							href='https://x.com/hanifcarroll'
							target='_blank'
							rel='noopener noreferrer'
							aria-label='X, formerly Twitter (opens in a new tab)'
							title='X'
						>
							<svg viewBox='0 0 24 24' width='18' height='18' fill='currentColor' aria-hidden='true'><path d='M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'></path></svg>
						</a>
					</li>
					<li>
						<a
							href='https://www.threads.com/@hanifcarroll'
							target='_blank'
							rel='noopener noreferrer'
							aria-label='Threads (opens in a new tab)'
							title='Threads'
						>
							<svg viewBox='0 0 24 24' width='18' height='18' fill='currentColor' aria-hidden='true'><path d='M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221z'></path></svg>
						</a>
					</li>
					<li>
						<a href={EMAIL_URL} aria-label='Email' title='Email'>
							<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z'></path><polyline points='22,6 12,13 2,6'></polyline></svg>
						</a>
					</li>
				</ul>
			</div>
		</header>

		<main class='hc-home-main'>
			<section id='projects' class='hc-home-section' aria-label='Selected projects'>
				<div class='hc-home-section-label'>
					<h2 class='hc-home-section-title'>Client work</h2>
				</div>
				<div class='hc-home-section-body'>
					<ul class='hc-home-projects'>
						{projects.map((project) => (
							<li class='hc-home-project'>
								<a href={`/projects/${project.slug}/`}>
									<div class='hc-home-project__media'>
										<Image
											src={project.image}
											alt={project.alt}
											loading='lazy'
											widths={[400, 800, 1200]}
											sizes='(min-width: 1024px) 320px, (min-width: 640px) 38vw, calc(100vw - 3rem)'
										/>

									</div>
									<div class='hc-home-project__content'>
										<p class='hc-home-project__status'>{project.status}</p>
                  <h3>{project.title}</h3>
										<p>{project.description}</p>
										<ul class='hc-home-tags' aria-label='Technologies used'>
											{project.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
										</ul>
									</div>
								</a>
							</li>
						))}
					</ul>
					<a class='hc-home-archive-link' href='/projects/'>
						View more projects
						<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14'></path><path d='M12 5l7 7-7 7'></path></svg>
					</a>
				</div>
			</section>

      <section class='hc-home-section' aria-label='Scoping and diagnostic work'>
        <div class='hc-home-section-label'><h2 class='hc-home-section-title'>Scoping &amp; diagnostic work</h2></div>
        <div class='hc-home-section-body'>
          <ul class='hc-home-scoping'>
            {scopingProjects.map((project) => <li><a href={`/projects/${project.slug}/`}>{project.title}</a><p>{project.description}</p></li>)}
          </ul>
        </div>
      </section>

			<section
				class='hc-home-section hc-home-feedback'
				aria-labelledby='feedback-title'
				data-testimonial-slider
			>
				<div class='hc-home-section-label'>
					<h2 id='feedback-title' class='hc-home-section-title'>Feedback</h2>
				</div>
				<div class='hc-home-section-body'>
					<div
						class='hc-home-feedback__viewport'
						aria-live='polite'
						aria-atomic='true'
						data-testimonial-viewport
					>
						{testimonials.map((testimonial, index) => (
							<blockquote
								class:list={['hc-home-feedback__quote', index === 0 && 'is-active']}
								data-testimonial-slide={index}
								aria-hidden={index !== 0}
							>
								<p>{testimonial.quote}</p>
								<footer>
									<cite>
										<span class='hc-home-feedback__name'>{testimonial.name}</span>
										<span class='hc-home-feedback__role'>{testimonial.role}</span>
									</cite>
								</footer>
							</blockquote>
						))}
					</div>
					<div class='hc-home-feedback__controls' role='group' aria-label='Testimonial controls'>
						<button type='button' data-testimonial-prev aria-label='Previous testimonial'>
							Previous
						</button>
						<span class='hc-home-feedback__position' data-testimonial-position>1 / {testimonials.length}</span>
						<button type='button' data-testimonial-next aria-label='Next testimonial'>Next</button>
					</div>
				</div>
			</section>

			<section id='experience' class='hc-home-section' aria-label='Work experience'>
				<div class='hc-home-section-label'>
					<h2 class='hc-home-section-title'>Experience</h2>
				</div>
				<div class='hc-home-section-body'>
					<ol class='hc-home-experience'>
						{experience.map((job) => (
							<li class='hc-home-job'>
								<div class='hc-home-job__period'>{job.period}</div>
								<div class='hc-home-job__content'>
									<h3>
										{job.role} ·{' '}
										{job.companyHref ? (
											<a href={job.companyHref} target='_blank' rel='noopener noreferrer'>
												<span class='hc-home-job__company'>{job.company}</span>
												<svg viewBox='0 0 24 24' width='14' height='14' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M7 17L17 7'></path><path d='M7 7h10v10'></path></svg>
											</a>
										) : (
											<span class='hc-home-job__company'>{job.company}</span>
										)}
									</h3>
									{job.body && <p>{job.body}</p>}
									{job.highlights && <ul class='hc-home-job__highlights'>
										{job.highlights.map((highlight) => <li>{highlight}</li>)}
									</ul>}
									{job.clients?.map((client) => (
										<div class='hc-home-job__client'>
											<h4><a href={client.href}>{client.name}</a></h4>
											<p class='hc-home-job__period'>{client.engagement}</p>
											<ul class='hc-home-job__highlights'>
												{client.highlights.map((highlight) => <li>{highlight}</li>)}
											</ul>
											<ul class='hc-home-tags' aria-label={`${client.name} technologies`}>
												{client.tags.map((tag) => <li>{tag}</li>)}
											</ul>
										</div>
									))}
									{job.additionalConsulting && <div class='hc-home-job__client'>
										<h4>Additional consulting</h4>
										<ul class='hc-home-job__highlights'>
											{job.additionalConsulting.map((highlight) => <li>{highlight}</li>)}
										</ul>
									</div>}
									{job.independentHighlights && <div class='hc-home-job__client'>
										<h4>Independent products &amp; demos</h4>
										<ul class='hc-home-job__highlights'>
											{job.independentHighlights.map((highlight) => <li>{highlight}</li>)}
										</ul>
									</div>}
									{job.independentBody && <p class="hc-home-job__independent">{job.independentBody}</p>}
                  {job.tags && <ul class='hc-home-tags' aria-label='Technologies used'>
