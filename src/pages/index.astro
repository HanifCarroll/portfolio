---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Portrait from '../assets/img/hanif-author-portrait.jpg';
import FormattedDate from '../components/FormattedDate.astro';
import GenruptThumb from '../assets/img/projects/genrupt-mobile-feature.png';
import PalabrunoThumb from '../assets/img/projects/palabruno-founder-idea-launch.png';
import BaEventosThumb from '../assets/img/projects/ba-eventos-hero.png';
import CasamoThumb from '../assets/img/projects/casamo-imac.png';
import TranquilitySpaThumb from '../assets/img/projects/tranquility-spa-concierge/project-card-phones.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';
import '../styles/archive-shared.css';
import '../styles/home.css';

const title = 'Hanif Carroll | AI Product Engineer for B2B SaaS';
const description =
	'I build customer-facing products, internal tools, and AI workflows for B2B SaaS teams. Open to contract work.';
const socialTitle = 'Hanif Carroll, AI Product Engineer';
const socialDescription = 'I build and ship B2B SaaS products, internal tools, and AI workflows.';

const homepageJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		jobTitle: 'AI Product Engineer',
		description,
		sameAs: [
			'https://github.com/hanifcarroll',
			'https://linkedin.com/in/hanifcarroll',
			'https://x.com/hanifcarroll',
			'https://www.threads.com/@hanifcarroll'
		],
		knowsAbout: [
			'Product engineering',
			'Internal tools',
			'HubSpot integrations',
			'AI product features',
			'Contract engineering'
		]
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		description
	}
];

const navLinks = [
	{ href: '#projects', label: 'Projects' },
	{ href: '#experience', label: 'Experience' },
	{ href: '#about', label: 'About' },
	{ href: '#blog', label: 'Blog' }
];

const blogPosts = (await getCollection('blog', ({ data }) => !data.hidden))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const projects = [
	{
		slug: 'palabruno',
		title: 'Palabruno',
		description:
			"Took a founder's Spanish-reading idea to launch across web, iOS, and Android in six weeks — owning product, UX, and full-stack engineering for AI reading, teacher workflows, and subscription billing.",
		image: PalabrunoThumb,
		alt: 'Palabruno reading product for Spanish learners and teachers.',
		tags: ['React Native', 'Expo', 'TanStack Start', 'Supabase', 'Stripe', 'OpenAI']
	},
	{
		slug: 'genrupt',
		title: 'Genrupt',
		description:
			'Built the billing, credit accounting, background jobs, and agent workflows that moved Genrupt from an AI demo to dependable paid operations for its first 200 seller customers.',
		image: GenruptThumb,
		alt: 'Genrupt creative operations workspace for Amazon seller teams.',
		tags: ['Next.js', 'TypeScript', 'PostgreSQL', 'Stripe', 'OpenAI', 'MCP']
	},
	{
		slug: 'casamo',
		title: 'Casamo',
		description:
			'Built and launched an evidence-backed stay-audit product for remote workers, with Airbnb and Booking.com scans, saved reports, payments, usage limits, and analytics.',
		image: CasamoThumb,
		alt: 'Casamo stay audit product for remote workers.',
		tags: ['Rails', 'SvelteKit', 'PostgreSQL', 'Solid Queue', 'DeepSeek', 'Stripe']
	},
	{
		slug: 'ba-eventos',
		title: 'BA Eventos',
		description:
			'Built a live AI event-discovery product that turns fragmented Buenos Aires listings into grounded search across 1,250+ upcoming events, backed by 9,200+ event records and 1,500+ venues.',
		image: BaEventosThumb,
		alt: 'BA Eventos AI event discovery experience for Buenos Aires.',
		tags: ['SvelteKit', 'Svelte 5', 'TypeScript', 'PostgreSQL', 'Supabase', 'Semantic Search']
	},
	{
		slug: 'tranquility-spa-concierge',
		title: 'Tranquility Spa Concierge',
		description:
			'Built a guided booking and staff-operations prototype that carries each spa recommendation through scheduling, intake, the visit record, aftercare, and feedback.',
		image: TranquilitySpaThumb,
		alt: 'Tranquility Spa Concierge guest and staff workflow shown on mobile screens.',
		tags: ['SvelteKit', 'Typebot', 'DeepSeek', 'Make', 'Airtable', 'Cal.com']
	}
];

const experience = [
	{
		period: 'Mar 2024 — Present',
		role: 'Founder & AI Product Engineer',
		company: 'HC Studio',
		companyHref: null,
		body: 'Solo product studio building AI-powered web and mobile products for early-stage founders — owning discovery, MVP scoping, UX, full-stack build, billing, and launch. Scaled Genrupt to its first 200+ paying customers and took Palabruno from idea to live on the App Store, Google Play, and web.',
		tags: ['TypeScript', 'React', 'Next.js', 'React Native', 'OpenAI', 'Stripe']
	},
	{
		period: 'Nov 2021 — Feb 2024',
		role: 'Senior Front End Engineer',
		company: 'LeagueApps',
		companyHref: 'https://www.leagueapps.com/',
		body: 'Cut organizer scheduling time 45% with drag-and-drop calendar workflows and conflict detection, and optimized large reporting grids with virtualization to cut load and interaction lag by 70%.',
		tags: ['React', 'TypeScript', 'AG Grid']
	},
	{
		period: 'Jan 2019 — Oct 2021',
		role: 'Software Engineer',
		company: 'Capgemini',
		companyHref: 'https://www.capgemini.com/',
		body: "Led delivery of a reporting module for Disney Cruise Line's ship and crew management system, built executive KPI dashboards for Cisco, and cut automated test-suite runtime 60%.",
		tags: ['Java', 'Spring Boot', 'TypeScript', 'Angular', 'React']
	},
	{
		period: 'Nov 2017 — Nov 2018',
		role: 'Front End Engineer',
		company: '8base',
		companyHref: 'https://www.8base.com/',
		body: 'Built CI/CD scripting across Jira and GitLab to cut ticket close time 15%, and refactored 20+ shared UI components into a reusable library, reducing duplicate code by 30%.',
		tags: ['JavaScript', 'GitLab', 'CI/CD']
	}
];

const testimonials = [
	{
		name: 'Markis Zarate',
		role: 'Founder, Zarate Studios',
		quote:
			"He’s reliable, communicates great, and has a sharp technical mind. Whether handling complex builds, troubleshooting under pressure, or adapting to shifting priorities, he was dependable every step of the way."
	},
	{
		name: 'Sarah Hibner',
		role: 'Senior Product Designer, LeagueApps',
		quote:
			'He suggested design-to-engineering hand-off improvements to make our workflow more efficient, asked insightful follow-up questions during design reviews, and brought my Figma designs to life so we could deliver value to our users.'
	},
	{
		name: 'Joshua Hamer',
		role: 'JIEC Labs',
		quote:
			'Working with Hanif on my Shopify store was easy, he was always quick to respond, and he gave me great pro tips all along the way. I really liked how the process was organized and feel like I got great value from the project. I would definitely work with him again and would recommend him to anyone looking to improve their e-commerce site!'
	},
	{
		name: 'Monica Londoño',
		role: 'Co-founder, Punto de Partida',
		quote:
			'Hanif quickly understood our needs, both from a business and aesthetic perspective, and translated them into a clean, functional website in no time. His professionalism and data-driven approach made the entire process seamless. The result exceeded our expectations.'
	}
];
---

<BaseLayout
	title={title}
	description={description}
	socialTitle={socialTitle}
	socialDescription={socialDescription}
	jsonLd={homepageJsonLd}
	bodyClass='hc-home'
	showFooterCta={true}
	showFooter={false}
	footerCtaTitle='Have something to ship?'
	footerCtaBody="Tell me what you're building, and we'll work out the next step."
	footerCtaPrimaryLabel='Book a 30-minute call'
	footerCtaLocation='home_blog_footer'
>
	<div class='hc-home-shell'>
		<header class='hc-home-header'>
			<div class='hc-home-header__top'>
				<figure class='hc-home-header__portrait' transition:name='portrait'>
					<Image
						src={Portrait}
						alt='Hanif Carroll'
						loading='eager'
						widths={[176, 352]}
						sizes='88px'
					/>
				</figure>
				<h1 class='hc-home-header__name'><a href='/' transition:name='brand'>Hanif Carroll</a></h1>
				<p class='hc-home-header__role'>AI Product Engineer</p>
				<p class='hc-home-header__intro'>
					I build customer-facing products, internal tools, and AI workflows for B2B SaaS teams. Open
					to contract work.
				</p>

				<nav class='hc-home-nav' aria-label='In-page jump links'>
					<ul>
						{navLinks.map((link) => (
							<li>
								<a href={link.href}>
									<span class='hc-home-nav__indicator' aria-hidden='true'></span>
									<span class='hc-home-nav__text'>{link.label}</span>
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>

			<div class='hc-home-header__footer' transition:name='rail-footer'>
				<div class='hc-home-header__actions'>
					<a class='hc-home-resume' href='/resume' download='Hanif-Carroll-Resume.pdf' data-track-event='resume_downloaded' data-track-location='home_rail'>
						Download résumé
					</a>
					<a
						class='hc-home-inquiry'
						href={BOOK_CALL_URL}
						target='_blank'
						rel='noopener noreferrer'
						data-track-event='book_call_clicked'
						data-track-location='home_rail'
					>
						Book a call <svg viewBox='0 0 24 24' width='14' height='14' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M7 17L17 7'></path><path d='M7 7h10v10'></path></svg>
					</a>
				</div>

				<ul class='hc-home-social' aria-label='Social media'>
					<li>
						<a
							href='https://github.com/hanifcarroll'
							target='_blank'
							rel='noopener noreferrer'
							aria-label='GitHub (opens in a new tab)'
							title='GitHub'
						>
							<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22'></path></svg>
						</a>
					</li>
					<li>
						<a
							href='https://linkedin.com/in/hanifcarroll'
							target='_blank'
							rel='noopener noreferrer'
							aria-label='LinkedIn (opens in a new tab)'
							title='LinkedIn'
						>
							<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z'></path><rect x='2' y='9' width='4' height='12'></rect><circle cx='4' cy='4' r='2'></circle></svg>
						</a>
					</li>
					<li>
						<a
							href='https://x.com/hanifcarroll'
							target='_blank'
							rel='noopener noreferrer'
							aria-label='X, formerly Twitter (opens in a new tab)'
							title='X'
						>
							<svg viewBox='0 0 24 24' width='18' height='18' fill='currentColor' aria-hidden='true'><path d='M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'></path></svg>
						</a>
					</li>
					<li>
						<a
							href='https://www.threads.com/@hanifcarroll'
							target='_blank'
							rel='noopener noreferrer'
							aria-label='Threads (opens in a new tab)'
							title='Threads'
						>
							<svg viewBox='0 0 24 24' width='18' height='18' fill='currentColor' aria-hidden='true'><path d='M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221z'></path></svg>
						</a>
					</li>
					<li>
						<a href={EMAIL_URL} aria-label='Email' title='Email'>
							<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z'></path><polyline points='22,6 12,13 2,6'></polyline></svg>
						</a>
					</li>
				</ul>
			</div>
		</header>

		<main class='hc-home-main'>
			<section id='projects' class='hc-home-section' aria-label='Selected projects'>
				<div class='hc-home-section-label'>
					<h2 class='hc-home-section-title'>Projects</h2>
				</div>
				<div class='hc-home-section-body'>
					<ul class='hc-home-projects'>
						{projects.map((project) => (
							<li class='hc-home-project'>
								<a href={`/projects/${project.slug}/`}>
									<div class='hc-home-project__media'>
										<Image
											src={project.image}
											alt={project.alt}
											loading='lazy'
											widths={[400, 800, 1200]}
											sizes='(min-width: 1024px) 320px, (min-width: 640px) 38vw, calc(100vw - 3rem)'
										/>
									</div>
									<div class='hc-home-project__content'>
										<h3>{project.title}</h3>
										<p>{project.description}</p>
										<ul class='hc-home-tags' aria-label='Technologies used'>
											{project.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
										</ul>
									</div>
								</a>
							</li>
						))}
					</ul>
					<a class='hc-home-archive-link' href='/projects/'>
						View more projects
						<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14'></path><path d='M12 5l7 7-7 7'></path></svg>
					</a>
				</div>
			</section>

			<section
				class='hc-home-section hc-home-feedback'
				aria-labelledby='feedback-title'
				data-testimonial-slider
			>
				<div class='hc-home-section-label'>
					<h2 id='feedback-title' class='hc-home-section-title'>Feedback</h2>
				</div>
				<div class='hc-home-section-body'>
					<div class='hc-home-feedback__viewport' aria-live='polite' aria-atomic='true'>
						{testimonials.map((testimonial, index) => (
							<blockquote
								class:list={['hc-home-feedback__quote', index === 0 && 'is-active']}
								data-testimonial-slide={index}
								aria-hidden={index !== 0}
							>
								<p>{testimonial.quote}</p>
								<footer>
									<cite>
										<span class='hc-home-feedback__name'>{testimonial.name}</span>
										<span class='hc-home-feedback__role'>{testimonial.role}</span>
									</cite>
								</footer>
							</blockquote>
						))}
					</div>
					<div class='hc-home-feedback__controls' role='group' aria-label='Testimonial controls'>
						<button type='button' data-testimonial-prev aria-label='Previous testimonial'>
							Previous
						</button>
						<span class='hc-home-feedback__position' data-testimonial-position>1 / 4</span>
						<button type='button' data-testimonial-next aria-label='Next testimonial'>Next</button>
					</div>
				</div>
			</section>

			<section id='experience' class='hc-home-section' aria-label='Work experience'>
				<div class='hc-home-section-label'>
					<h2 class='hc-home-section-title'>Experience</h2>
				</div>
				<div class='hc-home-section-body'>
					<ol class='hc-home-experience'>
						{experience.map((job) => (
							<li class='hc-home-job'>
								<div class='hc-home-job__period'>{job.period}</div>
								<div class='hc-home-job__content'>
									<h3>
										{job.role} ·{' '}
										{job.companyHref ? (
											<a href={job.companyHref} target='_blank' rel='noopener noreferrer'>
												<span class='hc-home-job__company'>{job.company}</span>
												<svg viewBox='0 0 24 24' width='14' height='14' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M7 17L17 7'></path><path d='M7 7h10v10'></path></svg>
											</a>
										) : (
											<span class='hc-home-job__company'>{job.company}</span>
										)}
									</h3>
									<p>{job.body}</p>
									<ul class='hc-home-tags' aria-label='Technologies used'>
										{job.tags.map((tag) => (
											<li>{tag}</li>
										))}
									</ul>
								</div>
							</li>
						))}
					</ol>
					<a
						class='hc-home-experience-resume'
						href='/resume'
						download='Hanif-Carroll-Resume.pdf'
						data-track-event='resume_downloaded'
						data-track-location='experience_footer'
					>
						Download full résumé
					</a>
				</div>
			</section>

			<section id='about' class='hc-home-section' aria-label='About me'>
				<div class='hc-home-section-label'>
					<h2 class='hc-home-section-title'>About</h2>
				</div>
				<div class='hc-home-section-body'>
					<p>
						Hey, I’m Hanif. I’m an AI product engineer with eight years of experience building web,
						mobile, and AI products. After working at <a href='https://www.8base.com/' target='_blank' rel='noopener noreferrer'>8base</a>, <a href='https://www.capgemini.com/' target='_blank' rel='noopener noreferrer'>Capgemini</a>, and <a href='https://www.leagueapps.com/' target='_blank' rel='noopener noreferrer'>LeagueApps</a>, I now run HC Studio, where I turn ambiguous ideas into useful, production-ready
						software. Recent work includes helping <a href='/projects/genrupt/'>Genrupt</a> reach its first
						200 paying customers and taking <a href='/projects/palabruno/'>Palabruno</a> from concept to
						production across iOS, Android, and web.
					</p>
					<p>
						I got into programming after <em>Mr. Robot</em> inspired me to learn how to code. Outside of work,
						I like to <a href='https://www.youtube.com/shorts/sQZoQeXo53o' data-lifting-video-trigger><strong>lift weights</strong></a>, experiment with AI, and have merienda in cozy coffee shops.
					</p>
					<a class='hc-home-archive-link hc-home-about-notes' href='/notes/'>
						Read my notes
						<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14'></path><path d='M12 5l7 7-7 7'></path></svg>
					</a>
				</div>
			</section>

			<section id='blog' class='hc-home-section' aria-label='Latest writing'>
				<div class='hc-home-section-label'>
					<h2 class='hc-home-section-title'>Blog</h2>
				</div>
				<div class='hc-home-section-body'>
					<ol class='hc-home-blog'>
						{blogPosts.map((post) => (
							<li class='hc-home-blog-post'>
								<a class='hc-home-blog-post__link' href={`/blog/${post.id}/`}>
									<div class='hc-home-blog-post__meta'>
										<FormattedDate date={post.data.pubDate} />
									</div>
									<div class='hc-home-blog-post__body'>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</div>
								</a>
							</li>
						))}
					</ol>
					<a class='hc-home-blog-archive' href='/blog/'>
						View more blog posts
					</a>
				</div>
			</section>
		</main>
	</div>

	<dialog class='hc-home-video-modal' aria-label='Lifting weights video' data-lifting-video-modal>
		<div class='hc-home-video-modal__surface'>
			<form method='dialog'>
				<button class='hc-home-video-modal__close' type='submit' aria-label='Close video'>
					<svg viewBox='0 0 24 24' aria-hidden='true'><path d='m6 6 12 12M18 6 6 18'></path></svg>
				</button>
			</form>
			<iframe
				class='hc-home-video-modal__frame'
				title='Hanif Carroll lifting weights'
				allow='autoplay; encrypted-media; picture-in-picture'
				allowfullscreen
				data-lifting-video-frame
			></iframe>
		</div>
	</dialog>
</BaseLayout>

<script>
	const videoTrigger = document.querySelector<HTMLAnchorElement>('[data-lifting-video-trigger]')!;
	const videoModal = document.querySelector<HTMLDialogElement>('[data-lifting-video-modal]')!;
	const videoFrame = document.querySelector<HTMLIFrameElement>('[data-lifting-video-frame]')!;

	videoTrigger.addEventListener('click', (event) => {
		event.preventDefault();
		videoFrame.src = 'https://www.youtube-nocookie.com/embed/sQZoQeXo53o?autoplay=1';
		videoModal.showModal();
	});

	videoModal.addEventListener('close', () => {
		videoFrame.removeAttribute('src');
		videoTrigger.focus();
	});

	const testimonialSlider = document.querySelector<HTMLElement>('[data-testimonial-slider]');
	if (testimonialSlider) {
		const testimonialSlides = Array.from(
			testimonialSlider.querySelectorAll<HTMLElement>('[data-testimonial-slide]')
		);
		const testimonialPosition = testimonialSlider.querySelector<HTMLElement>('[data-testimonial-position]');
		const previousTestimonial = testimonialSlider.querySelector<HTMLButtonElement>('[data-testimonial-prev]');
		const nextTestimonial = testimonialSlider.querySelector<HTMLButtonElement>('[data-testimonial-next]');

		if (testimonialSlides.length && testimonialPosition && previousTestimonial && nextTestimonial) {
			let currentTestimonial = 0;

			const showTestimonial = (index: number) => {
				currentTestimonial = (index + testimonialSlides.length) % testimonialSlides.length;

				testimonialSlides.forEach((slide, slideIndex) => {
					const active = slideIndex === currentTestimonial;
					slide.classList.toggle('is-active', active);
					slide.setAttribute('aria-hidden', String(!active));
				});

				testimonialPosition.textContent = `${currentTestimonial + 1} / ${testimonialSlides.length}`;
			};

			previousTestimonial.addEventListener('click', () => showTestimonial(currentTestimonial - 1));
			nextTestimonial.addEventListener('click', () => showTestimonial(currentTestimonial + 1));

			testimonialSlider.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowLeft') {
					event.preventDefault();
					showTestimonial(currentTestimonial - 1);
				} else if (event.key === 'ArrowRight') {
					event.preventDefault();
					showTestimonial(currentTestimonial + 1);
				}
			});

			let touchStartX: number | null = null;
			let touchStartY: number | null = null;
			testimonialSlider.addEventListener(
				'touchstart',
				(event) => {
					const touch = event.changedTouches[0];
					if (!touch) return;
					touchStartX = touch.clientX;
					touchStartY = touch.clientY;
				},
				{ passive: true }
			);
			testimonialSlider.addEventListener(
				'touchend',
				(event) => {
					if (touchStartX === null || touchStartY === null) return;
					const touch = event.changedTouches[0];
					if (!touch) return;

					const deltaX = touch.clientX - touchStartX;
					const deltaY = touch.clientY - touchStartY;
					touchStartX = null;
					touchStartY = null;

					if (Math.abs(deltaX) < 48 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
					showTestimonial(currentTestimonial + (deltaX < 0 ? 1 : -1));
				},
				{ passive: true }
			);

			showTestimonial(0);
		}
	}

	const update = () => {
		const sections = document.querySelectorAll<HTMLElement>('.hc-home-main section[id]');
		const links = document.querySelectorAll<HTMLAnchorElement>('.hc-home-nav a');
		if (!sections.length || !links.length) return;

		const probe = window.scrollY + window.innerHeight * 0.35;
		let current = sections[0]?.id ?? 'projects';
		sections.forEach((section) => {
			if (section.offsetTop <= probe) current = section.id;
		});

		links.forEach((link) => {
			const active = link.getAttribute('href') === `#${current}`;
			link.classList.toggle('is-active', active);
			if (active) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		});
	};

	let ticking = false;
	const onScroll = () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			update();
			ticking = false;
		});
	};

	window.addEventListener('scroll', onScroll, { passive: true });
	document.addEventListener('astro:page-load', () => requestAnimationFrame(update));
</script>
