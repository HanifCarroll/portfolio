---
import { Image } from 'astro:assets';
import HeroBackdrop from '../assets/img/hero-editorial-backdrop-navy-yellow.png';
import HeroPortrait from '../assets/img/hanif-consulting-hero-cutout-facing-left.png';
import DesarmaderoOperations from '../assets/img/projects/desarmadero-operations-ventas.png';
import GenruptCreativeOperations from '../assets/img/projects/genrupt-creative-ops-photo.png';
import OneTuesdayDuel from '../assets/img/projects/one-tuesday-hero.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOK_CALL_URL } from '../consts';
import { serviceOfferList } from '../lib/service-offers';
import { testimonials } from '../lib/testimonials';
import '../styles/home.css';

const title = 'Hanif Carroll | Technical Consultant for Founder-Led Businesses';
const description = 'I help founder-led businesses find and fix difficult workflows through practical process changes, automation, and custom software.';

const homepageJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		jobTitle: 'Technical Consultant',
		description,
		affiliation: { '@type': 'Organization', name: 'HC Studio' },
		sameAs: ['https://github.com/hanifcarroll', 'https://linkedin.com/in/hanifcarroll', 'https://x.com/hanifcarroll'],
		knowsAbout: ['Business systems engineering', 'Workflow automation', 'Internal tools', 'AI-assisted operations', 'Product engineering']
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		description
	}
];

const featuredProjects = [
	{
		slug: 'desarmadero-operations-prototype',
		label: 'Client work',
		title: 'Desarmadero Operations',
		heading: 'A working operations prototype from one discovery call.',
		body: 'An auto-dismantling yard was running sales and fulfillment through paper sheets, WhatsApp, Excel, and memory. I turned the workflow into a PRD, functional specification, and role-based prototype the client could validate before committing to the full build.',
		image: DesarmaderoOperations,
		alt: 'Desarmadero operations prototype showing the counter sales workflow and live order summary.'
	},
	{
		slug: 'genrupt',
		label: 'Client work',
		title: 'Genrupt',
		heading: 'Making Genrupt ready for paying teams.',
		body: 'I helped build the billing, credit accounting, background jobs, and agent workflows that made Genrupt ready for paying teams and helped it support its first 200 paying customers.',
		image: GenruptCreativeOperations,
		alt: 'Genrupt creative operations workspace for Amazon seller teams.'
	},
	{
		slug: 'one-tuesday',
		label: 'Interactive piece',
		title: 'One Tuesday, Twice',
		heading: 'Feel the transformation instead of reading about it.',
		body: 'Most case studies ask you to take the change on faith. This one is a playable simulation: run the worst day at a fictional service company, build the six changes one at a time, then watch the same day run through the system.',
		image: OneTuesdayDuel,
		alt: 'The same Tuesday simulated twice: the old workflow forgets requests and fills with backlog while the new system clears the day.'
	}
];

const homepageServices = serviceOfferList.map((offer) => ({
	...offer,
	homepageSummary: {
		audit: 'Map one difficult workflow, find where it breaks down, and leave with a recommendation and first build plan.',
		systemsBuild: 'Design and build an internal tool, automation, dashboard, integration, or AI-assisted workflow around your team.',
		ongoing: 'Improve and support the systems your team relies on through an agreed set of technical priorities.'
	}[offer.key]
}));

const method = [
	{
		title: 'Understand the complete workflow',
		body: 'We trace each workflow from request to outcome: who is involved, which tools they use, where information changes hands, and where the process breaks down.'
	},
	{
		title: 'Choose the smallest useful change',
		body: 'The best fix may be a process change, better use of an existing tool, an automation, or custom software. We choose based on what the workflow needs.'
	},
	{
		title: 'Build, document, and hand it over',
		body: 'When software is the right fix, I build a focused version around your team. You keep the maps, software, documentation, and notes behind important decisions.'
	}
];

const faqs = [
	{
		question: 'Do I need a specification before we talk?',
		answer: "No. Start with the workflow that's causing delays, repeated effort, missed handoffs, or unreliable reporting. The first call is for understanding the problem and deciding whether an audit is the right next step."
	},
	{
		question: 'Does every audit lead to custom software?',
		answer: 'No. The recommendation may be a process change, better use of an existing tool, an automation, an integration, or custom software. The audit is meant to show which change is worth making first.'
	},
	{
		question: 'What do I receive from an audit?',
		answer: 'You receive a workflow map, findings and priorities, a recommended first step, and a practical first build plan. You can use them with your team, another partner, or me.'
	},
	{
		question: 'What does an audit cost?',
		answer: 'Audits start at $750. I confirm the price and schedule before the audit begins, based on the workflow, the people involved, and the material that needs to be reviewed.'
	}
];

const founderTestimonial = testimonials.markisZarate;
---

<BaseLayout
	title={title}
	description={description}
	jsonLd={homepageJsonLd}
	bodyClass='hc-home'
	footerCtaTitle="Tell me what's getting harder to run."
	footerCtaBody="You don't need a specification or a preferred tool. Start with the workflow that's causing delays, repeated effort, or confusion. We'll decide whether it needs an audit, a focused build, or a smaller first step."
	footerCtaPrimaryLabel='Book a 30-minute audit fit call'
	footerCtaLocation='home_footer_cta'
	footerCtaSurface='canvas'
>
	<article>
		<header class='hc-home-hero' data-motion-intro>
			<div class='hc-home-hero__inner'>
				<div class='hc-home-hero__copy'>
					<h1 class='hc-home-hero__title' aria-label='Find and fix the workflows slowing down your business' data-motion='headline'>
						<span>Find and fix</span> <span class='hc-home-hero__title-accent'>the workflows</span> <span>slowing down</span> <span>your business</span>
					</h1>
					<p class='hc-home-hero__lead' data-motion-deck>I help founder-led businesses find and fix repeated manual work, unreliable handoffs, and scattered information, then choose the smallest useful change.</p>
					<div class='hc-home-hero__actions'>
						<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location='home_hero' data-motion-intro-item>Book a 30-minute audit fit call</a>
						<a class='hc-home-hero__secondary' href='/case-studies/' data-motion-intro-item>See case studies</a>
					</div>
					<aside class='hc-home-hero__proof' aria-label='Selected client result' data-motion-intro-item>
						<p class='hc-home-hero__proof-label'>Selected client result</p>
						<p>Helped build Genrupt's billing, credit accounting, background jobs, and agent workflows as it grew to its first 200 paying customers.</p>
						<a class='hc-text-link' href='/case-studies/genrupt/'>View the Genrupt case study</a>
					</aside>
				</div>
				<figure class='hc-home-hero__portrait' data-motion-intro-item='media'>
					<Image class='hc-home-hero__backdrop-image' src={HeroBackdrop} alt='' aria-hidden='true' loading='eager' widths={[640, 960, 1122]} sizes='(max-width: 900px) 100vw, 53vw' quality={92} />
					<Image class='hc-home-hero__portrait-image' src={HeroPortrait} alt='Hanif Carroll looking toward the homepage introduction' loading='eager' widths={[640, 960, 1122]} sizes='(max-width: 900px) 100vw, 53vw' quality={95} />
				</figure>
			</div>
		</header>

		<section class='hc-section hc-recognition-section' data-motion-group>
			<div class='hc-container hc-recognition'>
				<div class='hc-recognition__copy' data-motion='reveal'>
					<h2 class='hc-recognition__title'>As the business grows, manual work gets <span>harder to manage.</span></h2>
					<p>The business is growing, but day-to-day operations are getting harder to run. Requests arrive through inboxes and chats. Important status lives in spreadsheets. Approvals depend on one person. Reporting means pulling information from several tools.</p>
				</div>

				<div class='hc-workflow-diagram' data-motion='sequence' role='img' aria-label='Requests from inbox and chat, spreadsheet status, and approval decisions all depend on one person before reporting can happen.'>
					<div class='hc-workflow-sources'>
						<div class='hc-workflow-source' data-motion-step>
							<svg viewBox='0 0 24 24' aria-hidden='true'><rect x='2.5' y='4.5' width='19' height='15' rx='2'></rect><path d='m3.5 6 8.5 7 8.5-7'></path></svg>
							<span>Inbox</span>
						</div>
						<div class='hc-workflow-source' data-motion-step>
							<svg viewBox='0 0 24 24' aria-hidden='true'><path d='M4.5 4.5h15a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-8l-4.5 3v-3H4.5a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z'></path><circle cx='8' cy='11' r='.7'></circle><circle cx='12' cy='11' r='.7'></circle><circle cx='16' cy='11' r='.7'></circle></svg>
							<span>Chat</span>
						</div>
					</div>

					<span class='hc-workflow-arrow' data-motion-step='draw' aria-hidden='true'>→</span>
					<div class='hc-workflow-node hc-workflow-node--requests' data-motion-step>
						<span>Requests</span>
						<svg viewBox='0 0 24 24' aria-hidden='true'><path d='M6 2.5h8l4 4v15H6z'></path><path d='M14 2.5v5h4M9 12h6M9 16h6'></path></svg>
					</div>

					<span class='hc-workflow-arrow' data-motion-step='draw' aria-hidden='true'>→</span>
					<div class='hc-workflow-bottleneck'>
						<div class='hc-workflow-input' data-motion-step>
							<svg viewBox='0 0 24 24' aria-hidden='true'><rect x='4' y='3' width='16' height='18' rx='1.5'></rect><path d='M4 8h16M4 13h16M4 18h16M10 3v18'></path></svg>
							<span>Spreadsheet status</span>
						</div>
						<span class='hc-workflow-arrow hc-workflow-arrow--down' data-motion-step='draw-down' aria-hidden='true'>↓</span>
						<div class='hc-workflow-node hc-workflow-node--person' data-motion-step data-motion-pulse>
							<svg viewBox='0 0 24 24' aria-hidden='true'><circle cx='12' cy='7.5' r='3.5'></circle><path d='M5.5 21v-3.5a5 5 0 0 1 5-5h3a5 5 0 0 1 5 5V21'></path></svg>
							<strong>One person</strong>
						</div>
						<span class='hc-workflow-arrow hc-workflow-arrow--up' data-motion-step='draw-up' aria-hidden='true'>↑</span>
						<div class='hc-workflow-input' data-motion-step>
							<svg viewBox='0 0 24 24' aria-hidden='true'><circle cx='12' cy='12' r='9'></circle><path d='m8 12 2.5 2.5L16.5 8.5'></path></svg>
							<span>Approval decisions</span>
						</div>
						<p class='hc-workflow-warning' data-motion-step><span aria-hidden='true'>!</span> Only they know what happens next.</p>
					</div>

					<span class='hc-workflow-arrow' data-motion-step='draw' aria-hidden='true'>→</span>
					<div class='hc-workflow-node hc-workflow-node--reporting' data-motion-step>
						<span>Reporting</span>
						<svg viewBox='0 0 24 24' aria-hidden='true'><path d='M4 21v-6h4v6M10 21V9h4v12M16 21V3h4v18'></path></svg>
					</div>
				</div>

				<p class='hc-recognition__close' data-motion-item>A clear look at the entire workflow can show you where to begin.</p>
			</div>
		</section>

		<section class='hc-section' id='services' data-motion-group>
			<div class='hc-container'>
				<div class='hc-section-header hc-services-header' data-motion='reveal'>
					<h2 class='hc-section-title'>Start with the problem. Build only when the next step is clear.</h2>
					<p class='hc-section-intro'>The Business Systems Audit is the recommended starting point when you can see the problem but aren't sure what will fix it. Build and ongoing support follow when the workflow and priorities are clear.</p>
				</div>
				<div class='hc-service-paths'>
					{homepageServices.map((offer, index) => <article class:list={['hc-service-path', { 'hc-service-path--starting-point': offer.key === 'audit' }]} data-motion-item><div class='hc-service-path__heading'><span aria-hidden='true'>{String(index + 1).padStart(2, '0')}</span><p>{offer.label}</p></div><h3>{offer.chooserHeading}</h3><p>{offer.homepageSummary}</p><p class='hc-service-path__note'>{offer.commercialNote}</p><a class='hc-service-path__cta' href={offer.path}>{offer.key === 'audit' ? 'See what the audit includes' : offer.chooserCta}<span aria-hidden='true'>→</span></a></article>)}
				</div>
				<div class='hc-home-decision-cta' data-motion-item>
					<div>
						<h3>Not sure which path fits?</h3>
						<p>Start with a 30-minute fit call. We'll talk through the workflow and decide whether an audit, a focused build, or a smaller first step makes sense.</p>
					</div>
					<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location='home_services'>Book a 30-minute audit fit call</a>
				</div>
			</div>
		</section>

		<section class='hc-proof-section hc-section' id='case-studies'>
			<div class='hc-container-wide hc-proof-section__header' data-motion-group>
				<div class='hc-section-header'>
					<h2 class='hc-section-title' data-motion='reveal'>See how difficult workflows became working systems.</h2>
					<p class='hc-section-intro' data-motion-item>Two client engagements from discovery and product decisions to software people could use — and one you can run yourself.</p>
				</div>
			</div>
			<div class='hc-proof-list'>
				{featuredProjects.map((project, index) => {
					const isDark = (featuredProjects.length - index) % 2 === 0;
					return <article class:list={['hc-proof-row', { 'hc-proof-row--dark': isDark }]} data-header-surface={isDark ? 'dark' : 'light'} data-motion-group data-motion-from={index % 2 === 0 ? 'left' : 'right'}><div class='hc-container-wide hc-proof-row__inner'><div class='hc-proof-copy' data-motion-item><p class='hc-proof-number' aria-hidden='true'>{String(index + 1).padStart(2, '0')}</p><p class='hc-proof-label'>{project.label}</p><h3>{project.heading}</h3><p>{project.body}</p><a class='hc-text-link' href={`/case-studies/${project.slug}/`}>View {project.title}</a></div><figure class='hc-proof-media' data-motion-item data-motion='parallax'><Image src={project.image} alt={project.alt} loading='lazy' format='webp' widths={[640, 960, 1536]} sizes='(max-width: 900px) 100vw, 66vw' quality={88} /></figure></div></article>;
				})}
			</div>
			<div class='hc-proof-section__actions' data-motion='reveal'><a class='hc-button' href='/case-studies/'>Explore all case studies</a></div>
		</section>

		<section class='hc-section hc-testimonial-section' data-motion-group>
			<div class='hc-container'>
				<div class='hc-section-header' data-motion='reveal'><h2 class='hc-section-title'>A founder's view of the working relationship.</h2></div>
				<figure class='hc-testimonial hc-testimonial--featured' data-motion-item><span class='hc-testimonial__mark' aria-hidden='true'>“</span><blockquote>{founderTestimonial.featuredText}<span class='hc-testimonial__closing-mark' aria-hidden='true'>”</span></blockquote><figcaption><strong>{founderTestimonial.name}</strong><span>{founderTestimonial.attribution}</span></figcaption></figure>
			</div>
		</section>

		<section class='hc-section hc-method-section' id='method' data-header-surface='dark' data-motion-group>
			<div class='hc-container'>
				<div class='hc-section-header' data-motion='reveal'><h2 class='hc-section-title'>What working together looks like.</h2><p class='hc-section-intro'>A simple path from understanding the workflow to a system your team can own.</p></div>
				<div class='hc-method-grid'>{method.map((item, index) => <div class='hc-method-item' data-motion-item><span class='hc-index'>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></div>)}</div>
				<div class='hc-home-faq' data-motion-item>
					<div class='hc-home-faq__heading'><h3>Questions before the first call.</h3><p>You can start with the workflow problem. You don't need to decide on software, scope, or a preferred tool first.</p></div>
					<div class='hc-home-faq__items'>{faqs.map((item) => <div class='hc-home-faq__item'><h4>{item.question}</h4><p>{item.answer}</p></div>)}</div>
				</div>
				<div class='hc-actions' data-motion-item><a class='hc-text-link' href='/services/business-systems-audit/'>See the Business Systems Audit</a></div>
			</div>
		</section>

	</article>
</BaseLayout>
