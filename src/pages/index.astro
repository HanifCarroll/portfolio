---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Portrait from '../assets/img/hanif-author-portrait.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjectImage } from '../lib/project-images';
import { projects } from '../lib/projects';
import { textLinkClass } from '../lib/ui';
import FormattedDate from '../components/FormattedDate.astro';
import HomeActions from '../components/home/HomeActions.astro';
import HomeSection from '../components/home/HomeSection.astro';
import '../styles/home.css';

const title = 'Websites, tools, and automations for small businesses | Hanif Carroll';
const description =
	'I help small businesses work better with technology, with websites, tools, and automations built around how they work. Based in Buenos Aires, working U.S. Eastern hours.';
const socialTitle = 'Hanif Carroll | Websites, tools, and automations for small businesses';
const socialDescription = 'I help small businesses work better with technology, from websites that bring in customers to automating the work a team does by hand.';
const homepageJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		jobTitle: 'Freelance Software Engineer',
		description,
		sameAs: [
			'https://github.com/hanifcarroll',
			'https://linkedin.com/in/hanifcarroll',
			'https://x.com/hanifcarroll',
			'https://www.threads.com/@hanifcarroll'
		],
		knowsAbout: [
			'Client discovery',
			'Workflow analysis',
			'Workflow automation',
			'Small business software',
			'Business process mapping',
			'Prototyping',
			'Website development',
			'Web app development',
			'Custom software',
			'AI features',
			'Internal tools',
			'Integrations',
			'TypeScript',
			'React',
			'Node.js',
			'Python'
		]
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		description
	}
];

const featuredPostIds = ['using-diagrams-to-review-an-ai-report-workflow', 'business-process-mapping-examples', 'spreadsheet-vs-database-internal-tool'];
const allPosts = await getCollection('blog', ({ data }) => !data.hidden);
const blogPosts = featuredPostIds.map((id) => allPosts.find((post) => post.id === id)).filter((post) => post !== undefined);

const help = [
	{
		title: 'A website that brings in customers',
		body: 'A new site, or changes so more visitors call, book, or buy.',
		icon: 'M3 5h18v14H3zM3 9h18m-14 5h4m-4 2h2'
	},
	{
		title: 'Work your team does by hand',
		body: 'Copying between apps or updating spreadsheets, automated or handled by tools you already pay for.',
		icon: 'M3 7h14m-4-4 4 4-4 4M21 17H7m4-4-4 4 4 4'
	},
	{
		title: 'Orders and bookings in WhatsApp',
		body: 'A simple system your team and customers can use instead of paper and chat threads.',
		icon: 'M3 5h18v12H9l-6 4zM7 9h10M7 13h6'
	}
];

const work = [
	{
		slug: 'desarmadero-la-torre', name: 'Desarmadero La Torre', label: 'Auto-parts yard',
		alt: 'Desarmadero La Torre’s online parts catalog.',
		body: 'A parts catalog customers search before they call. The owner came back to map sales and payments into a working prototype.'
	},
	{
		slug: 'online-store-conversion-review', name: 'JIEC Labs', label: 'Online store',
		alt: 'The online-store review prepared for JIEC Labs.',
		body: 'Seven fixes, in order, to make a skincare store easier to shop.'
	},
	{
		slug: 'casa-elaria', name: 'Casa Elaria', label: 'Beauty brand',
		alt: 'The Casa Elaria beauty storefront.',
		body: 'A storefront that tested demand before the brand bought inventory.'
	},
	{
		slug: 'maximo-interiorismo', name: 'Maximo Interiorismo', label: 'Interior designer',
		alt: 'Interiors featured on Maximo Interiorismo’s portfolio site.',
		body: 'A portfolio site for an interior designer.'
	}
];

const process = [
	{ title: '1. Tell me about it', body: 'By email or on a call.' },
	{ title: '2. Agree on a fix', body: 'I look at how the work happens now and suggest a fix with a clear scope and price.' },
	{ title: '3. I build it', body: 'Then I set it up with your team and show you how it works.' }
];

const apps = [
	{
		slug: 'palabruno', name: 'Palabruno',
		alt: 'Palabruno’s Spanish reader on desktop and mobile.',
		body: 'A Spanish-reading app launched on iOS, Android, and web in under two months.',
		tags: ['TypeScript', 'React Native']
	},
	{
		slug: 'genrupt', name: 'Genrupt',
		alt: 'Genrupt’s project grid for Amazon sellers.',
		body: 'AI tools and billing for a startup’s first 200 paying customers.',
		tags: ['Next.js', 'PostgreSQL']
	},
	{
		slug: 'ba-eventos', name: 'BA Eventos',
		alt: 'BA Eventos on a phone.',
		body: 'One search for Buenos Aires events, by mood, neighborhood, and time.',
		tags: ['SvelteKit', 'TypeScript']
	},
	{
		slug: 'casamo', name: 'Casamo',
		alt: 'Casamo’s homepage on a desktop display.',
		body: 'Checks Airbnb and Booking.com listings against what a traveler needs.',
		tags: ['SvelteKit', 'Cloudflare Workers']
	}
];

const feedback = [
	{
		quote: '“Hanif quickly understood our needs, both from a business and aesthetic perspective, and translated them into a clean, functional website in no time. The result exceeded our expectations.”',
		credit: 'Monica Londoño · Co-founder, Punto de Partida'
	},
	{
		quote: '“He is really organized and great at finding ways to make things more efficient. He is also a pleasure to work with!”',
		credit: 'Michael Shackelford · Founder & CEO, Genrupt'
	}
];
---

<BaseLayout
	title={title}
	description={description}
	socialTitle={socialTitle}
	socialDescription={socialDescription}
	jsonLd={homepageJsonLd}
	footerCtaLocation='home_blog_footer'
>
	<div class='home'>
		<section class='home-hero' data-section='hero' aria-labelledby='hero-title'>
			<div class='home-shell'>
				<div class='home-identity'>
					<Image class='home-portrait' data-visual src={Portrait} alt='' width={96} height={96} loading='eager' />
					<p><strong>Hanif Carroll</strong> · Freelance Software Engineer</p>
				</div>
				<h1 id='hero-title'>I help small businesses work better with technology.</h1>
				<p class='home-deck' data-deck>I build websites that bring in customers, tools that fit how you work, and automations for the tasks your team still does by hand.</p>
				<HomeActions location='home_hero' />
			</div>
		</section>

		<HomeSection name='help' title='Where I can help.' intro='Most small businesses lose time in the same few places.' points={help} />

		<HomeSection name='work' id='projects' title='Work for small businesses.' intro='Each project started with how the business runs today.'>
			<ul class='home-gallery' slot='visual' role='list'>
				{work.map((project, index) => (
					<li class:list={{ 'home-featured': index === 0 }}>
						<a class='home-card' href={`/projects/${project.slug}/`}>
							<div class='home-picture' data-visual>
								<Image src={getProjectImage(projects[project.slug], 'feature')} alt={project.alt} widths={index === 0 ? [400, 720, 1440] : [400, 720]} sizes={index === 0 ? '(min-width: 1200px) 700px, (min-width: 768px) 58vw, calc(100vw - 3rem)' : '(min-width: 1200px) 360px, (min-width: 768px) 30vw, calc(100vw - 3rem)'} />
							</div>
							<div class='home-card-copy'>
								<p class='home-label'>{project.label}</p>
								<h3>{project.name}</h3>
								<p>{project.body}</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</HomeSection>

		<section class='home-quote-band' data-section='quote' aria-label='Testimonial from JIEC Labs'>
			<div class='home-shell'>
				<figure>
					<blockquote><p>“I really liked how the process was organized and feel like I got great value from the project.”</p></blockquote>
					<figcaption>Joshua Hamer · JIEC Labs</figcaption>
				</figure>
				<HomeActions location='home_quote_band' />
			</div>
		</section>

		<HomeSection name='process' title='How we’d work together.' intro='You don’t need a project brief. One task is enough to start.' points={process} ordered />

		<HomeSection name='apps' title='I also build apps and products.' intro='I’ve built apps with founders, and I run two products of my own.'>
			<ul class='home-gallery home-apps' slot='visual' role='list'>
				{apps.map((app) => (
					<li>
						<a class='home-card' href={`/projects/${app.slug}/`}>
							<div class='home-picture' data-visual>
								<Image src={getProjectImage(projects[app.slug], 'feature')} alt={app.alt} widths={[400, 560, 1120]} sizes='(min-width: 1200px) 550px, (min-width: 768px) 46vw, calc(100vw - 3rem)' />
							</div>
							<div class='home-card-copy'>
								<h3>{app.name}</h3>
								<p>{app.body}</p>
								<ul class='home-tags' aria-label='Technologies used' role='list'>
									{app.tags.map((tag) => <li data-tech-tag>{tag}</li>)}
								</ul>
							</div>
						</a>
					</li>
				))}
			</ul>
			<p class='home-gallery-link'><a class={textLinkClass} href='/projects/'>See all projects</a></p>
		</HomeSection>

		<HomeSection name='feedback' title='What clients say.'>
			<div class='home-feedback'>
				{feedback.map(({ quote, credit }) => (
					<figure>
						<blockquote><p>{quote}</p></blockquote>
						<figcaption>{credit}</figcaption>
					</figure>
				))}
			</div>
		</HomeSection>

		<HomeSection name='about' title='About me.'>
			<div class='home-about'>
				<p>I’m Hanif, a freelance software engineer in Buenos Aires with 9+ years of experience. I worked at <a href='https://www.8base.com/' target='_blank' rel='noopener noreferrer'>8base</a>, <a href='https://www.capgemini.com/' target='_blank' rel='noopener noreferrer'>Capgemini</a>, and <a href='https://www.leagueapps.com/' target='_blank' rel='noopener noreferrer'>LeagueApps</a> before starting HC Studio. The part I enjoy most is learning how people actually work and figuring out together what’s worth building. Outside of work, I <a href='https://www.youtube.com/shorts/sQZoQeXo53o' data-lifting-video-trigger><strong>lift weights</strong></a> and look for cozy coffee shops for merienda.</p>
				<div class='home-about-links'>
					<a class={textLinkClass} href='/how-i-work/'>How I work</a>
					<a class={textLinkClass} href='/notes/'>Read my notes</a>
				</div>
			</div>
		</HomeSection>

		<HomeSection name='writing' id='blog' title='Writing.'>
			<ol class='home-writing' role='list'>
				{blogPosts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<h3>{post.data.title}</h3>
							<FormattedDate date={post.data.pubDate} />
						</a>
					</li>
				))}
			</ol>
			<p class='home-gallery-link'><a class={textLinkClass} href='/blog/'>More posts</a></p>
		</HomeSection>
	</div>

	<dialog class='hc-home-video-modal' aria-label='Lifting weights video' data-lifting-video-modal>
		<div class='hc-home-video-modal__surface'>
			<form method='dialog'>
				<button class='hc-home-video-modal__close' type='submit' aria-label='Close video'>
					<svg viewBox='0 0 24 24' aria-hidden='true'><path d='m6 6 12 12M18 6 6 18'></path></svg>
				</button>
			</form>
			<iframe class='hc-home-video-modal__frame' title='Hanif Carroll lifting weights' allow='autoplay; encrypted-media; picture-in-picture' allowfullscreen data-lifting-video-frame></iframe>
		</div>
	</dialog>
</BaseLayout>

<script>
	const videoTrigger = document.querySelector<HTMLAnchorElement>('[data-lifting-video-trigger]')!;
	const videoModal = document.querySelector<HTMLDialogElement>('[data-lifting-video-modal]')!;
	const videoFrame = document.querySelector<HTMLIFrameElement>('[data-lifting-video-frame]')!;

	videoTrigger.addEventListener('click', (event) => {
		event.preventDefault();
		videoFrame.src = 'https://www.youtube-nocookie.com/embed/sQZoQeXo53o?autoplay=1';
		videoModal.showModal();
	});

	videoModal.addEventListener('close', () => {
		videoFrame.removeAttribute('src');
		videoTrigger.focus();
	});
</script>
