---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Portrait from '../assets/img/hanif-hero-portrait.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';
import HomeProjects from '../components/home/HomeProjects.astro';
import HomeSection from '../components/home/HomeSection.astro';
import { jiecTestimonial } from '../data/testimonials';
import '../styles/home.css';

const title = 'Websites, tools, and automations for small businesses | Hanif Carroll';
const description =
	'I help small businesses work better with technology, with websites, tools, and automations built around how they work. Based in Buenos Aires, working U.S. Eastern hours.';
const socialTitle = 'Hanif Carroll | Websites, tools, and automations for small businesses';
const socialDescription = 'I help small businesses work better with technology, from websites that bring in customers to automating the work a team does by hand.';
const homepageJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		jobTitle: 'Freelance Software Engineer',
		description,
		sameAs: [
			'https://github.com/hanifcarroll',
			'https://linkedin.com/in/hanifcarroll',
			'https://x.com/hanifcarroll',
			'https://www.threads.com/@hanifcarroll'
		],
		knowsAbout: [
			'Client discovery',
			'Workflow analysis',
			'Workflow automation',
			'Small business software',
			'Business process mapping',
			'Prototyping',
			'Website development',
			'Web app development',
			'Custom software',
			'AI features',
			'Internal tools',
			'Integrations',
			'TypeScript',
			'React',
			'Node.js',
			'Python'
		]
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		description
	}
];

const featuredPostIds = ['using-diagrams-to-review-an-ai-report-workflow', 'business-process-mapping-examples', 'spreadsheet-vs-database-internal-tool'];
const allPosts = await getCollection('blog', ({ data }) => !data.hidden);
const blogPosts = featuredPostIds.map((id) => allPosts.find((post) => post.id === id)).filter((post) => post !== undefined);

const help = [
	{
		title: 'Websites',
		body: 'A new site, or changes to the one you have, so more visitors call, book, or buy.'
	},
	{
		title: 'Tools',
		body: 'Simple systems for orders, bookings, quotes, or inventory, instead of paper, spreadsheets, and WhatsApp threads.'
	},
	{
		title: 'Automations',
		body: 'Your apps and spreadsheets update each other on their own, often with tools you already pay for, so your team stops copying by hand.'
	}
];

const work = [
	{
		slug: 'desarmadero-la-torre', name: 'Desarmadero La Torre',
		alt: 'Desarmadero La Torre’s online parts catalog.',
		body: 'A parts catalog customers could search before calling. The owner came back to map sales and payments into a working prototype.'
	},
	{
		slug: 'online-store-conversion-review', name: 'JIEC Labs',
		alt: 'The online-store review prepared for JIEC Labs.',
		body: "A shopper's review of a skincare store, then the fixes the owner picked, built and launched."
	},
	{
		slug: 'sales-funnel-solo-coach', name: 'Solo coach',
		alt: 'The sales funnel planned for a solo coach.',
		body: "A step-by-step plan that connected a coach's posts, emails, and offers. A week later her courses were on sale."
	},
	{
		slug: 'casa-elaria', name: 'Casa Elaria',
		alt: 'The Casa Elaria beauty storefront.',
		body: 'A storefront that tested demand before the brand bought inventory.'
	},
	{
		slug: 'maximo-interiorismo', name: 'Maximo Interiorismo',
		alt: 'Interiors featured on Maximo Interiorismo’s portfolio site.',
		body: 'A portfolio site for an interior designer.'
	}
];

const process = [
	{ title: 'Tell me about it', body: 'By email or on a call.' },
	{ title: 'Agree on a fix', body: 'I look at how the work happens now and suggest a fix with a clear scope and price.' },
	{ title: 'I build it', body: 'Then I set it up with your team and show you how it works.' }
];

const apps = [
	{
		slug: 'palabruno', name: 'Palabruno',
		alt: 'Palabruno’s Spanish reader on desktop and mobile.',
		body: 'A Spanish-reading app launched on iOS, Android, and web in under two months.',
		tags: ['TypeScript', 'React Native']
	},
	{
		slug: 'genrupt', name: 'Genrupt',
		alt: 'Genrupt’s project grid for Amazon sellers.',
		body: 'AI tools and billing for a startup’s first 200 paying customers.',
		tags: ['Next.js', 'PostgreSQL']
	},
	{
		slug: 'ba-eventos', name: 'BA Eventos',
		alt: 'BA Eventos on a phone.',
		body: 'One search for Buenos Aires events, by mood, neighborhood, and time.',
		tags: ['SvelteKit', 'TypeScript']
	},
	{
		slug: 'casamo', name: 'Casamo',
		alt: 'Casamo’s homepage on a desktop display.',
		body: 'Checks Airbnb and Booking.com listings against what a traveler needs.',
		tags: ['SvelteKit', 'Cloudflare Workers']
	}
];

const feedback = [
	{ quote: `“${jiecTestimonial.quote}”`, credit: `${jiecTestimonial.name} · ${jiecTestimonial.role}` },
	{
		quote: '“Hanif quickly understood our needs, both from a business and aesthetic perspective, and translated them into a clean, functional website in no time. The result exceeded our expectations.”',
		credit: 'Monica Londoño · Co-founder, Punto de Partida'
	},
	{
		quote: '“He is really organized and great at finding ways to make things more efficient. He is also a pleasure to work with!”',
		credit: 'Michael Shackelford · Founder & CEO, Genrupt'
	}
];
---

<BaseLayout
	title={title}
	description={description}
	socialTitle={socialTitle}
	socialDescription={socialDescription}
	jsonLd={homepageJsonLd}
	footerCtaLocation='home_blog_footer'
>
	<div class='home'>
		<section class='home-hero' data-section='hero' aria-labelledby='hero-title'>
			<div class='home-shell'>
				<Image class='home-portrait' data-visual src={Portrait} alt='Hanif Carroll' width={132} height={165} densities={[1, 2, 3]} quality={90} fit='cover' loading='eager' />
				<p class='home-label'>Hanif Carroll · Freelance Software Engineer</p>
				<h1 id='hero-title'>I help small businesses <br />work <em>better</em> with technology</h1>
				<p class='home-deck' data-deck>I build websites that bring in customers, tools that fit how you work, and automations for the tasks your team still does by hand.</p>
				<div class='home-actions' data-cta>
					<a class='home-primary' href={EMAIL_URL} data-track-event='email_clicked' data-track-location='home_hero'>Email me about a problem</a>
					<a class='home-link' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location='home_hero'>Book a call</a>
				</div>
			</div>
		</section>

		<HomeSection name='help' title='What I build'>
			<ul class='home-points' role='list'>
				{help.map(({ title, body }, index) => (
					<li>
						<span class='home-label' aria-hidden='true'>{String(index + 1).padStart(2, '0')}</span>
						<h3>{title}</h3>
						<p>{body}</p>
					</li>
				))}
			</ul>
			<p class='home-more'>Not sure which you need? Tell me about a problem in your business, and I’ll suggest the simplest fix.</p>
		</HomeSection>

		<HomeSection name='work' id='projects' title='Work for small businesses'>
			<HomeProjects items={work} />
		</HomeSection>

		<HomeSection name='process' title='How we’d work together' intro='You can start with just one problem.'>
			<ol class='home-points' role='list'>
				{process.map(({ title, body }, index) => (
					<li>
						<span class='home-step' aria-hidden='true'>{index + 1}</span>
						<h3>{title}</h3>
						<p>{body}</p>
					</li>
				))}
			</ol>
		</HomeSection>

		<HomeSection name='apps' title='I also build apps and products' intro='I’ve built apps with founders, and I run two products of my own.'>
			<HomeProjects items={apps} />
			<p class='home-more'><a class='home-link' href='/projects/'>See all projects</a></p>
		</HomeSection>

		<HomeSection name='feedback' title='What clients say'>
			<div class='home-feedback'>
				{feedback.map(({ quote, credit }) => (
					<figure>
						<blockquote><p>{quote}</p></blockquote>
						<figcaption class='home-label'>{credit}</figcaption>
					</figure>
				))}
			</div>
		</HomeSection>

		<HomeSection name='about' title='About me'>
			<p>I’m Hanif, a freelance software engineer in Buenos Aires with 9+ years of experience. I worked at <a class='home-link' href='https://www.8base.com/' target='_blank' rel='noopener noreferrer'>8base</a>, <a class='home-link' href='https://www.capgemini.com/' target='_blank' rel='noopener noreferrer'>Capgemini</a>, and <a class='home-link' href='https://www.leagueapps.com/' target='_blank' rel='noopener noreferrer'>LeagueApps</a> before starting HC Studio. The part I enjoy most is learning how people actually work and figuring out together what’s worth building. Outside of work, I <a class='home-link' href='https://www.youtube.com/shorts/sQZoQeXo53o' data-lifting-video-trigger>lift weights</a> and look for cozy coffee shops for merienda.</p>
			<div class='home-more'>
				<a class='home-link' href='/how-i-work/'>How I work</a>
				<a class='home-link' href='/notes/'>Read my notes</a>
			</div>
		</HomeSection>

		<HomeSection name='writing' id='blog' title='Writing'>
			<ol class='home-writing' role='list'>
				{blogPosts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<h3>{post.data.title}</h3>
							<FormattedDate date={post.data.pubDate} />
						</a>
					</li>
				))}
			</ol>
			<p class='home-more'><a class='home-link' href='/blog/'>More posts</a></p>
		</HomeSection>
	</div>

	<dialog class='hc-home-video-modal' aria-label='Lifting weights video' data-lifting-video-modal>
		<div class='hc-home-video-modal__surface'>
			<form method='dialog'>
				<button class='hc-home-video-modal__close' type='submit' aria-label='Close video'>
					<svg viewBox='0 0 24 24' aria-hidden='true'><path d='m6 6 12 12M18 6 6 18'></path></svg>
				</button>
			</form>
			<iframe class='hc-home-video-modal__frame' title='Hanif Carroll lifting weights' allow='autoplay; encrypted-media; picture-in-picture' allowfullscreen data-lifting-video-frame></iframe>
		</div>
	</dialog>
</BaseLayout>

<script>
	const videoTrigger = document.querySelector<HTMLAnchorElement>('[data-lifting-video-trigger]')!;
	const videoModal = document.querySelector<HTMLDialogElement>('[data-lifting-video-modal]')!;
	const videoFrame = document.querySelector<HTMLIFrameElement>('[data-lifting-video-frame]')!;

	videoTrigger.addEventListener('click', (event) => {
		event.preventDefault();
		videoFrame.src = 'https://www.youtube-nocookie.com/embed/sQZoQeXo53o?autoplay=1';
		videoModal.showModal();
	});

	videoModal.addEventListener('close', () => {
		videoFrame.removeAttribute('src');
		videoTrigger.focus();
	});
</script>
