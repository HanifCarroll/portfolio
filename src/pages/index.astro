---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Portrait from '../assets/img/hanif-author-portrait.jpg';
import FormattedDate from '../components/FormattedDate.astro';
import GenruptThumb from '../assets/img/projects/genrupt-mobile-feature.png';
import PalabrunoThumb from '../assets/img/projects/palabruno-founder-idea-launch.png';
import DesarmaderoThumb from '../assets/img/projects/desarmadero-parts-stockroom-photo.png';
import { testimonials as allTestimonials } from '../data/testimonials';
import MuchoHangoutsThumb from '../assets/img/projects/mucho-hangouts-feature.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOK_CALL_URL } from '../consts';
import '../styles/home.css';

const title = 'Hanif Carroll | Forward Deployed Engineer';
const description =
	'Forward Deployed Engineer working directly with clients on discovery, workflow software, integrations, and production AI. Available for fully remote roles and contracts.';
const socialTitle = 'Hanif Carroll, Forward Deployed Engineer';
const socialDescription = 'Client discovery, workflow software, and production AI. Explore client engagements from scoping and prototypes to launch, support, and handoff.';

const homepageJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		jobTitle: 'Forward Deployed Engineer',
		description,
		sameAs: [
			'https://github.com/hanifcarroll',
			'https://linkedin.com/in/hanifcarroll',
			'https://x.com/hanifcarroll',
			'https://www.threads.com/@hanifcarroll'
		],
		knowsAbout: [
			'Client discovery',
			'Workflow analysis',
			'Business process mapping',
			'Prototyping',
			'Production AI applications',
			'LLM integrations',
			'Internal tools',
			'Integrations',
			'TypeScript',
			'React',
			'Node.js',
			'Python'
		]
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		description
	}
];

const blogPosts = (await getCollection('blog', ({ data }) => !data.hidden))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const projects = [
  {
    slug: 'desarmadero-la-torre',
    title: 'Desarmadero La Torre — From parts catalog to operations prototype',
    description: 'Built a searchable parts catalog, then translated a returning client’s sales, payment, and dismantling workflows into a specification and role-based prototype.',
    image: DesarmaderoThumb,
    alt: 'Automotive salvage inventory and the operating environment behind the client engagement.',
    tags: ['TypeScript', 'SvelteKit', 'Cloudflare D1']
  },
  {
    slug: 'genrupt',
    title: 'Genrupt — Building dependable AI seller workflows',
    description: 'Worked directly with the founder on AI seller workflows and the account permissions, billing, credits, and recoverable processing behind them.',
    image: GenruptThumb,
    alt: 'Genrupt creative operations workspace for Amazon seller teams.',
    tags: ['TypeScript', 'Next.js', 'PostgreSQL']
  },
  {
    slug: 'palabruno',
    title: 'Palabruno — From product scope to launch and handoff',
    description: 'Collaborated on scope and learner/teacher workflows, then delivered web and mobile applications, subscriptions, payments, and release documentation.',
    image: PalabrunoThumb,
    alt: 'Palabruno reading product for Spanish learners and teachers.',
    tags: ['TypeScript', 'React', 'React Native']
  },
  {
    slug: 'mucho-hangouts',
    title: 'Mucho Hangouts — Stabilizing a live product while delivery continued',
    description: 'Addressed messaging, authentication, and application-state failures in an existing product while providing technical direction and mentoring its developers.',
    image: MuchoHangoutsThumb,
    alt: 'Mucho Hangouts social events product interface.',
    tags: ['TypeScript', 'React', 'Node.js']
  }
];

const testimonials = [...allTestimonials].sort((a, b) => {
  const order = ['Michael Shackelford', 'Valentin Zach'];
  const rank = (name: string) => order.includes(name) ? order.indexOf(name) : order.length;
  return rank(a.name) - rank(b.name);
});

const experience = [
	{
		period: 'Mar 2024 — Present',
		role: 'Independent Software Engineer',
		company: 'HC Studio',
		companyHref: null,
		body: 'Deliver software directly for clients and founders, with engagements spanning discovery, scoping, implementation, production support, and handoff.',
		independentProject: {name: 'BA Eventos', href: '/projects/ba-eventos/', description: 'a conversational event-search product for Buenos Aires.'},
		independentHighlights: [
			{name: 'Switchboard', href: '/projects/switchboard/', description: ' — Agentic system demo: Built a Python/FastAPI and LangGraph agent that investigates customer-change requests and proposes policy-checked changes for human approval; deployed on AWS using Step Functions, SQS, and DynamoDB.'},
			{name: 'Casamo', href: '/projects/casamo/', description: ' — Independent product: Built an AI product that helps digital nomads find and compare furnished accommodation on Airbnb and Booking.com, evaluating listings against their requirements using photos, amenities, and guest reviews, and highlighting trade-offs and questions to confirm before booking.'}
		],
		additionalConsulting: [
			{name: 'Casa Elaria', href: '/projects/casa-elaria/', description: ': Built a storefront that captured email interest at checkout without taking payment, enabling a purchase-intent test before inventory investment.'},
			{name: 'JIEC Labs', href: '/projects/online-store-conversion-review/', description: ': Reviewed the shopping journey and delivered seven prioritized recommendations covering product discovery, product-page clarity, and mobile performance.'}
		],
		clients: [
  {
    "name": "Desarmadero La Torre",
    "href": "/projects/desarmadero-la-torre/",
    "engagement": "Client software and operations prototype · 2025 — 2026",
    "highlights": [
      "Translated client discovery into a functional specification and an interactive SvelteKit operations prototype covering sales, payment release, dismantling assignments, and vehicle lookup.",
      "Built a parts catalog searchable by make, model, and year, with photos so customers could check stock before calling and staff could update listings, reducing phone inquiry volume."
    ],
    "tags": [
      "TypeScript",
      "SvelteKit",
      "Cloudflare D1"
    ]
  },
  {
    "name": "Genrupt",
    "href": "/projects/genrupt/",
    "engagement": "Contract AI Product Engineer · 2025 — 2026",
    "highlights": [
      "Built AI generation, listing preparation, and image editing workflows for Amazon sellers, including OCR and inpainting; worked alongside the founder to help support Genrupt’s first 200 paying customers.",
      "Built organization billing, shared credits, and recoverable generation jobs; used atomic PostgreSQL reservations to prevent credit overspending and provider-job reuse with idempotent settlement to prevent duplicate charges on retries.",
      "Connected external AI agents to market-analysis and Amazon-listing workflows through OAuth-authenticated MCP tools, with organization permissions and asynchronous results."
    ],
    "tags": [
      "TypeScript",
      "Next.js",
      "PostgreSQL"
    ]
  },
  {
    "name": "Palabruno",
    "href": "/projects/palabruno/",
    "engagement": "Contract AI Product Engineer · Mar — Apr 2026",
    "highlights": [
      "Worked with the founder to take a Spanish-reading prototype through launch on iOS, Android, and web, including learner and teacher workflows, Stripe and RevenueCat subscriptions, release documentation, and handoff.",
      "Built a reading pipeline combining linguistic rules with constrained LLM generation, with checks that learning cards matched the selected word or phrase, targeted regeneration of invalid cards, and regression tests."
    ],
    "tags": [
      "TypeScript",
      "React",
      "React Native / Expo"
    ]
  },
  {
    "name": "Mucho Hangouts",
    "href": "/projects/mucho-hangouts/",
    "engagement": "Fractional CTO · 2025",
    "highlights": [
      "Stabilized messaging, notifications, and sign-in in a live product by centralizing authentication and server state and fixing socket connection lifecycles, while feature delivery continued.",
      "Provided technical direction for a five-person team and mentored two junior developers through reviews, pairing, and reusable patterns."
    ],
    "tags": [
      "TypeScript",
      "React",
      "Node.js"
    ]
  }
]
	},
	{
		period: 'Nov 2021 — Feb 2024',
		role: 'Senior Frontend Engineer',
		company: 'LeagueApps, later via Nearsure',
		companyHref: 'https://www.leagueapps.com/',
		highlights: [
			'Modernized tournament scheduling with React on the company’s first migration team, helping establish shared frontend patterns and components.',
			'Built drag-and-drop scheduling with conflict checks to prevent double bookings, plus self-service reporting for tournament operators.'
		],
		tags: ['TypeScript', 'React', 'AG Grid']
	},
	{
		period: 'Jan 2019 — Oct 2021',
		role: 'Software Engineer',
		company: 'Capgemini',
		companyHref: 'https://www.capgemini.com/',
		highlights: [
			'Owned the reporting module and developed additional features for Disney Cruise Line’s crew management system, which handled scheduling, cabin assignments, and crew contracts.',
			'Built KPI dashboards for Cisco; maintained Java Spring Boot microservices for GE Aviation.'
		],
		tags: ['Java', 'Spring Boot', 'TypeScript', 'Angular', 'React']
	},
	{
		period: 'Nov 2017 — Nov 2018',
		role: 'Frontend Engineer',
		company: '8base',
		companyHref: 'https://www.8base.com/',
		highlights: [
			'Built Jira / GitLab CI/CD automation and refactored 20+ shared UI components into a reusable library.'
		],
		tags: ['JavaScript', 'GitLab', 'CI/CD']
	}
];


const sectionClass = 'grid scroll-mt-24 gap-6 border-t border-rule py-16 lg:grid-cols-12 lg:gap-12 lg:py-24';
const labelClass = 'm-0 text-xs font-bold uppercase tracking-[0.07em] text-ink';
const bodyClass = 'min-w-0 lg:col-span-7';
const linkClass =
	'font-semibold text-ink underline decoration-accent/70 decoration-2 underline-offset-4 transition-colors hover:text-accent-ink hover:decoration-accent focus-visible:text-accent-ink';
const arrowLinkClass = `group inline-flex items-center gap-2 text-[0.95rem] ${linkClass}`;
---

<BaseLayout
	title={title}
	description={description}
	socialTitle={socialTitle}
	socialDescription={socialDescription}
	jsonLd={homepageJsonLd}
	bodyClass='hc-home'
	showFooterCta={true}
	footerCtaLocation='home_blog_footer'
>
	<div class='mx-auto w-full max-w-page px-6 md:px-12'>
		<section class='grid gap-14 pt-12 pb-16 lg:grid-cols-12 lg:gap-12 lg:pt-20 lg:pb-24' aria-label='Introduction'>
			<div class='lg:col-span-5'>
				<figure class='m-0 mb-6 size-22 overflow-hidden rounded-full bg-accent/20' transition:name='portrait'>
					<Image
						class='size-full object-cover'
						src={Portrait}
						alt='Hanif Carroll'
						loading='eager'
						widths={[176, 352]}
						sizes='88px'
					/>
				</figure>
				<h1 class='m-0 text-[clamp(2.25rem,4.5vw,3.25rem)] font-bold leading-[1.05] tracking-[-0.03em] text-ink'>Hanif Carroll</h1>
				<p class='mt-3 mb-0 text-lg font-medium text-ink'>Forward Deployed Engineer</p>
				<div class='mt-6 grid max-w-md gap-4 text-base leading-relaxed text-ink-muted'>
					<p class='m-0'>I learn how an organization works, figure out where software could help, and build it with the people who’ll use it.</p>
					<p class='m-0'>Recently, that’s meant turning a salvage yard’s sales and dismantling workflow into an operations prototype, building billing and AI workflows alongside Genrupt’s founder, and shaping Palabruno around what teachers and learners each needed.</p>
					<p class='m-0'>Available for fully remote roles and contracts working directly with clients.</p>
				</div>
				<div class='mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm'>
					<a class={linkClass} href='/Hanif-Carroll-Resume.pdf' download='Hanif-Carroll-Resume.pdf' data-track-event='resume_downloaded' data-track-location='home_hero'>
						Resume
					</a>
					<a
						class={`inline-flex items-center gap-1 ${linkClass}`}
						href={BOOK_CALL_URL}
						target='_blank'
						rel='noopener noreferrer'
						data-track-event='book_call_clicked'
						data-track-location='home_hero'
					>
						Discuss a role or engagement <svg viewBox='0 0 24 24' width='14' height='14' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M7 17L17 7'></path><path d='M7 7h10v10'></path></svg>
					</a>
				</div>
			</div>

			<div id='projects' class='min-w-0 scroll-mt-24 lg:col-span-7'>
				<h2 class={`${labelClass} mb-6`}>Client work</h2>
				<ul class='m-0 grid list-none gap-10 p-0'>
					{projects.map((project) => (
						<li>
							<a class='group grid gap-3 text-inherit no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:grid-cols-8 sm:gap-4' href={`/projects/${project.slug}/`}>
								<div class='sm:col-span-3'>
									<Image
										class='aspect-video w-full object-contain'
										src={project.image}
										alt={project.alt}
										loading='lazy'
										widths={[400, 800, 1200]}
										sizes='(min-width: 1024px) 260px, (min-width: 640px) 38vw, calc(100vw - 3rem)'
									/>
								</div>
								<div class='sm:col-span-5'>
									<h3 class='m-0 text-base font-medium leading-snug text-ink transition-colors group-hover:text-accent-ink group-focus-visible:text-accent-ink'>{project.title}</h3>
									<p class='mt-2 mb-0 text-sm leading-relaxed text-ink-muted'>{project.description}</p>
									<ul class='mt-3 mb-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0 text-xs text-ink-muted' aria-label='Technologies used'>
										{project.tags.slice(0, 3).map((tag) => <li class='after:ml-3 after:text-line after:content-["·"] last:after:content-none'>{tag}</li>)}
									</ul>
								</div>
							</a>
						</li>
					))}
				</ul>
				<a class={`${arrowLinkClass} mt-10`} href='/projects/'>
					View more projects
					<svg class='text-accent-ink transition-transform group-hover:translate-x-[3px] motion-reduce:transition-none' viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14'></path><path d='M12 5l7 7-7 7'></path></svg>
				</a>
			</div>
		</section>

		<section class={`${sectionClass} hc-home-feedback`} aria-labelledby='feedback-title' data-testimonial-slider>
			<div class='lg:col-span-5'>
				<h2 id='feedback-title' class={labelClass}>Feedback</h2>
			</div>
			<div class={bodyClass}>
				<div class='hc-home-feedback__viewport' aria-live='polite' aria-atomic='true' data-testimonial-viewport>
					{testimonials.map((testimonial, index) => (
						<blockquote
							class:list={['hc-home-feedback__quote', index === 0 && 'is-active']}
							data-testimonial-slide={index}
							aria-hidden={index !== 0}
						>
							<p class='m-0 text-[clamp(1rem,1.8vw,1.2rem)] leading-[1.7] text-ink'>{testimonial.quote}</p>
							<footer class='mt-6'>
								<cite class='grid gap-1 not-italic'>
									<span class='text-sm font-bold text-ink'>{testimonial.name}</span>
									<span class='text-xs text-ink-muted'>{testimonial.role}</span>
								</cite>
							</footer>
						</blockquote>
					))}
				</div>
				<div class='hc-home-feedback__controls mt-8 flex items-center justify-between gap-4' role='group' aria-label='Testimonial controls'>
					<button type='button' data-testimonial-prev aria-label='Previous testimonial'>Previous</button>
					<span class='text-xs tracking-[0.06em] text-ink-muted tabular-nums' data-testimonial-position>1 / {testimonials.length}</span>
					<button type='button' data-testimonial-next aria-label='Next testimonial'>Next</button>
				</div>
			</div>
		</section>

		<section id='experience' class={sectionClass} aria-labelledby='experience-title'>
			<div class='lg:col-span-5'>
				<h2 id='experience-title' class={labelClass}>Experience</h2>
			</div>
			<div class={bodyClass}>
				<ol class='m-0 grid list-none gap-12 p-0'>
					{experience.map((job) => (
						<li class='grid gap-2 sm:grid-cols-8 sm:gap-4'>
							<div class='text-xs font-semibold uppercase tracking-[0.06em] text-ink-muted sm:col-span-2 sm:mt-0.5'>{job.period}</div>
							<div class='hc-home-job__content sm:col-span-6'>
								<h3 class='m-0 flex flex-wrap items-baseline gap-1 text-base font-medium leading-snug text-ink'>
									{job.role} ·{' '}
									{job.companyHref ? (
										<a class='group inline-flex items-center gap-1 text-ink no-underline transition-colors hover:text-accent-ink' href={job.companyHref} target='_blank' rel='noopener noreferrer'>
											{job.company}
											<svg class='text-accent-ink transition-transform group-hover:translate-x-px group-hover:-translate-y-px' viewBox='0 0 24 24' width='14' height='14' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M7 17L17 7'></path><path d='M7 7h10v10'></path></svg>
										</a>
									) : (
										<span>{job.company}</span>
									)}
								</h3>
								{job.body && <p class='mt-2 mb-0 text-sm leading-relaxed text-ink-muted'>{job.body}</p>}
								{job.highlights && <ul class='hc-home-job__highlights'>
									{job.highlights.map((highlight) => <li>{highlight}</li>)}
								</ul>}
								{job.clients?.map((client) => (
									<div class='mt-6'>
										<h4 class='m-0 mb-0.5 text-[0.9375rem] font-medium text-ink-muted'><a class='text-inherit underline decoration-ink-muted/35 underline-offset-3 hover:text-accent-ink hover:decoration-current' href={client.href}>{client.name}</a></h4>
										<p class='m-0 text-xs text-ink-muted'>{client.engagement}</p>
										<ul class='hc-home-job__highlights'>
											{client.highlights.map((highlight) => <li>{highlight}</li>)}
										</ul>
										<ul class='m-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0 text-xs text-ink-muted' aria-label={`${client.name} technologies`}>
											{client.tags.map((tag) => <li class='after:ml-3 after:text-line after:content-["·"] last:after:content-none'>{tag}</li>)}
										</ul>
									</div>
								))}
								{job.additionalConsulting && <div class='mt-6'>
									<h4 class='m-0 text-[0.9375rem] font-medium text-ink-muted'>Additional consulting</h4>
									<ul class='hc-home-job__highlights'>
										{job.additionalConsulting.map((highlight) => <li><a href={highlight.href}>{highlight.name}</a>{highlight.description}</li>)}
									</ul>
								</div>}
								{job.independentHighlights && <div class='mt-6'>
									<h4 class='m-0 text-[0.9375rem] font-medium text-ink-muted'>Independent products &amp; demos</h4>
									<ul class='hc-home-job__highlights'>
										{job.independentHighlights.map((highlight) => <li><a href={highlight.href}>{highlight.name}</a>{highlight.description}</li>)}
									</ul>
								</div>}
								{job.independentProject && <p class='mt-2 mb-0 text-sm leading-relaxed text-ink-muted'>I also build and operate <a class={linkClass} href={job.independentProject.href}>{job.independentProject.name}</a>, {job.independentProject.description}</p>}
								{job.tags && <ul class='mt-3 mb-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0 text-xs text-ink-muted' aria-label='Technologies used'>
									{job.tags.map((tag) => <li class='after:ml-3 after:text-line after:content-["·"] last:after:content-none'>{tag}</li>)}
								</ul>}
							</div>
						</li>
					))}
				</ol>
				<a
					class={`mt-10 inline-block text-[0.95rem] ${linkClass}`}
					href='/Hanif-Carroll-Resume.pdf'
					download='Hanif-Carroll-Resume.pdf'
					data-track-event='resume_downloaded'
					data-track-location='experience_footer'
				>
					Resume
				</a>
			</div>
		</section>

		<section id='about' class={sectionClass} aria-labelledby='about-title'>
			<div class='lg:col-span-5'>
				<h2 id='about-title' class={labelClass}>About</h2>
			</div>
			<div class={`${bodyClass} hc-home-about grid gap-5 text-base leading-[1.7] text-ink-muted`}>
				<p class='m-0'>
					Hey, I’m Hanif. I’m a forward deployed engineer based in Buenos Aires. I got into programming after <em>Mr. Robot</em> inspired me to learn how to code. I now have 9+ years of experience. The part of the work I enjoy most is the conversations: learning how people actually work and figuring out together what’s worth building.
				</p>
				<p class='m-0'>
					After working at <a href='https://www.8base.com/' target='_blank' rel='noopener noreferrer'>8base</a>, <a href='https://www.capgemini.com/' target='_blank' rel='noopener noreferrer'>Capgemini</a>, and <a href='https://www.leagueapps.com/' target='_blank' rel='noopener noreferrer'>LeagueApps</a>, I now run HC Studio, where I work with founders and product teams to turn ambiguous ideas into useful, reliable software.
				</p>
				<p class='m-0'>
					My recent client work includes operational discovery and a prototype for <a href='/projects/desarmadero-la-torre/'>Desarmadero La Torre</a>. I also helped <a href='/projects/genrupt/'>Genrupt</a> support its first 200 paying customers and took <a href='/projects/palabruno/'>Palabruno</a> from an early prototype to launch across iOS, Android, and web.
				</p>
				<p class='m-0'>
					For the past three years, I’ve used coding agents to build software and complete workflows across websites and apps. My experience includes Cursor, Claude Code, Codex, and Pi. I’ve written about <a href='/how-i-work/'>how I work</a> and <a href='/blog/using-diagrams-to-review-an-ai-report-workflow/'>using agent-generated diagrams to review Casamo’s workflow</a>.
				</p>
				<p class='m-0'>
					I’m interested in sociotechnical systems: how organizations work, and how technology can be designed around human needs. I’m currently reading <em><a href='https://www.amazon.com/dp/3662565080' target='_blank' rel='noopener noreferrer'>Fundamentals of Business Process Management</a></em>, <em><a href='https://www.amazon.com/dp/1603580557' target='_blank' rel='noopener noreferrer'>Thinking in Systems</a></em>, and <em><a href='https://www.amazon.com/dp/0787994944' target='_blank' rel='noopener noreferrer'>Designing Your Organization</a></em> to deepen my understanding of processes, systems, and organizational design.
				</p>
				<p class='m-0'>
					Outside of work, I like to <a href='https://www.youtube.com/shorts/sQZoQeXo53o' data-lifting-video-trigger><strong>lift weights</strong></a>, experiment with AI, and have merienda in cozy coffee shops.
				</p>
				<a class={`${arrowLinkClass} mt-2 justify-self-start`} href='/notes/'>
					Read my notes
					<svg class='text-accent-ink transition-transform group-hover:translate-x-[3px] motion-reduce:transition-none' viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14'></path><path d='M12 5l7 7-7 7'></path></svg>
				</a>
			</div>
		</section>

		<section id='blog' class={sectionClass} aria-labelledby='blog-title'>
			<div class='lg:col-span-5'>
				<h2 id='blog-title' class={labelClass}>Blog</h2>
			</div>
			<div class={bodyClass}>
				<ol class='m-0 grid list-none gap-9 p-0'>
					{blogPosts.map((post) => (
						<li>
							<a class='group grid gap-2 text-inherit no-underline sm:grid-cols-8 sm:gap-4' href={`/blog/${post.id}/`}>
								<div class='text-xs font-semibold uppercase tracking-[0.06em] text-ink-muted sm:col-span-2 sm:mt-0.5'>
									<FormattedDate date={post.data.pubDate} />
								</div>
								<div class='sm:col-span-6'>
									<h3 class='m-0 text-base font-medium leading-snug text-ink transition-colors group-hover:text-accent-ink'>{post.data.title}</h3>
									<p class='mt-2 mb-0 text-sm leading-relaxed text-ink-muted'>{post.data.description}</p>
								</div>
							</a>
						</li>
					))}
				</ol>
				<a class={`mt-10 inline-block text-[0.95rem] ${linkClass}`} href='/blog/'>View more blog posts</a>
			</div>
		</section>
	</div>

	<dialog class='hc-home-video-modal' aria-label='Lifting weights video' data-lifting-video-modal>
		<div class='hc-home-video-modal__surface'>
			<form method='dialog'>
				<button class='hc-home-video-modal__close' type='submit' aria-label='Close video'>
					<svg viewBox='0 0 24 24' aria-hidden='true'><path d='m6 6 12 12M18 6 6 18'></path></svg>
				</button>
			</form>
			<iframe
				class='hc-home-video-modal__frame'
				title='Hanif Carroll lifting weights'
				allow='autoplay; encrypted-media; picture-in-picture'
				allowfullscreen
				data-lifting-video-frame
			></iframe>
		</div>
	</dialog>
</BaseLayout>

<script>
	const videoTrigger = document.querySelector<HTMLAnchorElement>('[data-lifting-video-trigger]')!;
	const videoModal = document.querySelector<HTMLDialogElement>('[data-lifting-video-modal]')!;
	const videoFrame = document.querySelector<HTMLIFrameElement>('[data-lifting-video-frame]')!;

	videoTrigger.addEventListener('click', (event) => {
		event.preventDefault();
		videoFrame.src = 'https://www.youtube-nocookie.com/embed/sQZoQeXo53o?autoplay=1';
		videoModal.showModal();
	});

	videoModal.addEventListener('close', () => {
		videoFrame.removeAttribute('src');
		videoTrigger.focus();
	});

	const testimonialSlider = document.querySelector<HTMLElement>('[data-testimonial-slider]');
	if (testimonialSlider) {
		const testimonialSlides = Array.from(
			testimonialSlider.querySelectorAll<HTMLElement>('[data-testimonial-slide]')
		);
		const testimonialPosition = testimonialSlider.querySelector<HTMLElement>('[data-testimonial-position]');
		const testimonialViewport = testimonialSlider.querySelector<HTMLElement>('[data-testimonial-viewport]');
		const previousTestimonial = testimonialSlider.querySelector<HTMLButtonElement>('[data-testimonial-prev]');
		const nextTestimonial = testimonialSlider.querySelector<HTMLButtonElement>('[data-testimonial-next]');

		if (
			testimonialSlides.length &&
			testimonialPosition &&
			testimonialViewport &&
			previousTestimonial &&
			nextTestimonial
		) {
			let currentTestimonial = 0;
			const updateRuleHeight = () => {
				const activeSlide = testimonialSlides[currentTestimonial];
				if (activeSlide) {
					testimonialViewport.style.setProperty(
						'--hc-feedback-rule-height',
						`${activeSlide.offsetHeight}px`
					);
				}
			};

			const showTestimonial = (index: number) => {
				currentTestimonial = (index + testimonialSlides.length) % testimonialSlides.length;

				testimonialSlides.forEach((slide, slideIndex) => {
					const active = slideIndex === currentTestimonial;
					slide.classList.toggle('is-active', active);
					slide.setAttribute('aria-hidden', String(!active));
				});

				testimonialPosition.textContent = `${currentTestimonial + 1} / ${testimonialSlides.length}`;
				updateRuleHeight();
			};

			previousTestimonial.addEventListener('click', () => showTestimonial(currentTestimonial - 1));
			nextTestimonial.addEventListener('click', () => showTestimonial(currentTestimonial + 1));

			testimonialSlider.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowLeft') {
					event.preventDefault();
					showTestimonial(currentTestimonial - 1);
				} else if (event.key === 'ArrowRight') {
					event.preventDefault();
					showTestimonial(currentTestimonial + 1);
				}
			});

			let touchStartX: number | null = null;
			let touchStartY: number | null = null;
			testimonialSlider.addEventListener(
				'touchstart',
				(event) => {
					const touch = event.changedTouches[0];
					if (!touch) return;
					touchStartX = touch.clientX;
					touchStartY = touch.clientY;
				},
				{ passive: true }
			);
			testimonialSlider.addEventListener(
				'touchend',
				(event) => {
					if (touchStartX === null || touchStartY === null) return;
					const touch = event.changedTouches[0];
					if (!touch) return;

					const deltaX = touch.clientX - touchStartX;
					const deltaY = touch.clientY - touchStartY;
					touchStartX = null;
					touchStartY = null;

					if (Math.abs(deltaX) < 48 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
					showTestimonial(currentTestimonial + (deltaX < 0 ? 1 : -1));
				},
				{ passive: true }
			);

			showTestimonial(0);
			testimonialSlider.classList.add('is-enhanced');
			new ResizeObserver(updateRuleHeight).observe(testimonialViewport);
		}
	}
</script>
