---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Portrait from '../assets/img/hanif-author-portrait.jpg';
import FormattedDate from '../components/FormattedDate.astro';
import GenruptThumb from '../assets/img/projects/genrupt-mobile-feature.png';
import PalabrunoThumb from '../assets/img/projects/palabruno-founder-idea-launch.png';
import DesarmaderoThumb from '../assets/img/projects/desarmadero-parts-stockroom-photo.png';
import { testimonials as allTestimonials } from '../data/testimonials';
import MuchoHangoutsThumb from '../assets/img/projects/mucho-hangouts-feature.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';
import '../styles/home.css';

const title = 'Hanif Carroll | Freelance Software Engineer';
const description =
	'Freelance software engineer building websites, web apps, and custom tools for businesses, founders, and agencies. Based in Buenos Aires, working U.S. Eastern hours.';
const socialTitle = 'Hanif Carroll, Freelance Software Engineer';
const socialDescription = 'Websites, web apps, and custom tools for businesses, founders, and agencies. See client projects from the first call through launch and handoff.';

const homepageJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		jobTitle: 'Freelance Software Engineer',
		description,
		sameAs: [
			'https://github.com/hanifcarroll',
			'https://linkedin.com/in/hanifcarroll',
			'https://x.com/hanifcarroll',
			'https://www.threads.com/@hanifcarroll'
		],
		knowsAbout: [
			'Client discovery',
			'Workflow analysis',
			'Business process mapping',
			'Prototyping',
			'Website development',
			'Web app development',
			'Custom software',
			'AI features',
			'Internal tools',
			'Integrations',
			'TypeScript',
			'React',
			'Node.js',
			'Python'
		]
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		description
	}
];

// Hand-picked for the homepage: posts closest to how I work with clients.
const featuredPostIds = ['using-diagrams-to-review-an-ai-report-workflow', 'business-process-mapping-examples', 'spreadsheet-vs-database-internal-tool'];
const allPosts = await getCollection('blog', ({ data }) => !data.hidden);
const blogPosts = featuredPostIds.map((id) => allPosts.find((post) => post.id === id)).filter((post) => post !== undefined);

const projects = [
  {
    slug: 'desarmadero-la-torre',
    title: 'Desarmadero La Torre — From parts catalog to operations prototype',
    description: 'Built a searchable parts catalog, then translated a returning client’s sales, payment, and dismantling workflows into a specification and role-based prototype.',
    image: DesarmaderoThumb,
    alt: 'Automotive salvage inventory and the operating environment behind the client engagement.',
    tags: ['TypeScript', 'SvelteKit', 'Cloudflare D1']
  },
  {
    slug: 'genrupt',
    title: 'Genrupt — Building dependable AI seller workflows',
    description: 'Worked directly with the founder on AI seller workflows and the account permissions, billing, credits, and recoverable processing behind them.',
    image: GenruptThumb,
    alt: 'Genrupt creative operations workspace for Amazon seller teams.',
    tags: ['TypeScript', 'Next.js', 'PostgreSQL']
  },
  {
    slug: 'palabruno',
    title: 'Palabruno — From product scope to launch and handoff',
    description: 'Collaborated on scope and learner/teacher workflows, then delivered web and mobile applications, subscriptions, payments, and release documentation.',
    image: PalabrunoThumb,
    alt: 'Palabruno reading product for Spanish learners and teachers.',
    tags: ['TypeScript', 'React', 'React Native']
  },
  {
    slug: 'mucho-hangouts',
    title: 'Mucho Hangouts — Stabilizing a live product while delivery continued',
    description: 'Addressed messaging, authentication, and application-state failures in an existing product while providing technical direction and mentoring its developers.',
    image: MuchoHangoutsThumb,
    alt: 'Mucho Hangouts social events product interface.',
    tags: ['TypeScript', 'React', 'Node.js']
  }
];

const byName = (name: string) => allTestimonials.find((testimonial) => testimonial.name === name)!;
const heroTestimonial = byName('Michael Shackelford');
const feedback = ['Valentin Zach', 'Markis Zarate', 'Sarah Hibner'].map(byName);

const experience = [
	{
		period: 'Mar 2024 — Present',
		role: 'Freelance Software Engineer',
		company: 'HC Studio',
		companyHref: null,
		body: 'Build websites, web apps, and custom tools for businesses, founders, and agencies, from discovery and scoping through launch, support, and handoff.',
		independentProject: {name: 'BA Eventos', href: '/projects/ba-eventos/', description: 'a conversational event-search product for Buenos Aires.'},
		independentHighlights: [
			{name: 'Switchboard', href: '/projects/switchboard/', description: ' — Agentic system demo: Built a Python/FastAPI and LangGraph agent that investigates customer-change requests and proposes policy-checked changes for human approval; deployed on AWS using Step Functions, SQS, and DynamoDB.'},
			{name: 'Casamo', href: '/projects/casamo/', description: ' — Independent product: Built an AI product that helps digital nomads find and compare furnished accommodation on Airbnb and Booking.com, evaluating listings against their requirements using photos, amenities, and guest reviews, and highlighting trade-offs and questions to confirm before booking.'}
		],
		additionalConsulting: [
			{name: 'Casa Elaria', href: '/projects/casa-elaria/', description: ': Built a storefront that captured email interest at checkout without taking payment, enabling a purchase-intent test before inventory investment.'},
			{name: 'JIEC Labs', href: '/projects/online-store-conversion-review/', description: ': Reviewed the shopping journey and delivered seven prioritized recommendations covering product discovery, product-page clarity, and mobile performance.'}
		],
		clients: [
			{name: 'Desarmadero La Torre', href: '/projects/desarmadero-la-torre/', engagement: 'Contract engineer · 2025 — 2026', summary: 'Built a parts catalog customers search before calling, then turned the sales, payment, and dismantling workflow into an operations prototype.'},
			{name: 'Genrupt', href: '/projects/genrupt/', engagement: 'Contract engineer · 2025 — 2026', summary: 'Built AI seller workflows, billing, and shared credits, and helped support its first 200 paying customers.'},
			{name: 'Palabruno', href: '/projects/palabruno/', engagement: 'Contract engineer · Mar — Apr 2026', summary: 'Took a Spanish-reading prototype to launch on iOS, Android, and web, then handed it off.'},
			{name: 'Mucho Hangouts', href: '/projects/mucho-hangouts/', engagement: 'Contract technical lead · 2025', summary: 'Stabilized messaging and sign-in in a live product while guiding a five-person team.'}
		]
	},
	{
		period: 'Nov 2021 — Feb 2024',
		role: 'Senior Frontend Engineer',
		company: 'LeagueApps, later via Nearsure',
		companyHref: 'https://www.leagueapps.com/',
		highlights: [
			'Modernized tournament scheduling with React on the company’s first migration team, helping establish shared frontend patterns and components.',
			'Built drag-and-drop scheduling with conflict checks to prevent double bookings, plus self-service reporting for tournament operators.'
		],
		tags: ['TypeScript', 'React', 'AG Grid']
	},
	{
		period: 'Jan 2019 — Oct 2021',
		role: 'Software Engineer',
		company: 'Capgemini',
		companyHref: 'https://www.capgemini.com/',
		highlights: [
			'Owned the reporting module and developed additional features for Disney Cruise Line’s crew management system, which handled scheduling, cabin assignments, and crew contracts.',
			'Built KPI dashboards for Cisco; maintained Java Spring Boot microservices for GE Aviation.'
		],
		tags: ['Java', 'Spring Boot', 'TypeScript', 'Angular', 'React']
	},
	{
		period: 'Nov 2017 — Nov 2018',
		role: 'Frontend Engineer',
		company: '8base',
		companyHref: 'https://www.8base.com/',
		highlights: [
			'Built Jira / GitLab CI/CD automation and refactored 20+ shared UI components into a reusable library.'
		],
		tags: ['JavaScript', 'GitLab', 'CI/CD']
	}
];


const sectionClass = 'grid scroll-mt-24 gap-6 border-t border-rule py-16 lg:grid-cols-12 lg:gap-12 lg:py-24';
const labelClass = 'm-0 text-xs font-bold uppercase tracking-[0.07em] text-ink';
const bodyClass = 'min-w-0 lg:col-span-7';
const linkClass =
	'font-semibold text-ink underline decoration-accent/70 decoration-2 underline-offset-4 transition-colors hover:text-accent-ink hover:decoration-accent focus-visible:text-accent-ink';
const arrowLinkClass = `group inline-flex items-center gap-2 text-[0.95rem] ${linkClass}`;
---

<BaseLayout
	title={title}
	description={description}
	socialTitle={socialTitle}
	socialDescription={socialDescription}
	jsonLd={homepageJsonLd}
	bodyClass='hc-home'
	showFooterCta={true}
	footerCtaLocation='home_blog_footer'
>
	<div class='mx-auto w-full max-w-page px-6 md:px-12'>
		<section class='grid gap-14 pt-12 pb-16 lg:grid-cols-12 lg:gap-12 lg:pt-20 lg:pb-24' aria-label='Introduction'>
			<div class='lg:col-span-5'>
				<figure class='m-0 mb-6 size-22 overflow-hidden rounded-full bg-accent/20' transition:name='portrait'>
					<Image
						class='size-full object-cover'
						src={Portrait}
						alt='Hanif Carroll'
						loading='eager'
						widths={[176, 352]}
						sizes='88px'
					/>
				</figure>
				<h1 class='m-0 text-[clamp(2.25rem,4.5vw,3.25rem)] font-bold leading-[1.05] tracking-[-0.03em] text-ink'>Hanif Carroll</h1>
				<p class='mt-3 mb-0 text-lg font-medium text-ink'>Freelance Software Engineer</p>
				<div class='mt-6 grid max-w-md gap-4 text-base leading-relaxed text-ink-muted'>
					<p class='m-0'>I build websites, web apps, and custom tools for businesses, founders, and agencies. I learn how a business works, figure out where software could help, and build it with the people who’ll use it.</p>
					<p class='m-0'>Agencies can hand me builds to deliver under their name. I’m based in Buenos Aires and work U.S. Eastern hours.</p>
				</div>
				<div class='mt-8 flex flex-wrap items-center gap-x-3 gap-y-3 text-sm'>
					<a
						class='inline-flex min-h-11 items-center gap-2 whitespace-nowrap rounded-md border border-ink bg-ink px-4 py-2 text-[0.9rem] font-medium text-canvas no-underline transition-colors hover:bg-ink-muted focus-visible:bg-ink-muted'
						href={BOOK_CALL_URL}
						target='_blank'
						rel='noopener noreferrer'
						data-track-event='book_call_clicked'
						data-track-location='home_hero'
					>
						Book a call
						<svg class='size-3.5 fill-none stroke-current stroke-[1.25]' aria-hidden='true' viewBox='0 0 16 16' focusable='false'><path d='M3 13 13 3M6 3h7v7' /></svg>
					</a>
					<a
						class='inline-flex min-h-11 items-center gap-2 whitespace-nowrap rounded-md border border-ink/25 px-4 py-2 text-[0.9rem] font-medium text-ink no-underline transition-colors hover:border-ink hover:bg-ink/5 focus-visible:border-ink'
						href={EMAIL_URL}
						data-track-event='email_clicked'
						data-track-location='home_hero'
					>
						Email me
					</a>
				</div>
				<blockquote class='mt-10 mb-0 max-w-md border-l-2 border-accent pl-4'>
					<p class='m-0 text-sm leading-relaxed text-ink'>“{heroTestimonial.quote}”</p>
					<footer class='mt-3 text-xs text-ink-muted'>
						<cite class='not-italic'><span class='font-semibold text-ink'>{heroTestimonial.name}</span> · {heroTestimonial.role}</cite>
					</footer>
				</blockquote>
			</div>

			<div id='projects' class='min-w-0 scroll-mt-24 lg:col-span-7'>
				<h2 class={`${labelClass} mb-6`}>Client work</h2>
				<ul class='m-0 grid list-none gap-10 p-0'>
					{projects.map((project) => (
						<li>
							<a class='group grid gap-3 text-inherit no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:grid-cols-8 sm:gap-4' href={`/projects/${project.slug}/`}>
								<div class='sm:col-span-3'>
									<Image
										class='aspect-video w-full rounded-md object-cover'
										src={project.image}
										alt={project.alt}
										loading='lazy'
										widths={[400, 800, 1200]}
										sizes='(min-width: 1024px) 260px, (min-width: 640px) 38vw, calc(100vw - 3rem)'
									/>
								</div>
								<div class='sm:col-span-5'>
									<h3 class='m-0 text-base font-medium leading-snug text-ink transition-colors group-hover:text-accent-ink group-focus-visible:text-accent-ink'>{project.title}</h3>
									<p class='mt-2 mb-0 text-sm leading-relaxed text-ink-muted'>{project.description}</p>
									<ul class='mt-3 mb-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0 text-xs text-ink-muted' aria-label='Technologies used'>
										{project.tags.slice(0, 3).map((tag) => <li class='after:ml-3 after:text-line after:content-["·"] last:after:content-none'>{tag}</li>)}
									</ul>
								</div>
							</a>
						</li>
					))}
				</ul>
				<a class={`${arrowLinkClass} mt-10`} href='/projects/'>
					View more projects
					<svg class='text-accent-ink transition-transform group-hover:translate-x-[3px] motion-reduce:transition-none' viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14'></path><path d='M12 5l7 7-7 7'></path></svg>
				</a>
			</div>
		</section>

		<section class={sectionClass} aria-labelledby='feedback-title'>
			<div class='lg:col-span-5'>
				<h2 id='feedback-title' class={labelClass}>Feedback</h2>
			</div>
			<div class={`${bodyClass} grid gap-10`}>
				{feedback.map((testimonial) => (
					<blockquote class='m-0 border-l-2 border-accent pl-5'>
						<p class='m-0 text-base leading-[1.7] text-ink'>“{testimonial.quote}”</p>
						<footer class='mt-4'>
							<cite class='grid gap-1 not-italic'>
								<span class='text-sm font-bold text-ink'>{testimonial.name}</span>
								<span class='text-xs text-ink-muted'>{testimonial.role}</span>
							</cite>
						</footer>
					</blockquote>
				))}
			</div>
		</section>

		<section id='experience' class={sectionClass} aria-labelledby='experience-title'>
			<div class='lg:col-span-5'>
				<h2 id='experience-title' class={labelClass}>Experience</h2>
			</div>
			<div class={bodyClass}>
				<ol class='m-0 grid list-none gap-12 p-0'>
					{experience.map((job) => (
						<li class='grid gap-2 sm:grid-cols-8 sm:gap-4'>
							<div class='text-xs font-semibold uppercase tracking-[0.06em] text-ink-muted sm:col-span-2 sm:mt-0.5'>{job.period}</div>
							<div class='hc-home-job__content sm:col-span-6'>
								<h3 class='m-0 flex flex-wrap items-baseline gap-1 text-base font-medium leading-snug text-ink'>
									{job.role} ·{' '}
									{job.companyHref ? (
										<a class='group inline-flex items-center gap-1 text-ink no-underline transition-colors hover:text-accent-ink' href={job.companyHref} target='_blank' rel='noopener noreferrer'>
											{job.company}
											<svg class='text-accent-ink transition-transform group-hover:translate-x-px group-hover:-translate-y-px' viewBox='0 0 24 24' width='14' height='14' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M7 17L17 7'></path><path d='M7 7h10v10'></path></svg>
										</a>
									) : (
										<span>{job.company}</span>
									)}
								</h3>
								{job.body && <p class='mt-2 mb-0 text-sm leading-relaxed text-ink-muted'>{job.body}</p>}
								{job.highlights && <ul class='hc-home-job__highlights'>
									{job.highlights.map((highlight) => <li>{highlight}</li>)}
								</ul>}
								{job.clients && <div class='mt-6'>
									<h4 class='m-0 text-[0.9375rem] font-medium text-ink-muted'>Client work</h4>
									<ul class='hc-home-job__highlights'>
										{job.clients.map((client) => <li><a href={client.href}>{client.name}</a> <span class='text-xs'>({client.engagement})</span>: {client.summary}</li>)}
									</ul>
								</div>}
								{job.additionalConsulting && <div class='mt-6'>
									<h4 class='m-0 text-[0.9375rem] font-medium text-ink-muted'>Additional consulting</h4>
									<ul class='hc-home-job__highlights'>
										{job.additionalConsulting.map((highlight) => <li><a href={highlight.href}>{highlight.name}</a>{highlight.description}</li>)}
									</ul>
								</div>}
								{job.independentHighlights && <div class='mt-6'>
									<h4 class='m-0 text-[0.9375rem] font-medium text-ink-muted'>Independent products &amp; demos</h4>
									<ul class='hc-home-job__highlights'>
										{job.independentHighlights.map((highlight) => <li><a href={highlight.href}>{highlight.name}</a>{highlight.description}</li>)}
									</ul>
								</div>}
								{job.independentProject && <p class='mt-2 mb-0 text-sm leading-relaxed text-ink-muted'>I also build and operate <a class={linkClass} href={job.independentProject.href}>{job.independentProject.name}</a>, {job.independentProject.description}</p>}
								{job.tags && <ul class='mt-3 mb-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0 text-xs text-ink-muted' aria-label='Technologies used'>
									{job.tags.map((tag) => <li class='after:ml-3 after:text-line after:content-["·"] last:after:content-none'>{tag}</li>)}
								</ul>}
							</div>
						</li>
					))}
				</ol>
			</div>
		</section>

		<section id='about' class={sectionClass} aria-labelledby='about-title'>
			<div class='lg:col-span-5'>
				<h2 id='about-title' class={labelClass}>About</h2>
			</div>
			<div class={`${bodyClass} hc-home-about grid gap-5 text-base leading-[1.7] text-ink-muted`}>
				<p class='m-0'>
					Hey, I’m Hanif. I’m a freelance software engineer based in Buenos Aires. I got into programming after <em>Mr. Robot</em> inspired me to learn how to code. I now have 9+ years of experience. The part of the work I enjoy most is the conversations: learning how people actually work and figuring out together what’s worth building.
				</p>
				<p class='m-0'>
					After working at <a href='https://www.8base.com/' target='_blank' rel='noopener noreferrer'>8base</a>, <a href='https://www.capgemini.com/' target='_blank' rel='noopener noreferrer'>Capgemini</a>, and <a href='https://www.leagueapps.com/' target='_blank' rel='noopener noreferrer'>LeagueApps</a>, I now run HC Studio, where I work with businesses, founders, and agencies to turn rough ideas into useful, reliable software.
				</p>
				<p class='m-0'>
					For the past three years, I’ve used coding agents to build software and complete workflows across websites and apps. My experience includes Cursor, Claude Code, Codex, and Pi. I’ve written about <a href='/how-i-work/'>how I work</a> and <a href='/blog/using-diagrams-to-review-an-ai-report-workflow/'>using agent-generated diagrams to review Casamo’s workflow</a>.
				</p>
				<p class='m-0'>
					I’m interested in how organizations work and how technology can fit around people. Right now I’m reading <em><a href='https://www.amazon.com/dp/1603580557' target='_blank' rel='noopener noreferrer'>Thinking in Systems</a></em>.
				</p>
				<p class='m-0'>
					Outside of work, I like to <a href='https://www.youtube.com/shorts/sQZoQeXo53o' data-lifting-video-trigger><strong>lift weights</strong></a>, experiment with AI, and have merienda in cozy coffee shops.
				</p>
				<a class={`${arrowLinkClass} mt-2 justify-self-start`} href='/notes/'>
					Read my notes
					<svg class='text-accent-ink transition-transform group-hover:translate-x-[3px] motion-reduce:transition-none' viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14'></path><path d='M12 5l7 7-7 7'></path></svg>
				</a>
			</div>
		</section>

		<section id='blog' class={sectionClass} aria-labelledby='blog-title'>
			<div class='lg:col-span-5'>
				<h2 id='blog-title' class={labelClass}>Blog</h2>
			</div>
			<div class={bodyClass}>
				<ol class='m-0 grid list-none gap-9 p-0'>
					{blogPosts.map((post) => (
						<li>
							<a class='group grid gap-2 text-inherit no-underline sm:grid-cols-8 sm:gap-4' href={`/blog/${post.id}/`}>
								<div class='text-xs font-semibold uppercase tracking-[0.06em] text-ink-muted sm:col-span-2 sm:mt-0.5'>
									<FormattedDate date={post.data.pubDate} />
								</div>
								<div class='sm:col-span-6'>
									<h3 class='m-0 text-base font-medium leading-snug text-ink transition-colors group-hover:text-accent-ink'>{post.data.title}</h3>
									<p class='mt-2 mb-0 text-sm leading-relaxed text-ink-muted'>{post.data.description}</p>
								</div>
							</a>
						</li>
					))}
				</ol>
				<a class={`mt-10 inline-block text-[0.95rem] ${linkClass}`} href='/blog/'>View more blog posts</a>
			</div>
		</section>
	</div>

	<dialog class='hc-home-video-modal' aria-label='Lifting weights video' data-lifting-video-modal>
		<div class='hc-home-video-modal__surface'>
			<form method='dialog'>
				<button class='hc-home-video-modal__close' type='submit' aria-label='Close video'>
					<svg viewBox='0 0 24 24' aria-hidden='true'><path d='m6 6 12 12M18 6 6 18'></path></svg>
				</button>
			</form>
			<iframe
				class='hc-home-video-modal__frame'
				title='Hanif Carroll lifting weights'
				allow='autoplay; encrypted-media; picture-in-picture'
				allowfullscreen
				data-lifting-video-frame
			></iframe>
		</div>
	</dialog>
</BaseLayout>

<script>
	const videoTrigger = document.querySelector<HTMLAnchorElement>('[data-lifting-video-trigger]')!;
	const videoModal = document.querySelector<HTMLDialogElement>('[data-lifting-video-modal]')!;
	const videoFrame = document.querySelector<HTMLIFrameElement>('[data-lifting-video-frame]')!;

	videoTrigger.addEventListener('click', (event) => {
		event.preventDefault();
		videoFrame.src = 'https://www.youtube-nocookie.com/embed/sQZoQeXo53o?autoplay=1';
		videoModal.showModal();
	});

	videoModal.addEventListener('close', () => {
		videoFrame.removeAttribute('src');
		videoTrigger.focus();
	});


</script>
