---
import { Image } from 'astro:assets';
import HeroBackdrop from '../assets/img/hero-editorial-backdrop-navy-yellow.png';
import HeroPortrait from '../assets/img/hanif-consulting-hero-cutout-facing-left.png';
import AcquirePaperSystem from '../assets/img/projects/acquire-paper-system.png';
import DesarmaderoPaperSystem from '../assets/img/projects/desarmadero-operations-paper-system.png';
import GenruptPaperSystem from '../assets/img/projects/genrupt-paper-system.png';
import PalabrunoPaperSystem from '../assets/img/projects/palabruno-paper-system.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOK_CALL_URL } from '../consts';
import { serviceOfferList } from '../lib/service-offers';
import '../styles/home.css';

const title = 'Hanif Carroll | Technical Consultant for Founder-Led Businesses';
const description = 'I help founder-led businesses fix difficult workflows with custom software, automation, and AI.';

const homepageJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		jobTitle: 'Technical Consultant',
		description,
		affiliation: { '@type': 'Organization', name: 'HC Studio' },
		sameAs: ['https://github.com/hanifcarroll', 'https://linkedin.com/in/hanifcarroll', 'https://x.com/hanifcarroll'],
		knowsAbout: ['Business systems engineering', 'Workflow automation', 'Internal tools', 'AI-assisted operations', 'Product engineering']
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		description
	}
];

const featuredProjects = [
	{
		slug: 'desarmadero-operations-prototype',
		label: 'Client work',
		title: 'Desarmadero Operations',
		heading: 'A working operations prototype from one discovery call.',
		body: 'An auto-dismantling yard was running sales and fulfillment through paper sheets, WhatsApp, Excel, and memory. I turned the workflow into a PRD, functional specification, and role-based prototype the client could validate before committing to the full build.',
		image: DesarmaderoPaperSystem,
		alt: 'Paper model of a vehicle order moving through sales, payment, dismantling, and billing.'
	},
	{
		slug: 'genrupt',
		label: 'Client work',
		title: 'Genrupt',
		heading: 'Making Genrupt ready for paying teams.',
		body: 'I helped build the billing, credit accounting, background jobs, and agent workflows that made Genrupt ready for paying teams and helped it support its first 200 paying customers.',
		image: GenruptPaperSystem,
		alt: 'Paper model of creative assets, team access, usage events, and pricing rules flowing through the Genrupt system.'
	},
	{
		slug: 'acquire',
		label: 'Independent work',
		title: 'Acquire',
		heading: 'One place to manage a scattered acquisition workflow.',
		body: 'Acquire brings sourcing, review, applications, outreach, evidence, and follow-up into one local system. It keeps agent activity behind clear review steps and stores the state needed to recover interrupted activity.',
		image: AcquirePaperSystem,
		alt: 'Paper model of scattered opportunity inputs passing through review, qualification, and decision gates.'
	},
	{
		slug: 'palabruno',
		label: 'Client work',
		title: 'Palabruno',
		heading: 'Launching Palabruno across mobile and web.',
		body: 'I helped a nontechnical founder narrow the product, build the learner and teacher workflows, add mobile and web payments, launch on iOS, Android, and web, and leave with the documentation and assets needed to own the product.',
		image: PalabrunoPaperSystem,
		alt: 'Paper model of a Spanish reading, vocabulary, teacher handoff, and learner progress across tablet and mobile.'
	}
];

const homepageServices = serviceOfferList.map((offer) => ({
	...offer,
	homepageSummary: {
		audit: 'Map one difficult workflow, find where it breaks down, and leave with a recommendation and first build plan.',
		systemsBuild: 'Design and build an internal tool, automation, dashboard, integration, or AI-assisted workflow around your team.',
		ongoing: 'Improve and support the systems your team relies on through an agreed set of technical priorities.'
	}[offer.key]
}));

const method = [
	{
		title: 'Understand the complete workflow',
		body: 'We trace each workflow from request to outcome: who is involved, which tools they use, where information changes hands, and where the process breaks down.'
	},
	{
		title: 'Choose the smallest useful change',
		body: 'The best fix may be a process change, better use of an existing tool, an automation, or custom software. We choose based on what the workflow needs.'
	},
	{
		title: 'Build, document, and hand it over',
		body: 'When software is the right fix, I build a focused version around your team. You keep the maps, software, documentation, and notes behind important decisions.'
	}
];

const testimonials = [
	{
		quote: 'Hanif quickly understood our needs, both from a business and aesthetic perspective, and translated them into a clean, functional website in no time.',
		name: 'Monica Londoño',
		role: 'Co-founder, Punto de Partida'
	},
	{
		quote: "He's reliable, communicates great, and has a sharp technical mind. Whether handling complex builds, troubleshooting under pressure, or adapting to shifting priorities, he was dependable every step of the way.",
		name: 'Markis Zarate',
		role: 'Founder, Zarate Studios'
	},
	{
		quote: 'He suggested design-to-engineering hand-off improvements to make our workflow more efficient, asked insightful follow-up questions during design reviews, and brought my Figma designs to life so we could deliver value to our users.',
		name: 'Sarah Hibner',
		role: 'Senior Product Designer, LeagueApps'
	}
];
---

<BaseLayout
	title={title}
	description={description}
	jsonLd={homepageJsonLd}
	bodyClass='hc-home'
	footerCtaTitle="Tell me what's getting harder to run."
	footerCtaBody="You don't need a specification or a preferred tool. Start with the workflow that's causing delays, repeated effort, or confusion. We'll decide whether it needs an audit, a focused build, or a smaller first step."
	footerCtaLocation='home_footer_cta'
	footerCtaSurface='canvas'
>
	<article>
		<header class='hc-home-hero'>
			<div class='hc-home-hero__inner'>
				<div class='hc-home-hero__copy'>
					<h1 class='hc-home-hero__title' aria-label='Fix the workflows slowing down your business'>
						<span>Fix the</span> <span class='hc-home-hero__title-accent'>workflows</span> <span>slowing down</span> <span>your business</span>
					</h1>
					<p class='hc-home-hero__lead'>I help growing businesses replace repeated manual work and scattered information with clear workflows and software their team can use.</p>
					<div class='hc-home-hero__actions'>
						<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location='home_hero'>Book a Business Systems Audit</a>
						<a class='hc-home-hero__secondary' href='/case-studies/'>See case studies</a>
					</div>
					<aside class='hc-home-hero__proof' aria-label='Selected client result'>
						<p class='hc-home-hero__proof-label'>Selected client result</p>
						<p>Helped Genrupt build the systems behind its first 200 paying customers.</p>
						<a class='hc-text-link' href='/case-studies/genrupt/'>View the Genrupt case study</a>
					</aside>
				</div>
				<figure class='hc-home-hero__portrait'>
					<Image class='hc-home-hero__backdrop-image' src={HeroBackdrop} alt='' aria-hidden='true' loading='eager' widths={[640, 960, 1122]} sizes='(max-width: 900px) 100vw, 53vw' quality={92} />
					<Image class='hc-home-hero__portrait-image' src={HeroPortrait} alt='Hanif Carroll looking toward the homepage introduction' loading='eager' widths={[640, 960, 1122]} sizes='(max-width: 900px) 100vw, 53vw' quality={95} />
				</figure>
			</div>
		</header>

		<section class='hc-section hc-recognition-section'>
			<div class='hc-container hc-recognition'>
				<div class='hc-recognition__copy'>
					<h2 class='hc-recognition__title'>As the business grows, manual work gets <span>harder to manage.</span></h2>
					<p>The business is growing, but day-to-day operations are getting harder to run. Requests arrive through inboxes and chats. Important status lives in spreadsheets. Approvals depend on one person. Reporting means pulling information from several tools.</p>
				</div>

				<div class='hc-workflow-diagram' role='img' aria-label='Requests from inbox and chat, spreadsheet status, and approval decisions all depend on one person before reporting can happen.'>
					<div class='hc-workflow-sources'>
						<div class='hc-workflow-source'>
							<svg viewBox='0 0 24 24' aria-hidden='true'><rect x='2.5' y='4.5' width='19' height='15' rx='2'></rect><path d='m3.5 6 8.5 7 8.5-7'></path></svg>
							<span>Inbox</span>
						</div>
						<div class='hc-workflow-source'>
							<svg viewBox='0 0 24 24' aria-hidden='true'><path d='M4.5 4.5h15a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-8l-4.5 3v-3H4.5a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z'></path><circle cx='8' cy='11' r='.7'></circle><circle cx='12' cy='11' r='.7'></circle><circle cx='16' cy='11' r='.7'></circle></svg>
							<span>Chat</span>
						</div>
					</div>

					<span class='hc-workflow-arrow' aria-hidden='true'>→</span>
					<div class='hc-workflow-node hc-workflow-node--requests'>
						<span>Requests</span>
						<svg viewBox='0 0 24 24' aria-hidden='true'><path d='M6 2.5h8l4 4v15H6z'></path><path d='M14 2.5v5h4M9 12h6M9 16h6'></path></svg>
					</div>

					<span class='hc-workflow-arrow' aria-hidden='true'>→</span>
					<div class='hc-workflow-bottleneck'>
						<div class='hc-workflow-input'>
							<svg viewBox='0 0 24 24' aria-hidden='true'><rect x='4' y='3' width='16' height='18' rx='1.5'></rect><path d='M4 8h16M4 13h16M4 18h16M10 3v18'></path></svg>
							<span>Spreadsheet status</span>
						</div>
						<span class='hc-workflow-arrow hc-workflow-arrow--down' aria-hidden='true'>↓</span>
						<div class='hc-workflow-node hc-workflow-node--person'>
							<svg viewBox='0 0 24 24' aria-hidden='true'><circle cx='12' cy='7.5' r='3.5'></circle><path d='M5.5 21v-3.5a5 5 0 0 1 5-5h3a5 5 0 0 1 5 5V21'></path></svg>
							<strong>One person</strong>
						</div>
						<span class='hc-workflow-arrow hc-workflow-arrow--up' aria-hidden='true'>↑</span>
						<div class='hc-workflow-input'>
							<svg viewBox='0 0 24 24' aria-hidden='true'><circle cx='12' cy='12' r='9'></circle><path d='m8 12 2.5 2.5L16.5 8.5'></path></svg>
							<span>Approval decisions</span>
						</div>
						<p class='hc-workflow-warning'><span aria-hidden='true'>!</span> Only they know what happens next.</p>
					</div>

					<span class='hc-workflow-arrow' aria-hidden='true'>→</span>
					<div class='hc-workflow-node hc-workflow-node--reporting'>
						<span>Reporting</span>
						<svg viewBox='0 0 24 24' aria-hidden='true'><path d='M4 21v-6h4v6M10 21V9h4v12M16 21V3h4v18'></path></svg>
					</div>
				</div>

				<p class='hc-recognition__close'>A clear look at the entire workflow can show you where to begin.</p>
			</div>
		</section>

		<section class='hc-section' id='services'>
			<div class='hc-container'>
				<div class='hc-section-header hc-services-header'>
					<h2 class='hc-section-title'>Three ways we can work together.</h2>
					<p class='hc-section-intro'>Start with the level of help that matches what you already know. Each engagement produces something useful on its own.</p>
				</div>
				<div class='hc-service-paths'>
					{homepageServices.map((offer, index) => <article class='hc-service-path'><div class='hc-service-path__heading'><span aria-hidden='true'>{String(index + 1).padStart(2, '0')}</span><p>{offer.label}</p></div><h3>{offer.chooserHeading}</h3><p>{offer.homepageSummary}</p><div class='hc-service-path__footer'><p>{offer.commercialNote}</p><a href={offer.path}>{offer.chooserCta}<span aria-hidden='true'>→</span></a></div></article>)}
				</div>
			</div>
		</section>

		<section class='hc-proof-section hc-section'>
			<div class='hc-container-wide hc-proof-section__header'>
				<div class='hc-section-header'>
					<h2 class='hc-section-title'>Selected client and independent projects.</h2>
					<p class='hc-section-intro'>These projects show how I handle discovery, product decisions, building, and handoff.</p>
				</div>
			</div>
			<div class='hc-proof-list'>
				{featuredProjects.map((project, index) => {
					const isDark = (featuredProjects.length - index) % 2 === 0;
					return <article class:list={['hc-proof-row', { 'hc-proof-row--dark': isDark }]} data-header-surface={isDark ? 'dark' : 'light'}><div class='hc-container-wide hc-proof-row__inner'><div class='hc-proof-copy'><p class='hc-proof-number' aria-hidden='true'>{String(index + 1).padStart(2, '0')}</p><p class='hc-proof-label'>{project.label}</p><h3>{project.heading}</h3><p>{project.body}</p><a class='hc-text-link' href={`/case-studies/${project.slug}/`}>View {project.title}</a></div><figure class='hc-proof-media'><Image src={project.image} alt={project.alt} loading='lazy' format='png' widths={[640, 960, 1536]} sizes='(max-width: 900px) 100vw, 66vw' quality={100} /></figure></div></article>;
				})}
			</div>
			<div class='hc-proof-section__actions'><a class='hc-button' href='/case-studies/'>Explore all case studies</a></div>
		</section>

		<section class='hc-section hc-method-section' id='method' data-header-surface='dark'>
			<div class='hc-container'>
				<div class='hc-section-header'><h2 class='hc-section-title'>What working together looks like.</h2><p class='hc-section-intro'>A simple path from understanding the workflow to a system your team can own.</p></div>
				<div class='hc-method-grid'>{method.map((item, index) => <div class='hc-method-item'><span class='hc-index'>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></div>)}</div>
				<div class='hc-actions'><a class='hc-text-link' href='/services/'>See all services</a></div>
			</div>
		</section>

		<section class='hc-section hc-testimonial-section'>
			<div class='hc-container'>
				<div class='hc-section-header'><h2 class='hc-section-title'>What people have said about working with me</h2></div>
				<div class='hc-testimonials'>{testimonials.map((item, index) => <figure class:list={['hc-testimonial', { 'hc-testimonial--featured': index === 0 }]}><span class='hc-testimonial__mark' aria-hidden='true'>“</span><blockquote>{item.quote}<span class='hc-testimonial__closing-mark' aria-hidden='true'>”</span></blockquote><figcaption><strong>{item.name}</strong><span>{item.role}</span></figcaption></figure>)}</div>
			</div>
		</section>

		<section class='hc-section hc-about-preview-section'>
			<div class='hc-container-wide'>
				<div class='hc-about-preview'>
					<div class='hc-about-preview__visual'>
						<figure><Image src={HeroBackdrop} alt='' aria-hidden='true' class='hc-about-preview__backdrop' loading='lazy' /><Image src={HeroPortrait} alt='Hanif Carroll, technical consultant' class='hc-about-preview__portrait' loading='lazy' /></figure>
					</div>
					<div class='hc-about-preview__copy'>
						<div class='hc-about-preview__title'><h2>Hi, I'm Hanif.</h2></div>
						<div class='hc-about-preview__body'>
							<p>I'm Hanif Carroll, a technical consultant and product engineer with more than eight years of experience building web, mobile, automation, and AI systems. I work directly with founders and operators from the first conversations through product decisions, implementation, and handoff.</p>
							<p>I'm based in Buenos Aires, work US hours, and contract with US clients through my LLC, HC Studio.</p>
							<a class='hc-text-link' href='/about/'>More about how I work</a>
						</div>
					</div>
				</div>
			</div>
		</section>

	</article>
</BaseLayout>
