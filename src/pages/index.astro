---
import { Image } from 'astro:assets';
import HeroBackdrop from '../assets/img/hero-editorial-backdrop-navy-yellow.png';
import HeroPortrait from '../assets/img/hanif-consulting-hero-cutout-facing-left.png';
import GenruptCreativeOperations from '../assets/img/projects/genrupt-creative-ops-photo.png';
import PalabrunoPaperSystem from '../assets/img/projects/palabruno-paper-system.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOK_CALL_URL } from '../consts';
import { testimonials } from '../lib/testimonials';
import '../styles/home.css';

const title = 'Hanif Carroll | Contract Product Engineer for B2B SaaS';
const description = 'I join B2B SaaS teams as a contract product engineer, building customer-facing products, internal tools, and HubSpot integrations.';

const homepageJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		jobTitle: 'Contract Product Engineer',
		description,
		sameAs: ['https://github.com/hanifcarroll', 'https://linkedin.com/in/hanifcarroll', 'https://x.com/hanifcarroll'],
		knowsAbout: ['Product engineering', 'Internal tools', 'HubSpot integrations', 'AI product features', 'Contract engineering']
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/',
		description
	}
];

const featuredProjects = [
	{
		slug: 'genrupt',
		label: 'Client work',
		title: 'Genrupt',
		heading: 'Making Genrupt ready for paying teams.',
		body: 'I helped build the billing, credit accounting, background jobs, and agent workflows that made Genrupt ready for paying teams and helped it support its first 200 paying customers.',
		image: GenruptCreativeOperations,
		alt: 'Genrupt creative operations workspace for Amazon seller teams.'
	},
	{
		slug: 'palabruno',
		label: 'Client work',
		title: 'Palabruno',
		heading: "From a founder's idea to a launched reading product.",
		body: "I took a founder's idea to live on the App Store, Google Play, and web — owning product, UX, and full-stack engineering for AI reading features, teacher workflows, and subscription billing.",
		image: PalabrunoPaperSystem,
		alt: 'Palabruno reading product for Spanish learners and teachers.'
	}
];

const method = [
	{
		title: 'Understand the product and the people using it',
		body: "We start from the feature, integration, or system that's stuck: who uses it, where it lives in the code and data, and what shipped actually looks like."
	},
	{
		title: 'Ship the smallest useful version',
		body: "You see working software early, and we expand from what's proven instead of betting on a big-bang release."
	},
	{
		title: 'Hand over code your team can own',
		body: 'You keep the code, documentation, and the reasoning behind important decisions — ready to operate and extend.'
	}
];


const founderTestimonial = testimonials.markisZarate;
---

<BaseLayout
	title={title}
	description={description}
	jsonLd={homepageJsonLd}
	bodyClass='hc-home'
	footerCtaTitle="Tell me what your team needs to ship."
	footerCtaBody="No specification or preferred stack required. Start with the feature, integration, or system that's stuck — we'll decide whether a project or a monthly contract fits."
	footerCtaPrimaryLabel='Book a 30-minute fit call'
	footerCtaLocation='home_footer_cta'
	footerCtaSurface='canvas'
>
	<article>
		<header class='hc-home-hero' data-motion-intro>
			<div class='hc-home-hero__inner'>
				<div class='hc-home-hero__copy'>
					<h1 class='hc-home-hero__title' aria-label='Contract product engineer for B2B SaaS' data-motion='headline'>
						<span class='hc-home-hero__line'>Contract product</span>
						<span class='hc-home-hero__line'><span class='hc-home-hero__title-accent'>engineer</span> for</span>
						<span class='hc-home-hero__line'>B2B SaaS</span>
					</h1>
					<p class='hc-home-hero__lead' data-motion-deck>I join B2B SaaS teams to build customer-facing products, internal tools, and HubSpot integrations — senior engineering on contract, without the full-time hire.</p>
					<div class='hc-home-hero__actions'>
						<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location='home_hero' data-motion-intro-item>Book a 30-minute fit call</a>
						<a class='hc-home-hero__secondary' href='/case-studies/' data-motion-intro-item>See case studies</a>
					</div>
					<aside class='hc-home-hero__proof' aria-label='Selected client result' data-motion-intro-item>
						<p class='hc-home-hero__proof-label'>Selected client result</p>
						<p>Helped build Genrupt's billing, credit accounting, background jobs, and agent workflows as it grew to its first 200 paying customers.</p>
						<a class='hc-text-link' href='/case-studies/genrupt/'>View the Genrupt case study</a>
					</aside>
				</div>
				<figure class='hc-home-hero__portrait' data-motion-intro-item='media'>
					<Image class='hc-home-hero__backdrop-image' src={HeroBackdrop} alt='' aria-hidden='true' loading='eager' widths={[640, 960, 1122]} sizes='(max-width: 900px) 100vw, 53vw' quality={92} />
					<Image class='hc-home-hero__portrait-image' src={HeroPortrait} alt='Hanif Carroll looking toward the homepage introduction' loading='eager' widths={[640, 960, 1122]} sizes='(max-width: 900px) 100vw, 53vw' quality={95} />
				</figure>
			</div>
		</header>

		<section class='hc-section hc-recognition-section' data-motion-group>
			<div class='hc-container hc-recognition'>
				<div class='hc-recognition__copy' data-motion='reveal'>
					<h2 class='hc-recognition__title'>The feature you need keeps slipping down the <span>roadmap.</span></h2>
					<p>The work that matters most keeps losing to whatever is urgent.</p>
				</div>

				<ul class='hc-recognition__list' data-motion-item>
					<li>Customer-facing features keep getting pushed back.</li>
					<li>Integrations with your revenue stack keep getting deferred.</li>
					<li>Internal tools keep getting stuck in the backlog.</li>
				</ul>

				<p class='hc-recognition__close' data-motion-item>A contract engineer can own that work from discovery to production.</p>
			</div>
		</section>

		<section class='hc-section' id='services' data-motion-group>
			<div class='hc-container'>
				<div class='hc-section-header hc-services-header' data-motion='reveal'>
					<h2 class='hc-section-title'>One offer: contract product engineering.</h2>
					<p class='hc-section-intro'>Senior engineering for your product — usually a monthly engagement with retained context, or a defined project when the next build is already clear. The fit call picks the shape.</p>
				</div>
				<div class='hc-home-decision-cta' data-motion-item>
					<div>
						<h3>Start with a 30-minute fit call.</h3>
						<p>Tell me what's stuck — a feature, an integration, or an internal tool — and we'll pick the shape that fits.</p>
					</div>
					<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location='home_services'>Book a 30-minute fit call</a>
				</div>
			</div>
		</section>

		<section class='hc-proof-section hc-section' id='case-studies'>
			<div class='hc-container-wide hc-proof-section__header' data-motion-group>
				<div class='hc-section-header'>
					<h2 class='hc-section-title' data-motion='reveal'>See what I've shipped for product teams.</h2>
					<p class='hc-section-intro' data-motion-item>Two client engagements showing the path from discovery and product decisions to software people could use.</p>
				</div>
			</div>
			<div class='hc-proof-list'>
				{featuredProjects.map((project, index) => {
					const isDark = (featuredProjects.length - index) % 2 === 0;
					return <article class:list={['hc-proof-row', { 'hc-proof-row--dark': isDark }]} data-header-surface={isDark ? 'dark' : 'light'} data-motion-group data-motion-from={index % 2 === 0 ? 'left' : 'right'}><div class='hc-container-wide hc-proof-row__inner'><div class='hc-proof-copy' data-motion-item><p class='hc-proof-number' aria-hidden='true'>{String(index + 1).padStart(2, '0')}</p><p class='hc-proof-label'>{project.label}</p><h3>{project.heading}</h3><p>{project.body}</p><a class='hc-text-link' href={`/case-studies/${project.slug}/`}>View {project.title}</a></div><figure class='hc-proof-media' data-motion-item data-motion='parallax'><Image src={project.image} alt={project.alt} loading='lazy' format='webp' widths={[640, 960, 1536]} sizes='(max-width: 900px) 100vw, 66vw' quality={88} /></figure></div></article>;
				})}
			</div>
			<div class='hc-proof-section__actions' data-motion='reveal'><a class='hc-button' href='/case-studies/'>Explore all case studies</a></div>
		</section>

		<section class='hc-section hc-testimonial-section' data-motion-group>
			<div class='hc-container'>
				<div class='hc-section-header' data-motion='reveal'><h2 class='hc-section-title'>A founder's view of the working relationship.</h2></div>
				<figure class='hc-testimonial hc-testimonial--featured' data-motion-item><span class='hc-testimonial__mark' aria-hidden='true'>“</span><blockquote>{founderTestimonial.featuredText}<span class='hc-testimonial__closing-mark' aria-hidden='true'>”</span></blockquote><figcaption><strong>{founderTestimonial.name}</strong><span>{founderTestimonial.attribution}</span></figcaption></figure>
			</div>
		</section>

		<section class='hc-section hc-method-section' id='method' data-header-surface='dark' data-motion-group>
			<div class='hc-container'>
				<div class='hc-section-header' data-motion='reveal'><h2 class='hc-section-title'>What working together looks like.</h2><p class='hc-section-intro'>A simple path from understanding the problem to software your team can own.</p></div>
				<div class='hc-method-grid' data-motion-item>{method.map((item, index) => <div class='hc-method-item'><span class='hc-index'>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.body}</p></div>)}</div>
			</div>
		</section>

	</article>
</BaseLayout>
