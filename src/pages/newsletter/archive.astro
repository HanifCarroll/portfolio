---
import { getCollection } from 'astro:content';
import ArchiveList from '../../components/newsletter/ArchiveList.astro';
import SubscribeForm from '../../components/newsletter/SubscribeForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { NewsletterArchiveIssue } from '../../lib/newsletter/archive';
import '../../styles/newsletter.css';

const entries = (await getCollection('newsletter')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const issues: NewsletterArchiveIssue[] = entries.map((entry) => ({
	slug: entry.id,
	title: entry.data.title,
	description: entry.data.description,
	pubDate: entry.data.pubDate,
	issueNumber: entry.data.issueNumber,
	tags: entry.data.tags
}));
const title = 'A Working Theory archive | Hanif Carroll';
const description = 'Browse every published issue of A Working Theory, field notes on AI, judgment, and better ways of working.';
---

<BaseLayout title={title} description={description} showFooterCta={false} bodyClass='page-newsletter'>
	<article class='awt-page awt-archive-page'>
		<header class='awt-archive-hero' data-header-surface='dark' data-motion-intro>
			<div class='hc-container-wide awt-archive-hero__grid'>
				<div>
					<a class='awt-back-link' href='/newsletter/'>A Working Theory</a>
					<h1 data-motion-headline>Issue archive</h1>
					<p data-motion-deck>Field notes on AI, judgment, and better ways of working, newest first.</p>
				</div>
				<div class='awt-archive-hero__signup' data-motion-intro-item>
					<p>Get the next working theory by email.</p>
					<SubscribeForm location='archive' />
				</div>
			</div>
		</header>
		<section class='hc-container-wide awt-archive-section' aria-label='Published issues' data-motion-section>
			<ArchiveList issues={issues} />
		</section>
	</article>
</BaseLayout>
