---
import { getCollection } from 'astro:content';
import ArchiveList from '../../components/newsletter/ArchiveList.astro';
import SubscribeForm from '../../components/newsletter/SubscribeForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { NewsletterArchiveIssue } from '../../lib/newsletter/archive';
import '../../styles/newsletter.css';

const entries = (await getCollection('newsletter')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const issues: NewsletterArchiveIssue[] = entries.map((entry) => ({
	slug: entry.id,
	title: entry.data.title,
	description: entry.data.description,
	pubDate: entry.data.pubDate,
	issueNumber: entry.data.issueNumber,
	tags: entry.data.tags,
	coverImage: entry.data.coverImage,
	coverAlt: entry.data.coverAlt
}));
const title = 'A Working Theory archive | Hanif Carroll';
const description = 'Browse every published issue of A Working Theory, field notes on AI, judgment, and better ways of working.';
---

<BaseLayout title={title} description={description} showFooterCta={false} bodyClass='page-newsletter page-newsletter--navy-masthead'>
	<article class='awt-page awt-archive-page'>
		<header class='awt-archive-hero' data-header-surface='dark' data-motion-intro>
			<div class='hc-container-wide awt-archive-hero__inner'>
				<a class='awt-back-link' href='/newsletter/'>A Working Theory</a>
				<h1 data-motion='headline'>Issue archive</h1>
				<p data-motion-deck>Field notes on AI, judgment, and better ways of working. Browse every issue, newest first.</p>
			</div>
		</header>
		<section class='hc-container-wide awt-archive-section' aria-label='Published issues' data-motion-group>
			<div class='awt-archive-section__heading'>
				<p>Published issues</p>
				<span>{issues.length} {issues.length === 1 ? 'issue' : 'issues'}</span>
			</div>
			<ArchiveList issues={issues} />
		</section>
		<section class='awt-archive-subscribe' aria-labelledby='awt-archive-subscribe-title' data-motion-group>
			<div class='hc-container-wide'>
				<div class='awt-archive-subscribe__inner'>
					<div>
						<p>Keep reading</p>
						<h2 id='awt-archive-subscribe-title'>Get the next working theory by email.</h2>
					</div>
					<SubscribeForm location='archive' />
				</div>
			</div>
		</section>
	</article>
</BaseLayout>
