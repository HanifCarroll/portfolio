								<li id={entryId(section.slug, entry.title)} class='hc-notes-entry'>
									<span class='hc-notes-entry__index' aria-hidden='true'>{String(entryIndex + 1).padStart(2, '0')}</span>
									<div>
										<h3>{entry.title}</h3>
										{entry.body.map((paragraph) => <p>{paragraph}</p>)}
