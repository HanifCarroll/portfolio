---
import BaseLayout from '../layouts/BaseLayout.astro';
import sections, { noteEntryId } from '../data/notes';
import { deckClass, itemTitleClass, pageTitleClass, sectionHeadingClass, shellClass } from '../lib/ui';
import '../styles/notes.css';

const title = 'Notes';
const description =
	'Notes on what I’ve learned from building products, working independently, learning, training, and trying to live an intentional life.';

const publicSections = sections.filter(({ title }) => !['Systems and Attention', 'Health and Training'].includes(title));

---

<BaseLayout
	title={`${title} | Hanif Carroll`}
	description={description}
	bodyClass='hc-notes'
	showFooterCta={false}
>
	<div class:list={[shellClass, 'pb-[clamp(6rem,12vw,10rem)]']}>
		<header class='pt-12 pb-[clamp(3rem,6vw,5rem)] lg:pt-20'>
			<h1 class={pageTitleClass}>Notes</h1>
			<p class:list={[deckClass, 'mt-6']}>{description}</p>
		</header>

		<div class='grid gap-12 lg:grid-cols-12'>
			<aside class='hidden lg:col-span-4 lg:block xl:col-span-3'>
				<nav class='hc-notes-toc sticky top-24 max-h-[calc(100svh-8rem)] overflow-y-auto overscroll-contain pb-8 [scrollbar-width:none]' aria-label='Table of contents'>
					<ul class='m-0 grid list-none p-0'>
						{publicSections.map((section, sectionIndex) => (
							<li class={`hc-notes-nav-section${sectionIndex === 0 ? ' is-active' : ''}`} data-notes-section>
								<a
									class='block py-2 text-base leading-snug text-ink-muted no-underline -outline-offset-2 transition-colors hover:text-ink aria-[current=location]:text-ink'
									href={`#${section.slug}`}
									data-notes-section-link
								>
									{section.title}
								</a>
								<div
									class='hc-notes-nav-entries'
									data-notes-nav-entries
									inert={sectionIndex !== 0}
									aria-hidden={sectionIndex === 0 ? 'false' : 'true'}
								>
									<ol>
										{section.entries.map((entry) => (
											<li><a class='block py-1.5 text-base leading-snug text-ink-muted no-underline -outline-offset-2 hover:text-ink focus-visible:text-ink' href={`#${noteEntryId(section.slug, entry)}`}>{entry.title}</a></li>
										))}
									</ol>
								</div>
							</li>
						))}
					</ul>
				</nav>
			</aside>

			<div class='min-w-0 lg:col-span-8 xl:col-span-9' data-notes-main>
				{publicSections.map((section) => (
					<section id={section.slug} class='mb-[clamp(5rem,10vw,8rem)] scroll-mt-24 last:mb-0' aria-labelledby={`${section.slug}-title`}>
						<h2 id={`${section.slug}-title`} class={sectionHeadingClass}>{section.title}</h2>
						<ol class='m-0 mt-10 grid list-none gap-14 p-0'>
							{section.entries.map((entry) => (
								<li id={noteEntryId(section.slug, entry)} class='scroll-mt-24'>
									<h3 class={itemTitleClass}>{entry.title}</h3>
									{entry.body.map((paragraph) => <p class='mt-3 mb-0 max-w-[40rem] text-lg leading-[1.6] text-ink-muted'>{paragraph}</p>)}
								</li>
							))}
						</ol>
					</section>
				))}
			</div>
		</div>
	</div>
</BaseLayout>


<script>
	const update = () => {
		const sections = document.querySelectorAll<HTMLElement>('[data-notes-main] section[id]');
		const links = document.querySelectorAll<HTMLAnchorElement>('[data-notes-section-link]');
		if (!sections.length || !links.length) return;

		const probe = window.scrollY + window.innerHeight * 0.35;
		let current = sections[0]?.id;
		sections.forEach((section) => {
			if (section.offsetTop <= probe) current = section.id;
		});

		links.forEach((link) => {
			const active = link.getAttribute('href') === `#${current}`;
			const section = link.closest('[data-notes-section]');
			const entries = section?.querySelector<HTMLElement>('[data-notes-nav-entries]');
			link.classList.toggle('is-active', active);
			section?.classList.toggle('is-active', active);
			entries?.toggleAttribute('inert', !active);
			entries?.setAttribute('aria-hidden', String(!active));
			if (active) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		});
	};

	let ticking = false;
	window.addEventListener('scroll', () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			update();
			ticking = false;
		});
	}, { passive: true });
	requestAnimationFrame(update);
	window.addEventListener('pageshow', () => requestAnimationFrame(update));
</script>
