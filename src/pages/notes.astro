---
import { Image } from 'astro:assets';
import Portrait from '../assets/img/hanif-author-portrait.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';
import '../styles/projects.css';
import '../styles/notes.css';

const title = 'Notes';
const description =
	'Notes on what I’ve learned from building products, working independently, learning, training, and trying to live an intentional life.';

const entryId = (section: string, title: string) =>
	`${section}-${title
		.toLowerCase()
		.replace(/[’']/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '')}`;

const sections = [
	{
		slug: 'building-products',
		title: 'Building Products',
		purpose: 'What I\'ve learned about product decisions by building, testing, and watching people use what I make.',
		entries: [
			{
				title: 'Let the outcome define the product',
				body: [
					`Name the exact outcome before deciding what the product should do. A specific outcome makes it easier to decide which features belong, which ones you can remove, and where the product's boundary should be.`
				]
			},
			{
				title: 'High-stakes decisions need visible choices',
				body: [
					`The amount of choice a product gives people should match the stakes of the decision. One recommendation and a couple of backups may be enough for a small decision, but someone about to spend a lot of time or money will usually want several good options to compare.`
				]
			},
			{
				title: 'Let actual use overturn the original design',
				body: [
					`When several people expose the same mistaken assumption in a product, change the design. The original idea matters less than how people understand the product and what they need from it.`
				]
			},
			{
				title: 'Choose the workflow defaults',
				body: [
					`Understand the work well enough to choose the workflow stages and default views. Users can control settings that vary from person to person, but good defaults give them a useful starting point and show that you understand the job.`
				]
			},
			{
				title: 'Explain what is happening during a wait',
				body: [
					`A wait feels longer when someone doesn't know whether anything is happening or what comes next. Make the same delay easier to tolerate by showing that the work has started, explaining its current state, and telling the user what will happen next.`
				]
			}
		]
	},
	{
		slug: 'working-with-ai',
		title: 'Working with AI',
		purpose: 'How I design and work with agent-assisted systems.',
		entries: [
			{
				title: 'Constrain the parts handled by AI',
				body: [
					`Use code for the structure and relationships the product already knows. Use AI where generation or language judgment is useful. Reliability improves when the model has fewer relationships and decisions to maintain on its own.`
				]
			},
			{
				title: 'Use simulations to practice judgment',
				body: [
					`AI simulations can give you repeated practice making the kinds of decisions a job requires before you have to make them at work. The exercise needs a realistic situation, a clear decision or output, and a rubric based on the job so the feedback can point out weak assumptions, missing questions, and consequences you overlooked.`
				]
			},
			{
				title: 'Give agents context and a procedure',
				body: [
					`An agent needs the right context and a procedure for working through it. Context determines what the agent can see and which distinctions matter. The procedure stops it from inventing a new process every time. Start with a temporary procedure, use it, and turn the failures that recur into rules.`
				]
			},
			{
				title: 'The human remains the executive',
				body: [
					`Agents can carry out tasks and return information, but you still set the goals, choose the direction, and make the decisions. The agent doesn't have to be AI; it can be software, another person, or you working in a different role. What matters is the distinction between setting direction and carrying out the work.`
				]
			},
			{
				title: 'Leave judgment in the loop',
				body: [
					`Turn the parts of a workflow with predictable answers into fixed rules. Leave judgment in the parts where the right answer depends on the goal and the situation. Trying to force that judgment into selectors and simple rules makes the workflow brittle.`
				]
			},
			{
				title: 'Evaluate the result and trace how it happened',
				body: [
					`An evaluation tells you whether an AI result was good. A trace shows how the system produced it by connecting the context, output, and time taken at each stage. You need both because they answer different questions. Early tests can start with pass or fail and one main category for the first important failure.`
				]
			},
			{
				title: 'Give agents small tools with clear jobs',
				body: [
					`Give agents simple tools for repetitive work so they can spend their attention on decisions. One tool might save structured information, crawl a site, or collect source material. The same small tool can serve several workflows without trying to encode every decision inside it.`
				]
			},
			{
				title: 'Give each workflow one job',
				body: [
					`Agents become less reliable when one workflow runs for too long or tries to do too many jobs. Separate tasks that happen near each other but require different responsibilities, such as drafting a post and creating its image. Each workflow should be small enough to finish without holding the whole system in mind.`
				]
			},
			{
				title: 'Understand the workflow before automating it',
				body: [
					`Write down a workflow and use it enough to understand the steps, handoffs, and decisions before you build tools for it. Repeating the process shows which parts recur, which parts can become code, and which decisions still need judgment. Starting with the tool can lock you into the wrong structure before you understand the job.`
				]
			}
		]
	},
	{
		slug: 'business-and-independent-work',
		title: 'Business and Independent Work',
		purpose: 'What I\'m learning while trying to build an independent practice without treating a temporary offer or customer group as permanent.',
		entries: [
			{
				title: 'Work on what changes the outcome',
				body: [
					`The work you find comfortable isn't always the work most likely to change your situation. Improving a product may be useful, but sometimes finding clients, applying for work, or delivering for the people already paying you matters more.`
				]
			},
			{
				title: 'Use free audits to help and learn',
				body: [
					`A small free audit can help someone while giving you practice finding and explaining problems. It also gives people an example of how you think and may uncover implementation work they want help with.`
				]
			},
			{
				title: 'A narrow customer group creates knowledge that compounds',
				body: [
					`When you focus on one kind of buyer, every conversation teaches you something you can use in the next one. Over time, you develop better questions, examples, content, offers, and a clearer sense of the problems that recur.`
				]
			},
			{
				title: 'Give consulting a smaller first step',
				body: [
					`A paid diagnostic can make consulting easier to buy because the client pays for a clear first decision instead of committing to a large implementation. They get a map of the current system, its expensive bottlenecks, the risks, and the choices for what to do next. You learn enough about their situation to propose a larger project responsibly.`
				]
			},
			{
				title: 'Use specialization as a way into the wider operation',
				body: [
					`Specializing in one platform can give a buyer a concrete reason to start working with you. The first project may be about that platform, but it can also show you the surrounding processes and the other problems worth solving.`
				]
			},
			{
				title: 'Learn the market\'s language from practitioner communities',
				body: [
					`Practitioner communities show you how people describe their problems, which constraints they face, and which practical resources they look for or make themselves. Repeated complaints can suggest a useful tool or resource you can create.`
				]
			},
			{
				title: 'Answer “What are you working on?” specifically',
				body: [
					`A specific answer gives the other person something they can connect to a problem, a person, or a reason to follow up. A vague category may sound flexible, but it gives them very little to work with.`
				]
			},
			{
				title: 'Use small public tools to show how you think',
				body: [
					`A small public tool can solve a real problem and show how you think. People can inspect the job it handles, the limits you chose, and your explanation of when it is useful. They can try the result instead of relying on a description of your abilities.`
				]
			}
		]
	},
	{
		slug: 'learning-and-research',
		title: 'Learning and Research',
		purpose: 'How I turn information into something I can understand and use.',
		entries: [
			{
				title: 'Start with the capability, not the reading list',
				body: [
					`Choose what to study after you name what you want to be able to do. That might be understanding a business process, running a better client conversation, designing an AI workflow, or delivering a particular kind of project. The capability gives the reading list a reason to exist.`
				]
			},
			{
				title: 'Learn technical work through projects',
				body: [
					`Learn technical work by using it in a project. A real problem gives you a reason to study a tool or concept, and building with it forces you to deal with the parts you could skim past in a general explanation.`
				]
			},
			{
				title: 'Compare models against an independent reference',
				body: [
					`If you want to compare two models fairly, the reference answer can't come from either one. A model-made reference can catch obvious failures, but it will favor the model that made it. Use a human-checked reference before drawing conclusions about which model is more accurate.`
				]
			}
		]
	},
	{
		slug: 'writing-and-communication',
		title: 'Writing and Communication',
		purpose: 'How I find ideas, develop them, and learn to explain them.',
		entries: [
			{
				title: 'Speak before judging the thought',
				body: [
					`Get the thought out before you decide whether it is worth saving. Editing too early can stop an idea before it has a chance to become something useful. The problem may not be that you have no thoughts. You may be rejecting them before they have time to develop.`
				]
			},
			{
				title: 'Use voice notes as rehearsal',
				body: [
					`Walking and talking gives you a way to think out loud, catch ideas, and work through them before you turn them into writing, plans, or video. Speaking without stopping is also practice. It helps you become more fluent and develop a thought instead of filtering it out too early.`
				]
			},
			{
				title: 'Separate creating, editing, and implementing',
				body: [
					`Separate creating, editing, and implementing into different modes. Create mode is for catching ideas. Edit mode is for reviewing and organizing them. Implement mode turns the edited idea into code, notes, content, outreach, or a plan. The separation gives an idea time to develop before you judge it.`
				]
			},
			{
				title: 'Test ideas in short form before expanding them',
				body: [
					`Short posts let you test an idea before it becomes an article or video. A strong response gives you a reason to spend more time developing it. A weak response costs very little. The short post helps you decide which ideas deserve the larger investment.`
				]
			},
			{
				title: 'Use interviews when the note is too thin',
				body: [
					`An atomic note can hold the main idea without enough detail for a post or essay. Read the note, its sources, and related notes first. If the examples, boundaries, or meaning are still missing, use a short interview to collect them instead of asking AI to fill the gaps.`
				]
			}
		]
	},
	{
		slug: 'systems-and-attention',
		title: 'Systems and Attention',
		purpose: 'How I manage decisions and limited attention.',
		entries: [
			{
				title: 'Revisit decisions only when the situation changes',
				body: [
					`Let a decision stand until new evidence changes the situation in a meaningful way. Choosing one path means closing off the alternatives for a while, which is what makes action possible. The decision doesn't have to be permanent, but reconsidering it without new evidence stops you from moving forward.`
				]
			},
			{
				title: 'Choose a work rhythm that fits the person and season',
				body: [
					`A sustainable way of working has to fit you. You may do well with intense bursts or prefer steady effort. The pattern can also change as you change. A rhythm that works now may become too costly when your interests, responsibilities, or goals are different.`
				]
			}
		]
	},
	{
		slug: 'health-and-training',
		title: 'Health and Training',
		purpose: 'What long-term strength training has taught me about goals and changing intensity over time.',
		entries: [
			{
				title: 'Strength training can remain part of your identity',
				body: [
					`A practice can remain part of your identity even when its intensity changes. You don't need to approach it with the same ambition every year for it to remain part of who you are.`
				]
			},
			{
				title: 'Simplify training around the goal',
				body: [
					`A clear goal makes it easier to simplify training. Organize the program around the lifts you want to improve and include assistance work only when you know why it is there.`
				]
			},
			{
				title: 'More work is not always more progress',
				body: [
					`An exercise can be useful by itself and still make the whole program worse. Removing work gives you more time and recovery for the lifts you're trying to improve. When the goal changes, the program can change with it.`
				]
			},
			{
				title: 'Training intensity moves through seasons',
				body: [
					`Training can remain part of your life without always being the largest goal. Lower the intensity when other parts of life need more from you, then push again when you have the desire and space.`
				]
			}
		]
	},
	{
		slug: 'life-philosophy',
		title: 'Life Philosophy',
		purpose: 'The values and open questions connecting the rest of these notes.',
		entries: [
			{
				title: 'Fear can hide opportunities with a lot of upside',
				body: [
					`Content and outreach can lead somewhere useful, but they also create the possibility of being ignored or rejected. A failed attempt usually changes very little. The fear often comes from being seen trying, not from the cost of failure.`
				]
			},
			{
				title: 'Money is a tool for expressing values',
				body: [
					`Money can support the life you choose, but it can't decide what that life should serve. Treating money as the highest value distorts that relationship. You still have to decide what the money is for.`
				]
			}
		]
	}
];

---

<BaseLayout
	title={`${title} | Hanif Carroll`}
	description={description}
	bodyClass='hc-projects-archive hc-notes'
	showHeader={false}
	showFooterCta={false}
	showFooter={false}
>
	<div class='hc-archive-shell'>
		<details class='hc-notes-mobile-menu'>
			<summary>
				<span>Notes</span>
				<span class='hc-notes-mobile-menu__action'><span class='hc-notes-mobile-menu__open'>Table of Contents</span><span class='hc-notes-mobile-menu__close'>Close</span><svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M6 9l6 6 6-6'></path></svg></span>
			</summary>
			<div class='hc-notes-mobile-menu__panel'>
				<p class='hc-notes-toc-label'>Chapters</p>
				<nav aria-label='Mobile table of contents'>
					<ol class='hc-notes-mobile-toc'>
						{sections.map((section, sectionIndex) => (
							<li>
								<details class='hc-notes-mobile-section' open={sectionIndex === 0}>
									<summary><strong>{section.title}</strong><svg viewBox='0 0 24 24' width='18' height='18' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M6 9l6 6 6-6'></path></svg></summary>
									<ol>
										{section.entries.map((entry) => (
											<li><a href={`#${entryId(section.slug, entry.title)}`}>{entry.title}</a></li>
										))}
									</ol>
								</details>
							</li>
						))}
					</ol>
				</nav>
			</div>
		</details>

		<header class='hc-archive-header hc-notes-sidebar'>
			<div class='hc-notes-sidebar__brand'>
				<figure><Image src={Portrait} alt='Hanif Carroll' loading='eager' widths={[96, 192]} sizes='48px' /></figure>
				<div><a href='/'>Hanif Carroll</a><span>Notes</span></div>
			</div>

			<div class='hc-notes-sidebar__toc'>
				<nav class='hc-archive-nav' aria-label='Table of contents'>
					<ul>
						{sections.map((section, sectionIndex) => (
							<li class={`hc-notes-nav-section${sectionIndex === 0 ? ' is-active' : ''}`} data-notes-section>
								<a href={`#${section.slug}`} data-notes-section-link>
									<span class='hc-notes-nav-number' aria-hidden='true'>{String(sectionIndex + 1).padStart(2, '0')}</span>
									<span class='hc-archive-nav__text'>{section.title}</span>
								</a>
								<div
									class='hc-notes-nav-entries'
									data-notes-nav-entries
									inert={sectionIndex !== 0}
									aria-hidden={sectionIndex === 0 ? 'false' : 'true'}
								>
									<ol>
										{section.entries.map((entry) => (
											<li><a class='hc-notes-nav-entry' href={`#${entryId(section.slug, entry.title)}`}>{entry.title}</a></li>
										))}
									</ol>
								</div>
							</li>
						))}
					</ul>
				</nav>
			</div>

			<div class='hc-archive-header__footer'>
				<div class='hc-archive-header__actions'>
					<a
						class='hc-archive-resume'
						href='/Hanif-Carroll-Resume.pdf'
						download
						data-track-event='resume_downloaded'
						data-track-location='notes_rail'
					>
						Download résumé
					</a>
					<a
						class='hc-archive-inquiry'
						href={BOOK_CALL_URL}
						target='_blank'
						rel='noopener noreferrer'
						data-track-event='book_call_clicked'
						data-track-location='notes_rail'
					>
						Book a call <span aria-hidden='true'>&nearr;</span>
					</a>
				</div>

				<ul class='hc-archive-social' aria-label='Social media and contact'>
					<li>
						<a href='https://github.com/hanifcarroll' target='_blank' rel='noopener noreferrer' aria-label='GitHub (opens in a new tab)' title='GitHub'>
							<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22'></path></svg>
						</a>
					</li>
					<li>
						<a href='https://linkedin.com/in/hanifcarroll' target='_blank' rel='noopener noreferrer' aria-label='LinkedIn (opens in a new tab)' title='LinkedIn'>
							<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z'></path><rect x='2' y='9' width='4' height='12'></rect><circle cx='4' cy='4' r='2'></circle></svg>
						</a>
					</li>
					<li>
						<a href='https://x.com/hanifcarroll' target='_blank' rel='noopener noreferrer' aria-label='X, formerly Twitter (opens in a new tab)' title='X'>
							<svg viewBox='0 0 24 24' width='18' height='18' fill='currentColor' aria-hidden='true'><path d='M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'></path></svg>
						</a>
					</li>
					<li>
						<a href='https://www.threads.com/@hanifcarroll' target='_blank' rel='noopener noreferrer' aria-label='Threads (opens in a new tab)' title='Threads'>
							<svg viewBox='0 0 24 24' width='18' height='18' fill='currentColor' aria-hidden='true'><path d='M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221z'></path></svg>
						</a>
					</li>
					<li>
						<a href={EMAIL_URL} aria-label='Email' title='Email'>
							<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z'></path><polyline points='22,6 12,13 2,6'></polyline></svg>
						</a>
					</li>
				</ul>
			</div>
		</header>

		<main class='hc-archive-main'>
			<nav class='hc-archive-back' aria-label='Back to home'>
				<a href='/'>
					<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M19 12H5'></path><path d='M12 19l-7-7 7-7'></path></svg>
					Hanif Carroll
				</a>
			</nav>
			<header class='hc-notes-intro'>
				<h1>Notes</h1>
				<p>{description}</p>
			</header>

			{sections.map((section) => (
				<section id={section.slug} class='hc-archive-group hc-notes-group' aria-labelledby={`${section.slug}-title`}>
					<div class='hc-archive-section-label'>
						<h2 id={`${section.slug}-title`} class='hc-archive-section-title'>{section.title}</h2>
					</div>
					<div class='hc-archive-section-body'>
						<p class='hc-archive-group__description'>{section.purpose}</p>
						<ol class='hc-notes-entries'>
							{section.entries.map((entry, entryIndex) => (
								<li id={entryId(section.slug, entry.title)} class='hc-notes-entry'>
									<span class='hc-notes-entry__index' aria-hidden='true'>{String(entryIndex + 1).padStart(2, '0')}</span>
									<div>
										<h3>{entry.title}</h3>
										{entry.body.map((paragraph) => <p>{paragraph}</p>)}
									</div>
								</li>
							))}
						</ol>
					</div>
				</section>
			))}
		</main>
	</div>
</BaseLayout>

<script>
	const update = () => {
		const sections = document.querySelectorAll<HTMLElement>('.hc-archive-main section[id]');
		const links = document.querySelectorAll<HTMLAnchorElement>('[data-notes-section-link]');
		if (!sections.length || !links.length) return;

		const probe = window.scrollY + window.innerHeight * 0.35;
		let current = sections[0]?.id;
		sections.forEach((section) => {
			if (section.offsetTop <= probe) current = section.id;
		});

		links.forEach((link) => {
			const active = link.getAttribute('href') === `#${current}`;
			const section = link.closest('[data-notes-section]');
			const entries = section?.querySelector<HTMLElement>('[data-notes-nav-entries]');
			link.classList.toggle('is-active', active);
			section?.classList.toggle('is-active', active);
			entries?.toggleAttribute('inert', !active);
			entries?.setAttribute('aria-hidden', String(!active));
			if (active) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		});
	};

	let ticking = false;
	window.addEventListener('scroll', () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			update();
			ticking = false;
		});
	}, { passive: true });
	const setupMobileMenu = () => {
		const menu = document.querySelector<HTMLDetailsElement>('.hc-notes-mobile-menu');
		const trigger = menu?.querySelector<HTMLElement>(':scope > summary');
		const panel = menu?.querySelector<HTMLElement>('.hc-notes-mobile-menu__panel');
		if (!menu || !trigger || !panel || menu.dataset.ready) return;
		menu.dataset.ready = 'true';
		let animation: Animation | undefined;
		let closing = false;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const open = () => {
			closing = false;
			animation?.cancel();
			menu.open = true;
			if (reducedMotion.matches) return;
			animation = panel.animate(
				[
					{ opacity: 0, transform: 'translateY(-0.5rem)' },
					{ opacity: 1, transform: 'translateY(0)' }
				],
				{ duration: 220, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
			);
		};

		const close = () => {
			if (!menu.open || closing) return;
			closing = true;
			animation?.cancel();
			if (reducedMotion.matches) {
				menu.open = false;
				closing = false;
				return;
			}
			animation = panel.animate(
				[
					{ opacity: 1, transform: 'translateY(0)' },
					{ opacity: 0, transform: 'translateY(-0.25rem)' }
				],
				{ duration: 160, easing: 'ease-in', fill: 'forwards' }
			);
			animation.addEventListener('finish', () => {
				menu.open = false;
				closing = false;
			}, { once: true });
		};

		trigger.addEventListener('click', (event) => {
			event.preventDefault();
			if (menu.open && !closing) close();
			else open();
		});
		menu.addEventListener('toggle', () => document.documentElement.classList.toggle('hc-notes-menu-open', menu.open));
		menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
	};

	document.addEventListener('astro:page-load', () => {
		requestAnimationFrame(update);
		setupMobileMenu();
	});
</script>
