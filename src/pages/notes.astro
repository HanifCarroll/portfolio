---
import { Image } from 'astro:assets';
import Portrait from '../assets/img/hanif-author-portrait.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOK_CALL_URL, EMAIL_URL } from '../consts';
import '../styles/projects.css';
import '../styles/notes.css';

const title = 'Notes';
const description =
	'Notes on what I’ve learned from building products, working independently, learning, training, and trying to live an intentional life.';

const entryId = (section: string, title: string) =>
	`${section}-${title
		.toLowerCase()
		.replace(/[’']/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '')}`;

const sections = [
	{
		slug: 'building-products',
		title: 'Building Products',
		purpose: 'What I’ve learned about product decisions by building, testing, and watching people use what I make.',
		entries: [
			{
				title: 'Let the outcome define the product',
				body: [
					`A product becomes easier to design once you can name the exact outcome it should create. That gives you a way to remove anything that doesn’t help someone reach that outcome and keep the product as small as it can be.`
				]
			},
			{
				title: 'High-stakes decisions need visible choices',
				body: [
					`The higher the stakes, the more of the decision people need to see. A single recommendation may be convenient, but for an expensive or consequential choice, show enough good options for someone to compare them and make the final decision themselves.`
				]
			},
			{
				title: 'Constrain the parts handled by AI',
				body: [
					`Use code for the parts of a workflow whose result you can define in advance. Use AI later, where the product needs judgment. Giving a model fewer decisions makes the workflow easier to understand and more reliable.`
				]
			},
			{
				title: 'Let actual use overturn the original design',
				body: [
					`Feedback matters most when several people expose the same mistaken assumption in the product. At that point, change the original design instead of preserving an idea that doesn’t fit how people want to use it.`
				]
			},
			{
				title: 'Keep the product narrow while making its components reusable',
				body: [
					`Keep the product’s job narrow while making the parts inside it reusable. Components such as scrapers, transcription, captions, structured files, and rendering can show up in many systems without turning the product itself into a general-purpose tool.`
				]
			}
		]
	},
	{
		slug: 'working-with-ai',
		title: 'Working with AI',
		purpose: 'How I design and work with agent-assisted systems.',
		entries: [
			{
				title: 'Keep judgment in the loop',
				body: [
					`Use code to prepare the facts and an agent to compare them with what you’re trying to do. Don’t automate the judgment out of a task before you understand what that judgment involves.`
				]
			},
			{
				title: 'Give agents small tools with clear jobs',
				body: [
					`A useful agent tool doesn’t need to do the whole job. It should remove a mechanical part, such as clicking through pages or copying information, so the agent can spend its time on the comparison or decision that matters.`
				]
			},
			{
				title: 'Understand the workflow before automating it',
				body: [
					`Automate a workflow in stages. Use the early versions to see what the task contains and where the agent gets stuck. Once you understand those steps, turn the repeated parts into code and leave the parts that need judgment to the agent.`
				]
			},
			{
				title: 'The human remains the executive',
				body: [
					`An agent can plan and do a great deal, but it doesn’t decide what kind of life or business you’re trying to build. You set the goals, choose the direction, and judge what comes back.`
				]
			},
			{
				title: 'Agents need context and procedure',
				body: [
					`Once you understand a repeated task, give the agent both context and a procedure. The context explains the situation. The procedure explains how to work through it. Without them, the agent has to invent both every time.`
				]
			},
			{
				title: 'Keep workflow boundaries narrow',
				body: [
					`Split large workflows into parts with clear inputs and outputs. This makes failures easier to locate and keeps one bad result from affecting everything that follows. Give the agent freedom inside the part that needs judgment, not across the whole system.`
				]
			},
			{
				title: 'Carry decisions into later tasks',
				body: [
					`Record decisions outside the conversation where you made them and update the work that follows. Otherwise every new agent can reopen a settled question or quietly make its own version of the decision.`
				]
			}
		]
	},
	{
		slug: 'business-and-independent-work',
		title: 'Business and Independent Work',
		purpose: 'What I’m learning while trying to build an independent practice without treating a temporary offer or customer group as permanent.',
		entries: [
			{
				title: 'Work on what changes the outcome',
				body: [
					`Ask whether the work you just did changed your situation. Improving the product may be the right answer, but sometimes the real problem is finding clients or delivering for the people already paying you. Comfortable work can still be avoidance.`
				]
			},
			{
				title: 'Treat sales as the beginning of a relationship',
				body: [
					`The first interaction doesn’t need to create a sale. Its job is to begin a useful professional relationship. Learn what someone is working on, pay attention, and help when you have something relevant to offer. A sales conversation can happen later if there is trust and a problem you can solve.`
				]
			},
			{
				title: 'Diagnose before proposing a solution',
				body: [
					`Understand what someone is working on and which parts are difficult before you propose anything. Sometimes the right response is advice, an introduction, or nothing. If there is a project, start the proposal from the person’s situation instead of the solution you arrived wanting to sell.`
				]
			},
			{
				title: 'A narrow customer group creates knowledge that compounds',
				body: [
					`A narrower customer group lets you keep learning the same processes, language, and recurring problems. Each conversation makes the next one easier, and you become more capable of offering something useful before asking for anything.`
				]
			},
			{
				title: 'Remove rules that do not change what you do next',
				body: [
					`A framework is useful when it makes the next action clearer. If it gives you more categories to maintain but still leads to the same action, remove it. Do the few things the business needs instead of designing the perfect business in advance.`
				]
			}
		]
	},
	{
		slug: 'learning-and-research',
		title: 'Learning and Research',
		purpose: 'How I turn information into something I can understand and use.',
		entries: [
			{
				title: 'Start with the capability, not the reading list',
				body: [
					`Choose what to study after you name what you want to be able to do. That might be understanding a business process, running a better client conversation, designing an AI workflow, or delivering a particular kind of project. The capability gives the reading list a reason to exist.`
				]
			},
			{
				title: 'Explain ideas aloud to test your understanding',
				body: [
					`Explaining an idea aloud forces you to reconstruct it without leaning on the source’s wording. The unclear parts become obvious when you can’t explain why one point leads to the next. The recording can then become a note, a research question, or the beginning of a piece of writing.`
				]
			},
			{
				title: 'Learn technical work through projects',
				body: [
					`Learn technical work by using it in a project. A real problem gives you a reason to study a tool or concept, and building with it makes you deal with the parts you could have skimmed past in a general explanation.`
				]
			}
		]
	},
	{
		slug: 'writing-and-communication',
		title: 'Writing and Communication',
		purpose: 'How I find ideas, develop them, and learn to explain them.',
		entries: [
			{
				title: 'Speak before judging the thought',
				body: [
					`Say the thought before deciding whether it is worth keeping. Most thoughts won’t become something public, and they don’t need to. Speaking gives the worthwhile ones enough time to take shape before you judge them.`
				]
			},
			{
				title: 'Walking and talking is rehearsal',
				body: [
					`Walking and talking gives you regular practice explaining ideas without stopping. By the time you sit in front of a camera or start writing, you have already found the thought, said it badly, and learned how you might say it again.`
				]
			},
			{
				title: 'Separate creating, editing, and implementing',
				body: [
					`Separate creating, editing, and implementing. Creating needs room for unfinished ideas. Editing decides which ideas are worth keeping. Implementing turns those decisions into writing or tasks. Mixing the three makes you judge ideas too early or start building them before you have compared them.`
				]
			},
			{
				title: 'Test an idea before expanding it',
				body: [
					`Before you build a system around an idea, look for the smallest experiment that can answer the remaining question. Another recording or a simple comparison usually teaches you more than adding machinery to an assumption.`
				]
			},
			{
				title: 'Use interviews when the source material is too thin',
				body: [
					`A voice note can name a subject without containing enough detail for public writing. A short interview can collect what happened, why you cared, and what changed your mind before the draft is written. Answer a few more questions instead of asking an AI to fill the gaps with a plausible version of you.`
				]
			}
		]
	},
	{
		slug: 'systems-and-attention',
		title: 'Systems and Attention',
		purpose: 'How I manage decisions, context, and limited attention.',
		entries: [
			{
				title: 'Keep decisions settled until something changes',
				body: [
					`Once you make a decision, don’t reopen it unless the situation changes or you learn something that gives you a reason. Otherwise the time after a decision becomes another round of comparison. Treating a choice as current rather than eternal lets you focus without pretending it can never change.`
				]
			},
			{
				title: 'Prefer simple frameworks that affect the next action',
				body: [
					`A framework should reduce choices and make the next action clearer. AI can make your tendency to overthink systems worse by producing an elaborate answer to every distinction you invent. If a framework doesn’t change what you do next, you probably don’t need it.`
				]
			},
			{
				title: 'Choose a work rhythm that fits the person and season',
				body: [
					`One work rhythm won’t be right for everyone or every period of life. What matters is whether the rhythm still serves the life you’re trying to build. The answer can change with your responsibilities, energy, and goals.`
				]
			},
			{
				title: 'Preserve decisions and context for future work',
				body: [
					`Keep goals, decisions, and important context in Markdown files so later work can continue from the same place. Otherwise a useful decision can disappear inside a conversation and the next task may repeat the research or move in another direction.`
				]
			}
		]
	},
	{
		slug: 'relationships-and-community',
		title: 'Relationships and Community',
		purpose: 'How other people fit into the way I think about work and life.',
		entries: [
			{
				title: 'Community is a value, not a networking strategy',
				body: [
					`Treat community as part of the kind of person you want to be. Be useful to individual people and the groups you’re part of. Some relationships may lead to work, but don’t look at the people around you as a source of introductions and clients.`
				]
			},
			{
				title: 'Money can be a tool; people cannot',
				body: [
					`Money is a tool you can use in service of other values. People are different. They aren’t instruments for reaching your goals, so decisions about work, moving, or money also have to account for the people who rely on you and what those decisions will do to their lives.`
				]
			},
			{
				title: 'Begin professional relationships with curiosity and usefulness',
				body: [
					`Begin professional relationships by understanding the person: what they are building, which problems they see, and whether you have anything useful to contribute. That might mean sharing an idea, making an introduction, or simply paying attention until you understand their work better.`
				]
			}
		]
	},
	{
		slug: 'health-and-training',
		title: 'Health and Training',
		purpose: 'What long-term strength training has taught me about goals and changing intensity over time.',
		entries: [
			{
				title: 'Strength training as a long-term identity',
				body: [
					`A practice can remain part of your identity even when its intensity changes. You don’t need to approach it with the same ambition every year for it to remain part of who you are.`
				]
			},
			{
				title: 'Simplify training around the goal',
				body: [
					`A clear goal makes it easier to simplify training. Organize the program around the lifts you want to improve and keep assistance work only when you know why it is there.`
				]
			},
			{
				title: 'More work is not always more progress',
				body: [
					`An exercise can be useful by itself and still make the whole program worse. Removing work gives you more time and recovery for the lifts you’re trying to improve. If the goal changes, the program can change with it.`
				]
			},
			{
				title: 'Training intensity moves through seasons',
				body: [
					`Training can remain part of your life without always being the largest goal. You can lower the intensity when other parts of life need more from you and push again when you have the desire and space.`
				]
			}
		]
	},
	{
		slug: 'life-philosophy',
		title: 'Life Philosophy',
		purpose: 'The values and open questions connecting the rest of these notes.',
		entries: [
			{
				title: 'Write down the values guiding your life',
				body: [
					`Write down the values guiding your life so you can compare a decision with the person you’re trying to become. Let the values keep one another in check. Ambition needs community, community needs truth, and simplicity can’t become an excuse to ignore a difficult fact.`
				]
			},
			{
				title: 'Money is a tool for expressing values',
				body: [
					`Money matters because it can create security, give you more control over your time, support people you love, and help you build useful things. It is important, but you still have to answer what it is for and what kind of life earning it is supposed to support.`
				]
			},
			{
				title: 'Make decisions without pretending they are permanent',
				body: [
					`Choosing one interest means setting others aside for a while. Make the decision and stop reconsidering it until the situation changes. You don’t have to pretend the choice will define the rest of your life; you only have to give it enough time to teach you something.`
				]
			},
			{
				title: 'A person’s way of working and living can change over time',
				body: [
					`There isn’t one final answer to how you should organize work, ambition, relationships, and rest. You learn who you are through experience, and the answer can change as your responsibilities and interests change. Trying to live an intentional life means continuing to ask what serves you now, your future self, and the people around you.`
				]
			}
		]
	}
];

---

<BaseLayout
	title={`${title} | Hanif Carroll`}
	description={description}
	bodyClass='hc-projects-archive hc-notes'
	showHeader={false}
	showFooterCta={false}
	showFooter={false}
>
	<div class='hc-archive-shell'>
		<details class='hc-notes-mobile-menu'>
			<summary>
				<span>Notes</span>
				<span class='hc-notes-mobile-menu__action'><span class='hc-notes-mobile-menu__open'>Table of Contents</span><span class='hc-notes-mobile-menu__close'>Close</span><svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M6 9l6 6 6-6'></path></svg></span>
			</summary>
			<div class='hc-notes-mobile-menu__panel'>
				<p class='hc-notes-toc-label'>Chapters</p>
				<nav aria-label='Mobile table of contents'>
					<ol class='hc-notes-mobile-toc'>
						{sections.map((section, sectionIndex) => (
							<li>
								<details class='hc-notes-mobile-section' open={sectionIndex === 0}>
									<summary><strong>{section.title}</strong><svg viewBox='0 0 24 24' width='18' height='18' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M6 9l6 6 6-6'></path></svg></summary>
									<ol>
										{section.entries.map((entry) => (
											<li><a href={`#${entryId(section.slug, entry.title)}`}>{entry.title}</a></li>
										))}
									</ol>
								</details>
							</li>
						))}
					</ol>
				</nav>
			</div>
		</details>

		<header class='hc-archive-header hc-notes-sidebar'>
			<div class='hc-notes-sidebar__brand'>
				<figure><Image src={Portrait} alt='Hanif Carroll' loading='eager' widths={[96, 192]} sizes='48px' /></figure>
				<div><a href='/'>Hanif Carroll</a><span>Notes</span></div>
			</div>

			<div class='hc-notes-sidebar__toc'>
				<nav class='hc-archive-nav' aria-label='Table of contents'>
					<ul>
						{sections.map((section, sectionIndex) => (
							<li class={`hc-notes-nav-section${sectionIndex === 0 ? ' is-active' : ''}`} data-notes-section>
								<a href={`#${section.slug}`} data-notes-section-link>
									<span class='hc-notes-nav-number' aria-hidden='true'>{String(sectionIndex + 1).padStart(2, '0')}</span>
									<span class='hc-archive-nav__text'>{section.title}</span>
								</a>
								<div
									class='hc-notes-nav-entries'
									data-notes-nav-entries
									inert={sectionIndex !== 0}
									aria-hidden={sectionIndex === 0 ? 'false' : 'true'}
								>
									<ol>
										{section.entries.map((entry) => (
											<li><a class='hc-notes-nav-entry' href={`#${entryId(section.slug, entry.title)}`}>{entry.title}</a></li>
										))}
									</ol>
								</div>
							</li>
						))}
					</ul>
				</nav>
			</div>

			<div class='hc-archive-header__footer'>
				<div class='hc-archive-header__actions'>
					<a
						class='hc-archive-resume'
						href='/Hanif-Carroll-Resume.pdf'
						download
						data-track-event='resume_downloaded'
						data-track-location='notes_rail'
					>
						Download résumé
					</a>
					<a
						class='hc-archive-inquiry'
						href={BOOK_CALL_URL}
						target='_blank'
						rel='noopener noreferrer'
						data-track-event='book_call_clicked'
						data-track-location='notes_rail'
					>
						Book a call <span aria-hidden='true'>&nearr;</span>
					</a>
				</div>

				<ul class='hc-archive-social' aria-label='Social media and contact'>
					<li>
						<a href='https://github.com/hanifcarroll' target='_blank' rel='noopener noreferrer' aria-label='GitHub (opens in a new tab)' title='GitHub'>
							<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22'></path></svg>
						</a>
					</li>
					<li>
						<a href='https://linkedin.com/in/hanifcarroll' target='_blank' rel='noopener noreferrer' aria-label='LinkedIn (opens in a new tab)' title='LinkedIn'>
							<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z'></path><rect x='2' y='9' width='4' height='12'></rect><circle cx='4' cy='4' r='2'></circle></svg>
						</a>
					</li>
					<li>
						<a href='https://x.com/hanifcarroll' target='_blank' rel='noopener noreferrer' aria-label='X, formerly Twitter (opens in a new tab)' title='X'>
							<svg viewBox='0 0 24 24' width='18' height='18' fill='currentColor' aria-hidden='true'><path d='M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'></path></svg>
						</a>
					</li>
					<li>
						<a href='https://www.threads.com/@hanifcarroll' target='_blank' rel='noopener noreferrer' aria-label='Threads (opens in a new tab)' title='Threads'>
							<svg viewBox='0 0 24 24' width='18' height='18' fill='currentColor' aria-hidden='true'><path d='M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221z'></path></svg>
						</a>
					</li>
					<li>
						<a href={EMAIL_URL} aria-label='Email' title='Email'>
							<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z'></path><polyline points='22,6 12,13 2,6'></polyline></svg>
						</a>
					</li>
				</ul>
			</div>
		</header>

		<main class='hc-archive-main'>
			<nav class='hc-archive-back' aria-label='Back to home'>
				<a href='/'>
					<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M19 12H5'></path><path d='M12 19l-7-7 7-7'></path></svg>
					Hanif Carroll
				</a>
			</nav>
			<header class='hc-notes-intro'>
				<h1>Notes</h1>
				<p>{description}</p>
			</header>

			{sections.map((section) => (
				<section id={section.slug} class='hc-archive-group hc-notes-group' aria-labelledby={`${section.slug}-title`}>
					<div class='hc-archive-section-label'>
						<h2 id={`${section.slug}-title`} class='hc-archive-section-title'>{section.title}</h2>
					</div>
					<div class='hc-archive-section-body'>
						<p class='hc-archive-group__description'>{section.purpose}</p>
						<ol class='hc-notes-entries'>
							{section.entries.map((entry, entryIndex) => (
								<li id={entryId(section.slug, entry.title)} class='hc-notes-entry'>
									<span class='hc-notes-entry__index' aria-hidden='true'>{String(entryIndex + 1).padStart(2, '0')}</span>
									<div>
										<h3>{entry.title}</h3>
										{entry.body.map((paragraph) => <p>{paragraph}</p>)}
									</div>
								</li>
							))}
						</ol>
					</div>
				</section>
			))}
		</main>
	</div>
</BaseLayout>

<script>
	const update = () => {
		const sections = document.querySelectorAll<HTMLElement>('.hc-archive-main section[id]');
		const links = document.querySelectorAll<HTMLAnchorElement>('[data-notes-section-link]');
		if (!sections.length || !links.length) return;

		const probe = window.scrollY + window.innerHeight * 0.35;
		let current = sections[0]?.id;
		sections.forEach((section) => {
			if (section.offsetTop <= probe) current = section.id;
		});

		links.forEach((link) => {
			const active = link.getAttribute('href') === `#${current}`;
			const section = link.closest('[data-notes-section]');
			const entries = section?.querySelector<HTMLElement>('[data-notes-nav-entries]');
			link.classList.toggle('is-active', active);
			section?.classList.toggle('is-active', active);
			entries?.toggleAttribute('inert', !active);
			entries?.setAttribute('aria-hidden', String(!active));
			if (active) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		});
	};

	let ticking = false;
	window.addEventListener('scroll', () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			update();
			ticking = false;
		});
	}, { passive: true });
	const setupMobileMenu = () => {
		const menu = document.querySelector<HTMLDetailsElement>('.hc-notes-mobile-menu');
		const trigger = menu?.querySelector<HTMLElement>(':scope > summary');
		const panel = menu?.querySelector<HTMLElement>('.hc-notes-mobile-menu__panel');
		if (!menu || !trigger || !panel || menu.dataset.ready) return;
		menu.dataset.ready = 'true';
		let animation: Animation | undefined;
		let closing = false;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const open = () => {
			closing = false;
			animation?.cancel();
			menu.open = true;
			if (reducedMotion.matches) return;
			animation = panel.animate(
				[
					{ opacity: 0, transform: 'translateY(-0.5rem)' },
					{ opacity: 1, transform: 'translateY(0)' }
				],
				{ duration: 220, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
			);
		};

		const close = () => {
			if (!menu.open || closing) return;
			closing = true;
			animation?.cancel();
			if (reducedMotion.matches) {
				menu.open = false;
				closing = false;
				return;
			}
			animation = panel.animate(
				[
					{ opacity: 1, transform: 'translateY(0)' },
					{ opacity: 0, transform: 'translateY(-0.25rem)' }
				],
				{ duration: 160, easing: 'ease-in', fill: 'forwards' }
			);
			animation.addEventListener('finish', () => {
				menu.open = false;
				closing = false;
			}, { once: true });
		};

		trigger.addEventListener('click', (event) => {
			event.preventDefault();
			if (menu.open && !closing) close();
			else open();
		});
		menu.addEventListener('toggle', () => document.documentElement.classList.toggle('hc-notes-menu-open', menu.open));
		menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
	};

	document.addEventListener('astro:page-load', () => {
		requestAnimationFrame(update);
		setupMobileMenu();
	});
</script>
