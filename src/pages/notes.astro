<script>
	const update = () => {
		const sections = document.querySelectorAll<HTMLElement>('.hc-archive-main section[id]');
		const links = document.querySelectorAll<HTMLAnchorElement>('[data-notes-section-link]');
		if (!sections.length || !links.length) return;

		const probe = window.scrollY + window.innerHeight * 0.35;
		let current = sections[0]?.id;
		sections.forEach((section) => {
			if (section.offsetTop <= probe) current = section.id;
		});

		links.forEach((link) => {
			const active = link.getAttribute('href') === `#${current}`;
			link.classList.toggle('is-active', active);
			link.closest('[data-notes-section]')?.classList.toggle('is-active', active);
			if (active) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		});
	};

	let ticking = false;
	window.addEventListener('scroll', () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			update();
			ticking = false;
		});
	}, { passive: true });
	const setupMobileMenu = () => {
		const menu = document.querySelector<HTMLDetailsElement>('.hc-notes-mobile-menu');
		const trigger = menu?.querySelector<HTMLElement>(':scope > summary');
		const panel = menu?.querySelector<HTMLElement>('.hc-notes-mobile-menu__panel');
		if (!menu || !trigger || !panel || menu.dataset.ready) return;
		menu.dataset.ready = 'true';
		let animation: Animation | undefined;
		let closing = false;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const open = () => {
			closing = false;
			animation?.cancel();
			menu.open = true;
			if (reducedMotion.matches) return;
			animation = panel.animate(
				[
					{ opacity: 0, transform: 'translateY(-0.5rem)' },
					{ opacity: 1, transform: 'translateY(0)' }
				],
				{ duration: 220, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
			);
		};

		const close = () => {
			if (!menu.open || closing) return;
			closing = true;
			animation?.cancel();
			if (reducedMotion.matches) {
				menu.open = false;
				closing = false;
				return;
			}
			animation = panel.animate(
				[
					{ opacity: 1, transform: 'translateY(0)' },
					{ opacity: 0, transform: 'translateY(-0.25rem)' }
				],
				{ duration: 160, easing: 'ease-in', fill: 'forwards' }
			);
			animation.addEventListener('finish', () => {
				menu.open = false;
				closing = false;
			}, { once: true });
		};

		trigger.addEventListener('click', (event) => {
			event.preventDefault();
			if (menu.open && !closing) close();
			else open();
		});
		menu.addEventListener('toggle', () => document.documentElement.classList.toggle('hc-notes-menu-open', menu.open));
		menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
	};

	document.addEventListener('astro:page-load', () => {
		requestAnimationFrame(update);
		setupMobileMenu();
	});
</script>
