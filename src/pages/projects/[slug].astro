---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCallout from '../../components/ServiceCallout.astro';
import TestimonialBillboard from '../../components/TestimonialBillboard.astro';
import ProjectVideo from '../../components/project-video/ProjectVideo.astro';
import type { Project } from '@src/lib/types/project';
import { getProject } from '@src/lib/projects';
import { getProjectImage } from '@src/lib/project-images';
import { getProjectTrackMeta } from '@src/lib/project-tracks';
import {
	DELISTED_PROJECT_SLUGS,
} from '@src/lib/project-curation';
import '../../styles/case-study.css';

interface PageProps {
	project: Project;
	caseStudy: CollectionEntry<'caseStudies'>;
}

export async function getStaticPaths() {
	const caseStudies = await getCollection('caseStudies');

	return caseStudies.map((caseStudy) => {
		const slug = caseStudy.id;
		const project = getProject(slug);

		if (!project) {
			throw new Error(`Missing project metadata for case study "${slug}".`);
		}

		return {
			params: { slug },
			props: { project, caseStudy }
		};
	});
}

const { project, caseStudy } = Astro.props as PageProps;
const trackMeta = getProjectTrackMeta(project.track);
const caseStudyVariant = trackMeta.ctaVariant;
const { Content } = await render(caseStudy);
const heroImage = getProjectImage(project, 'hero');
const heroWidths = [640, 960, 1280, 1600, 2000].filter((width) => width < heroImage.width);
heroWidths.push(heroImage.width);
const seoTitle = project.seoTitle ?? `${project.title} · Project`;
const seoDescription = project.seoDescription ?? project.description;
const isDelisted = (DELISTED_PROJECT_SLUGS as readonly string[]).includes(project.slug);
const canonicalUrl = new URL(`/projects/${project.slug}/`, Astro.site).toString();
const caseStudyJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.title,
	headline: seoTitle,
	description: seoDescription,
	url: canonicalUrl,
	creator: {
		'@type': 'Person',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/'
	},
	about: [project.client, project.service, ...project.technologies.slice(0, 6)],
	datePublished: project.year?.split('-')[0]
};

const caseStudyFacts = project.proofType === 'client'
	? [
			{ label: 'Engagement', value: project.service },
			{ label: 'Contribution', value: project.role },
			{ label: 'Year', value: project.year },
		]
	: [
			{ label: 'Role', value: project.role },
			{ label: 'Year', value: project.year },
			project.liveUrl && { label: 'Status', value: 'Live product' },
		].filter((detail): detail is { label: string; value: string } => Boolean(detail));
const coreTechnologies = project.technologies.slice(0, 6);

const overviewVideo = project.videos?.overview;

const heroActions = [
	project.liveUrl && {
		label: 'Visit live product',
		href: project.liveUrl,
		trackEvent: 'project_live_site_clicked',
		trackLocation: 'project_detail_hero',
		external: true
	},
	project.repository && {
		label: project.repositoryCtaLabel ?? 'View repository',
		href: project.repository,
		trackEvent: 'project_repository_clicked',
		trackLocation: 'project_detail_hero',
		external: true
	}
].filter((action): action is { label: string; href: string; trackEvent: string; trackLocation: string; external: boolean } =>
	Boolean(action)
);
---

<BaseLayout
	title={seoTitle}
	description={seoDescription}
	robots={isDelisted ? 'noindex, follow' : undefined}
	image={heroImage?.src}
	jsonLd={caseStudyJsonLd}
	showFooterCta={false}
	showFooter={false}
	bodyClass='page-case-study-detail'
>
	<article class='cs-shell'>
		<nav class='cs-breadcrumb' aria-label='Breadcrumb'>
			<a href='/' class='cs-breadcrumb__link'>
				<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M19 12H5'></path><path d='M12 19l-7-7 7-7'></path></svg>
				Hanif Carroll
			</a>
			<span class='cs-breadcrumb__sep' aria-hidden='true'>/</span>
			<a href='/projects/' class='cs-breadcrumb__link'>Projects</a>
		</nav>

		<header class='cs-hero' data-motion-intro>
			<div class='cs-hero__body'>
				<h1 class='cs-hero__title' data-motion='headline'>{project.title}</h1>
				<p class='cs-hero__description' data-motion-deck>{project.description}</p>
				{
					heroActions.length > 0 && (
						<div class='cs-hero__actions' data-motion-intro-item>
							{
								heroActions.map((action, index) => (
									<a
										class={index === 0 ? 'hc-button' : 'cs-hero__secondary'}
										href={action.href}
										target={action.external ? '_blank' : undefined}
										rel={action.external ? 'noopener noreferrer' : undefined}
										data-track-event={action.trackEvent}
										data-track-location={action.trackLocation}
									>
										{action.label}
									</a>
								))
							}
						</div>
					)
				}
			</div>

			<figure class='cs-project-hero'>
				<Image
					src={heroImage}
					alt={`${project.title} project visual`}
					widths={heroWidths}
					sizes='(min-width: 75rem) 1200px, 100vw'
					loading='eager'
					class:list={[
						'cs-project-hero__image',
						heroImage.height > heroImage.width && 'cs-project-hero__image--portrait',
					]}
				/>
			</figure>

			<aside
				class='cs-hero__facts'
				aria-label='Project facts'
				style={`--cs-fact-count: ${caseStudyFacts.length}`}
				data-motion-intro-item
			>
				{
					caseStudyFacts.map((detail) => (
						<div class='cs-hero__fact'>
							<p>{detail.label}</p>
							<strong>{detail.value}</strong>
						</div>
					))
				}
				{
					coreTechnologies.length > 0 && (
						<div class='cs-hero__stack'>
							<p>Built with</p>
							<ul aria-label='Core technologies'>
								{coreTechnologies.map((technology) => <li>{technology}</li>)}
							</ul>
						</div>
					)
				}
			</aside>
		</header>

		{
			overviewVideo && (
				<ProjectVideo video={overviewVideo} title={`Project overview · ${overviewVideo.duration}`} />
			)
		}


		<div class='cs-content'>
			<Content />
		</div>

		{
			project.proofQuote && (
				<TestimonialBillboard
					quote={project.proofQuote.quote}
					name={project.proofQuote.author}
					role={project.proofQuote.role ?? 'Client'}
					label='Client feedback'
				/>
			)
		}

		{
			project.relatedLinks && project.relatedLinks.length > 0 && (
				<nav class='cs-related' aria-labelledby={`related-${project.slug}`}>
					<p id={`related-${project.slug}`} class='cs-related__heading'>
						See another example
					</p>
					<div class='cs-related__links'>
						{project.relatedLinks.map((link) => (
							<a
								class='cs-related__link'
								href={link.href}
								data-track-event='related_case_study_clicked'
								data-track-location={`case_study_${project.slug}`}
							>
								{link.label}
							</a>
						))}
					</div>
				</nav>
			)
		}

		<ServiceCallout variant={caseStudyVariant} context='case-study' location={`case_study_${project.slug}`} />
	</article>
</BaseLayout>
