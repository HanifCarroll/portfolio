---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCallout from '../../components/ServiceCallout.astro';
import ImageLightbox from '../../components/case-study/ImageLightbox.astro';
import { clientDelivery, type ClientDeliverySlug } from '../../data/client-delivery';
import { testimonials } from '../../data/testimonials';
import type { Project } from '@src/lib/types/project';
import { getProject } from '@src/lib/projects';
import { getProjectImage } from '@src/lib/project-images';
import { getProjectTrackMeta } from '@src/lib/project-tracks';
import {
	DELISTED_PROJECT_SLUGS,
} from '@src/lib/project-curation';
import { buttonClass } from '@src/lib/ui';

interface PageProps {
	project: Project;
	caseStudy: CollectionEntry<'caseStudies'>;
}

export async function getStaticPaths() {
	const caseStudies = await getCollection('caseStudies');

	return caseStudies.map((caseStudy) => {
		const slug = caseStudy.id;
		const project = getProject(slug);

		if (!project) {
			throw new Error(`Missing project metadata for case study "${slug}".`);
		}

		return {
			params: { slug },
			props: { project, caseStudy }
		};
	});
}

const { project, caseStudy } = Astro.props as PageProps;
const delivery = clientDelivery[project.slug as ClientDeliverySlug];
const clientTestimonial = project.slug === 'genrupt'
	? testimonials.find((item) => item.name === 'Michael Shackelford')
	: project.slug === 'palabruno'
		? testimonials.find((item) => item.name === 'Valentin Zach')
		: undefined;
const trackMeta = getProjectTrackMeta(project.track);
const caseStudyVariant = trackMeta.ctaVariant;
const { Content } = await render(caseStudy);
const heroImage = getProjectImage(project, 'hero');
const heroWidths = [640, 960, 1280, 1600, 2000].filter((width) => width < heroImage.width);
heroWidths.push(heroImage.width);
const seoTitle = project.seoTitle ?? `${project.title} · Project`;
const seoDescription = project.seoDescription ?? project.description;
const isDelisted = (DELISTED_PROJECT_SLUGS as readonly string[]).includes(project.slug);
const canonicalUrl = new URL(`/projects/${project.slug}/`, Astro.site).toString();
const caseStudyJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.title,
	headline: seoTitle,
	description: seoDescription,
	url: canonicalUrl,
	creator: {
		'@type': 'Person',
		name: 'Hanif Carroll',
		url: 'https://www.hanifcarroll.com/'
	},
	about: [project.client, project.service, ...project.technologies.slice(0, 6)],
	datePublished: project.year?.split('-')[0]
};

const caseStudyFacts = project.proofType === 'client'
	? [
			{ label: 'Engagement', value: project.service },
			{ label: 'My responsibility', value: project.role },
			delivery && { label: 'Status', value: delivery.status },
			{ label: 'Year', value: project.year },
		].filter((detail): detail is { label: string; value: string } => Boolean(detail?.value))
	: [
			{ label: 'Role', value: project.role },
			{ label: 'Year', value: project.year },
			project.liveUrl && { label: 'Status', value: project.liveStatusLabel ?? (project.proofType === 'experiment' ? 'Live demo' : 'Live product') },
		].filter((detail): detail is { label: string; value: string } => Boolean(detail));
const coreTechnologies = project.technologies.slice(0, 6);

const heroActions = [
	project.liveUrl && {
		label: project.liveCtaLabel ?? delivery?.liveLabel ?? (project.proofType === 'experiment' ? 'Try live demo' : 'Visit live product'),
		href: project.liveUrl,
		trackEvent: 'project_live_site_clicked',
		trackLocation: 'project_detail_hero',
		external: true
	},
	project.repository && {
		label: project.repositoryCtaLabel ?? 'View repository',
		href: project.repository,
		trackEvent: 'project_repository_clicked',
		trackLocation: 'project_detail_hero',
		external: true
	}
].filter((action): action is { label: string; href: string; trackEvent: string; trackLocation: string; external: boolean } =>
	Boolean(action)
);

// The image lightbox finds its triggers through the cs-project-hero and cs-content hooks.
const breadcrumbLinkClass = 'group inline-flex items-center gap-[0.4rem] font-semibold text-ink-muted no-underline transition-colors duration-[160ms] ease-out-soft hover:text-accent-ink focus-visible:text-accent-ink';
const secondaryActionClass = "inline-flex min-h-[3.25rem] items-center gap-[0.4rem] text-base font-bold leading-[1.2] text-ink no-underline hover:text-accent-ink focus-visible:text-accent-ink after:text-accent-ink after:transition-transform after:duration-[240ms] after:ease-out-soft after:content-['→'] hover:after:translate-x-1 focus-visible:after:translate-x-1 motion-reduce:after:transition-none";
const factLabelClass = 'm-0 text-[0.65rem] font-bold uppercase leading-[1.3] tracking-[0.08em] text-ink-muted';
---

<BaseLayout
	title={seoTitle}
	description={seoDescription}
	robots={isDelisted ? 'noindex, follow' : undefined}
	image={heroImage?.src}
	jsonLd={caseStudyJsonLd}
	showFooterCta={false}
	bodyClass='page-case-study-detail'
>
	<article class='mx-auto w-full max-w-[1200px] px-6 pt-9 pb-28 md:px-14 md:pt-14 md:pb-32 max-sm:pb-0'>
		<nav class='mb-14 flex flex-wrap items-center gap-2 font-sans text-[0.875rem] max-lg:hidden' aria-label='Breadcrumb'>
			<a href='/' class={breadcrumbLinkClass}>
				<svg class='shrink-0 text-accent-ink transition-transform duration-[240ms] ease-out-soft group-hover:-translate-x-[3px] group-focus-visible:-translate-x-[3px] motion-reduce:transition-none' viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M19 12H5'></path><path d='M12 19l-7-7 7-7'></path></svg>
				Hanif Carroll
			</a>
			<span class='text-ink-muted opacity-55' aria-hidden='true'>/</span>
			<a href='/projects/' class={breadcrumbLinkClass}>Projects</a>
		</nav>

		<header class='mb-20 grid gap-10' data-motion-intro>
			<div class='grid max-w-[54rem] content-start gap-[1.1rem]'>
				<h1 class='m-0 font-editorial text-[clamp(2.75rem,5vw,4.5rem)] font-semibold leading-[0.98] tracking-[-0.02em] text-ink text-balance' data-motion='headline'>{project.title}</h1>
				<p class='m-0 max-w-[42rem] font-editorial text-[clamp(1.25rem,1.1rem+0.45vw,1.5rem)] leading-[1.4] text-ink-muted text-pretty' data-motion-deck>{project.description}</p>
				{
					heroActions.length > 0 && (
						<div class='flex flex-wrap items-center gap-x-5 gap-y-[0.9rem] pt-2' data-motion-intro-item>
							{
								heroActions.map((action, index) => (
									<a
										class={index === 0 ? buttonClass() : secondaryActionClass}
										href={action.href}
										target={action.external ? '_blank' : undefined}
										rel={action.external ? 'noopener noreferrer' : undefined}
										data-track-event={action.trackEvent}
										data-track-location={action.trackLocation}
									>
										{action.label}
									</a>
								))
							}
						</div>
					)
				}
			</div>

			<figure class='cs-project-hero m-0 w-full overflow-hidden bg-canvas'>
				<Image
					src={heroImage}
					alt={`${project.title} project visual`}
					widths={heroWidths}
					sizes='(min-width: 75rem) 1200px, 100vw'
					loading='eager'
					class:list={[
						'block h-auto',
						heroImage.height > heroImage.width ? 'mx-auto max-h-[44rem] w-auto max-w-full' : 'w-full',
					]}
				/>
			</figure>

			<aside
				class='grid grid-cols-1 gap-3 font-sans md:grid-cols-[repeat(var(--cs-fact-count),minmax(0,1fr))] md:gap-4'
				aria-label='Project facts'
				style={`--cs-fact-count: ${caseStudyFacts.length}`}
				data-motion-intro-item
			>
				{
					caseStudyFacts.map((detail) => (
						<div class='grid min-w-0 content-start gap-[0.2rem]'>
							<p class={factLabelClass}>{detail.label}</p>
							<strong class='text-[0.85rem] font-medium leading-[1.35] text-ink'>{detail.value}</strong>
						</div>
					))
				}
				{
					coreTechnologies.length > 0 && (
						<div class='col-span-full grid gap-1'>
							<p class={factLabelClass}>Built with</p>
							<ul class='m-0 flex list-none flex-wrap p-0 text-[0.8rem] font-medium leading-[1.4] text-ink' aria-label='Core technologies'>
								{coreTechnologies.map((technology) => <li class="not-last:after:mx-[0.55rem] not-last:after:text-accent-ink not-last:after:content-['·']">{technology}</li>)}
							</ul>
						</div>
					)
				}
			</aside>
		</header>

		<div class='cs-content grid'>
			<Content />
			{clientTestimonial && (
				<section class='border-t border-line py-8' aria-label='Client feedback'>
					<h2>Working together</h2>
					<blockquote class='mx-0 mt-4 mb-0 border-l-2 border-accent pl-5'>
						<p class='leading-[1.75]'>{clientTestimonial.quote}</p>
						<footer><cite class='text-[0.9rem] not-italic text-ink-muted'>{clientTestimonial.name} · {clientTestimonial.role}</cite></footer>
					</blockquote>
				</section>
			)}
		</div>

		<ServiceCallout variant={caseStudyVariant} context='case-study' location={`case_study_${project.slug}`} />
	</article>
	<ImageLightbox zoomable={project.slug === 'desarmadero-operations-prototype'} />
</BaseLayout>
