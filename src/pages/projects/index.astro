---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVideoCard from '../../components/project-video/ProjectVideoCard.astro';
import { projects } from '../../lib/project-cards';
import { PROJECT_INDEX_ORDER } from '../../lib/project-curation';

const title = 'Case Studies';
const description = 'Selected client and independent projects showing workflow diagnosis, product decisions, software systems, and supported results.';

const orderProjects = (projectList: typeof projects, preferredOrder: readonly string[]) => {
	const orderMap = new Map(preferredOrder.map((slug, index) => [slug, index]));

	return [...projectList].sort((a, b) => {
		const aIndex = orderMap.get(a.slug) ?? Number.MAX_SAFE_INTEGER;
		const bIndex = orderMap.get(b.slug) ?? Number.MAX_SAFE_INTEGER;
		return aIndex - bIndex;
	});
};

const orderedProjects = orderProjects(projects, PROJECT_INDEX_ORDER);
---

<BaseLayout title={`${title} | Hanif Carroll`} description={description} bodyClass='page-projects-index'>
	<article class='projects-index'>
		<div class='projects-index__catalog hc-container-wide'>
			<aside class='projects-index__rail' data-motion-intro>
				<p class='projects-index__label'>Case studies</p>
				<h1 data-motion-headline>Selected client and independent projects.</h1>
				<p class='projects-index__intro' data-motion-deck>Systems, launches, and operating tools, with the decisions and evidence behind them.</p>
				<div class='projects-index__filters' aria-label='Filter case studies'><button class='is-active' type='button' data-project-filter='all' aria-pressed='true'>All</button><button type='button' data-project-filter='client' aria-pressed='false'>Client</button><button type='button' data-project-filter='independent' aria-pressed='false'>Independent</button></div>
			</aside>
			<section class='projects-index__ranked-work' aria-label='Project work' data-motion-section>
				{orderedProjects.map((project, index) => <ProjectVideoCard project={project} variant='card' index={index + 1} />)}
			</section>
		</div>
	</article>
</BaseLayout>

<script>
	const installProjectFilters = () => {
		const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
		const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-proof]'));
		buttons.forEach((button) => {
			if (button.dataset.filterReady === 'true') return;
			button.dataset.filterReady = 'true';
			button.addEventListener('click', () => {
			const filter = button.dataset.projectFilter ?? 'all';
			buttons.forEach((item) => { const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', String(active)); });
			cards.forEach((card) => {
				const isClient = card.dataset.projectProof === 'client';
				card.hidden = filter === 'client' ? !isClient : filter === 'independent' ? isClient : false;
			});
			});
		});
	};
	installProjectFilters();
	document.addEventListener('astro:page-load', installProjectFilters);
</script>
