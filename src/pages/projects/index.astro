---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveProjectRow from '../../components/ArchiveProjectRow.astro';
import { projects } from '../../lib/project-cards';
import {
	DELISTED_PROJECT_SLUGS,
	NESTED_PROJECT_SLUGS,
	PROJECT_ARCHIVE_GROUPS,
} from '../../lib/project-curation';

const title = 'Projects';
const description =
	'Forward deployed engineering: client discovery, operational software, production AI, and independent products.';

const projectBySlug = new Map(projects.map((project) => [project.slug, project]));

const selectProjects = (slugs: readonly string[]) =>
	slugs.map((slug) => {
		const project = projectBySlug.get(slug);
		if (!project) throw new Error(`Missing project metadata for "${slug}".`);
		return project;
	});

const allCategorizedSlugs = PROJECT_ARCHIVE_GROUPS.flatMap((group) => group.slugs);
const duplicateSlugs = allCategorizedSlugs.filter(
	(slug, index) => allCategorizedSlugs.indexOf(slug) !== index,
);
if (duplicateSlugs.length > 0) {
	throw new Error(
		`Projects archive contains duplicate slugs: ${[...new Set(duplicateSlugs)].join(', ')}`,
	);
}

const delistedSet = new Set<string>([...DELISTED_PROJECT_SLUGS, ...NESTED_PROJECT_SLUGS]);
const categorizedSlugSet = new Set<string>(allCategorizedSlugs);
const uncategorizedProjects = projects.filter(
	(project) => !categorizedSlugSet.has(project.slug) && !delistedSet.has(project.slug),
);
if (uncategorizedProjects.length > 0) {
	throw new Error(
		`Projects need an archive group or delist tier: ${uncategorizedProjects.map((project) => project.slug).join(', ')}`,
	);
}

const groups = PROJECT_ARCHIVE_GROUPS.map((group) => ({
	...group,
	projects: selectProjects(group.slugs),
}));

const archiveJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: title,
	description,
	url: new URL('/projects/', Astro.site).toString(),
};
---

<BaseLayout
	title={`${title} | Hanif Carroll`}
	description={description}
	jsonLd={archiveJsonLd}
	showFooterCta={false}
>
	<div class='mx-auto w-full max-w-page px-6 pb-24 md:px-12'>
		<header class='max-w-reading pt-12 pb-14 lg:pt-20 lg:pb-20'>
			<h1 class='m-0 text-[clamp(2.25rem,5vw,3.5rem)] font-bold leading-none tracking-[-0.035em] text-ink'>Projects</h1>
			<p class='mt-4 mb-0 text-lg leading-relaxed text-ink-muted'>Client engagements and independent products — the situation, my decisions, and what I delivered.</p>
		</header>

		{groups.map((group) => (
			<section id={group.id} class='grid scroll-mt-24 gap-6 border-t border-rule py-14 lg:grid-cols-12 lg:gap-12 lg:py-20' aria-labelledby={`${group.id}-title`}>
				<div class='lg:col-span-5'>
					<h2 id={`${group.id}-title`} class='m-0 text-xs font-bold uppercase tracking-[0.07em] text-ink'>{group.label}</h2>
					<p class='mt-4 mb-0 max-w-sm text-base leading-relaxed text-ink-muted'>{group.description}</p>
				</div>
				<ol class='m-0 grid list-none gap-10 p-0 lg:col-span-7'>
					{group.projects.map((project) => (
						<ArchiveProjectRow project={project} />
					))}
				</ol>
			</section>
		))}
	</div>
</BaseLayout>
