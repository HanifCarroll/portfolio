---
import { Image } from 'astro:assets';
import OneTuesdayHero from '../../assets/img/projects/framed/one-tuesday.png';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BOOK_CALL_URL, EMAIL_URL } from '../../consts';
import { getLocale, localizedPath } from '../../i18n';
import { getProject, localizeProject } from '../../lib/projects';
import { getTuesdayCopy, ONE_TUESDAY_PATH } from '../../lib/tuesday-sim/copy';
import { getTuesdayStory, TUESDAY_RESULTS } from '../../lib/tuesday-sim/story';
import { buttonClass, closingActionsClass, closingButtonClass, closingClass, closingLinkClass, shellClass } from '../../lib/ui';
import '../../styles/tuesday.css';

const locale = getLocale(Astro.currentLocale);
const copy = getTuesdayCopy(locale);
const { reader } = copy;
const { chapters, statements, readouts, assumptions } = getTuesdayStory(locale);
const baseProject = getProject('one-tuesday');
if (!baseProject) throw new Error('Missing project metadata for one-tuesday.');
const project = localizeProject(baseProject, locale);
const title = project.seoTitle ?? project.title;
const description = project.seoDescription ?? project.description;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  url: new URL(localizedPath(ONE_TUESDAY_PATH, locale), Astro.site).toString(),
  creator: { '@type': 'Person', name: 'Hanif Carroll', url: 'https://www.hanifcarroll.com/' },
};
const { before, after, stressedBefore, stressedAfter } = TUESDAY_RESULTS;
const handledGain = after.completed - before.completed;
const carriedReduction = before.carried - after.carried;
const coordinationReduction = before.manualMinutes - after.manualMinutes;
const { duration, hours } = copy;

// Reader mode: generic element rules use :where() so per-section overrides (specificity 0,1,1) win.
const readerClass = [
  // The shared page box, so the text lines up with the header; each block keeps the reading measure.
  `${shellClass} pt-12 pb-[clamp(6rem,12vw,10rem)] text-[1.125rem] leading-[1.65] text-ink lg:pt-20 [&>*]:max-w-reading [body.tuesday-live_&]:hidden`,
  '[&_:where(h1,h2,h3)]:font-editorial [&_:where(h1,h2,h3)]:font-normal',
  '[&_:where(h1)]:mb-6 [&_:where(h1)]:text-[clamp(3rem,7vw,5.25rem)] [&_:where(h1)]:leading-none [&_:where(h1)]:tracking-[-0.045em]',
  '[&_:where(h2)]:mt-20 [&_:where(h2)]:mb-4 [&_:where(h2)]:text-[clamp(2rem,3.6vw,3rem)] [&_:where(h2)]:leading-[1.02] [&_:where(h2)]:tracking-[-0.035em]',
  '[&_:where(h3)]:mt-8 [&_:where(h3)]:mb-2 [&_:where(h3)]:text-[1.625rem] [&_:where(h3)]:leading-[1.18]',
  '[&_:where(h1,h2,h3)[tabindex=\'-1\']]:scroll-mt-28',
  '[&_:where(p)]:mb-6',
  '[&_:where(table)]:my-6 [&_:where(table)]:w-full [&_:where(table)]:border-collapse [&_:where(table)]:text-base [&_:where(table)]:leading-[1.65] max-[900px]:[&_:where(table)]:block max-[900px]:[&_:where(table)]:max-w-full max-[900px]:[&_:where(table)]:overflow-x-auto',
  '[&_:where(th,td)]:border-b [&_:where(th,td)]:border-rule [&_:where(th,td)]:px-3 [&_:where(th,td)]:py-[10px] [&_:where(th,td)]:text-left',
  '[&_:where(th)]:font-normal [&_:where(th)]:text-ink-muted',
];
---

<BaseLayout
  title={title}
  description={description}
  image={OneTuesdayHero.src}
  jsonLd={jsonLd}
  showFooterCta={false}
  bodyClass='page-one-tuesday'
>
  <div id='tuesday-experience-root' data-locale={locale}></div>

  <article id='tuesday-reader' tabindex='-1' class:list={readerClass}>
    <p class='text-base uppercase leading-[1.3] tracking-[0.12em] text-ink-muted'>{copy.kicker}</p>
    <h1>{copy.title}</h1>
    <p class='text-[1.25rem] text-ink-muted'>{copy.company}</p>
    <p class='text-[1.25rem] text-ink-muted'>{reader.intro(before.arrivals)}</p>

    <figure class='cs-project-hero mx-0 my-8'>
      <Image
        src={OneTuesdayHero}
        alt={reader.heroAlt}
        widths={[640, 960, 1200]}
        sizes='(min-width: 44rem) 41rem, calc(100vw - 3rem)'
        loading='eager'
        class='block h-auto w-full'
      />
    </figure>

    <div class='my-12 [&_p]:mb-4'>
      <p>{reader.launchNote}</p>
      <button type='button' class={buttonClass()} data-tuesday-launch disabled>{reader.launch}</button>
    </div>

    <h2 id='tuesday-reader-old' tabindex='-1'>{reader.old}</h2>
    <p>{reader.intake}</p>
    <p>{reader.status}</p>
    <p>{reader.day(before.arrivals)}</p>
    <table>
      <thead><tr><th>{reader.measure}</th><th>{copy.old}</th></tr></thead>
      <tbody>
        <tr><td>{reader.arrivals}</td><td>{before.arrivals}</td></tr>
        <tr><td>{reader.handled}</td><td>{before.completed}</td></tr>
        <tr><td>{reader.forgotten}</td><td>{before.dropped}</td></tr>
        <tr><td>{reader.carried}</td><td>{before.carried}</td></tr>
        <tr><td>{reader.duplicates}</td><td>{before.duplicates}</td></tr>
        <tr><td>{reader.angry}</td><td>{before.complaints}</td></tr>
        <tr><td>{reader.average}</td><td>{duration(before.avgWaitMinutes)}</td></tr>
        <tr><td>{reader.manual}</td><td>{hours(before.manualMinutes)}</td></tr>
      </tbody>
    </table>
    <p>{reader.coordination}</p>

    <h2 id='tuesday-reader-build' tabindex='-1'>{reader.build}</h2>
    <p>{reader.changes}</p>
    {chapters.map((chapter) => (
      <section>
        <h3>{chapter.week}: {chapter.title}</h3>
        {chapter.body.map((paragraph) => <p>{paragraph}</p>)}
        <p class='text-base leading-[1.65] text-ink-muted'>{chapter.stageNote}</p>
      </section>
    ))}

    <h2 id='tuesday-reader-new' tabindex='-1'>{reader.compare(before.arrivals)}</h2>
    <p>{copy.sameRequests(before.arrivals, ':')}</p>
    <table>
      <thead><tr><th>{reader.measure}</th><th>{copy.old}</th><th>{copy.new}</th></tr></thead>
      <tbody>
        <tr><td>{reader.handled}</td><td>{before.completed}</td><td>{after.completed}</td></tr>
        <tr><td>{reader.forgotten}</td><td>{before.dropped}</td><td>{after.dropped}</td></tr>
        <tr><td>{reader.carried}</td><td>{before.carried}</td><td>{after.carried}</td></tr>
        <tr><td>{reader.duplicates}</td><td>{before.duplicates}</td><td>{after.duplicates}</td></tr>
        <tr><td>{reader.angry}</td><td>{before.complaints}</td><td>{after.complaints}</td></tr>
        <tr><td>{reader.average}</td><td>{duration(before.avgWaitMinutes)}</td><td>{duration(after.avgWaitMinutes)}</td></tr>
        <tr><td>{reader.manual}</td><td>{hours(before.manualMinutes)}</td><td>{hours(after.manualMinutes)}</td></tr>
      </tbody>
    </table>
    <p>{reader.comparison(handledGain, carriedReduction, hours(coordinationReduction))}</p>

    <div>
      <h2>{reader.stress}</h2>
      <p>{reader.stressSetup}</p>
      <table>
        <thead><tr><th>{reader.underStress}</th><th>{copy.old}</th><th>{copy.new}</th></tr></thead>
        <tbody>
          <tr><td>{reader.arrivals}</td><td>{stressedBefore.arrivals}</td><td>{stressedAfter.arrivals}</td></tr>
          <tr><td>{reader.forgotten}</td><td>{stressedBefore.dropped}</td><td>{stressedAfter.dropped}</td></tr>
          <tr><td>{reader.carried}</td><td>{stressedBefore.carried}</td><td>{stressedAfter.carried}</td></tr>
          <tr><td>{reader.angry}</td><td>{stressedBefore.complaints}</td><td>{stressedAfter.complaints}</td></tr>
        </tbody>
      </table>

      <h2>{reader.assumptions}</h2>
      <dl class='grid gap-4'>
        {assumptions.map((assumption) => (
          <div>
            <dt class='m-0 font-semibold'>{assumption.parameter}</dt>
            <dd class='mt-1 mb-0 ml-0 text-ink-muted'>{assumption.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <h2 id='tuesday-reader-mirror' tabindex='-1'>{reader.mirrorQuestion}</h2>
    <p>{reader.instructions}</p>
    <fieldset class='my-4 flex flex-col gap-2 border-0 p-0' data-tuesday-reader-mirror>
      <legend class='sr-only'>{reader.legend}</legend>
      {statements.map((statement) => (
        <div class='flex items-center justify-between gap-6 py-3 max-[900px]:flex-col max-[900px]:items-start [&_p]:m-0' data-tuesday-reader-statement>
          <p>{statement}</p>
          <div class='flex shrink-0 gap-2' role='group' aria-label={statement}>
            <button type='button' class='t4-choice' data-tuesday-reader-answer='yes' aria-pressed='false'>{copy.yes}</button>
            <button type='button' class='t4-choice' data-tuesday-reader-answer='no' aria-pressed='false'>{copy.no}</button>
          </div>
        </div>
      ))}
    </fieldset>
    <output class='mb-6 block text-base leading-[1.65] text-ink-muted' data-tuesday-reader-total={reader.answered('{answered}', statements.length)} aria-live='polite'>
      {reader.answered(0, statements.length)}
    </output>
    <div class='mb-6' data-tuesday-reader-readouts role='status' aria-live='polite' hidden>
      {readouts.map((readout) => (
        <div class='py-2 motion-safe:[&.is-visible]:animate-[t4-result-in_420ms_var(--ease-out-soft)] [&_h3]:mt-0 [&_h3]:mb-2 [&_p]:m-0 [&_p]:text-ink-muted' data-min={readout.min} data-max={readout.max} hidden>
          <h3>{readout.headline}</h3>
          <p>{readout.body}</p>
        </div>
      ))}
    </div>
  </article>

  <!-- The reader's closing, in the same ink block as the shared closing. -->
  <section class:list={[closingClass, '[body.tuesday-live_&]:hidden']} data-section='closing-cta'>
    <div class={shellClass}>
      <p class='mx-auto mb-0 max-w-[46rem] font-editorial text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.12] tracking-[-0.02em] text-white text-balance'>{reader.closing}</p>
      <div class={closingActionsClass}>
        <a
          class={closingButtonClass}
          href={BOOK_CALL_URL}
          target='_blank'
          rel='noopener noreferrer'
          data-track-event='book_call_clicked'
          data-track-location='one_tuesday_reader'
        >{copy.booking}</a>
        <a
          class={closingLinkClass}
          href={EMAIL_URL}
          data-track-event='email_clicked'
          data-track-location='one_tuesday_reader'
        >{reader.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import type { Root } from 'react-dom/client';

  let experienceRoot: Root | undefined;
  let experienceContainer: HTMLElement | null = null;
  let experienceLoad: Promise<void> | undefined;

  const loadExperience = async () => {
    const container = document.getElementById('tuesday-experience-root');
    if (!container) return;

    if (experienceRoot && experienceContainer === container) {
      window.dispatchEvent(new CustomEvent('tuesday:launch'));
      return;
    }

    experienceLoad ??= Promise.all([
      import('../../components/tuesday/TuesdayExperience'),
      import('react'),
      import('react-dom/client'),
    ]).then(([{ default: TuesdayExperience }, { createElement }, { createRoot }]) => {
      experienceContainer = container;
      experienceRoot = createRoot(container);
      experienceRoot.render(createElement(TuesdayExperience, { locale: container.dataset.locale === 'es' ? 'es' : 'en' }));
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => window.scrollTo({ top: 0, behavior: 'auto' }));
      });
    }).finally(() => {
      experienceLoad = undefined;
    });

    await experienceLoad;
  };

  const enableLaunchButtons = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-tuesday-launch]').forEach((button) => {
      button.disabled = false;
    });
  };

  const initializeReaderMirror = () => {
    const mirror = document.querySelector<HTMLFieldSetElement>('[data-tuesday-reader-mirror]');
    const total = document.querySelector<HTMLOutputElement>('[data-tuesday-reader-total]');
    const readouts = document.querySelector<HTMLElement>('[data-tuesday-reader-readouts]');
    if (!mirror || !total || !readouts || mirror.dataset.ready === 'true') return;

    mirror.dataset.ready = 'true';
    const statements = [...mirror.querySelectorAll<HTMLElement>('[data-tuesday-reader-statement]')];
    const resultCards = [...readouts.querySelectorAll<HTMLElement>('[data-min][data-max]')];

    mirror.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const answer = event.target.closest<HTMLButtonElement>('[data-tuesday-reader-answer]');
      const statement = answer?.closest<HTMLElement>('[data-tuesday-reader-statement]');
      if (!answer || !statement || !mirror.contains(answer)) return;

      statement.dataset.answer = answer.dataset.tuesdayReaderAnswer;
      statement.querySelectorAll<HTMLButtonElement>('[data-tuesday-reader-answer]').forEach((button) => {
        button.classList.toggle('is-on', button === answer);
        button.setAttribute('aria-pressed', String(button === answer));
      });

      const answered = statements.filter((item) => item.dataset.answer).length;
      const score = statements.filter((item) => item.dataset.answer === 'yes').length;
      total.value = total.dataset.tuesdayReaderTotal?.replace('{answered}', String(answered)) ?? '';

      resultCards.forEach((card) => {
        card.hidden = true;
        card.classList.remove('is-visible');
      });
      if (answered < statements.length) {
        readouts.hidden = true;
        return;
      }

      readouts.hidden = false;
      resultCards.forEach((card) => {
        const min = Number(card.dataset.min);
        const max = Number(card.dataset.max);
        const matches = score >= min && score <= max;
        card.hidden = !matches;
        card.classList.toggle('is-visible', matches);
      });
    });
  };

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const launch = event.target.closest('[data-tuesday-launch]');
    if (!launch) return;
    void loadExperience();
  });

  const initializePage = () => {
    enableLaunchButtons();
    initializeReaderMirror();

    if (window.matchMedia('(min-width: 901px)').matches) {
      void loadExperience();
    }
  };

  document.addEventListener('astro:page-load', initializePage);
  initializePage();
</script>
