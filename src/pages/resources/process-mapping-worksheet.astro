---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/process-mapping-worksheet.css';

const title = 'Free Process-Mapping Worksheet | Hanif Carroll';
const description =
	'Map one business workflow from trigger to outcome, identify handoffs and delays, and choose the smallest useful change with this free printable worksheet.';

const stepRows = Array.from({ length: 6 }, (_, index) => index + 1);
---

<BaseLayout
	title={title}
	description={description}
	bodyClass='page-process-worksheet'
	showFooterCta={false}
>
	<article class='worksheet-page'>
		<header class='worksheet-hero' data-header-surface='dark'>
			<div class='hc-container worksheet-hero__inner'>
				<div class='worksheet-hero__content'>
					<p class='worksheet-eyebrow'>Free process-mapping worksheet</p>
					<h1>Map one workflow before choosing what to fix.</h1>
					<p class='worksheet-hero__intro'>Use this worksheet with the people who do the work. Walk through one recent example, mark where information changes hands or waits, then choose one change to test.</p>
					<div class='worksheet-actions'>
						<a class='hc-button' href='#worksheet'>Start the worksheet</a>
						<button class='hc-button worksheet-print-button' type='button' data-print-worksheet data-track-location='hero'>Print or save</button>
						<a
							class='hc-text-link worksheet-example-link'
							href='/blog/business-process-mapping-examples/#completed-worksheet-example'
							data-track-event='worksheet_example_clicked'
							data-track-location='hero'
						>
							See a completed example
						</a>
					</div>
					<p class='worksheet-hero__meta'>Seven guided sections · Leave with one change to test · No email required</p>
				</div>
				<figure class='worksheet-hero__visual'>
					<img
						src='/resources/process-mapping-worksheet/worksheet-hero-transparent.png'
						alt='Process-mapping worksheet with workflow steps, handoffs, and a highlighted decision point'
						width='781'
						height='873'
						loading='eager'
						fetchpriority='high'
					/>
				</figure>
			</div>
		</header>

		<form id='worksheet' class='hc-container worksheet' aria-label='Business process mapping worksheet' data-worksheet-form novalidate>
			<div class='worksheet-draft-controls'>
				<p data-draft-status role='status' aria-live='polite'>Your draft saves privately in this browser.</p>
				<button type='button' data-clear-worksheet>Clear worksheet</button>
			</div>

			<section id='worksheet-section-1' class='worksheet-card worksheet-card--wide'>
				<div class='worksheet-card__number' aria-hidden='true'>01</div>
				<div>
					<h2>Name the workflow and its boundary</h2>
					<p>Use a trigger-to-outcome name. Keep the scope narrow enough to walk through in one conversation.</p>
					<div class='worksheet-fields worksheet-fields--three'>
						<label>Workflow name <input type='text' name='workflow-name' placeholder='Customer request to completed field job' /></label>
						<label>Starts when <input type='text' name='starts-when' /></label>
						<label>Finished when <input type='text' name='finished-when' /></label>
					</div>
				</div>
			</section>

			<div class='worksheet-grid'>
				<section id='worksheet-section-2' class='worksheet-card'>
					<div class='worksheet-card__number' aria-hidden='true'>02</div>
					<div>
						<h2>List the people</h2>
						<p>Who creates, changes, approves, receives, or reports on the work?</p>
						<label>People and roles <textarea name='people' rows='5' placeholder='Coordinator, field technician, approver'></textarea></label>
					</div>
				</section>

				<section id='worksheet-section-3' class='worksheet-card'>
					<div class='worksheet-card__number' aria-hidden='true'>03</div>
					<div>
						<h2>List the tools and records</h2>
						<p>Include inboxes, chat, forms, spreadsheets, systems, paper notes, and memory.</p>
						<label>Tools and records <textarea name='tools' rows='5' placeholder='Shared inbox, scheduling spreadsheet, invoicing system'></textarea></label>
					</div>
				</section>
			</div>

			<section id='worksheet-section-4' class='worksheet-card worksheet-card--wide worksheet-card--walkthrough'>
				<div class='worksheet-card__number' aria-hidden='true'>04</div>
				<div>
					<h2>Walk through one recent example</h2>
					<p>Write what actually happened, including rework and unofficial steps. Use one row per action and add another step whenever you need it.</p>
					<div class='worksheet-table-wrap'>
						<table>
							<thead>
								<tr><th scope='col'>Step</th><th scope='col'>What happened?</th><th scope='col'>Who owned it?</th><th scope='col'>Where was it recorded?</th><th scope='col'>What waited or went wrong?</th></tr>
							</thead>
							<tbody data-step-body>
								{stepRows.map((number) => (
									<tr data-step-row>
										<th scope='row' data-step-number>{number}</th>
										<td data-label='What happened?'><textarea name={`step-${number}-action`} rows='2' data-step-field='action' aria-label={`Step ${number} action`} placeholder={number === 1 ? 'Customer emails a request' : undefined}></textarea></td>
										<td data-label='Who owned it?'><textarea name={`step-${number}-owner`} rows='2' data-step-field='owner' aria-label={`Step ${number} owner`} placeholder={number === 1 ? 'Coordinator' : undefined}></textarea></td>
										<td data-label='Where was it recorded?'><textarea name={`step-${number}-record`} rows='2' data-step-field='record' aria-label={`Step ${number} record`} placeholder={number === 1 ? 'Shared inbox' : undefined}></textarea></td>
										<td data-label='What waited or went wrong?'><textarea name={`step-${number}-problem`} rows='2' data-step-field='problem' aria-label={`Step ${number} wait or problem`} placeholder={number === 1 ? 'Details were missing' : undefined}></textarea></td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
					<button class='worksheet-add-step' type='button' data-add-step>Add another step</button>
					<template data-step-row-template>
						<tr data-step-row>
							<th scope='row' data-step-number>0</th>
							<td data-label='What happened?'><textarea name='step-0-action' rows='2' data-step-field='action' aria-label='Step 0 action'></textarea></td>
							<td data-label='Who owned it?'><textarea name='step-0-owner' rows='2' data-step-field='owner' aria-label='Step 0 owner'></textarea></td>
							<td data-label='Where was it recorded?'><textarea name='step-0-record' rows='2' data-step-field='record' aria-label='Step 0 record'></textarea></td>
							<td data-label='What waited or went wrong?'><textarea name='step-0-problem' rows='2' data-step-field='problem' aria-label='Step 0 wait or problem'></textarea></td>
						</tr>
					</template>
				</div>
			</section>

			<div class='worksheet-grid'>
				<section id='worksheet-section-5' class='worksheet-card'>
					<div class='worksheet-card__number' aria-hidden='true'>05</div>
					<div>
						<h2>Mark decisions and exceptions</h2>
						<p>What changes the path? What happens when details are missing, approval is late, or the usual owner is unavailable?</p>
						<label>Decisions and exceptions <textarea name='decisions' rows='6' placeholder='If details are missing, the coordinator asks the customer before scheduling'></textarea></label>
					</div>
				</section>

				<section id='worksheet-section-6' class='worksheet-card'>
					<div class='worksheet-card__number' aria-hidden='true'>06</div>
					<div>
						<h2>Mark handoffs and waits</h2>
						<p>Where does responsibility or information move? Name the next owner, expected time, and sign that the handoff is complete.</p>
						<label>Handoffs and waits <textarea name='handoffs' rows='6' placeholder='Coordinator → technician when the job is scheduled'></textarea></label>
					</div>
				</section>
			</div>

			<section id='worksheet-section-7' class='worksheet-card worksheet-card--wide worksheet-decision'>
				<div class='worksheet-card__number' aria-hidden='true'>07</div>
				<div>
					<h2>Choose the first useful change</h2>
					<p>Start with the gap that makes status, ownership, or the next action hard to trust.</p>
					<div class='worksheet-fields worksheet-fields--two'>
						<label>Where is the trusted status now? <textarea name='trusted-status' rows='3'></textarea></label>
						<label>What is the main bottleneck? <textarea name='bottleneck' rows='3'></textarea></label>
						<label>What is the smallest change to test? <textarea name='first-change' rows='3'></textarea></label>
						<label>What will you review after the trial? <textarea name='review-after-trial' rows='3'></textarea></label>
					</div>
				</div>
			</section>
		</form>

		<section class='worksheet-next'>
			<div class='hc-container worksheet-next__inner'>
				<div>
					<h2>Save the map. Test one change.</h2>
					<p>Keep the worksheet with the team and review what changes after the trial. If the right fix is still unclear, that's the signal to dig deeper into the workflow before building.</p>
				</div>
				<div class='worksheet-next__actions'>
					<button class='hc-button worksheet-print-button' type='button' data-print-worksheet data-track-location='completion'>Print or save the worksheet</button>
				</div>
			</div>
		</section>
	</article>

	<script is:inline>
		const WORKSHEET_STORAGE_KEY = 'hc-process-mapping-worksheet:v1';
		const DEFAULT_STEP_COUNT = 6;

		const setupPrintButtons = () => {
			document.querySelectorAll('[data-print-worksheet]').forEach((button) => {
				if (!(button instanceof HTMLButtonElement) || button.dataset.ready === 'true') return;
				button.dataset.ready = 'true';
				button.addEventListener('click', () => {
					window.hcTrackEvent?.('worksheet_print_clicked', {
						event_location: button.dataset.trackLocation || 'unknown'
					});
					window.print();
				});
			});
		};

		const setupSectionTracking = () => {
			const sections = [
				{ element: document.querySelector('#worksheet-section-4'), number: 4 },
				{ element: document.querySelector('#worksheet-section-7'), number: 7 }
			].filter(({ element }) => element instanceof HTMLElement);
			if (sections.length === 0 || !('IntersectionObserver' in window)) return;

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting || !(entry.target instanceof HTMLElement) || entry.target.dataset.analyticsReached === 'true') return;
						entry.target.dataset.analyticsReached = 'true';
						const section = sections.find(({ element }) => element === entry.target);
						if (!section) return;
						window.hcTrackEvent?.(`worksheet_section_${section.number}_reached`);
						observer.unobserve(entry.target);
					});
				},
				{ threshold: 0.35 }
			);

			sections.forEach(({ element }) => {
				if (!(element instanceof HTMLElement) || element.dataset.analyticsObserved === 'true') return;
				element.dataset.analyticsObserved = 'true';
				observer.observe(element);
			});
		};

		const setupWorksheet = () => {
			const form = document.querySelector('[data-worksheet-form]');
			if (!(form instanceof HTMLFormElement) || form.dataset.ready === 'true') return;

			const stepBody = form.querySelector('[data-step-body]');
			const stepTemplate = form.querySelector('[data-step-row-template]');
			const addStepButton = form.querySelector('[data-add-step]');
			const clearButton = form.querySelector('[data-clear-worksheet]');
			const status = form.querySelector('[data-draft-status]');
			if (!(stepBody instanceof HTMLTableSectionElement) || !(stepTemplate instanceof HTMLTemplateElement)) return;

			form.dataset.ready = 'true';
			let saveTimer;
			let hasTrackedStart = false;

			const setStatus = (message) => {
				if (status instanceof HTMLElement) status.textContent = message;
			};

			const updateStepRow = (row, number) => {
				if (!(row instanceof HTMLTableRowElement)) return;
				const numberCell = row.querySelector('[data-step-number]');
				if (numberCell) numberCell.textContent = String(number);

				row.querySelectorAll('[data-step-field]').forEach((field) => {
					if (!(field instanceof HTMLTextAreaElement)) return;
					const fieldName = field.dataset.stepField;
					const label = fieldName === 'problem' ? 'wait or problem' : fieldName;
					field.name = `step-${number}-${fieldName}`;
					field.setAttribute('aria-label', `Step ${number} ${label}`);
				});
			};

			const addStepRow = () => {
				const number = stepBody.querySelectorAll('[data-step-row]').length + 1;
				const fragment = stepTemplate.content.cloneNode(true);
				const row = fragment.querySelector('[data-step-row]');
				updateStepRow(row, number);
				stepBody.append(fragment);
				return stepBody.querySelector(`[name="step-${number}-action"]`);
			};

			const ensureStepRows = (count) => {
				while (stepBody.querySelectorAll('[data-step-row]').length < count) addStepRow();
			};

			const collectDraft = () => {
				const values = {};
				form.querySelectorAll('input[name], textarea[name]').forEach((field) => {
					if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) values[field.name] = field.value;
				});
				return {
					version: 1,
					stepCount: stepBody.querySelectorAll('[data-step-row]').length,
					values
				};
			};

			const saveDraft = () => {
				window.clearTimeout(saveTimer);
				try {
					localStorage.setItem(WORKSHEET_STORAGE_KEY, JSON.stringify(collectDraft()));
					setStatus('Draft saved privately in this browser.');
				} catch (error) {
					console.error('Process-mapping worksheet draft could not be saved.', error);
					setStatus('Draft saving is unavailable in this browser.');
				}
			};

			const scheduleSave = () => {
				setStatus('Saving draft…');
				window.clearTimeout(saveTimer);
				saveTimer = window.setTimeout(saveDraft, 250);
			};

			const restoreDraft = () => {
				const rawDraft = localStorage.getItem(WORKSHEET_STORAGE_KEY);
				if (!rawDraft) return;

				const draft = JSON.parse(rawDraft);
				if (
					!draft
					|| draft.version !== 1
					|| !Number.isInteger(draft.stepCount)
					|| draft.stepCount < DEFAULT_STEP_COUNT
					|| !draft.values
					|| typeof draft.values !== 'object'
				) {
					throw new Error('Saved worksheet draft does not match the current format.');
				}

				const entries = Object.entries(draft.values);
				if (entries.some(([, value]) => typeof value !== 'string')) {
					throw new Error('Saved worksheet draft contains an invalid field value.');
				}

				ensureStepRows(draft.stepCount);
				entries.forEach(([name, value]) => {
					const field = form.elements.namedItem(name);
					if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) field.value = value;
				});
				setStatus('Draft restored from this browser.');
				window.hcTrackEvent?.('worksheet_restored');
			};

			form.addEventListener('submit', (event) => event.preventDefault());
			form.addEventListener('input', () => {
				if (!hasTrackedStart) {
					hasTrackedStart = true;
					window.hcTrackEvent?.('worksheet_started');
				}
				scheduleSave();
			});
			form.addEventListener('change', saveDraft);

			if (addStepButton instanceof HTMLButtonElement) {
				addStepButton.addEventListener('click', () => {
					const field = addStepRow();
					saveDraft();
					if (field instanceof HTMLTextAreaElement) field.focus();
				});
			}

			if (clearButton instanceof HTMLButtonElement) {
				clearButton.addEventListener('click', () => {
					if (!window.confirm('Clear every field in this worksheet? This cannot be undone.')) return;
					localStorage.removeItem(WORKSHEET_STORAGE_KEY);
					form.reset();
					const rows = [...stepBody.querySelectorAll('[data-step-row]')];
					rows.slice(DEFAULT_STEP_COUNT).forEach((row) => row.remove());
					setStatus('Worksheet cleared.');
				});
			}

			try {
				restoreDraft();
			} catch (error) {
				console.error('Process-mapping worksheet draft could not be restored.', error);
				setStatus('A saved draft exists but could not be restored.');
			}
		};

		const setupProcessWorksheet = () => {
			setupPrintButtons();
			setupSectionTracking();
			setupWorksheet();
		};

		document.addEventListener('astro:page-load', setupProcessWorksheet);
		setupProcessWorksheet();
	</script>
</BaseLayout>
