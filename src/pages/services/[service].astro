---
import ServiceOfferPage from '../../components/ServiceOfferPage.astro';
import { serviceOfferList, type ServiceOffer } from '../../lib/service-offers';

interface PageProps {
	offer: ServiceOffer;
}

export function getStaticPaths() {
	return serviceOfferList.map((offer) => ({
		params: { service: offer.slug },
		props: { offer }
	}));
}

const { offer } = Astro.props as PageProps;
---

<ServiceOfferPage offer={offer} />
