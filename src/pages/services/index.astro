---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceTestimonial from '../../components/ServiceTestimonial.astro';
import { BOOK_CALL_URL } from '../../consts';
import { testimonials } from '../../lib/testimonials';
import PalabrunoPaperSystem from '../../assets/img/projects/palabruno-paper-system.png';
import GenruptPaperSystem from '../../assets/img/projects/genrupt-paper-system.png';
import MuchoHangoutsFeature from '../../assets/img/projects/mucho-hangouts-feature.png';
import ServiceOverview from '../../assets/img/illustrations/service-overview.svg';
import ServiceAuditMap from '../../assets/img/illustrations/service-audit-map.svg';
import ServiceSolutionOptions from '../../assets/img/illustrations/service-solution-options.svg';
import ServiceFocusedBuild from '../../assets/img/illustrations/service-focused-build.svg';
import ServiceHandoffSystem from '../../assets/img/illustrations/service-handoff-system.svg';
import '../../styles/services.css';

const title = 'Contract Product Engineering | Hanif Carroll';
const description =
	'Contract product engineering for B2B SaaS teams: customer-facing features, internal tools, and HubSpot integrations from a senior engineer.';

const engagementModels = [
	{
		key: 'project',
		label: 'Project contract',
		heading: 'A defined build, from scope to handoff.',
		body: 'One customer-facing feature, internal tool, or integration — scoped, priced, and built around the people who will use it.',
		note: 'Scoped and priced before work begins'
	},
	{
		key: 'monthly',
		label: 'Monthly contract',
		heading: 'Ongoing senior engineering for your product.',
		body: 'Continuing priorities across your product and the systems around it, handled by someone who keeps the context between them.',
		note: 'Monthly, scoped around priorities and available time'
	}
];

const fitSignals = [
	'A customer-facing feature or internal tool is stuck behind a packed roadmap.',
	'You need an engineer who can own a problem from discovery to production.',
	'Integrations between your product and the revenue stack keep getting deferred.',
	'You want senior output on a contract basis, not another full-time hire.',
	'HubSpot is part of your go-to-market stack, and the product work touches it.'
];

const proof = [
	{
		slug: 'genrupt',
		label: 'Client work',
		title: 'Genrupt',
		body: 'I helped make Genrupt ready for paying teams by building billing, credit accounting, reliable background jobs, and agent access. The platform went on to support its first 200 paying customers.',
		image: GenruptPaperSystem,
		alt: 'Paper model of the Genrupt commercial system.'
	},
	{
		slug: 'palabruno',
		label: 'Client work',
		title: 'Palabruno',
		body: 'I took a founder\u2019s idea to live on the App Store, Google Play, and the web, owning product, UX, and full-stack engineering for AI reading features, teacher workflows, and subscription billing.',
		image: PalabrunoPaperSystem,
		alt: 'Paper model of the Palabruno reading product.'
	},
	{
		slug: 'mucho-hangouts',
		label: 'Client work',
		title: 'Mucho Hangouts',
		body: 'I helped improve messaging, notifications, delivery patterns, and team practices while the product remained active and priorities continued to change.',
		image: MuchoHangoutsFeature,
		alt: 'Mucho Hangouts product interface for social events and group discovery.'
	}
];

const principles = [
	{
		title: 'Start from how the work actually runs',
		body: 'I read the code, the data, and the people using the system before proposing changes. No guessing from a ticket title.',
		image: ServiceAuditMap,
		alt: 'Paper model of scattered requests and status cards becoming a clear system map.'
	},
	{
		title: 'Ship the smallest useful version first',
		body: 'You see working software early, and we expand from what is proven instead of betting on a big reveal.',
		image: ServiceSolutionOptions,
		alt: 'Paper model comparing several possible technical approaches before one is selected.'
	},
	{
		title: 'Make the important parts observable',
		body: 'Your team should be able to see the status, decisions, and failures that matter — in the code, the data, and the product surface.',
		image: ServiceFocusedBuild,
		alt: 'Paper model of components assembled into a useful first system.'
	},
	{
		title: 'You keep everything we produce',
		body: 'You keep the code, documentation, and the reasoning behind important decisions. Handoff is part of the engagement.',
		image: ServiceHandoffSystem,
		alt: 'Paper model of a working system, documentation, and access packaged for a team to own.'
	}
];

const faqs = [
	{
		title: 'How do engagements usually start?',
		body: 'With a fit call. If the problem is clear, you get a written scope with price, schedule, and responsibilities before any work begins.'
	},
	{
		title: 'Project or monthly — which fits?',
		body: 'A project contract suits one defined build. A monthly contract suits continuing priorities across your product and the systems around it.'
	},
	{
		title: 'Can you work inside our existing stack and team?',
		body: 'Yes. I work in your repo, your tools, and your rituals — reviews, standups, and the way your team already ships.'
	},
	{
		title: 'Do you only build new things?',
		body: 'No. Fixing, finishing, and integrating existing systems is most of the work.'
	},
	{
		title: 'What about HubSpot work?',
		body: 'Integrations between your product and HubSpot are a core part of the offer. I work in your code, your data model, and the mapping between the two.'
	},
	{
		title: 'What happens when the engagement ends?',
		body: 'You keep the code, documentation, and the reasoning behind important decisions. I plan the handoff as part of the engagement.'
	}
];
---

<BaseLayout
	title={title}
	description={description}
	bodyClass='page-services'
	footerCtaTitle="Tell me what your team needs to ship."
	footerCtaBody="Start with the feature, integration, or system that's stuck. We'll work out whether a project or a monthly contract fits."
	footerCtaLocation='services_footer_cta'
>
	<article class='hc-services-page'>
		<header class='hc-hero' data-motion-intro>
			<div class='hc-container'>
				<div class='hc-hero-surface'>
					<div class='hc-hero-copy'>
						<h1 class='hc-display' data-motion='headline'>Senior product engineering for B2B SaaS, on contract.</h1>
						<p class='hc-lead' data-motion-deck>I join your team to build customer-facing features, internal tools, and HubSpot integrations — as a defined project or ongoing monthly engineering.</p>
						<div class='hc-actions'>
							<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location='services_hero'>Book a fit call</a>
							<a class='hc-text-link' href='#services'>Compare the engagement models</a>
						</div>
					</div>
					<figure class='hc-artifact-stack hc-artifact-stack--single' data-motion-intro-item>
						<Image src={ServiceOverview} alt='Paper model of a business constraint moving through diagnosis into a useful system.' loading='eager' widths={[640, 960, 1536]} sizes='(max-width: 900px) 100vw, 50vw' />
					</figure>
				</div>
			</div>
		</header>

		<section class='hc-section hc-services-offers' id='services' data-motion-group>
			<div class='hc-container'>
				<div class='hc-section-header'>
					<h2 class='hc-section-title' data-motion='reveal'>Two ways to work together.</h2>
				</div>
				<div class='hc-service-list'>
					{
						engagementModels.map((model, index) => (
							<a
								class='hc-service-item'
								href={BOOK_CALL_URL}
								target='_blank'
								rel='noopener noreferrer'
								data-track-event='book_call_clicked'
								data-track-location={`services_model_${model.key}`}
								data-motion-item
							>
								<span class='hc-index'>{String(index + 1).padStart(2, '0')}</span>
								<div class='hc-service-item__body'>
									<h3>{model.label}</h3>
									<p>{model.heading} {model.body}</p>
									<span class='hc-service-item__meta'><span>{model.note}</span><span class='hc-text-link'>Book a fit call</span></span>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section class='hc-section--compact hc-services-fit' data-motion-group data-header-surface='dark'>
			<div class='hc-container'>
				<div class='hc-fit-panel' data-motion-item>
					<h2>For B2B SaaS teams that need senior engineering without a full-time hire.</h2>
					<div class='hc-fit-panel__body'>
						<ul class='hc-signal-list'>
							{fitSignals.map((signal) => <li>{signal}</li>)}
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class='hc-section hc-services-proof' data-motion-group data-header-surface='dark'>
			<div class='hc-container'>
				<div class='hc-section-header'><h2 class='hc-section-title' data-motion='reveal'>Project examples.</h2></div>
				<div class='hc-proof-grid'>
					{proof.map((item) => <a class='hc-proof-card' href={`/case-studies/${item.slug}/`} data-motion-item><figure><Image src={item.image} alt={item.alt} loading='lazy' /></figure><div class='hc-proof-card__copy'><p class='hc-proof-label'>{item.label}</p><h3>{item.title}</h3><p>{item.body}</p><span class='hc-text-link'>View {item.title}</span></div></a>)}
				</div>
				<ServiceTestimonial testimonial={testimonials.markisZarate} />
			</div>
		</section>

		<section class='hc-section hc-services-principles' data-motion-group>
			<div class='hc-container'>
				<div class='hc-section-header'><h2 class='hc-section-title' data-motion='reveal'>How I work inside your team.</h2></div>
				<div class='hc-principles-grid'>
					{
						principles.map((item, index) => (
							<div class='hc-principle' data-motion-item>
								<figure><Image src={item.image} alt={item.alt} loading='lazy' /></figure>
								<div class='hc-principle__copy'>
									<span class='hc-index'>{String(index + 1).padStart(2, '0')}</span>
									<div>
										<h3>{item.title}</h3>
										<p>{item.body}</p>
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class='hc-section hc-services-faq' id='faq' data-motion-group>
			<div class='hc-container'>
				<div class='hc-section-header'><h2 class='hc-section-title' data-motion='reveal'>Questions people ask before starting</h2></div>
				<div class='hc-faq-list'>
					{faqs.map((faq, index) => <div class:list={['hc-faq-item', { 'is-open': index === 0 }]} data-motion-item><button class='hc-faq-item__trigger' type='button' aria-expanded={index === 0 ? 'true' : 'false'}><span>{faq.title}</span><span class='hc-faq-item__icon' aria-hidden='true'></span></button><div class='hc-faq-item__answer'><div><p>{faq.body}</p></div></div></div>)}
				</div>
			</div>
		</section>

	</article>
</BaseLayout>

<script>
	const installFaqAnimations = () => {
		document.querySelectorAll<HTMLElement>('.hc-faq-item').forEach((item) => {
			if (item.dataset.faqAnimationReady === 'true') return;
			const trigger = item.querySelector<HTMLButtonElement>('.hc-faq-item__trigger');
			if (!trigger) return;

			item.dataset.faqAnimationReady = 'true';
			trigger.addEventListener('click', () => {
				const open = !item.classList.contains('is-open');
				item.classList.toggle('is-open', open);
				trigger.setAttribute('aria-expanded', String(open));
			});
		});
	};

	installFaqAnimations();
	document.addEventListener('astro:page-load', installFaqAnimations);
</script>
