---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceTestimonial from '../../components/ServiceTestimonial.astro';
import { BOOK_CALL_URL } from '../../consts';
import { serviceOfferList } from '../../lib/service-offers';
import { testimonials } from '../../lib/testimonials';
import DesarmaderoPaperSystem from '../../assets/img/projects/desarmadero-operations-paper-system.png';
import GenruptPaperSystem from '../../assets/img/projects/genrupt-paper-system.png';
import MuchoHangoutsFeature from '../../assets/img/projects/mucho-hangouts-feature.png';
import ServiceOverview from '../../assets/img/illustrations/service-overview.svg';
import ServiceAuditMap from '../../assets/img/illustrations/service-audit-map.svg';
import ServiceSolutionOptions from '../../assets/img/illustrations/service-solution-options.svg';
import ServiceFocusedBuild from '../../assets/img/illustrations/service-focused-build.svg';
import ServiceHandoffSystem from '../../assets/img/illustrations/service-handoff-system.svg';
import '../../styles/services.css';

const title = 'Technical Consulting Services | Hanif Carroll';
const description =
	'Technical consulting for founder-led businesses: diagnose workflow problems, build focused software, and support the systems teams rely on.';

const proof = [
	{
		slug: 'desarmadero-operations-prototype',
		label: 'Client work',
		title: 'Desarmadero Operations',
		body: 'After one discovery call, I created a workflow map, PRD, functional specification, and role-based prototype the client could review before a full build.',
		image: DesarmaderoPaperSystem,
		alt: 'Paper model of the Desarmadero operations workflow.'
	},
	{
		slug: 'genrupt',
		label: 'Client work',
		title: 'Genrupt',
		body: 'I helped make Genrupt ready for paying teams by building billing, credit accounting, reliable background jobs, and agent access. The platform went on to support its first 200 paying customers.',
		image: GenruptPaperSystem,
		alt: 'Paper model of the Genrupt commercial system.'
	},
	{
		slug: 'mucho-hangouts',
		label: 'Client work',
		title: 'Mucho Hangouts',
		body: 'I helped improve messaging, notifications, delivery patterns, and team practices while the product remained active and priorities continued to change.',
		image: MuchoHangoutsFeature,
		alt: 'Mucho Hangouts product interface for social events and group discovery.'
	}
];

const principles = [
	{
		title: 'Understand the workflow first',
		body: 'I begin with the people, steps, tools, and handoffs involved. That gives us a clear view of where the workflow is breaking down.',
		image: ServiceAuditMap,
		alt: 'Paper model of scattered requests and status cards becoming a clear workflow map.'
	},
	{
		title: 'Use the simplest fix that will work',
		body: 'The answer may be custom software, an automation, an integration, better use of an existing tool, or a change to the process.',
		image: ServiceSolutionOptions,
		alt: 'Paper model comparing several possible technical approaches before one is selected.'
	},
	{
		title: 'Make the important parts easy to see',
		body: 'Your team should be able to see the status, decisions, approvals, and failures that matter.',
		image: ServiceFocusedBuild,
		alt: 'Paper model of workflow components assembled into a useful first system.'
	},
	{
		title: 'You keep everything we produce',
		body: 'You keep the useful artifacts, software, documentation, and context needed to run or extend the system.',
		image: ServiceHandoffSystem,
		alt: 'Paper model of a working system, documentation, and access packaged for a team to own.'
	}
];

const faqs = [
	{
		title: 'Where should I start?',
		body: "Start with the Business Systems Audit when you can see the problem but aren't sure what will fix it. If the workflow and result are already clear, we may be able to scope a build directly."
	},
	{
		title: 'Do I need custom software?',
		body: 'Not necessarily. The audit may point to custom software, an automation, an integration, better use of an existing tool, or a process change.'
	},
	{
		title: 'Can you work with the tools we already use?',
		body: 'Yes. I look at the tools and data you already have. If they can do the job, we use them.'
	},
	{
		title: 'Is this AI consulting?',
		body: 'No. I help improve the way your business runs. AI is one tool I may use when it fits the job and can be made reliable enough for daily use.'
	},
	{
		title: 'What happens when the engagement ends?',
		body: 'You keep the maps, software, documentation, and notes behind important decisions. I plan the handoff as part of the engagement.'
	},
	{
		title: 'How much does it cost?',
		body: 'The Business Systems Audit starts at $750. I price builds after we define the scope. Ongoing partnerships are monthly and scoped around agreed priorities and available time.'
	}
];
---

<BaseLayout
	title={title}
	description={description}
	bodyClass='page-services'
	footerCtaTitle='Which workflow is giving your team trouble?'
	footerCtaBody="Start with the repeated manual work, unreliable handoff, reporting problem, approval bottleneck, or system that no longer fits. We'll work out whether an audit is the best place to begin."
	footerCtaLocation='services_footer_cta'
>
	<article class='hc-services-page'>
		<header class='hc-hero' data-motion-intro>
			<div class='hc-container'>
				<div class='hc-hero-surface'>
					<div class='hc-hero-copy'>
						<h1 class='hc-display' data-motion='headline'>Technical help when work gets harder to run.</h1>
						<p class='hc-lead' data-motion-deck>I help you understand the workflow, build what your team needs first, and handle the technical priorities that come up as the business changes.</p>
						<div class='hc-actions'>
							<a class='hc-button' href={BOOK_CALL_URL} target='_blank' rel='noopener noreferrer' data-track-event='book_call_clicked' data-track-location='services_hero'>Book an audit fit call</a>
							<a class='hc-text-link' href='#services'>Compare the services</a>
						</div>
					</div>
					<figure class='hc-artifact-stack hc-artifact-stack--single' data-motion-intro-item>
						<Image src={ServiceOverview} alt='Paper model of a business constraint moving through diagnosis into a useful system.' loading='eager' widths={[640, 960, 1536]} sizes='(max-width: 900px) 100vw, 50vw' />
					</figure>
				</div>
			</div>
		</header>

		<section class='hc-section hc-services-offers' id='services' data-motion-group>
			<div class='hc-container'>
				<div class='hc-section-header'>
					<h2 class='hc-section-title' data-motion='reveal'>Use the service that matches where you are.</h2>
				</div>
				<div class='hc-service-list'>
					{
						serviceOfferList.map((offer, index) => (
							<a
								class='hc-service-item'
								href={offer.path}
								data-track-event='service_page_clicked'
								data-track-location={`services_offer_${offer.key}`}
								data-motion-item
							>
								<span class='hc-index'>{String(index + 1).padStart(2, '0')}</span>
								<div class='hc-service-item__body'>
									<h3>{offer.label}</h3>
									<p>{offer.chooserSummary}</p>
									<span class='hc-service-item__meta'><span>{offer.commercialNote}</span><span class='hc-text-link'>{offer.chooserCta}</span></span>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section class='hc-section--compact hc-services-fit' data-motion-group data-header-surface='dark'>
			<div class='hc-container'>
				<div class='hc-fit-panel' data-motion-item>
					<h2>For businesses that already have customers and recurring work.</h2>
					<div class='hc-fit-panel__body'>
						<ul class='hc-signal-list'>
							<li>Recurring work is spread across spreadsheets, inboxes, forms, chats, and disconnected tools.</li>
							<li>Handoffs, approvals, reporting, or customer workflows depend on manual checking.</li>
							<li>Important status lives in people's heads, so the team has to ask around.</li>
							<li>The team knows software or AI may help but doesn't know what should be built first.</li>
							<li>A known workflow needs ongoing help from someone who can make decisions and build.</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class='hc-section hc-services-proof' data-motion-group data-header-surface='dark'>
			<div class='hc-container'>
				<div class='hc-section-header'><h2 class='hc-section-title' data-motion='reveal'>Project examples.</h2></div>
				<div class='hc-proof-grid'>
					{proof.map((item) => <a class='hc-proof-card' href={`/case-studies/${item.slug}/`} data-motion-item><figure><Image src={item.image} alt={item.alt} loading='lazy' /></figure><div class='hc-proof-card__copy'><p class='hc-proof-label'>{item.label}</p><h3>{item.title}</h3><p>{item.body}</p><span class='hc-text-link'>View {item.title}</span></div></a>)}
				</div>
				<ServiceTestimonial testimonial={testimonials.markisZarate} />
			</div>
		</section>

		<section class='hc-section hc-services-principles' data-motion-group>
			<div class='hc-container'>
				<div class='hc-section-header'><h2 class='hc-section-title' data-motion='reveal'>How I turn a difficult workflow into a working system.</h2></div>
				<div class='hc-principles-grid'>
					{principles.map((item, index) => <div class='hc-principle' data-motion-item><figure><Image src={item.image} alt={item.alt} loading='lazy' /></figure><div class='hc-principle__copy'><span class='hc-index'>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></div></div>)}
				</div>
			</div>
		</section>

		<section class='hc-section hc-services-faq' id='faq' data-motion-group>
			<div class='hc-container'>
				<div class='hc-section-header'><h2 class='hc-section-title' data-motion='reveal'>Questions people ask before starting</h2></div>
				<div class='hc-faq-list'>
					{faqs.map((faq, index) => <div class:list={['hc-faq-item', { 'is-open': index === 0 }]} data-motion-item><button class='hc-faq-item__trigger' type='button' aria-expanded={index === 0 ? 'true' : 'false'}><span>{faq.title}</span><span class='hc-faq-item__icon' aria-hidden='true'></span></button><div class='hc-faq-item__answer'><div><p>{faq.body}</p></div></div></div>)}
				</div>
			</div>
		</section>

	</article>
</BaseLayout>

<script>
	const installFaqAnimations = () => {
		document.querySelectorAll<HTMLElement>('.hc-faq-item').forEach((item) => {
			if (item.dataset.faqAnimationReady === 'true') return;
			const trigger = item.querySelector<HTMLButtonElement>('.hc-faq-item__trigger');
			if (!trigger) return;

			item.dataset.faqAnimationReady = 'true';
			trigger.addEventListener('click', () => {
				const open = !item.classList.contains('is-open');
				item.classList.toggle('is-open', open);
				trigger.setAttribute('aria-expanded', String(open));
			});
		});
	};

	installFaqAnimations();
	document.addEventListener('astro:page-load', installFaqAnimations);
</script>
