---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Agent Tools Library';
const description = 'A growing library of local tools shaped by real workflows.';
const agentInstruction =
	'Point your agent to this page and ask whether any of these tools would help with the work you do.';
const agentPrompt =
	'Review this Agent Tools Library: https://www.hanifcarroll.com/tools/. Based on the work I do and the tasks I ask you to help with, tell me which tools here would be useful, why they fit, and how I should use them. If none fit, say so.';

const tools = [
	{
		name: 'agent-recall',
		focus: 'Session recall',
		body: 'Help agents find prior work and cite where it came from, so old decisions, fixes, and context do not disappear in buried chat history.',
		repo: 'https://github.com/HanifCarroll/agent-recall'
	},
	{
		name: 'site-capture',
		focus: 'Website context',
		body: 'Capture websites into screenshots, readable pages, and source records so agents can review a site without losing the evidence trail.',
		repo: 'https://github.com/HanifCarroll/site-capture'
	},
	{
		name: 'social-read',
		focus: 'Social post context',
		body: 'Save LinkedIn and X posts, comments, and screenshots into structured files agents can read without wandering through a social feed.',
		repo: 'https://github.com/HanifCarroll/social-read'
	},
	{
		name: 'chatgpt-share-export',
		focus: 'Shared conversation export',
		body: 'Turn public ChatGPT shared conversations into clean files an agent can review, summarize, and use as source material.',
		repo: 'https://github.com/HanifCarroll/chatgpt-share-export'
	},
	{
		name: 'devtree',
		focus: 'Safe project workspaces',
		body: 'Set up isolated project copies with the right environment, server, and logs, so an agent can test changes without disturbing the main workspace.',
		repo: 'https://github.com/HanifCarroll/devtree'
	},
	{
		name: 'mailbridge',
		focus: 'Mailbox context',
		body: 'Give agents a controlled way to search, read, and draft from Gmail and Fastmail without handing them broad mailbox access.',
		repo: 'https://github.com/HanifCarroll/mailbridge'
	},
	{
		name: 'macos-automation-cli',
		focus: 'macOS app automation',
		body: 'Let agents work with local Mac apps like Mail, Calendar, Contacts, Reminders, Notes, and Messages through clear, limited commands.',
		repo: 'https://github.com/HanifCarroll/macos-automation-cli'
	},
	{
		name: 'granola-notes-cli',
		focus: 'Meeting-note retrieval',
		body: 'Bring Granola notes and transcripts into agent conversations so meeting context is easy to find and reuse.',
		repo: 'https://github.com/HanifCarroll/granola-notes-cli'
	}
];
---

<BaseLayout title={`${title} · Hanif Carroll`} description={description} showFooterCta={false} footerLinksOnly>
	<article class='content-page container max-w-4xl'>
		<header class='content-page__hero'>
			<h1 class='content-page__title'>{title}</h1>
			<p class='content-page__lede'>{description}</p>
			<p class='content-page__lede'>{agentInstruction}</p>
			<div class='tools-prompt'>
				<button
					type='button'
					class='tools-prompt__button'
					data-copy-prompt
					data-copy-source='agent-tools-prompt'
					aria-label='Copy prompt'
					aria-live='polite'
					title='Copy prompt'
				>
					<svg
						class='tools-prompt__copy-icon'
						aria-hidden='true'
						xmlns='http://www.w3.org/2000/svg'
						width='18'
						height='18'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='2'
						stroke-linecap='round'
						stroke-linejoin='round'
					>
						<rect width='14' height='14' x='8' y='8' rx='2' ry='2'></rect>
						<path d='M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2'></path>
					</svg>
				</button>
				<pre class='tools-prompt__code'><code id='agent-tools-prompt'>{agentPrompt}</code></pre>
			</div>
		</header>

		<section aria-label='Tools'>
			<div class='content-page__list'>
				{
					tools.map((tool) => (
						<article class='content-page__entry'>
							<h2 class='content-page__entry-title'>{tool.name}</h2>
							<p class='content-page__entry-meta'>{tool.focus}</p>
							<p class='content-page__entry-body'>{tool.body}</p>
							<p class='content-page__aside'>
								<a
									href={tool.repo}
									class='content-page__link'
									target='_blank'
									rel='noopener noreferrer'
									aria-label={`View ${tool.name} repository`}
									data-track-event='tool_repo_clicked'
									data-track-location='tools_page'
								>
									View repo
								</a>
							</p>
						</article>
					))
				}
			</div>
		</section>

		<footer class='content-page__footer'>
			<a href='/projects/' class='content-page__link'>See client case studies</a>
		</footer>
	</article>

	<script is:inline>
		const setupPromptCopy = () => {
			const copyButton = document.querySelector('[data-copy-prompt]');
			if (!copyButton) return;

			const sourceId = copyButton.getAttribute('data-copy-source');
			const source = sourceId ? document.getElementById(sourceId) : null;
			if (!source?.textContent) return;

			const defaultLabel = copyButton.getAttribute('aria-label') || 'Copy prompt';
			let resetTimer;

			copyButton.addEventListener('click', async () => {
				window.clearTimeout(resetTimer);
				try {
					await navigator.clipboard.writeText(source.textContent.trim());
					copyButton.setAttribute('aria-label', 'Prompt copied');
					copyButton.dataset.copyState = 'copied';
				} catch {
					copyButton.setAttribute('aria-label', 'Copy failed');
					copyButton.dataset.copyState = 'failed';
				}

				resetTimer = window.setTimeout(() => {
					copyButton.setAttribute('aria-label', defaultLabel);
					delete copyButton.dataset.copyState;
				}, 1800);
			});
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', setupPromptCopy, { once: true });
		} else {
			setupPromptCopy();
		}
	</script>

	<style>
		.tools-prompt {
			position: relative;
			max-width: var(--measure-default);
		}

		.tools-prompt__button {
			position: absolute;
			top: 0.75rem;
			right: 0.75rem;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2rem;
			height: 2rem;
			border: 1px solid rgba(12, 12, 12, 0.16);
			padding: 0;
			background: transparent;
			color: var(--site-ink);
			transition:
				background-color 150ms ease,
				border-color 150ms ease,
				color 150ms ease;
		}

		.tools-prompt__button:hover {
			background: var(--site-ink);
			border-color: var(--site-ink);
			color: #f9f9f7;
		}

		.tools-prompt__button[data-copy-state='copied'] {
			background: rgba(12, 12, 12, 0.08);
		}

		.tools-prompt__code {
			margin: 0;
			overflow-x: auto;
			border: 1px solid rgba(12, 12, 12, 0.12);
			padding: 1rem 3.4rem 1rem 1rem;
			background: rgba(12, 12, 12, 0.045);
			white-space: pre-wrap;
		}

		.tools-prompt__code code {
			font-size: var(--font-size-sm);
			line-height: var(--line-height-relaxed);
			color: var(--site-body);
			font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		}

		:global(.dark) .tools-prompt__code {
			border-color: rgba(255, 255, 255, 0.12);
			background: rgba(255, 255, 255, 0.06);
		}

		:global(.dark) .tools-prompt__button {
			border-color: rgba(255, 255, 255, 0.18);
		}

		:global(.dark) .tools-prompt__button:hover {
			color: #090909;
		}

		:global(.dark) .tools-prompt__button[data-copy-state='copied'] {
			background: rgba(255, 255, 255, 0.1);
		}
	</style>
</BaseLayout>
