---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Agent Tools Library';
const description = 'A growing library of local tools shaped by real workflows.';

const tools = [
	{
		name: 'agent-recall',
		focus: 'Session recall',
		body: 'Help agents find prior work and cite where it came from, so old decisions, fixes, and context do not disappear in buried chat history.',
		repo: 'https://github.com/HanifCarroll/agent-recall'
	},
	{
		name: 'site-capture',
		focus: 'Website context',
		body: 'Capture websites into screenshots, readable pages, and source records so agents can review a site without losing the evidence trail.',
		repo: 'https://github.com/HanifCarroll/site-capture'
	},
	{
		name: 'social-read',
		focus: 'Social post context',
		body: 'Save LinkedIn and X posts, comments, and screenshots into structured files agents can read without wandering through a social feed.',
		repo: 'https://github.com/HanifCarroll/social-read'
	},
	{
		name: 'chatgpt-share-export',
		focus: 'Shared conversation export',
		body: 'Turn public ChatGPT shared conversations into clean files an agent can review, summarize, and use as source material.',
		repo: 'https://github.com/HanifCarroll/chatgpt-share-export'
	},
	{
		name: 'devtree',
		focus: 'Safe project workspaces',
		body: 'Set up isolated project copies with the right environment, server, and logs, so an agent can test changes without disturbing the main workspace.',
		repo: 'https://github.com/HanifCarroll/devtree'
	},
	{
		name: 'mailbridge',
		focus: 'Mailbox context',
		body: 'Give agents a controlled way to search, read, and draft from Gmail and Fastmail without handing them broad mailbox access.',
		repo: 'https://github.com/HanifCarroll/mailbridge'
	},
	{
		name: 'macos-automation-cli',
		focus: 'macOS app automation',
		body: 'Let agents work with local Mac apps like Mail, Calendar, Contacts, Reminders, Notes, and Messages through clear, limited commands.',
		repo: 'https://github.com/HanifCarroll/macos-automation-cli'
	},
	{
		name: 'granola-notes-cli',
		focus: 'Meeting-note retrieval',
		body: 'Bring Granola notes and transcripts into agent conversations so meeting context is easy to find and reuse.',
		repo: 'https://github.com/HanifCarroll/granola-notes-cli'
	}
];
---

<BaseLayout title={`${title} · Hanif Carroll`} description={description} showFooterCta={false} footerLinksOnly>
	<article class='content-page container max-w-4xl'>
		<header class='content-page__hero'>
			<h1 class='content-page__title'>{title}</h1>
			<p class='content-page__lede'>{description}</p>
		</header>

		<section aria-label='Tools'>
			<div class='content-page__list'>
				{
					tools.map((tool) => (
						<article class='content-page__entry'>
							<h2 class='content-page__entry-title'>{tool.name}</h2>
							<p class='content-page__entry-meta'>{tool.focus}</p>
							<p class='content-page__entry-body'>{tool.body}</p>
							<p class='content-page__aside'>
								<a
									href={tool.repo}
									class='content-page__link'
									target='_blank'
									rel='noopener noreferrer'
									aria-label={`View ${tool.name} repository`}
									data-track-event='tool_repo_clicked'
									data-track-location='tools_page'
								>
									View repo
								</a>
							</p>
						</article>
					))
				}
			</div>
		</section>

		<footer class='content-page__footer'>
			<a href='/projects/' class='content-page__link'>See client case studies</a>
		</footer>
	</article>
</BaseLayout>
