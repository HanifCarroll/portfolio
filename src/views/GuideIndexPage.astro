---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGuideGroups, guideCopy } from '../data/guide';
import { guideProblems } from '../data/guide-problems';
import { getLocale, localizedPath } from '../i18n';
import { getGuideCatalog } from '../lib/guide-paths';
import { deckClass, pageTitleClass, sectionHeadingClass, shellClass, titleHoverClass, underlineClass } from '../lib/ui';

const locale = getLocale(Astro.currentLocale);
const copy = guideCopy[locale];
const guideGroups = getGuideGroups(locale);
const headingClass = `${sectionHeadingClass} text-[clamp(2rem,3.6vw,3rem)]`;
const entries = await getGuideCatalog(locale);
const byId = new Map(entries.map((entry) => [entry.slug, entry]));
const problemGroups = guideGroups
	.map((group) => ({ ...group, problems: guideProblems.filter((problem) => problem.group === group.id) }))
	.filter((group) => group.problems.length > 0);
const groups = guideGroups
	.map((group) => ({ ...group, entries: entries.filter(({ entry }) => entry.data.group === group.id) }))
	.filter((group) => group.entries.length > 0);
---

<BaseLayout title={copy.seoTitle} description={copy.description}>
	<div class:list={[shellClass, 'pt-12 pb-[clamp(6rem,12vw,10rem)] lg:pt-20']}>
		<header class='pb-[clamp(4rem,8vw,6rem)]'>
			<h1 class={pageTitleClass}>{copy.title}</h1>
			<p class:list={[deckClass, 'mt-6 max-w-[40rem]']}>{copy.intro}</p>
		</header>

		<section class='mb-[clamp(5rem,10vw,8rem)]' aria-labelledby='problems-title'>
			<h2 id='problems-title' class:list={[headingClass, 'mb-8']}>{copy.findProblem}</h2>
			<div class='grid gap-x-10 gap-y-10 md:grid-cols-2'>
				{problemGroups.map((group) => (
					<div>
						<h3 class='m-0 font-editorial text-2xl leading-[1.18] font-normal text-ink'>{group.title}</h3>
						<ul class='m-0 mt-3 grid list-none gap-3 p-0 text-lg leading-[1.5]'>
							{group.problems.map((problem) => (
								<li class='text-ink'>
									{locale === 'es' ? problem.textEs : problem.text}
									<span class='block text-base text-ink-muted'>
										{problem.entries.map((id, index) => {
											const topic = byId.get(id)!;
											return <>{index > 0 && copy.or}<a class:list={['text-ink', underlineClass]} href={topic.href} hreflang={topic.hreflang}>{topic.title}{topic.hreflang && copy.fallback}</a></>;
										})}
									</span>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
			<p class='mt-10 mb-0 max-w-[40rem] text-lg leading-[1.55] text-ink'>
				{copy.contactBefore}<a class:list={['text-ink', underlineClass]} href={localizedPath('/contact/', locale)}>{copy.contactLink}</a>{copy.contactAfter}
			</p>
		</section>

		{groups.map((group) => (
			<section id={group.id} class='mb-[clamp(5rem,10vw,8rem)] scroll-mt-24 last:mb-0' aria-labelledby={`${group.id}-title`}>
				<div class='mb-8'>
					<h2 id={`${group.id}-title`} class={headingClass}>{group.title}</h2>
					<p class='mt-3 mb-0 max-w-[38rem] text-lg leading-[1.55] text-ink-muted'>{group.description}</p>
				</div>
				<ul class='m-0 grid list-none gap-7 p-0'>
					{group.entries.map((topic) => (
						<li>
							<a class='group grid items-baseline gap-1 no-underline md:grid-cols-[17rem_minmax(0,1fr)] md:gap-8' href={topic.href} hreflang={topic.hreflang}>
								<span class:list={['font-editorial text-2xl leading-[1.18] text-ink', titleHoverClass]}>{topic.title}{topic.hreflang && <span class='font-sans text-base text-ink-muted'>{copy.fallback}</span>}</span>
								<span class='text-base leading-[1.6] text-ink-muted'>
									{topic.summary}
									{topic.tools.length > 0 && <span class='mt-1 block'>{topic.tools.join(' · ')}</span>}
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))}
	</div>
</BaseLayout>
