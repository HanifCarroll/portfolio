---
import { Image } from 'astro:assets';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary, getLocale, localizedPath } from '../i18n';
import NotFoundImage from '@src/assets/img/404-not-found.png';
import { buttonClass, deckClass, metaClass, pageTitleClass, shellClass, textLinkClass } from '../lib/ui';

const locale = getLocale(Astro.currentLocale);
const { action } = getDictionary(locale);
const copy = {
	en: {
		title: '404 Page Not Found - ' + SITE_TITLE,
		description: SITE_DESCRIPTION + ' 404 Page Not Found',
		heading: 'Page not found',
		body: "The page you're looking for is either moved or no longer exists.",
		back: 'Return home',
		projects: 'Browse projects',
		alt: 'Lost page illustration',
		closing: 'Have something in your business you’d like help with?',
	},
	es: {
		title: 'Página no encontrada (404) | ' + SITE_TITLE,
		description: 'La página que buscás cambió de dirección o ya no existe. Volvé al inicio o mirá mis proyectos.',
		heading: 'Página no encontrada',
		body: 'La página que buscás cambió de dirección o ya no existe.',
		back: 'Volvé al inicio',
		projects: action.seeProjects,
		alt: 'Ilustración de página perdida',
		closing: '¿Necesitás ayuda con algo en tu negocio?',
	},
}[locale];
---

<BaseLayout
	title={copy.title}
	description={copy.description}
	footerCtaTitle={copy.closing}
>
	<section class:list={[shellClass, 'pt-12 pb-[clamp(6rem,12vw,10rem)] lg:pt-20']} aria-labelledby='not-found-title'>
		<p class:list={[metaClass, 'mb-4']}>404</p>
		<h1 id='not-found-title' class={pageTitleClass}>{copy.heading}</h1>
		<p class:list={[deckClass, 'mt-6']}>{copy.body}</p>
		<div class='mt-8 flex flex-wrap items-center gap-x-6 gap-y-3'>
			<a class={buttonClass()} href={localizedPath('/', locale)}>{copy.back}</a>
			<a class={textLinkClass} href={localizedPath('/projects/', locale)}>{copy.projects}</a>
		</div>
		<Image width={300} class='mt-16' src={NotFoundImage} alt={copy.alt} />
	</section>
</BaseLayout>
